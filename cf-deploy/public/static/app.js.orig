  if (O?.rec && O.recState === 'idle') oakAssess(O.rec.blob, O.data.sentences[O.idx]);
}
window.oakRetryAssess = oakRetryAssess;
async function oakAssess(recBlob, sentence) {
  const O = window._oak;
  if (!O || !O.data.assessEnabled) return;
  if (lcAvailable() && lcNetOff()) { O.recError = '现在没网，录音已保存，联网后可重新评测出分'; oakRenderControls(); return; }
  const seq = ++O.assessSeq, key = oakKey(O);
  const current = () => window._oak === O && seq === O.assessSeq;
  O.assess = { state: 'assessing' }; oakRenderControls();
  let wav;
  try { wav = await oakBlobToWav16k(recBlob); }
  catch (_) {
    if (current()) { O.assess = { state: 'error', msg: '这段录音处理不了，重新录一遍吧' }; oakRenderControls(); }
    return;
  }
  if (!current() || !O.data.assessEnabled) return;
  const controller = new AbortController();
  const timeoutMsg = '点评超时了，录音已保存，点重新点评';
  const timer = setTimeout(() => controller.abort(), 30000);
  try {
    const response = await fetch('/api/oak/assess?child_id=' + O.data.childId, { method: 'POST', headers: { 'Content-Type': 'audio/wav', 'x-ref-text': encodeURIComponent(sentence.en) }, body: wav, signal: controller.signal });
    if (response.status === 504) throw new Error(timeoutMsg);
    if (!response.ok) throw new Error('点评没成功，检查一下网络再试');
    const j = await response.json();
    if (controller.signal.aborted) throw new Error(timeoutMsg);
    if (!current()) return;
    if (j.error === 'timeout') throw new Error(timeoutMsg);
    if (j.ok !== true) throw new Error(j.error === 'not_configured' ? 'AI 点评还没开通，请家长在家长区确认设置' : j.error === 'not_recognized' ? '没听清，再大声读一遍吧' : '点评没成功，检查一下网络再试');
    const stars = calcStars(j.pron);
    const bad = (Array.isArray(j.words) ? j.words : []).filter(w => w && w.err !== 'Insertion' && (w.err === 'Omission' || (typeof w.score === 'number' && w.score < 60))).sort((a, b) => (a.score || 0) - (b.score || 0)).slice(0, 3).map(w => ({ w: w.w || '', score: w.score || 0 }));
    O.assess = { state: 'done', stars, bad };
    if (typeof j.fiveStarCount === 'number') O.data.fiveStarCount = j.fiveStarCount;
    if (j.draw) O.data.draw = j.draw;
    try {
      const saved = JSON.parse(localStorage.getItem('oak.assess') || '{}');
      saved[key] = { stars, bad, at: Date.now() };
      localStorage.setItem('oak.assess', JSON.stringify(saved));
    } catch (_) {}
  } catch (e) {
    if (!current()) return;
    const messages = ['AI 点评还没开通，请家长在家长区确认设置', '没听清，再大声读一遍吧'];
    O.assess = { state: 'error', msg: controller.signal.aborted || e.name === 'AbortError' || e.message === timeoutMsg ? timeoutMsg : messages.includes(e.message) ? e.message : '点评没成功，检查一下网络再试' };
  } finally {
    clearTimeout(timer);
  }
  if (current()) oakRenderControls();
}
function oakEncodeWav16(samples, sampleRate) {
  var n = samples.length, buf = new ArrayBuffer(44 + n * 2), v = new DataView(buf);
  var str = function (o, s) { for (var i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };
  str(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); str(8, 'WAVE');
  str(12, 'fmt '); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
  v.setUint32(24, sampleRate, true); v.setUint32(28, sampleRate * 2, true);
  v.setUint16(32, 2, true); v.setUint16(34, 16, true);
  str(36, 'data'); v.setUint32(40, n * 2, true);
  for (var i = 0; i < n; i++) {
    var x = Math.max(-1, Math.min(1, samples[i] || 0));
    v.setInt16(44 + i * 2, x < 0 ? x * 0x8000 : x * 0x7fff, true);
  }
  return new Blob([buf], { type: 'audio/wav' });
}

async function oakBlobToWav16k(blob) {
  var AC = window.AudioContext || window.webkitAudioContext;
  var OAC = window.OfflineAudioContext || window.webkitOfflineAudioContext;
  if (!AC || !OAC || !blob) throw new Error('no_audio_api');
  var ctx = new AC();
  try {
    var ab = blob.arrayBuffer ? await blob.arrayBuffer() : await new Response(blob).arrayBuffer();
    var decoded = await new Promise(function (res, rej) {
      var p = ctx.decodeAudioData(ab, res, rej);
      if (p && p.then) p.then(res, rej);
    });
    var len = Math.max(1, Math.ceil(decoded.duration * 16000));
    var off = new OAC(1, len, 16000);
    var src = off.createBufferSource();
    src.buffer = decoded; src.connect(off.destination); src.start(0);
    var rendered = await new Promise(function (res, rej) {
      off.oncomplete = function (e) { res(e.renderedBuffer); };
      var p = off.startRendering();
      if (p && p.then) p.then(res, rej);
    });
    return oakEncodeWav16(rendered.getChannelData(0), 16000);
  } finally {
    try { if (ctx.close) ctx.close(); } catch (e) {}
  }
}


async function upgradeMoveByIndex(i) {
  const m = (window._kidMoves || [])[i];
  const id = window._kidId;
  if (!m || !id) return;
  const cur = m.skillLevel || 1;
  if (cur >= 5) { alert('这个招式已经满级啦'); return; }
  if (!await askConfirm(`要用 3 枚技能碎片把「${m.name}」升到技能 Lv.${cur + 1} 吗？`)) return;
  const j = await api('/api/quiz/upgrade-move', { child_id: id, moveName: m.name });
  if (!j.ok) { alert(j.error || '升级失败'); return; }
  celebrate('技能升级！', null, `${ic('sparkles')} ${esc(j.move.name)}升到技能 Lv.${j.move.skillLevel}啦！`);
  setTimeout(() => { closeModal(); goChild(id); }, 1100);
  await loadOverview(false);
}
window.upgradeMoveByIndex = upgradeMoveByIndex;

// 招式名 → [效果名, 详情说明, 按钮简短说明]
const MOVE_FX = {
  '撒娇': ['弱化', '对方下一次攻击伤害降低 40%', '对方下招变弱'],
  '叫声': ['弱化', '对方下一次攻击伤害降低 40%', '对方下招变弱'],
  '摇尾巴': ['弱化', '对方下一次攻击伤害降低 40%', '对方下招变弱'],
  '蹭蹭脸颊': ['蓄力', '自己下一次攻击伤害提升 50%', '自己下招变强'],
  '生长': ['蓄力', '自己下一次攻击伤害提升 50%', '自己下招变强'],
  '求雨': ['蓄力', '自己下一次攻击伤害提升 50%', '自己下招变强'],
  '烟幕': ['干扰', '对方下一次攻击有 50% 概率落空', '对方下招可能落空'],
  '影子分身': ['干扰', '对方下一次攻击有 50% 概率落空', '对方下招可能落空'],
  '缩入壳中': ['防御', '自己受到的下一次攻击伤害减半', '下次受伤减半'],
  '寄生种子': ['吸取', '造成伤害，并回复所造伤害一半的体力', '吸取回复'],
};

const SKILL_FX = {
  weak: [0.6, 0.55, 0.5, 0.45, 0.4],
  charge: [1.5, 1.6, 1.7, 1.8, 1.9],
  shell: [0.5, 0.45, 0.4, 0.35, 0.3],
  smoke: [0.5, 0.55, 0.6, 0.65, 0.7],
};
function skillFxText(m) {
  const fx = MOVE_FX[m.name];
  if (!fx) {
    // MOVE_FX 未收录的变化招（如影子球）以后端 effectKind/effectMult/effectMiss 为准，不走战斗按钮的 moveBtnLabel
    const lv = m.skillLevel || 1;
    if (m.effectKind === 'weak') return `对方下一次攻击 ×${m.effectMult ?? SKILL_FX.weak[lv - 1]}`;
    if (m.effectKind === 'charge') return `自己下一次攻击 ×${m.effectMult ?? SKILL_FX.charge[lv - 1]}`;
    if (m.effectKind === 'shell') return `自己受到的下一次攻击 ×${m.effectMult ?? SKILL_FX.shell[lv - 1]}`;
    if (m.effectKind === 'smoke') return `对方下一次攻击有 ${Math.round((m.effectMiss ?? SKILL_FX.smoke[lv - 1]) * 100)}% 概率落空`;
    if (m.effectKind === 'drain') return '造成伤害，并回复所造伤害一半的体力';
    return null;
  }
  if (fx[0] === '吸取') return '造成伤害，并回复所造伤害一半的体力';
  const lv = m.skillLevel || 1;
  if (fx[0] === '弱化') return `对方下一次攻击 ×${m.effectMult ?? SKILL_FX.weak[lv - 1]}`;
  if (fx[0] === '蓄力') return `自己下一次攻击 ×${m.effectMult ?? SKILL_FX.charge[lv - 1]}`;
  if (fx[0] === '防御') return `自己受到的下一次攻击 ×${m.effectMult ?? SKILL_FX.shell[lv - 1]}`;
  if (fx[0] === '干扰') {
    const p = Math.round((m.effectMiss ?? SKILL_FX.smoke[lv - 1]) * 100);
    return `对方下一次攻击有 ${p}% 概率落空`;
  }
  return fx[1];
}
function skillFxNextText(m) {
  const fx = MOVE_FX[m.name];
  if (!fx) {
    const lv = m.skillLevel || 1;
    if (lv >= 5) return null;
    const nl = lv + 1;
    if (m.effectKind === 'weak') return `下一级（技能 Lv.${nl}）：对方下一次攻击 ×${SKILL_FX.weak[nl - 1]}`;
    if (m.effectKind === 'charge') return `下一级（技能 Lv.${nl}）：自己下一次攻击 ×${SKILL_FX.charge[nl - 1]}`;
    if (m.effectKind === 'shell') return `下一级（技能 Lv.${nl}）：自己受到的下一次攻击 ×${SKILL_FX.shell[nl - 1]}`;
    if (m.effectKind === 'smoke') return `下一级（技能 Lv.${nl}）：对方下一次攻击有 ${Math.round(SKILL_FX.smoke[nl - 1] * 100)}% 概率落空`;
    return null;
  }
  if (fx[0] === '吸取') return null;
  const lv = m.skillLevel || 1;
  if (lv >= 5) return null;
  const nl = lv + 1;
  if (fx[0] === '弱化') return `下一级（技能 Lv.${nl}）：对方下一次攻击 ×${SKILL_FX.weak[nl - 1]}`;
  if (fx[0] === '蓄力') return `下一级（技能 Lv.${nl}）：自己下一次攻击 ×${SKILL_FX.charge[nl - 1]}`;
  if (fx[0] === '防御') return `下一级（技能 Lv.${nl}）：自己受到的下一次攻击 ×${SKILL_FX.shell[nl - 1]}`;
  if (fx[0] === '干扰') return `下一级（技能 Lv.${nl}）：对方下一次攻击有 ${Math.round(SKILL_FX.smoke[nl - 1] * 100)}% 概率落空`;
  return null;
}
function moveBtnLabel(m) {
  const fx = MOVE_FX[m.name];
  if (!fx) return `<small>${tr(`威力 ${m.power}`, `Power ${m.power}`)}</small>`;
  if (fx[0] === '吸取') return `<small>${tr(`威力 ${m.power} 吸取回复`, `Power ${m.power} Drain & heal`)}</small>`;
  return `<small>${ic('sparkles')} ${fx[0]} ${fx[2]}</small>`;
}

function showMoveDetail(i) {
  const m = (window._kidMoves || [])[i];
  if (!m) return;
  const fx = MOVE_FX[m.name];
  const isStatus = (fx && fx[0] !== '吸取') || (m.effectKind && m.effectKind !== 'drain');
  const fxName = fx ? fx[0] : ({ weak: '弱化', charge: '蓄力', smoke: '干扰', shell: '防御', drain: '吸取' }[m.effectKind] || null);
  const skillLv = m.skillLevel || 1;
  const powerTxt = isStatus ? tr('变化招式，本身不造成伤害', 'Status move, Deals no damage itself') : tr(`威力 ${m.power}`, `Power ${m.power}`);
  const learnTxt = m.early ? tr('已解锁招式', 'Unlocked move') : tr(`Lv.${m.level} 学会`, `Learned at Lv.${m.level}`);
  const skillTxt = m.fairy ? '' : ` 技能 Lv.${skillLv}`;
  const fxTxt = skillFxText(m);
  const fxNext = skillFxNextText(m);
  const nextPowerTxt = (!isStatus && !m.fairy && skillLv < 5) ? `下一级（技能 Lv.${skillLv + 1}）：威力 ${m.power + 6}` : null;
  const frags = (window._kidQuiz && window._kidQuiz.fragments) || 0;
  let upgradeHtml = '';
  if (!m.fairy) {
    if (skillLv >= 5) upgradeHtml = `<p style="text-align:center">已满级</p>`;
    else if (frags >= 3) upgradeHtml = `<button class="bigbtn" onclick="upgradeMoveByIndex(${i})">用 3 枚碎片升到技能 Lv.${skillLv + 1}</button>`;
    else upgradeHtml = `<button class="bigbtn" disabled>还差 ${3 - frags} 枚碎片</button>`;
  }
  const root = (typeof modalRoot !== 'undefined' && modalRoot) || document.getElementById('modal-root');
  if (!root) return;
  root.innerHTML = `<div class="overlay" onclick="if(event.target===this)closeModal()"><div class="modal">
    <div style="text-align:center">${typeChip(m.type)}</div>
    <h3 style="text-align:center;margin:8px 0 4px">${esc(m.name)}${m.early ? ' ' + ic('puzzle') : ''}</h3>
    <p style="text-align:center;color:var(--text-2);margin:0 0 8px">${powerTxt} ${learnTxt}${skillTxt}</p>
    ${fxName && fxTxt ? `<p class="note">${ic('sparkles')} ${fxName}：${fxTxt}</p>` : ''}
    ${fxNext ? `<p class="note">${fxNext}</p>` : ''}
    ${nextPowerTxt ? `<p class="note">${nextPowerTxt}</p>` : ''}
    <p>${esc(m.desc || '')}</p>
    ${upgradeHtml}
    <button class="bigbtn" onclick="closeModal()">知道啦</button>
  </div></div>`;
}
window.showMoveDetail = showMoveDetail;

/* 备战宠招式详情（2026-11-07）：图鉴卡片里已学会的备战招式点开，复用主宠 showMoveDetail 的
 * 文案与升级交互（3 碎片升 1 级、上限 5 级、同一确认与庆祝口径），只多传 benchNo 走备战校验；
 * “知道啦”回卡片（不回图鉴网格），升级成功后刷新图鉴页。未学会的招式卡片上不可点，不进这里。 */
function showDexMoveDetail(i) {
  const m = (window._dexMoves || [])[i];
  if (!m || !m.learned) return;
  const fx = MOVE_FX[m.name];
  const isStatus = (fx && fx[0] !== '吸取') || (m.effectKind && m.effectKind !== 'drain');
  const fxName = fx ? fx[0] : ({ weak: '弱化', charge: '蓄力', smoke: '干扰', shell: '防御', drain: '吸取' }[m.effectKind] || null);
  const skillLv = m.skillLevel || 1;
  const powerTxt = isStatus ? tr('变化招式，本身不造成伤害', 'Status move, Deals no damage itself') : tr(`威力 ${m.power}`, `Power ${m.power}`);
  const learnTxt = tr(`Lv.${m.level} 学会`, `Learned at Lv.${m.level}`);
  const skillTxt = ` 技能 Lv.${skillLv}`;
  const fxTxt = skillFxText(m);
  const fxNext = skillFxNextText(m);
  const nextPowerTxt = (!isStatus && skillLv < 5) ? `下一级（技能 Lv.${skillLv + 1}）：威力 ${m.power + 6}` : null;
  const frags = (dexData && typeof dexData.fragments === 'number') ? dexData.fragments : ((window._kidQuiz && window._kidQuiz.fragments) || 0);
  let upgradeHtml = '';
  if (skillLv >= 5) upgradeHtml = `<p style="text-align:center">已满级</p>`;
  else if (frags >= 3) upgradeHtml = `<button class="bigbtn" onclick="upgradeBenchMoveByIndex(${i})">用 3 枚碎片升到技能 Lv.${skillLv + 1}</button>`;
  else upgradeHtml = `<button class="bigbtn" disabled>还差 ${3 - frags} 枚碎片</button>`;
  const root = (typeof modalRoot !== 'undefined' && modalRoot) || document.getElementById('modal-root');
  if (!root) return;
  root.innerHTML = `<div class="overlay" onclick="if(event.target===this)closeModal()"><div class="modal">
    <div style="text-align:center">${typeChip(m.type)}</div>
    <h3 style="text-align:center;margin:8px 0 4px">${esc(m.name)}</h3>
    <p style="text-align:center;color:var(--text-2);margin:0 0 8px">${powerTxt} ${learnTxt}${skillTxt}</p>
    ${fxName && fxTxt ? `<p class="note">${ic('sparkles')} ${fxName}：${fxTxt}</p>` : ''}
    ${fxNext ? `<p class="note">${fxNext}</p>` : ''}
    ${nextPowerTxt ? `<p class="note">${nextPowerTxt}</p>` : ''}
    <p>${esc(m.desc || '')}</p>
    ${upgradeHtml}
    <button class="bigbtn" onclick="backToDexCard()">知道啦</button>
  </div></div>`;
}
window.showDexMoveDetail = showDexMoveDetail;

function backToDexCard() {
  if (window._dexMoveKey) openDexCard(window._dexMoveKey);
  else closeModal();
}
window.backToDexCard = backToDexCard;

async function upgradeBenchMoveByIndex(i) {
  const m = (window._dexMoves || [])[i];
  const id = state.childId;
  const no = window._dexMoveNo;
  if (!m || !id || !no) return;
  const cur = m.skillLevel || 1;
  if (cur >= 5) { alert('这个招式已经满级啦'); return; }
  if (!await askConfirm(`要用 3 枚技能碎片把「${m.name}」升到技能 Lv.${cur + 1} 吗？`)) return;
  const j = await api('/api/quiz/upgrade-move', { child_id: id, moveName: m.name, benchNo: no });
  if (!j.ok) { alert(j.error || '升级失败'); return; }
  celebrate('技能升级！', null, `${ic('sparkles')} ${esc(j.move.name)}升到技能 Lv.${j.move.skillLevel}啦！`);
  delete cacheMap('dexCache')[id]; delete cacheMap('dexCacheAt')[id];
  setTimeout(() => { closeModal(); goPokedex(id); }, 1100);
  await loadOverview(false);
}
window.upgradeBenchMoveByIndex = upgradeBenchMoveByIndex;

/* 称号徽章点开看徽章（2026-11-11 徽章合一）：一里程碑一枚徽章，图标即贴纸 emoji；弹框显示贴纸＋对应称号名。titles 与 stickers 按下标成对，名字存 window._childTitles、贴纸存 window._childStickers。 */
function showTitleBadge(i) {
  const t = (window._childTitles || [])[Number(i)];
  const s = (window._childStickers || [])[Number(i)];
  if (!t) return;
  showModal(`<div style="text-align:center;padding:8px 0 4px"><div style="font-size:2.5rem">${esc(s || '🏅')}</div><div style="font-size:22px;font-weight:600;margin-top:8px">${esc(t)}</div></div>`);
}
window.showTitleBadge = showTitleBadge;

/* ---------- 对战选技能：紧凑图标排＋点击弹框（2026-11-06 用户反馈：全宽大按钮占满一屏，对战框看不到） ----------
 * 复用现有 .moveicons/.moveicon（伙伴招式列表同款：属性图标＋技能名）与 modal/overlay 写法；
 * 出招仍走 battleMove(name)，弹框确认先关框再出招。注意：对战视图的招式对象只有
 * {name, type, damage_class, power}（服务端 buildPlayerSide 已去掉 skillLevel），所以弹框不显示
 * “下一级威力”（无技能等级数据，写了就是编的）；威力与效果说明以当前招式对象为准。 */
function battleMovePickerHtml(moves) {
  window._battleMoves = moves || [];
  // 与首页招式区同款紧凑布局：一行 5 个（.moves5，66px 格），2026-11-14 用户反馈对战页仍是 4 列留白后补；
  // 道馆（4592）与兄弟对战（4600）共用本函数，两处一起改。
  return `<div class="moveicons moves5 battle-moves">${(moves || []).map((m, i) => `<button class="moveicon" onclick="battleMoveClick(${i})" onpointerdown="battleMoveDown(${i})" onpointerup="battleMoveUp()" onpointerleave="battleMoveUp()" onpointercancel="battleMoveUp()" oncontextmenu="return battleMoveCtx(${i})"><img loading="lazy" src="${moveIconSrc(m)}" alt="" draggable="false" onerror="this.remove()"><span>${esc(m.name)}</span></button>`).join('')}</div>
    <div class="battle-move-busy" hidden>${tr('出招中…', 'Attacking…')}</div>`;
}
/* 单击即出招（2026-11-15 对战修复批 #3）：点技能按钮直接出招；长按（≥450ms）或右键/系统长按菜单
 * 打开原详情弹框 showBattleMoveDetail（弹框里仍可“用这个技能”）。长按触发后随之而来的 click 要吞掉，
 * 否则看完详情松手就会误出招。出招期间 battleMoveBusyUI 置灰整排按钮并显示“出招中…”。 */
let _bmPress = null;
function battleMoveDown(i) {
  battleMoveUp();
  _bmPress = { i: i, fired: false, timer: setTimeout(function () { if (_bmPress) { _bmPress.fired = true; _bmPress.timer = null; showBattleMoveDetail(i); } }, 450) };
}
function battleMoveUp() {
  if (_bmPress && _bmPress.timer) { clearTimeout(_bmPress.timer); _bmPress.timer = null; }
}
function battleMoveClick(i) {
  const fired = _bmPress && _bmPress.fired;
  _bmPress = null;
  if (fired) return; // 刚长按看过详情，这次抬手产生的 click 不算出招
  const m = (window._battleMoves || [])[i];
  if (!m || window._battleBusy || window._battleAnimating) return;
  battleMove(m.name);
}
function battleMoveCtx(i) {
  // 触屏系统长按会弹 contextmenu：拦掉并当作“看详情”（若 450ms 计时器已先开过，就不重复开）
  if (!(_bmPress && _bmPress.fired)) { battleMoveUp(); _bmPress = { i: i, fired: true, timer: null }; showBattleMoveDetail(i); }
  return false;
}
function battleMoveBusyUI(on) {
  document.querySelectorAll(".moveicons.battle-moves").forEach(function (el) { el.classList.toggle('is-busy', !!on); el.querySelectorAll('.moveicon').forEach(function (b) { b.disabled = !!on; }); });
  document.querySelectorAll('.battle-move-busy').forEach(function (el) { el.hidden = !on; });
}
window.battleMoveDown = battleMoveDown; window.battleMoveUp = battleMoveUp; window.battleMoveClick = battleMoveClick; window.battleMoveCtx = battleMoveCtx;
function showBattleMoveDetail(i) {
  const m = (window._battleMoves || [])[i];
  if (!m) return;
  const fx = MOVE_FX[m.name];
  const isStatus = (fx && fx[0] !== '吸取') || (m.effectKind && m.effectKind !== 'drain');
  const fxName = fx ? fx[0] : ({ weak: '弱化', charge: '蓄力', smoke: '干扰', shell: '防御', drain: '吸取' }[m.effectKind] || null);
  const powerTxt = isStatus ? tr('变化招式，本身不造成伤害', 'Status move, Deals no damage itself') : tr(`威力 ${m.power}`, `Power ${m.power}`);
  const fxTxt = skillFxText(m);
  const root = (typeof modalRoot !== 'undefined' && modalRoot) || document.getElementById('modal-root');
  if (!root) return;
  root.innerHTML = `<div class="overlay" onclick="if(event.target===this)closeModal()"><div class="modal">
    <div style="text-align:center">${typeChip(m.type)}</div>
    <h3 style="text-align:center;margin:8px 0 4px">${esc(m.name)}</h3>
    <p style="text-align:center;color:var(--text-2);margin:0 0 8px">${powerTxt}</p>
    ${fxName && fxTxt ? `<p class="note">${ic('sparkles')} ${fxName}：${fxTxt}</p>` : ''}
    <button class="bigbtn blue" onclick="confirmBattleMove('${esc(m.name)}')">${tr('用这个技能', 'Use this move')}</button>
    <button class="bigbtn" onclick="closeModal()">${tr('取消', 'Cancel')}</button>
  </div></div>`;
}
function confirmBattleMove(name) {
  if (!name) return;
  closeModal();
  battleMove(name);
}
window.showBattleMoveDetail = showBattleMoveDetail;
window.confirmBattleMove = confirmBattleMove;


/* ---------- 道馆（闯关梯子 + 兄弟对战，共用战斗引擎） ---------- */
const TYPE_EN = { '电': 'electric', '火': 'fire', '水': 'water', '草': 'grass', '岩石': 'rock', '地面': 'ground', '普通': 'normal', '飞行': 'flying', '龙': 'dragon', '妖精': 'fairy' }; // 2026-11-09 任务 72：妖精补图标（此前无 fairy 文件，回退 normal）
// 2026-11-13 任务 106：个别招式有专属图标（img/moves/），其余招式仍用属性图标
const MOVE_ICONS = { '伏特攻击': 'volt-tackle', '打雷': 'thunder', '十万伏特': 'thunderbolt', '电球': 'electro-ball' };
const moveIconSrc = (m) => MOVE_ICONS[m.name] ? `/static/img/moves/${MOVE_ICONS[m.name]}.webp` : `/static/img/types/${TYPE_EN[m.type] || 'normal'}.webp`;
function typeChip(type) {
  const en = TYPE_EN[type];
  return `<span class="typechip">${en ? `<img loading="lazy" src="/static/img/types/${en}.webp" alt="" onerror="this.remove()">` : ''}${esc(type || '')}</span>`;
}
function hpBarHtml(p) {
  const pct = Math.max(0, Math.round((p.hp / p.maxHp) * 100));
  const cls = pct > 50 ? 'hp-hi' : pct > 25 ? 'hp-mid' : 'hp-low';
  return `<div class="hpbar"><i class="${cls}" style="width:${pct}%"></i></div><div class="hptext">HP ${p.hp} / ${p.maxHp}</div>`;
}
function petFace(p, size) {
  if (p.img) return `<img src="${p.img}" style="width:${size}px;height:${size}px;object-fit:contain">`;
  return eggHtml(p.egg || EGG_FALLBACK, size);
}

async function goGym(id) {
  careRoomUnmount(); // 离开养成页先卸掉房间
  if (lcAvailable() && !lcNetOff()) setTimeout(function () { lcLoadEngine().catch(function () {}); }, 1500); // 在线时空闲预热离线引擎（失败静默）
  state.childId = id;
  state.view = 'gym';
  const snap = lcAvailable() ? await lcSnapshot(id) : null;
  if (snap && snap.gymStatus && snap.pvpStatus && snap.pokedexFull) {
    window._gymPage = { id, status: snap.gymStatus, pvp: snap.pvpStatus, benchGym: null, leadGym: null, benchPvp: null, benchJoin: null, eggs: (snap.child.sealedEggs || []), dex: snap.pokedexFull, form: snap.child.form };
    renderGymPage();
    if (lcShouldSync()) lcSyncChild(id);
    return;
  }
  const gymC = cacheMap('gymCache')[id];
  const pvC = cacheMap('pvpCache')[id];
  const cdC = state.childCache[id];
  const dxC = cacheMap('dexCache')[id];
  const gymFresh = gymC && cacheFresh(cacheMap('gymCacheAt')[id]);
  const pvFresh = pvC && cacheFresh(cacheMap('pvpCacheAt')[id]);
  const cdFresh = cdC && cacheFresh(state.childCacheAt[id]);
  const dxFresh = dxC && cacheFresh(cacheMap('dexCacheAt')[id]);
  if (gymFresh && pvFresh && cdFresh && dxFresh) {
    window._gymPage = { id, status: gymC, pvp: pvC, benchGym: null, leadGym: null, benchPvp: null, benchJoin: null, eggs: cdC.sealedEggs || [], dex: dxC, form: cdC.form };
    renderGymPage();
    if (lcAvailable() && lcShouldSync()) lcSyncChild(id);
    return;
  }
  const [j, pv, cd, dx] = await Promise.all([
    gymFresh ? Promise.resolve(gymC) : api('/api/gym/status', { childId: id }),
    pvFresh ? Promise.resolve(pvC) : api('/api/battle/pvp/status', { childId: id }),
    cdFresh ? Promise.resolve({ ok: true, child: cdC }) : api('/api/child?id=' + id),
    dxFresh ? Promise.resolve(dxC) : api('/api/pokedex', { childId: id }),
  ]);
  if (!j.ok) return;
  if (!gymFresh) { cacheMap('gymCache')[id] = j; cacheMap('gymCacheAt')[id] = Date.now(); }
  if (!pvFresh && pv && pv.ok) { cacheMap('pvpCache')[id] = pv; cacheMap('pvpCacheAt')[id] = Date.now(); }
  if (!cdFresh && cd.ok) storeChild(id, cd);
  if (!dxFresh && dx.ok) { cacheMap('dexCache')[id] = dx; cacheMap('dexCacheAt')[id] = Date.now(); }
  if (lcAvailable()) lcEnsureFull(id).catch(() => {});
  window._gymPage = { id, status: j, pvp: pv.ok ? pv : null, benchGym: null, leadGym: null, benchPvp: null, benchJoin: null, eggs: cd.ok ? cd.child.sealedEggs : [], dex: dx.ok ? dx : null, form: cd.ok ? cd.child.form : null };
  renderGymPage();
  if (lcAvailable() && lcShouldSync()) lcSyncChild(id);
}
window.goGym = goGym;

/* 主宠当前形态（2026-10-27 探针发现修）：须用孩子实际形态（/api/child 的 form，由后端 attachEvoForm 挂载），
 * 不能只用 current && no != null——lineEntries 的 current 对整条线都为真，那会把 Lv1 蛋孩子错认成一阶形态
 * （主宠球显示皮丘、点开无反应）；也不能纯按等级推导——终极形态须用过石头才成真（后端 formInfo 同款封顶逻辑）。
 * form 为空时按蛋处理（不猜形态）。 */
function mainPetEntry(dx, form) {
  if (!dx) return null;
  if (form && form.branch) {
    // 已进化分支的当前形态在收藏进化里（分支进化写 egg:{no} 图鉴行，见后端 applyEeveeBranchEvo）；
    // form.branchNo 是分支物种号（attachEvoForm 挂载），按它在收藏里找当前条目。
    const b = (dx.collection || []).find((e) => e.no === form.branchNo && e.unlocked);
    if (b) return b;
  }
  const idx = form ? form.formIdx : 0;
  return (dx.lineEntries || []).find((e) => e.current && e.formIdx === idx) || null;
}
window.mainPetEntry = mainPetEntry;

/* 道馆备战选择器（2026-10-27 返工第 3 件；同日用户纠正后改紧凑版）：
 * 小球横排：球约 52px、球内放立绘，球下方只一行名字（主宠名/精灵名），
 * 不再显示任何附加信息行（“克制第 X 关！”角标、属性·备战·等级行、“不带备战”
 * 副文案一律不画）。所有详情（克制列表、属性、等级）只在点开后的卡片里看。
 * 点球 = 看卡片（openGymBenchCard：复用 openDexCard，卡片内含实战克制列表）；
 * 选备战 = 卡片里的“带它备战”/“只带主宠”按钮（pickGymBenchFromCard），点球本身不改选择；
 * 主宠球用主宠立绘（mainPet.img），备战球用收藏宠立绘；选中态金圈 .on。
 * 主宠还是蛋时球里按物种画蛋（eggHtml，20px），点球弹提示不进卡片（蛋没有卡片）。
 * 球上方的主宠克制提示行（renderGymPage 的 note）用户没让改，保留；
 * 克制宠仍排前（只排序、不显示徽章）。PvP 的两栏选择器 pvpTeamPickerHtml 不动。 */
/* 备战球标签一行放得下才不乱（2026-11-06）：390px 下一行 5 球只有 362px 宽，
 * 球最小 64px＋4 个 10px 间距占 360px，标签超过 3.7em（4 字中文名、蛋名“神秘的蛋”）
 * 就会把球撑宽、末尾一只掉到第二行。只对超长标签收小字号＋nowrap（短名保持 16px 不变），
 * 收到底限 .6rem 仍放不下的（如主宠数据缺失时的英文 fallback “Main companion”）只保证标签本身一行，
 * 行会折——那是防御分支（图鉴一定先加载，主宠为空基本到不了），不为它再动文案。
 * 返工 2026-11-14：超长标签不再动态收小到 14px 以下，统一收敛到阶梯下限 14px。
 * 真标签最长 4 字中文，14px 仍放得下；英文 fallback 本就是防御分支，行折接受。 */
function ballLabelStyle(name) {
  const w = [...(name || '')].reduce((a, ch) => a + (ch.charCodeAt(0) < 128 ? 0.6 : 1), 0);
  if (w <= 3.7) return '';
  return ' style="font-size:14px;white-space:nowrap"';
}
function benchPickerHtml(collection, selKey, _onclickFn, counterMode, level, mainPet) {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  void biTitle;
  // level 参数保留：等级已移到卡片内展示，球下不再显示
  void level;
  const sel = window._gymPage[selKey];
  const ball = (no, img, name, isEgg, eggDesign) => `<button class="pokeball ${sel === (no || null) ? 'on' : ''}" onclick="openGymBenchCard(${no || 0})">
    <span class="pb-ball">${img ? `<img loading="lazy" src="${img}" alt="">` : (isEgg ? '<span class="pb-star">' + eggHtml(eggDesign || EGG_FALLBACK, 20) + '</span>' : '<span class="pb-star">' + ic('star') + '</span>')}</span>
    <b${ballLabelStyle(name)}>${esc(name)}</b></button>`;
  let list = [...(collection || [])];
  // 道馆备战（借鉴包 v1 §6）：克制宠排前（只排序、不显示徽章；克制详情在卡片里看）
  if (counterMode) list.sort((a, b) => ((b.counters || []).length - (a.counters || []).length) || (a.no - b.no));
  const mainIsEgg = mainPet && mainPet.no == null;
  const mainBall = ball(0, mainPet && mainPet.img, (mainPet && mainPet.name) || tr('主宠', 'Main companion'), mainIsEgg, mainPet && mainPet.egg);
  if (!list.length) return `<div class="benchballs">${mainBall}</div><p style="color:var(--text-2);font-size:var(--fs-label)">${bi('还没有随身的备战伙伴（去大木博士之家，把仓库里的伙伴带在身边），带上后就能选一只当备战。', "No backup companion with you yet (visit Prof. Oak's House to bring a stored partner along). Once you have one, you can pick it as backup.")}</p>`;
  return `<div class="benchballs">${mainBall}${list.map((c) => ball(c.no, c.img, c.name)).join('')}</div>`;
}
/* 道馆精灵球点开卡片：先取图鉴数据（goGym 已预取，缺失时现取），再按编号找已获得条目开卡；
 * no=0 为主宠（当前形态条目，伊布已进化分支时取分支条目）。选备战在卡片内完成。 */
async function openGymBenchCard(no) {
  const G = window._gymPage;
  if (!G) return;
  let dx = G.dex;
  if (!dx) {
    const j = await api('/api/pokedex', { childId: G.id });
    if (!j.ok) return;
    dx = j; G.dex = j;
    cacheMap('dexCache')[G.id] = j; cacheMap('dexCacheAt')[G.id] = Date.now();
  }
  dexData = dx;
  const all = [...(dx.lineEntries || []), ...(dx.wild || []), ...(dx.others || []), ...(dx.collection || []), ...(dx.eggSpecies || []), ...(dx.dex151 || []).map((e) => ({ ...e, key: `dex151:${e.no}` })), ...(dx.benchDex || [])];

  let key = null;
  if (!no) {
    const cur = mainPetEntry(dx, G.form);
    if (!cur) { alert('主宠数据还没加载出来'); return; }
    if (cur.no == null) {
      const first = (dx.lineEntries || []).find((e) => e.current && e.formIdx === 1);
      alert(`还是颗蛋呢！升到 5 级就孵化成${first ? first.name : '一阶形态'}啦`);
      return;
    }
    key = cur.key;
  } else {
    const hit = all.find((e) => e.no === no && e.unlocked);
    key = hit ? hit.key : null;
  }
  if (!key) { alert('这只宠还没有收录进图鉴'); return; }
  window._dexCardGym = { childId: G.id, benchNo: no || null };
  openDexCard(key);
}
/* 随身队伍精灵点开属性卡片（2026-11-05 用户验收）：按编号在图鉴里找已获得条目开卡（与道馆备战卡片同口径，不带选备战上下文）；主宠为蛋时无卡片。 */
async function openPartyPetCard(childId, no) {
  const id = Number(childId);
  const n = Number(no);
  if (!n) return;
  let dx = cacheMap('dexCache')[id];
  if (!dx) {
    const j = await api('/api/pokedex', { childId: id });
    if (!j || !j.ok) return;
    dx = j;
    cacheMap('dexCache')[id] = j; cacheMap('dexCacheAt')[id] = Date.now();
  }
  dexData = dx;
  const all = [...(dx.lineEntries || []), ...(dx.wild || []), ...(dx.others || []), ...(dx.collection || []), ...(dx.eggSpecies || []), ...(dx.dex151 || []).map((e) => ({ ...e, key: `dex151:${e.no}` })), ...(dx.benchDex || [])];
  const hit = all.find((e) => e.no === n && e.unlocked);
  if (!hit) { alert(tr('这只宠还没有收录进图鉴', 'This partner is not in the Pokédex yet')); return; }
  openDexCard(hit.key);
}
window.openPartyPetCard = openPartyPetCard;
window.openGymBenchCard = openGymBenchCard;
function pickGymBenchFromCard() {
  const g = window._dexCardGym;
  if (!g || !window._gymPage) return;
  window._gymPage.benchGym = g.benchNo || null;
  closeModal();
  renderGymPage();
}
window.pickGymBenchFromCard = pickGymBenchFromCard;
/* 任务 126：道馆先发选择——卡片里“让它先发”/“主宠先发”按钮用；null = 主宠先发（默认）。 */
function pickGymLeadFromCard() {
  const g = window._dexCardGym;
  if (!g || !window._gymPage) return;
  window._gymPage.leadGym = g.benchNo || null;
  closeModal();
  renderGymPage();
}
window.pickGymLeadFromCard = pickGymLeadFromCard;
window.pickBenchGym = (no) => { window._gymPage.benchGym = no || null; renderGymPage(); };
window.pickBenchPvp = (no) => { window._gymPage.benchPvp = no || null; renderGymPage(); };
window.pickBenchJoin = (no) => { window._gymPage.benchJoin = no || null; renderGymPage(); };

/* 对战规则：单场战报一句话（VS 卡下方＋荣誉墙战报行共用）。
 * r.defense 为阶段 2 后端字段 {A:{answered,dodges},B:{...}}，旧局无此字段时只显示胜负。 */
/* 对战规则阶段 2（L5）：败者防守表现子句——只进单场战报，不上冠军墙。
 * r.defense 为后端字段 {A:{answered,dodges},B:{...}}，旧局无此字段时返回空。 */
function pvpDefenseClause(r) {
  if (!r.defense) return '';
  const loserSide = r.winnerName === r.aName ? 'B' : 'A';
  const loserName = r.winnerName === r.aName ? r.bName : r.aName;
  const d = r.defense[loserSide];
  if (!d || d.answered <= 0) return '';
  return ` ${esc(loserName)}守住了 ${d.answered} 道题${d.dodges > 0 ? `，触发 ${d.dodges} 次闪避` : ''}`;
}

function pvpBattleSummary(r) {
  const winnerName = r.winnerName || '';
  let s = `本场战报：${esc(winnerName)}胜`;
  if (r.winnerPetsLeft != null && r.totalActions != null) s += `（剩 ${r.winnerPetsLeft} 只，共 ${r.totalActions} 次出招）`;
  s += pvpDefenseClause(r);
  return s;
}

/* 对战规则阶段 1（R18）：两栏出战选择器——每栏主宠固定行＋备战宠胶囊。
 * o: { title, mainPet, level, collection, pickedBenchNo, interactive, onclickFn, oppMainPetName, lockedHint }
 * interactive=false 时胶囊禁用（对方栏：对方加入时自己选；进行中对局的 A 方栏：已选备战只读展示）。
 * 隔离口径（DEPLOY §25）：登录方只能操作自己栏的胶囊，对方栏一律 disabled、点不动。
 * 克制角标：后端 pvpCounter（typeMult 同源），文案「克制{对方主宠名}！」；备战等级与主宠同步。 */
function pvpTeamPickerHtml(o) {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const mp = o.mainPet || {};
  const img = mp.img
    ? `<img src="${mp.img}" style="width:34px;height:34px;object-fit:contain">`
    : eggHtml(mp.egg || EGG_FALLBACK, 34);
  const mainRow = `<div style="display:flex;align-items:center;gap:8px;background:#fefbe9;border-radius:12px;padding:8px 12px;margin-bottom:10px;font-size:16px;font-weight:600">${img}<span>${esc(mp.name || tr('主宠', 'Main companion'))} Lv.${o.level}${mp.type ? ' ' + esc(mp.type) : ''}</span><span style="font-size:14px;color:var(--text-2);font-weight:400">${tr('主宠', 'Main companion')}</span></div>`;
  // 2026-11-05 用户验收：兄弟对战备战选择器改精灵球样式（与道馆同款，点球即选；克制角标保留）。
  const balls = [{ no: 0 }, ...(o.collection || [])];
  let caps = `<div class="benchballs">${balls.map((c) => {
    const sel = (o.pickedBenchNo || null) === (c.no || null);
    const counter = c.no && c.pvpCounter;
    const inner = c.no
      ? (c.img ? `<img loading="lazy" src="${c.img}" alt="">` : `<span class="pb-star">${ic('star')}</span>`)
      : (mp.img ? `<img loading="lazy" src="${mp.img}" alt="">` : `<span class="pb-star">${eggHtml(mp.egg || EGG_FALLBACK, 20)}</span>`);
    const label = c.no ? c.name : (mp.name || tr('主宠', 'Main companion'));
    return `<button class="pokeball ${sel ? 'on' : ''}" ${o.interactive ? `onclick="${o.onclickFn}(${c.no || 0})"` : 'disabled'}><span class="pb-ball">${inner}</span><b${ballLabelStyle(label)}>${esc(label)}</b>${counter ? `<small class="countertag">${ic('swords')} ${tr(`克制${esc(o.oppMainPetName || '对方主宠')}！`, `Counters ${esc(o.oppMainPetName || '对方主宠')}!`)}</small>` : ''}</button>`;
  }).join('')}</div>`;
  if (!o.collection || !o.collection.length) {
    caps += `<p style="color:var(--text-2);font-size:var(--fs-label)">${bi('还没有收藏宠，有收藏宠后可以带一只备战。', 'No collection pets yet. Once you have one, you can bring one as backup.')}</p>`;
  }
  return `<div class="pvp-picker"><h3>${esc(o.title)}</h3><p style="font-size:14px;color:var(--text-2);margin-bottom:10px">${o.interactive ? bi('主宠固定出战，选 1 只备战宠', 'Main companion always fights, pick 1 backup pet') : (o.lockedHint || tr('主宠固定出战', 'Main companion always fights'))}</p>${mainRow}${caps}</div>`;
}

function renderGymPage() {
  const G = window._gymPage;
  const j = G.status;
  const pv = G.pvp;
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const stageCard = (s) => {
    let btn;
    if (s.state === 'locked') {
      btn = `<button class="sc-btn gray" disabled>${ic('lock')} ${tr('先通关上一关', 'Clear the previous stage first')}</button>`;
    } else if (!j.gatesOpen && !j.isWeekend) {
      btn = `<button class="sc-btn gray" disabled>${tr('周末才开放', 'Weekends only')}</button>`;
    } else if (!j.gatesOpen && j.weekApproved < j.need) {
      btn = `<button class="sc-btn gray" disabled>${tr(`本周打卡 ${j.weekApproved}/${j.need} 天`, `Checked in ${j.weekApproved}/${j.need} days this week`)}</button>`;
    } else if (j.myLevel < s.needLevel) {
      btn = `<button class="sc-btn gray" disabled>${tr(`需要 Lv.${s.needLevel}（你 Lv.${j.myLevel}）`, `Requires Lv.${s.needLevel} (you're Lv.${j.myLevel})`)}</button>`;
    } else {
      btn = `<button class="sc-btn ${s.state === 'cleared' ? 'blue' : ''}" style="${s.state === 'cleared' ? '' : 'background:var(--orange);color:var(--text);box-shadow:var(--shadow-float)'}" onclick="startStage(${s.stage})">${s.state === 'cleared' ? tr('再练一次（不重复给蛋）', 'Practice again (no extra egg)') : ic('swords') + ' ' + tr('开始挑战', 'Start challenge')}</button>`;
    }
    return `<div class="subjcard" style="cursor:default">
      <div class="sc-head"><img src="${s.bossImg}" style="width:64px;height:64px;object-fit:contain">
        <div style="flex:1;min-width:0"><div class="sc-name" style="font-size:var(--fs-body);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${tr(`第 ${s.stage} 关 `, `Stage ${s.stage} `)}${esc(s.gymName)}</div>
        <div class="sc-note">${tr('馆主 ', 'Gym leader ')}${esc(s.bossName)} Lv.${s.bossLevel} ${tr('门槛', 'Requires')} ${s.needLevel} ${(s.bossTypes || [s.type]).map((t) => typeChip(t)).join(' ')}</div>
        <div class="sc-note">${ic('gift')} ${tr('通关奖励蛋：', 'Clear reward egg:')}${esc(s.eggName)}</div></div>
      </div>${btn}</div>`;
  };
  let pvpHtml = '';
  if (pv) {
    const rm = pv.rematch || { status: 'none', canRequest: false, requesterName: null };
    const rmApproved = rm.status === 'approved';
    const counted = !!(pv.me.counted || (pv.other && pv.other.counted));
    const meOk = !!pv.gatesOpen || rmApproved || (pv.isWeekend && pv.me.weekApproved >= 4 && !pv.me.counted);
    const otherOk = !!pv.gatesOpen || rmApproved || (pv.isWeekend && pv.other && pv.other.weekApproved >= 4 && !pv.other.counted);
    const canOpen = meOk && otherOk;
    const thisWeekChamp = (pv.champions || []).find((c) => c.weekStart === pv.weekStart);
    const lastWeekChamp = (pv.champions || []).find((c) => c.weekStart !== pv.weekStart);
    // 再来一局状态横幅：无进行中对局时展示（申请入口/待审核/已批准/已驳回/已用完）
    let rematchBanner = '';
    if (!pv.myMatch) {
      if (rm.canRequest) {
        rematchBanner = `<div style="margin:10px 0"><button class="bigbtn" style="background:var(--blue);color:var(--text)" onclick="requestRematch()">${ic('mail')} ${tr('申请再来一局（家长审核）', 'Request a rematch (parent approval)')}</button>
        <p style="color:var(--text-2);font-size:var(--fs-label);margin:6px 0 0">${bi('本周的正式对战打完啦。想再打一场？先申请，家长批准了就能再来一局。', "This week's official battle is done. Want another? Apply first — once a parent approves, you can play again.")}</p></div>`;
      } else if (rm.status === 'pending') {
        rematchBanner = `<div class="note" style="margin:10px 0">${ic('mail')} ${esc(rm.requesterName || '有人')}${bi(' 申请了再来一局，正在等家长审核，批准后这里就能开战。', ' requested a rematch, waiting for parent approval. Once approved, you can start here.')}</div>`;
      } else if (rm.status === 'approved') {
        rematchBanner = `<div class="note" style="margin:10px 0">${ic('checkcircle')} ${bi('家长已经批准再来一局！在下面选好备战就能开战。', 'A parent approved the rematch! Pick your backup below and start.')}</div>`;
      } else if (rm.status === 'rejected') {
        rematchBanner = `<div class="note" style="margin:10px 0">${bi('家长这次没有批准再来一局，本周就到这里啦，下周末再战。', "A parent didn't approve the rematch this time. That's it for this week — rematch next weekend.")}</div>`;
      } else if (rm.status === 'consumed') {
        rematchBanner = `<div class="note" style="margin:10px 0">${bi('本周的再来一局已经打过啦，下周末再战！', "This week's rematch is already played. Rematch next weekend!")}</div>`;
      }
    }
    // R16 状态行（蓝字主行）＋ R17 场次计数行：按 UI 稿 v1 屏 1–5 的文案
    const minApproved = Math.min(pv.me.weekApproved, pv.other ? pv.other.weekApproved : pv.me.weekApproved);
    const countBase = counted
      ? `${tr('本周已战 <b>1/1 场</b>', 'Battled <b>1/1</b> this week')} ${ic('trophy')} ${tr('本周冠军：', "This week's champion: ")}<b>${esc(thisWeekChamp ? thisWeekChamp.childName : tr('已决出', 'Decided'))}</b>`
      : tr('本周已战 <b>0/1 场</b> 胜者 <b>+1 精灵球</b>，记为本周冠军', "Battled <b>0/1</b> this week Winner gets <b>+1 Poké Ball</b> and becomes this week's champion");
    let subHtml = '';
    if (pv.gatesOpen) subHtml = `<div class="pvp-state">${tr('测试放行中，可以开战！', 'Test mode: battle is open!')}</div><div class="pvp-count">${countBase}</div>`;
    else if (!pv.isWeekend) subHtml = `<div class="pvp-state">${tr('还没到周末 周六 0 点开放', 'Not the weekend yet Opens Saturday 0:00')}</div><div class="pvp-count">${countBase}</div>`;
    else if (!counted && minApproved < 4) subHtml = `<div class="pvp-state">${tr(`本周打卡 ${minApproved}/4 天，再完成 ${4 - minApproved} 天就能开战`, `Checked in ${minApproved}/4 days this week, finish ${4 - minApproved} more days to battle`)}</div><div class="pvp-count">${countBase}</div>`;
    else if (counted && rm.status === 'pending') subHtml = `<div class="pvp-state">${tr('本周已战 <b>1/1 场</b> 再来一局：<b>等爸爸妈妈批准</b>', 'Battled <b>1/1</b> this week Rematch: <b>waiting for parent approval</b>')}</div><div class="pvp-count">${tr('批准后可再打 1 场（不计次、不发球、不改冠军）', "After approval, 1 extra battle (doesn't count, no ball, champion unchanged)")}</div>`;
    else if (counted && rm.status === 'approved') subHtml = `<div class="pvp-state">${tr('本周已战 <b>1/1 场</b> 家长已批准再来一局（剩 1 场）', 'Battled <b>1/1</b> this week Parent approved the rematch (1 left)')}</div>`;
    else if (counted && rm.status === 'consumed') subHtml = `<div class="pvp-state">${tr('本周已战 <b>1/1 场</b> 再来一局已用完', 'Battled <b>1/1</b> this week Rematch used up')}</div>`;
    else if (counted && rm.status === 'rejected') subHtml = `<div class="pvp-state">${tr('本周已战 <b>1/1 场</b> 再来一局未批准', 'Battled <b>1/1</b> this week Rematch not approved')}</div>`;
    else subHtml = `<div class="pvp-state">${countBase}</div>`;
    // VS 卡（UI 稿 v1）：大宝队／小宝队，主宠名＋Lv＋属性；蛋形态无立绘时显示蛋图标
    const vsSideHtml = (who) => {
      if (!who) return '';
      const mp = who.mainPet || {};
      const img = mp.img
        ? `<img src="${mp.img}" style="width:72px;height:72px;object-fit:contain">`
        : eggHtml(mp.egg || EGG_FALLBACK, 72);
      return `<div class="vs-side"><span class="vs-team">${esc(who.name)}${tr('队', "'s team")}${who.grade ? ' ' + esc(trGrade(who.grade)) : ''}</span><div class="vs-sprite">${img}</div><div class="vs-name">${esc(mp.name || tr('主宠', 'Main companion'))}</div><div class="vs-lv">Lv.${who.level}${mp.type ? ' ' + esc(mp.type) : ''}</div></div>`;
    };
    // 压平说明行：本周已打完时换成本场战报一句话（UI 稿 v1 屏 4）
    let flatNote = tr('等级按较低一方压平', 'Levels are flattened to the lower side');
    if (counted) {
      const latest = (pv.recent || []).find((r) => r.weekStart === pv.weekStart);
      if (latest) flatNote = pvpBattleSummary(latest);
    }
    const vsHtml = pv.other ? `<div class="vs-row">${vsSideHtml(pv.me)}<div class="vs-mid">VS</div>${vsSideHtml(pv.other)}</div><p class="vs-note">${flatNote}</p>` : '';
    // 备战行（UI 稿 v1 屏 1）：我方为已选备战（未选=只带主宠），对方有进行中对局时取局内备战，否则待加入时选
    const myBenchPet = G.benchPvp ? (pv.benchOptions || pv.myCollection || []).find((c) => c.no === G.benchPvp) : null;
    const myBenchTxt = myBenchPet
      ? `${esc(myBenchPet.name)} ${esc(myBenchPet.type)}${myBenchPet.pvpCounter ? ' <b style="color:var(--danger-text)">克制！</b>' : ''}`
      : tr('只带主宠', 'Main companion only');
    let otherBenchTxt = tr('等对方加入时选', 'Chosen when the opponent joins');
    if (pv.myMatch && pv.myMatch.sides) {
      const otherSide = pv.myMatch.mySide === 'A' ? 'B' : 'A';
      const sp = pv.myMatch.sides[otherSide];
      const bp = sp && sp.pets && sp.pets[1];
      otherBenchTxt = bp ? `${esc(bp.name)} ${esc(bp.type)}` : tr('只带主宠', 'Main companion only');
    }
    const benchRowHtml = `<div class="vs-benchrow"><span class="vs-bench">${tr('备战：', 'Backup: ')}${myBenchTxt}</span><span class="vs-bench">${tr('备战：', 'Backup: ')}${otherBenchTxt}</span></div>`;
    const champLineHtml = lastWeekChamp
      ? `<p style="text-align:center;font-size:14px;color:var(--text-2);margin-bottom:12px">${ic('trophy')} ${tr('上周冠军：', "Last week's champion: ")}${esc(lastWeekChamp.childName)}${tr(`（${esc(lastWeekChamp.weekStart)} 那周）`, ` (week of ${esc(lastWeekChamp.weekStart)})`)}　<a href="#pvp-honor">${tr('查看荣誉墙 ›', 'View honor wall ›')}</a></p>`
      : '';
    // C8 四态主按钮：未到周末／打卡未满／可开战／本周已打完（再来一局待审核另有一态）
    let action = '';
    if (pv.myMatch && pv.myMatch.status === 'waiting') {
      if (pv.myMatch.mySide === 'A') {
        action = `<div class="note">${bi(`你已发起对战，等 ${esc(pv.other ? pv.other.name : '对方')} 在下面输密码加入 ↓`, `You started a battle. Waiting for ${esc(pv.other ? pv.other.name : '对方')} to enter the password below ↓`)}</div>${pvpJoinFormHtml(pv)}`;
      } else {
        action = `<div class="note">${esc(pv.other ? pv.other.name : '对方')}${bi(' 向你发起了对战！选好备战，输入你的小密码加入 ↓', ' challenged you! Pick your backup, enter your little password, and join ↓')}</div>${pvpJoinFormHtml(pv)}`;
      }
    } else if (pv.myMatch && pv.myMatch.status === 'active') {
      action = `<button class="bigbtn" onclick="enterBattle(${pv.myMatch.battleId})">${ic('swords')} ${tr('进入正在进行的对战', 'Enter the ongoing battle')}</button>`;
    } else if (canOpen) {
      // 阶段 1（R18）：两栏出战选择器——我方栏可点，对方栏只读预览（对方加入时自己选）
      action = `<div class="pvp-pickers">${pvpTeamPickerHtml({ title: tr(`${pv.me.name}的出战伙伴`, `${pv.me.name}'s battle team`), mainPet: pv.me.mainPet, level: pv.me.level, collection: pv.myCollection, pickedBenchNo: G.benchPvp, interactive: true, onclickFn: 'pickBenchPvp', oppMainPetName: pv.other && pv.other.mainPet ? pv.other.mainPet.name : '' })}${pv.other ? pvpTeamPickerHtml({ title: tr(`${pv.other.name}的出战伙伴`, `${pv.other.name}'s battle team`), mainPet: pv.other.mainPet, level: pv.other.level, collection: pv.otherCollection, pickedBenchNo: null, interactive: false, lockedHint: tr('对方加入时自己选', 'Opponent picks when joining') }) : ''}</div>
        <button class="bigbtn" onclick="createPvp()">${ic('swords')} ${tr('开始对战', 'Start battle')}</button>
        <p style="color:var(--text-2);font-size:var(--fs-label)">${bi('对方要在同一台设备上输自己的小密码加入。等级按低的一方压平，赢了得精灵球＋本周冠军（不发经验哦）。', "The opponent enters their little password on this same device to join. Levels are flattened to the lower side. Winner gets a Poké Ball + this week's champion (no XP).")}</p>`;
    } else if (!pv.isWeekend && !pv.gatesOpen) {
      action = `<button class="bigbtn gray" disabled>${ic('clock')} ${tr('还没到周末', 'Not the weekend yet')}</button><p style="text-align:center;font-size:var(--fs-label);color:var(--text-2)">${bi(`本周打卡进度：${esc(pv.me.name)} ${pv.me.weekApproved}/4 天${pv.other ? ` ${esc(pv.other.name)} ${pv.other.weekApproved}/4 天` : ''}`, `This week's check-in progress: ${esc(pv.me.name)} ${pv.me.weekApproved}/4 days${pv.other ? ` ${esc(pv.other.name)} ${pv.other.weekApproved}/4 days` : ''}`)}</p>`;
    } else if (counted && rm.status === 'pending') {
      action = `<button class="bigbtn gray" disabled>${ic('hourglass')} ${tr('等爸爸妈妈批准', 'Waiting for parent approval')}</button><p style="text-align:center;font-size:var(--fs-label);color:var(--text-2)">${esc(rm.requesterName || '有人')}${tr('申请了再来一局，家长在审核页批准或驳回', ' requested a rematch, A parent approves or rejects it on the review page')}</p>`;
    } else if (counted) {
      action = `<button class="bigbtn gray" disabled>${ic('trophy')} ${tr('本周冠军已决出', "This week's champion is decided")}</button><p style="text-align:center;font-size:var(--fs-label);color:var(--text-2)">${tr('还想再打一场？可以请爸爸妈妈批准「再来一局」', 'Want another? Ask a parent to approve a rematch')}</p>`;
    } else {
      const sideNote = (who) => `${tr(`${esc(who.name)}本周 ${who.weekApproved}/4 天`, `${esc(who.name)}: ${who.weekApproved}/4 days this week`)}${who.weekApproved >= 4 ? ' ✓' : tr(`，还差 ${4 - who.weekApproved} 天`, `, ${4 - who.weekApproved} days left`)}`;
      action = `<button class="bigbtn gray" disabled>${ic('pencil')} ${tr('打卡还没满 4 天', 'Not 4 check-in days yet')}</button><p style="text-align:center;font-size:var(--fs-label);color:var(--text-2)">${sideNote(pv.me)}${pv.other ? ` ${sideNote(pv.other)}` : ''}</p>`;
    }
    if (lcAvailable() && lcNetOff()) { if (canOpen) { if (action.indexOf('onclick="createPvp()"') !== -1) { action = action.replace('onclick="createPvp()"', 'onclick="lcStartPvpLocal()"'); } else { action += `<button class="bigbtn" onclick="lcStartPvpLocal()">${ic('swords')} ${tr('开始离线本地对战', 'Start an offline local battle')}</button><p style="color:var(--text-2);font-size:var(--fs-label)">${bi('现在没网，打的是本地对战：双方只带主宠，两人在同一台手机上轮流出招，胜负先记下来（待同步），联网后结算发奖；不用输密码。', "You're offline, so this is a local battle: both sides bring only their main companion, take turns on the same phone, and the result is saved (pending sync) until online settlement and rewards. No password needed.")}</p>`; } } else if (pv.myMatch) { action += `<div class="note">${bi('现在没网，线上对战等联网后再继续哦。', "You're offline, online battles continue once you're back online.")}</div>`; } }
    pvpHtml = `<div class="section-title">${ic('swords')} ${biTitle('兄弟对战 周末冠军赛', 'Sibling battles Weekend championship')}</div>
    <div class="card">
      ${subHtml}
      ${vsHtml}
      ${benchRowHtml}
      ${champLineHtml}
      ${rematchBanner}
      ${action}
      <div class="pvp-tip">${ic('swords')} ${bi('兄弟对战只在周末开放。<br>平时好好打卡、攒够 4 天，周末带着伙伴们来争本周冠军吧！招式保留各自已解锁。', "Sibling battles are weekends only.<br>Check in well, reach 4 days, and come fight for this week's champion with your companions! Each side keeps its own unlocked moves.")}</div>
      <div id="pvp-honor">
      ${pv.champions && pv.champions.length ? `<div class="section-title">${ic('trophy')} ${biTitle('荣誉墙', 'Honor wall')}</div><div>${pv.champions.slice(0, 4).map((c) => `<span class="badge">${ic('crown')} ${esc(c.childName)}${tr(`（${esc(c.weekStart)} 那周）`, ` (week of ${esc(c.weekStart)})`)}</span>`).join('')}</div>` : ''}
      ${pv.recent && pv.recent.length ? `<div class="section-title">${biTitle('最近战报（近 4 周）', 'Recent battles (last 4 weeks)')}</div>${pv.recent.slice(0, 4).map((r) => `<div style="border-bottom:0.5px solid var(--line);padding:6px 0;font-size:16px">${esc(r.aName)} vs ${esc(r.bName)} → ${ic('trophy')} ${esc(r.winnerName)} ${tr(`胜（剩 ${r.winnerPetsLeft} 只 共 ${r.totalActions} 次出招）`, `won (${r.winnerPetsLeft} pets left ${r.totalActions} moves total)`)}${pvpDefenseClause(r)}</div>`).join('')}` : ''}
      </div>
    </div>`;
  }
  // 任务 111：道馆新顺序——吸顶「已选」→ 顶栏 → 徽章墙 → 候补选择 → Stage 1–6 → 收藏馆 → 兄妹对战。
  // 候补只列随身队：主宠球另画＋携带列表 j.collection（服务端 carriedCollection，最多 4 只），合计 5 球；
  // 仓库里的不显示，测试站 benchOptions（146 种调试全量）不再进选择器——2026-11-14 用户亲口定：5 只里点一只当备战。
  const dx = G.dex;
  const mainPet = mainPetEntry(dx, G.form);
  const mainNo = mainPet && mainPet.no;
  const benchList = (j.collection || []).filter((c) => c.no !== mainNo);
  // 已选备战若已不在携带队（回仓库换出去了），清掉选择退回主宠，避免用仓库里的宠出战。
  if (G.benchGym != null && !benchList.some((c) => c.no === G.benchGym)) G.benchGym = null;
  // 任务 126：先发同理——已选先发若已不在随身队（主宠或携带列表），清掉退回主宠先发。
  if (G.leadGym != null && G.leadGym !== mainNo && !benchList.some((c) => c.no === G.leadGym)) G.leadGym = null;
  const benchName = G.benchGym != null ? (benchList.find((c) => c.no === G.benchGym) || {}).name : null;
  const leadName = G.leadGym != null ? (benchList.find((c) => c.no === G.leadGym) || {}).name : ((mainPet && mainPet.name) || tr('主宠', 'Main companion'));
  const pickedTxt = tr('先发：', 'Lead: ') + esc(leadName) + ' · ' + (benchName ? tr('备战：', 'Backup: ') + esc(benchName) : tr('备战：未选', 'Backup: none'));
  app.innerHTML = `
  <div class="gym-picked" onclick="document.getElementById('benchSection').scrollIntoView({behavior:'smooth',block:'start'})">${ic('checkcircle')} ${pickedTxt}</div>
  ${childTop(biTitle('周末道馆', 'Weekend Gym'), `goChild(${G.id})`, undefined, true)}
  ${!j.gatesOpen && !j.isWeekend ? '<div class="note">' + bi('道馆只在周六、周日开放哦，平时先把作业打卡攒满 4 天！', 'The Gym is open Saturdays and Sundays only. Check in homework to reach 4 days first!') + '</div>' : ''}
  <div class="section-title"><img class="sec-ic" src="/static/img/feat/badge-wall.webp" alt=""> ${biTitle(`我的徽章墙（${j.clearedCount}/${j.badges.length}）`, `My badge wall (${j.clearedCount}/${j.badges.length})`)}</div>
  <div class="badgewall">${j.badges.map((b) => `<div class="badgeslot ${b.lit ? 'lit' : ''}">${typeChip(b.type)}<div>${esc(b.badge)}</div>${b.lit ? '' : '<div style="font-size:14px">' + tr('未获得', 'Not earned') + '</div>'}</div>`).join('')}</div>
  <section id="benchSection" class="bench-section">
  <div class="section-title" style="margin-top:2px">${biTitle('带哪只当备战？', 'Which backup to bring?')}</div>
  <div id="benchBallsWrap">${benchPickerHtml(benchList, 'benchGym', 'pickBenchGym', true, j.myLevel, mainPet)}</div>
  </section>
  <div class="section-title gym-stage-title"><img class="sec-ic" src="/static/img/feat/gym-challenge.webp" alt=""> ${biTitle('道馆闯关', 'Gym challenges')}</div>
  <div class="gym-stage-sub">${tr(`已打卡 ${j.weekApproved}/${j.need} 天 · Lv.${j.myLevel}`, `Checked in ${j.weekApproved}/${j.need} days · Lv.${j.myLevel}`)}</div>
  ${j.stages.map(stageCard).join('')}
  <button class="bigbtn ghost icbtn" onclick="goEggs(${G.id})"><span class="btn-plate pl-48"><img class="btn-ic" src="/static/img/home/home-collection.webp" alt=""></span> ${tr(`我的收藏馆 (${G.eggs.length})`, `My Collection Hall (${G.eggs.length})`)}</button>
  ${pvpHtml}
  ${tabbar()}`;
}

/* 2026-11-14：道馆候补「全部 151 只」折叠已删——选择器只列随身队（仓库口径），toggleGymBenchFold 随之删除，勿加回。 */

function pvpJoinFormHtml(pv) {
  // 阶段 1（R18）：两栏出战选择器——A 方栏只读（建房时已选好备战，取局内 sides.A.pets[1]），
  // B 方（加入方）栏可点，自己选备战；各路由各账号自己选（C6）。
  const joinerIsMe = pv.myMatch.mySide === 'B';
  const aIsMe = pv.myMatch.mySide === 'A';
  const aSide = pv.myMatch.sides && pv.myMatch.sides.A;
  const aBenchNo = aSide && aSide.pets && aSide.pets[1] ? aSide.pets[1].no : null;
  const aWho = aIsMe ? pv.me : pv.other;
  const bWho = aIsMe ? pv.other : pv.me;
  // B 方（加入方）测试模式用 benchOptions 全选（146 种，/api/battle/pvp/status 仅 DEBUG_GATES_OPEN 时展开）；正式站无此字段、回落到携带列表。A 方栏只读（显示对方实际已选的），不动。
  const aColl = aIsMe ? pv.myCollection : pv.otherCollection;
  const bColl = pv.benchOptions || (aIsMe ? pv.otherCollection : pv.myCollection);
  const aMain = aWho ? aWho.mainPet : null;
  const bMain = bWho ? bWho.mainPet : null;
  const aLevel = aSide ? aSide.battleLevel : (aWho ? aWho.level : 1);
  const bLevel = bWho ? bWho.level : 1;
  const benchJoin = window._gymPage ? window._gymPage.benchJoin : null;
  return `<div class="pvp-pickers">${pvpTeamPickerHtml({ title: tr(`${aWho ? aWho.name : '对方'}的出战伙伴`, `${aWho ? aWho.name : '对方'}'s battle team`), mainPet: aMain, level: aLevel, collection: aColl, pickedBenchNo: aBenchNo, interactive: false, lockedHint: tr('已选好，加入后开战', 'Picked, battle starts after joining') })}${pvpTeamPickerHtml({ title: tr(`${bWho ? bWho.name : '对方'}的出战伙伴`, `${bWho ? bWho.name : '对方'}'s battle team`), mainPet: bMain, level: bLevel, collection: bColl, pickedBenchNo: benchJoin, interactive: true, onclickFn: 'pickBenchJoin', oppMainPetName: aMain ? aMain.name : '' })}</div>
  <label>${joinerIsMe ? tr('输入我的 4 位小密码', 'Enter my 4-digit little password') : tr(`让 ${esc(pv.other ? pv.other.name : '对方')} 输入他的 4 位小密码`, `Let ${esc(pv.other ? pv.other.name : '对方')} enter their 4-digit little password`)}</label>
  <input type="password" id="pvp-pwd" inputmode="numeric" maxlength="4" placeholder="••••" style="text-align:center;font-size:22px;letter-spacing:.6em">
  <button class="bigbtn green" onclick="joinPvp(${pv.myMatch.battleId})">${tr('加入对战！', 'Join battle!')}</button>`;
}

function lcBattleView(st, meta) {
  if (!st) return null;
  function sideView(s) {
    if (!s) return null;
    return { childId: s.childId, childName: s.childName, battleLevel: s.battleLevel, line: s.line || null, activeIdx: s.activeIdx || 0, pets: (s.pets || []).map(function (p, i) { return { key: p.key, name: p.name, type: p.type, no: p.no, img: p.img, level: p.appLevel != null ? p.appLevel : p.level, hp: p.hp, maxHp: p.maxHp, active: i === (s.activeIdx || 0), fainted: p.hp <= 0, moves: p.moves }; }) };
  }
  var v = { battleId: meta.battleId, mode: meta.mode, stage: meta.stage || null, status: st.winner ? 'finished' : 'active', weekStart: meta.weekStart || null, turn: meta.mode === 'gym' ? 'A' : st.turn, turnNo: st.turnNo, firstSide: st.firstSide, weather: (st.weather && st.weather.kind) || null, canAttack: !st.winner && (meta.mode === 'gym' ? true : BattleLocal.canSideAttack(st, st.turn)), winnerSide: st.winner || null, winnerChildId: st.winner ? (((st.sides || {})[st.winner] || {}).childId) : null, phase: st.pending ? 'defense' : 'move', fx: st.fx || { A: {}, B: {} }, pending: st.pending ? { attackerSide: st.pending.attacker, defenderSide: st.pending.attacker === 'A' ? 'B' : 'A', moveName: st.pending.moveName, petName: st.pending.petName, targetName: st.pending.targetName, question: st.pending.question || null, sinceEpoch: st.pending.sinceEpoch || null, deadlineEpoch: st.pending.sinceEpoch ? st.pending.sinceEpoch + BattleLocal.PVP_DEFENSE_TIMEOUT_SECS : null, timeoutSecs: BattleLocal.PVP_DEFENSE_TIMEOUT_SECS } : null, sides: { A: sideView((st.sides || {}).A), B: sideView((st.sides || {}).B) }, log: st.log || [], gymItems: meta.gymItems || null };
  return v;
}
async function lcAfterLocalRound(prevLogLen) {
  const B = window._battle;
  if (!B || !B.local) return;
  const prevView = B.view;
  const postView = lcBattleView(B.local.st, B.local.meta);
  if (B.local.meta.mode === 'pvp') {
    var v = postView;
    B.childId = v.pending ? v.sides[v.pending.defenderSide].childId : (v.turn && v.sides[v.turn] ? v.sides[v.turn].childId : B.childId);
  }
  await animateBattleRound(prevView, postView, (postView.log || []).slice(prevLogLen));
  if (!window._battle) return;
  B.view = postView;
  renderBattleView();
  if (postView.status === 'finished') await lcFinishLocalBattle();
}
async function lcFinishLocalBattle() {
  const B = window._battle;
  if (!B || !B.local) return;
  if (B.local.meta.mode === 'gym') {
    if (B.view.winnerSide === 'A') {
      const cmdId = await LocalCache.enqueue(B.childId, 'gym_settle', { stage: B.local.meta.stage, won: true, date: B.local.meta.date, team: B.local.meta.team || null });
      lcTrackSettle(cmdId, { type: 'gym_settle', childId: B.childId, payload: { stage: B.local.meta.stage, won: true, date: B.local.meta.date, team: B.local.meta.team || null }, stage: B.local.meta.stage });
      celebrate('对战结束！', null, esc((B.view.sides.A && B.view.sides.A.childName) || '你') + ' 赢啦！<br>通关结果已记下（待同步），联网结算后发放徽章和封印蛋');
    } else {
      celebrate('差一点就赢啦！', null, '回去练练级、带上克制的备战宠，再来挑战');
    }
    modalCloseHook = function () { window._battle = null; goGym(B.childId); };
    return;
  }
  if (B.local.meta.mode === 'pvp') {
    const wSide = B.view.winnerSide;
    const wId = B.view.winnerChildId;
    const lId = wId ? ((B.view.sides.A && B.view.sides.A.childId === wId) ? (B.view.sides.B && B.view.sides.B.childId) : (B.view.sides.A && B.view.sides.A.childId)) : null;
    const wName = (wSide && B.view.sides[wSide] && B.view.sides[wSide].childName) || '获胜方';
    if (wId && lId && B.local.meta.week) {
      const cmdId2 = await LocalCache.enqueue(wId, 'pvp_settle', { winner_child_id: wId, loser_child_id: lId, week: B.local.meta.week });
      lcTrackSettle(cmdId2, { type: 'pvp_settle', childId: wId, payload: { winner_child_id: wId, loser_child_id: lId, week: B.local.meta.week } });
    }
    celebrate('获胜！', null, esc(wName) + ' 赢啦！<br>对战结果已记下（待同步），联网结算后确认本周冠军与精灵球');
    modalCloseHook = function () { window._battle = null; goGym(B.childId); };
  }
}
/* 本地战斗引擎懒加载（2026-11-15 对战修复批 #4）：原先 index.html 同步 <script type=module> 每页都拉约 200KB，
 * 实际只有离线本地对战用。现在只在开始离线对战前 await 本函数；加载成功后 window.BattleLocal 就位，
 * 局内其余 BattleLocal 引用（出招/换宠/防御答题，都发生在本地对战已开始之后）不再需要等待。
 * 在线对战完全不碰引擎。首次离线对战前需联网加载过一次（goGym 在线时会空闲预热，让浏览器缓存住它）。 */
let _lcEnginePromise = null;
function lcLoadEngine() {
  if (window.BattleLocal) return Promise.resolve(window.BattleLocal);
  if (!_lcEnginePromise) {
    _lcEnginePromise = import('/static/engine-local.js').then(function () {
      if (!window.BattleLocal) throw new Error('engine-local loaded without BattleLocal');
      return window.BattleLocal;
    }).catch(function (e) { _lcEnginePromise = null; throw e; });
  }
  return _lcEnginePromise;
}
window.lcLoadEngine = lcLoadEngine;
async function lcStartGymLocal(stage) {
  const G = window._gymPage;
  if (!lcAvailable()) { alert('本地战斗引擎还没准备好，需要联网加载一次'); return; }
  try { await lcLoadEngine(); } catch (e) { alert('本地战斗引擎还没准备好，需要联网加载一次'); return; }
  const snap = await lcSnapshot(G.id);
  if (!snap || !snap.child) { alert('本地数据还没缓存下来，需要联网加载一次'); return; }
  try {
    var child = snap.child;
    var sideA = lcBuildPlayerSide(child, BattleLocal.effPlayerLevel(child.level), G.benchGym, (G.status && G.status.collection) || [], snap.pokedexFull);
    sideA.pets.forEach(function (p) { p.appLevel = child.level; });
    var cfg = BattleLocal.GYM_STAGES.find((g) => g.stage === Number(stage));
    if (!cfg) { alert('没有这一关'); return; }
    var sp2 = BattleLocal.SPECIES[cfg.bossNo];
    var sideB = { childId: null, childName: cfg.gymName + '馆主 ' + sp2.name, battleLevel: BattleLocal.effBossLevel(cfg), activeIdx: 0, pets: [BattleLocal.makePet({ key: 'boss', name: sp2.name, type: sp2.type, defTypes: BattleLocal.bossDefTypes(cfg.bossNo), no: cfg.bossNo, img: frontImgFor({ no: cfg.bossNo }), level: BattleLocal.effBossLevel(cfg), hpMult: cfg.hpMult, moves: cfg.bossMoves.map(function (m) { var off = BattleLocal.officialMove(m[0]); return { name: m[0], type: m[1], damage_class: off ? off.damage_class : undefined, power: m[2] }; }) })] };
    sideB.pets[0].appLevel = cfg.bossLevel;
    var st = BattleLocal.createBattleState({ mode: 'gym', firstSide: 'A', sides: { A: sideA, B: sideB }, weather: cfg.weather || null });
    // 友好度战斗加成（D10）：离线开局从快照孩子对象读友好度（/api/child 已带 friendship 字段；旧快照无此字段默认 0）。
    st.gym.friendship = Math.max(0, Math.min(255, Number((snap.child && snap.child.friendship) || 0)));
    st.gym.endureUsed = false;
    var battleId = 'local-gym-' + stage + '-' + Date.now();
    window._battle = { battleId: battleId, childId: G.id, view: null, local: { st: st, meta: { battleId: battleId, mode: 'gym', stage: stage, date: lcShDate(), weekStart: lcWeekStartMon(lcShDate()), team: { benchNo: G.benchGym || null }, gymItems: null } } };
    window._battle.view = lcBattleView(st, window._battle.local.meta);
    state.view = 'battle';
    renderBattleView();
  } catch (e) {
    alert('主宠数据有问题，联网后再试吧');
  }
}

function lcBuildPlayerSide(child, battleLevel, benchNo, collection, dexFull) {
  var mainMoves = (child.moves || []).map(function (m) { return { name: m.name, type: m.type, damage_class: m.damage_class, power: m.power }; });
  if (!mainMoves.length) mainMoves = [{ name: '撞击', type: '普通', power: 35 }];
  var mainEntry = mainPetEntry(dexFull, child.form);
  var branchType = (child.form && child.form.branch && mainEntry && mainEntry.type) || null;
  var petType = branchType || BattleLocal.LINE_TYPE[child.line];
  var mainNo = (child.form && child.form.branchNo) || (mainEntry && mainEntry.no) || (child.form && child.form.img ? Number((child.form.img.match(/\/p(\d+)\./) || [])[1]) || null : null);
  var side = { childId: child.id, childName: child.name, battleLevel: battleLevel, activeIdx: 0, pets: [BattleLocal.makePet({ key: 'main', name: (child.form && child.form.formName) || child.name, type: petType, no: mainNo, defTypes: BattleLocal.playerDefTypes(mainNo), img: child.form && child.form.img ? child.form.img : (mainEntry && mainEntry.img) || '', level: battleLevel, moves: mainMoves, egg: child.form && child.form.egg })] };
  if (benchNo) {
    var c = (collection || []).find(function (x) { return x.no === benchNo; });
    if (c) {
      var sp = BattleLocal.SPECIES[benchNo];
      if (c.exMain && BattleLocal.LINE_MOVES && BattleLocal.LINE_MOVES[c.lineKey]) {
        // 任务 110：备战前主宠（快照条目带 exMain/lineKey）——走自己线的招式表；
        // 名/属性直接用快照里的（服务端已算好，离线 SPECIES 里没有主宠线物种）。
        // 与服务端 lineMovesFor 同口径（按孩子等级过滤；已解锁招不补——离线快照没有
        // unlocked_moves，与既有收藏分支同口径）。妖精属性回落到本线普通属性，
        // 与服务端 benchType 回落同款（makePet 只认 9 属性）。
        var exPetType = (c.type && BattleLocal.TYPES.indexOf(c.type) >= 0) ? c.type : (BattleLocal.LINE_TYPE[c.lineKey] || '普通');
        var exMoves = (function () {
          var ls = BattleLocal.LINE_MOVES[c.lineKey];
          var levels = {};
          try { levels = JSON.parse(child.move_levels || '{}') || {}; } catch (e) { levels = {}; }
          var realLevel = child.level || battleLevel;
          var out = [];
          for (var i = 0; i < ls.length; i++) {
            var lv = ls[i][0], nm = ls[i][1];
            if (lv < 2 || lv > realLevel) continue;
            var off = BattleLocal.officialMove(nm);
            var sl = Number.isInteger(levels[nm]) ? Math.min(5, Math.max(1, levels[nm])) : 1;
            out.push({ name: nm, type: off ? off.type : (c.type || '普通'), damage_class: off ? off.damage_class : undefined, power: 25 + 6 * lv + 6 * (sl - 1) });
          }
          return out.length ? out : [{ name: '撞击', type: '普通', power: 35 }];
        })();
        side.pets.push(BattleLocal.makePet({ key: 'dex:' + benchNo, name: c.name, type: exPetType, no: benchNo, defTypes: BattleLocal.playerDefTypes(benchNo), img: frontImgFor({ no: benchNo }), level: battleLevel, moves: exMoves }));
      } else if (sp) {
        var benchMoves = (function () {
          var ls = (BattleLocal.COLLECTION_LEARNSET && BattleLocal.COLLECTION_LEARNSET[benchNo]) || [];
          var levels = {};
          try { levels = JSON.parse(child.move_levels || '{}') || {}; } catch (e) { levels = {}; }
          var realLevel = child.level || battleLevel;
          var out = [];
          for (var i = 0; i < ls.length; i++) {
            var lv = ls[i][0], nm = ls[i][1];
            if (lv < 2 || lv > realLevel) continue;
            var off = BattleLocal.officialMove(nm);
            var sl = Number.isInteger(levels[nm]) ? Math.min(5, Math.max(1, levels[nm])) : 1;
            out.push({ name: nm, type: off ? off.type : sp.type, damage_class: off ? off.damage_class : undefined, power: 25 + 6 * lv + 6 * (sl - 1) });
          }
          return out.length ? out : [{ name: '撞击', type: '普通', power: 35 }];
        })();
        side.pets.push(BattleLocal.makePet({ key: 'dex:' + benchNo, name: sp.name, type: sp.type, no: benchNo, defTypes: BattleLocal.playerDefTypes(benchNo), img: frontImgFor({ no: benchNo }), level: battleLevel, moves: benchMoves }));
      }
    }
  }
  return side;
}

async function lcLocalPvpMove(moveName, prevLogLen) {
  const B = window._battle;
  if (!B || !B.local || B.local.meta.mode !== 'pvp') return;
  const st = B.local.st;
  if (st.pending) { alert('对方正在答题防守，等他答完再继续哦'); return; }
  const side = st.turn;
  const defenderSide = side === 'A' ? 'B' : 'A';
  const defenderChildId = st.sides[defenderSide].childId;
  const q = (BattleLocal.canSideAttack(st, side) && moveName) ? await lcPickLocalDefenseQuestion(defenderChildId) : null;
  if (!q) {
    const r = BattleLocal.applyBattleAction(st, side, moveName || null, Math.random, { critRate: BattleLocal.PVP_CRIT_RATE, critMult: BattleLocal.PVP_CRIT_MULT });
    if (r.error) {
      alert(r.error === 'MOVE_NOT_LEARNED' ? tr('这个招式还没学会哦', "You haven't learned this move yet") : r.error === 'MUST_CHOOSE_MOVE' ? tr('先选一个招式吧', 'Pick a move first') : tr('现在不能出招', "Can't move now"));
      return;
    }
    await lcAfterLocalRound(prevLogLen);
    return;
  }
  const staged = BattleLocal.stagePvpAttack(st, side, moveName);
  if (staged.error) { alert(staged.error === 'MOVE_NOT_LEARNED' ? tr('这个招式还没学会哦', "You haven't learned this move yet") : tr('现在不能出招', "Can't move now")); return; }
  // 特性第二期（2b）：睡眠/麻痹导致无法行动（预演时检定，走即时结算，不进防守答题）
  if (staged.blocked) { BattleLocal.applyStagedBlocked(st, Object.assign({}, staged, { attacker: side })); await lcAfterLocalRound(prevLogLen); return; }
  if (staged.effectKind) { BattleLocal.applyStagedEffect(st, Object.assign({}, staged, { attacker: side })); await lcAfterLocalRound(prevLogLen); return; }
  if (staged.smokeMiss) { BattleLocal.applyStagedMiss(st, Object.assign({}, staged, { attacker: side })); await lcAfterLocalRound(prevLogLen); return; }
  st.pending = { attacker: side, moveName: staged.moveName, moveType: staged.moveType, petName: staged.petName, targetName: staged.targetName, dmg: staged.dmg, mult: staged.mult, critical: staged.critical === true, mods: staged.mods || [], drain: staged.drain === true, sinceEpoch: Math.floor(Date.now() / 1000), question: q };
  B.local.staged = st.pending;
  st.log.push({ type: 'attack_pending', side: side, text: staged.petName + ' 准备用「' + staged.moveName + '」攻击 ' + staged.targetName + '！防守方答对一道题就能防御！' });
  if (st.log.length > 40) st.log = st.log.slice(-40);
  await lcAfterLocalRound(prevLogLen);
}

async function lcStartPvpLocal() {
  const G = window._gymPage;
  if (!lcAvailable()) { alert('本地战斗引擎还没准备好，需要联网加载一次'); return; }
  try { await lcLoadEngine(); } catch (e) { alert('本地战斗引擎还没准备好，需要联网加载一次'); return; }
  const snap = await lcSnapshot(G.id);
  if (!snap || !snap.child || !snap.pvpStatus || !snap.pvpStatus.other) { alert('本地数据还没缓存下来，需要联网加载一次'); return; }
  const otherId = snap.pvpStatus.other.id;
  const otherSnap = await lcSnapshot(otherId);
  if (!otherSnap || !otherSnap.child) { alert('对方的本地数据还没缓存下来，需要联网加载一次'); return; }
  try {
    const me = snap.child;
    const other = otherSnap.child;
    const sideA = lcBuildPlayerSide(me, me.level, null, [], snap.pokedexFull);
    const sideB = lcBuildPlayerSide(other, other.level, null, [], otherSnap.pokedexFull);
    const flatLevel = Math.min(sideA.battleLevel, sideB.battleLevel);
    BattleLocal.flattenSideLevel(sideA, flatLevel);
    BattleLocal.flattenSideLevel(sideB, flatLevel);
    const teamSize = Math.min(sideA.pets.length, sideB.pets.length);
    sideA.pets = sideA.pets.slice(0, teamSize);
    sideB.pets = sideB.pets.slice(0, teamSize);
    const firstSide = Math.random() < 0.5 ? 'A' : 'B';
    const st = BattleLocal.createBattleState({ mode: 'pvp', firstSide: firstSide, sides: { A: sideA, B: sideB } });
    const battleId = 'local-pvp-' + Date.now();
    const weekStart = lcWeekStartMon(lcShDate());
    window._battle = { battleId: battleId, childId: firstSide === 'A' ? me.id : other.id, view: null, local: { st: st, staged: null, meta: { battleId: battleId, mode: 'pvp', date: lcShDate(), weekStart: weekStart, week: weekStart, gymItems: null } } };
    window._battle.view = lcBattleView(st, window._battle.local.meta);
    state.view = 'battle';
    renderBattleView();
  } catch (e) {
    alert('主宠数据有问题，联网后再试吧');
  }
}
window.lcStartPvpLocal = lcStartPvpLocal;
async function startStage(stage) {
  if (lcAvailable() && lcNetOff()) { await lcStartGymLocal(stage); return; }
  const G = window._gymPage;
  const j = await api('/api/battle/gym/start', { childId: G.id, stage, benchNo: G.benchGym || undefined, leadNo: G.leadGym || undefined });
  if (!j.ok) { alert(j.error || '开始失败'); return; }
  enterBattleView(j.battle, G.id);
}
window.startStage = startStage;

async function createPvp() {
  if (window._pvpBusy) return;
  if (lcAvailable() && lcNetOff()) { alert('现在没网，线上对战建不了；可以用道馆页的「离线本地对战」先打一场'); return; }
  window._pvpBusy = true;
  try {
    const G = window._gymPage;
    const j = await api('/api/battle/pvp/create', { childId: G.id, benchNo: G.benchPvp || undefined }, undefined, 15000);
    if (!j.ok) { alert(j.error || '发起失败'); goGym(G.id); return; }
    if (j.battle.status === 'active') { enterBattleView(j.battle, G.id); return; }
    goGym(G.id); // 回到道馆页，展示等待加入 + 加入表单
  } catch (e) {
    alert('网络好像不太稳，发起没成功，再试一次吧');
  } finally {
    window._pvpBusy = false;
  }
}
window.createPvp = createPvp;

/* 加入方回合凭证：内存 + sessionStorage 双存（2026-10-24 卡死修复）。
 * 只存内存时页面一刷新凭证就丢，同屏设备上的加入方立刻失去行动资格（只能看提示干等）；
 * sessionStorage 按标签页隔离、关掉即失效，配合 battleId 键名，刷新可恢复、跨局不串。 */
function storePvpToken(bid, token) {
  window._pvpToken = token;
  try { if (bid && token) sessionStorage.setItem('pvpTok:' + bid, token); } catch (e) { /* 隐私模式静默 */ }
}
function readPvpToken(bid) {
  try { return bid ? sessionStorage.getItem('pvpTok:' + bid) : null; } catch (e) { return null; }
}
function curPvpToken(bid) { return window._pvpToken || readPvpToken(bid) || undefined; }
function clearPvpToken(bid) {
  try { if (bid) sessionStorage.removeItem('pvpTok:' + bid); } catch (e) { /* 静默 */ }
  if (!bid || (window._battle && window._battle.battleId === bid)) window._pvpToken = undefined;
}

async function joinPvp(battleId) {
  if (window._pvpBusy) return;
  if (lcAvailable() && lcNetOff()) { alert('现在没网，加入不了线上对战；可以用道馆页的「离线本地对战」先打一场'); return; }
  window._pvpBusy = true;
  try {
    const G = window._gymPage;
    const pv = G.pvp;
    const joinerId = pv.myMatch.mySide === 'B' ? pv.me.id : pv.other.id;
    const pwd = document.getElementById('pvp-pwd').value;
    if (!/^\d{4}$/.test(pwd)) { alert('请输入 4 位小密码'); return; }
    const j = await api('/api/battle/pvp/join', { battleId, childId: joinerId, password: pwd, benchNo: G.benchJoin || undefined }, undefined, 15000);
    if (!j.ok) { alert(j.error || '加入失败'); const el = document.getElementById('pvp-pwd'); if (el) el.value = ''; return; }
    storePvpToken(battleId, j.joinToken);
    enterBattleView(j.battle, G.id);
  } catch (e) {
    alert('网络好像不太稳，加入没成功，再试一次吧');
  } finally {
    window._pvpBusy = false;
  }
}
window.joinPvp = joinPvp;

async function requestRematch() {
  if (lcAvailable() && lcNetOff()) { alert('现在没网，再来一局的申请等联网后再发哦'); return; }
  const G = window._gymPage;
  if (!G || window._pvpBusy) return;
  window._pvpBusy = true;
  try {
    const j = await api('/api/battle/pvp/rematch/request', { childId: G.id }, undefined, 15000);
    if (!j.ok) { alert(j.error || '申请失败'); return; }
    alert('申请已经发给家长啦，等家长审核通过就能再来一局！');
    goGym(G.id);
  } catch (e) {
    alert('网络好像不太稳，申请没发出去，再试一次吧');
  } finally {
    window._pvpBusy = false;
  }
}
window.requestRematch = requestRematch;

async function enterBattle(battleId) {
  let j;
  try {
    j = await api('/api/battle/state', { battleId, joinToken: curPvpToken(battleId) }, undefined, 15000);
  } catch (e) {
    alert('网络好像不太稳，没能进入对战，再试一次吧');
    return;
  }
  if (!j.ok) { alert(j.error || '进入失败'); return; }
  enterBattleView(j.battle, window._gymPage ? window._gymPage.id : selfChildId());
}
window.enterBattle = enterBattle;

function enterBattleView(battle, childId) {
  // 刷新后重进：把 sessionStorage 里的加入凭证恢复到内存，同屏加入方不用重新输密码加入
  const savedTok = readPvpToken(battle.battleId);
  if (savedTok && !window._pvpToken) window._pvpToken = savedTok;
  if (battle.status === 'finished' || battle.status === 'abandoned') clearPvpToken(battle.battleId);
  window._battle = { battleId: battle.battleId, childId, view: battle };
  state.view = 'battle';
  renderBattleView();
}
window.enterBattleView = enterBattleView;

function battleFxHtml(key) {
  const fx = (window._battle && window._battle.view && window._battle.view.fx && window._battle.view.fx[key]) || {};
  const tags = [];
  if (fx.charge) tags.push('<span class="fxbadge">' + ic('zap') + ' 蓄力中</span>');
  if (fx.shell) tags.push('<span class="fxbadge">' + ic('shield') + ' 防御中</span>');
  if (fx.weak) tags.push('<span class="fxbadge">' + ic('droplet') + ' 被弱化</span>');
  if (fx.smoke) tags.push('<span class="fxbadge">' + ic('warning') + ' 被干扰</span>');
  return tags.length ? `<div style="margin-top:6px">${tags.join('')}</div>` : '';
}

/* ---------- 道馆对战舞台（v3-2 臂锤场景接入） ----------
 * 布局：对手右上（正面立绘，不放训练师，用户 2026-11-04 定）、玩家左下
 * （训练师背身＋主宠背身）。演出与规则分离：playStageAttack 只消费战斗
 * 事件 JSON（side/pet/move/moveType/dmg/superEffective/critical/targetHp），
 * 不算伤害；HP 起止值全部来自事件与视图，不做演示用满血复位。
 * 通用招式先共用臂锤编排（突进下砸＋裂纹/冲击环/碎石/舞台轻震），
 * 分招式演出以后再加；miss/effect 事件只出声、不播舞台动画。 */
const BACK_SPRITES = [5, 6, 25, 26, 131, 143];
const backImg = (no) => (BACK_SPRITES.includes(no) ? `/static/img/back-${no}.webp` : null);
const avatarBackImg = (line) => (line === 'pikachu' || line === 'charmander' ? `/static/img/avatar-back-${line}.webp` : null);
const frontImgFor = (pet) => (pet && pet.no ? `/static/img/p${pet.no}.webp` : null);

// 天气角标（第三期简化版）：有天气时在舞台上方显示，PvP/合作/野外无天气不显示。
function battleWeatherBadge(v) {
  return v.weather === 'sun'
    ? `<div style="text-align:center;margin-bottom:6px"><span class="badge" style="background:#FFE082;color:#7A4A00">☀️ 大晴天 火属性招式更强、水属性招式变弱</span></div>`
    : v.weather === 'rain'
      ? `<div style="text-align:center;margin-bottom:6px"><span class="badge" style="background:#BBDEFB;color:#0D47A1">🌧️ 下雨 水属性招式更强、火属性招式变弱</span></div>`
      : v.weather === 'sand'
        ? `<div style="text-align:center;margin-bottom:6px"><span class="badge" style="background:#D7CCC8;color:#3E2723">🏜️ 沙暴 岩石特防提升、非岩/地/钢受损</span></div>`
        : '';
}

/* ---------- 兄弟对战“只剩个头”棋盘（任务 71，2026-11-09） ----------
 * 参考小红书游戏卡米猫《你终于：宠物小精灵只剩头头啦！》图 1/图 2：
 * 单位 = 头部头像＋底框 UI（血条、属性、等级进底框），不用完整立绘；
 * 对手在上、我方在下两排，顶部信息栏（回合＋轮到谁），底部技能栏。
 * 只改表现层：容器仍用 id="bs-stage"、出战宠血条仍用 id="bs-hp-A/B" 与
 * id="bs-hpnum-A/B"、伤害飘字 #bs-dmg 与招式名 #bs-skill 保留，
 * playStageAttack / applyStageHp / skipStageAnimation 不用改。
 * 头像取法：站内无“头部”单图，立绘是官方原画（头部在上方），
 * 用 CSS 把立绘放大裁切到头部区域（.pvp-head img），不新增图片资产；
 * 图标样式不自创，技能栏沿用现有招式图标（type SVG），等任务 72 全站
 * 图标样式结果出来后再统一换。
 * 背身规则（2026-11-04）：头像统一正面（笔记风格本身无背身），
 * 我方/对手靠行位置＋行标签＋出战金框区分；道馆舞台（完整立绘）仍按
 * 背身规则（玩家背身、对手正面）。本方案随 DEPLOY §177 报用户定。 */
function pvpBoardHtml(v) {
  const A = v.sides.A, B = v.sides.B;
  const pct = (p) => (p && p.maxHp ? Math.max(0, Math.min(100, Math.round((p.hp / p.maxHp) * 100))) : 100);
  const turnSide = v.turn ? v.sides[v.turn] : null;
  const finished = v.status === 'finished';
  const winnerName = finished && v.winnerSide && v.sides[v.winnerSide] ? v.sides[v.winnerSide].childName : '';
  const turnTxt = finished
    ? tr(`${esc(winnerName)} 获胜！`, `${esc(winnerName)} wins!`)
    : v.status === 'waiting'
      ? tr('等待对方进入', 'Waiting for the opponent to join')
      : (v.phase === 'defense' && v.pending && v.sides[v.pending.defenderSide]
        ? tr(`${esc(v.sides[v.pending.defenderSide].childName)} 正在防守`, `${esc(v.sides[v.pending.defenderSide].childName)} is defending`)
        : (turnSide ? tr(`轮到 ${esc(turnSide.childName)}`, `It's ${esc(turnSide.childName)}'s turn`) : ''));
  const unit = (p, i, side, sideKey, isDisplayBench) => {
    if (!p) return '';
    const active = !isDisplayBench && i === side.activeIdx;
    const img = p.img || frontImgFor(p);
    const hpId = active ? ` id="bs-hp-${sideKey}"` : '';
    const hpNumId = active ? ` id="bs-hpnum-${sideKey}"` : '';
    return `<div class="pvp-unit${active ? ' is-active' : ' is-bench'}${p.fainted ? ' is-fainted' : ''}">
      <span class="pvp-tag">${active ? tr('出战中', 'In battle') : (p.fainted ? tr('已倒下', 'Fainted') : tr('待命', 'Benched'))}</span>
      <div class="pvp-head">${img ? `<img loading="lazy" src="${img}" alt="${esc(p.name)}">` : `<span class="pvp-head-empty">${esc((p.name || '?').slice(0, 1))}</span>`}</div>
      <div class="pvp-frame">
        <div class="pvp-name">${esc(p.name)}</div>
        <div class="pvp-sub"><span class="pvp-lv">Lv.${p.level}</span><span class="pvp-type">${typeChip(p.type)}</span></div>
        <div class="hp-track"><div class="hp-fill"${hpId} style="width:${pct(p)}%"></div></div>
        <div class="hp-num"><span${hpNumId}>${p.hp}</span> / ${p.maxHp}</div>
      </div>
    </div>`;
  };
  // 任务 73：备战宠上板——每方一行放出战 2 只＋全部备战宠（携带上限 5 只、出战 2 只、备战最多 3 只）；
  // 备战卡只作展示（待命样式、不挂血条 id、无换宠按钮），不等于中途可换宠。
  const row = (side, sideKey, label) => (side ? `<div class="pvp-side-label">${label}</div><div class="pvp-row">${side.pets.map((p, i) => unit(p, i, side, sideKey)).join('')}${(side.bench || []).map((p) => unit(p, -1, side, sideKey, true)).join('')}</div>` : '');
  return `<div class="bs-wrap">${battleWeatherBadge(v)}<div class="battle-stage pvp-board" id="bs-stage">
    <div class="pvp-topbar"><span>${tr(`第 ${v.turnNo || 1} 回合`, `Round ${v.turnNo || 1}`)}</span><span>${turnTxt}</span></div>
    ${row(B, 'B', tr(`对手 ${esc(B ? B.childName : '')}`, `Opponent ${esc(B ? B.childName : '')}`))}
    <div class="pvp-vs">VS</div>
    ${row(A, 'A', tr(`我方 ${esc(A ? A.childName : '')}`, `Our side ${esc(A ? A.childName : '')}`))}
    <div class="damage-popup" id="bs-dmg"></div>
    <div class="bs-skill" id="bs-skill"></div>
    <button class="bs-skip" id="bs-skip" onclick="skipStageAnimation()">${tr('跳过演出', 'Skip animation')}</button>
  </div></div>
  ${battleFxHtml('A')}${battleFxHtml('B')}`;
}

function battleStageHtml(v) {
  if (v && v.mode === 'pvp') return pvpBoardHtml(v);
  const A = v.sides.A, B = v.sides.B;
  const aPet = A ? A.pets[A.activeIdx] : null;
  const bPet = B ? B.pets[B.activeIdx] : null;
  const aImg = aPet ? (aPet.no ? (backImg(aPet.no) || aPet.img || frontImgFor(aPet)) : aPet.img) : null;
  const bImg = bPet ? (bPet.img || frontImgFor(bPet)) : null;
  const trainerImg = A ? avatarBackImg(A.line) : null;
  const pct = (p) => (p && p.maxHp ? Math.max(0, Math.min(100, Math.round((p.hp / p.maxHp) * 100))) : 100);
  const hud = (pet, side, owner) => {
    if (!pet) return '';
    return `<div class="hud-panel ${side === 'B' ? 'hud-opponent' : 'hud-player'}">
      <div class="hud-row"><span class="poke-name">${esc(pet.name)}</span><span class="poke-lv">Lv.${pet.level}</span></div>
      <div class="hud-owner">${esc(owner)}</div>
      <div class="hp-track"><div class="hp-fill" id="bs-hp-${side}" style="width:${pct(pet)}%"></div></div>
      <div class="hp-num"><span id="bs-hpnum-${side}">${pet.hp}</span> / ${pet.maxHp}</div>
    </div>`;
  };
  const bench = (side) => (side && side.pets.length > 1 ? `<div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">${side.pets.map((p, i) => `<span class="badge" style="${p.fainted ? 'opacity:.45;text-decoration:line-through' : ''}">${i === side.activeIdx ? ic('swords') + ' ' : ic('moon') + ' '}${esc(p.name)} ${p.hp}/${p.maxHp}</span>`).join('')}</div>` : '');
  const cracks = ['crack-b1', 'crack-b2', 'crack-b3', 'crack-b4', 'crack-b5', 'crack-b6'].map((c) => `<span class="crack-branch ${c}"></span>`).join('');
  const debris = [
    ['rock', '-115px', '28px', '-160deg'], ['dust', '-78px', '-34px', '90deg'],
    ['rock', '-46px', '54px', '-110deg'], ['dust', '-18px', '-48px', '60deg'],
    ['rock', '52px', '-36px', '145deg'], ['dust', '68px', '18px', '180deg'],
    ['rock', '-142px', '62px', '-200deg'], ['dust', '34px', '42px', '120deg'],
  ].map(([k, dx, dy, rot]) => `<span class="debris-piece debris-${k}" style="--dx:${dx};--dy:${dy};--rot:${rot};"></span>`).join('');
  const weatherBadge = battleWeatherBadge(v);
  return `<div class="bs-wrap">${weatherBadge}<div class="battle-stage" id="bs-stage">
    <div class="gym-court-lines"></div>
    ${hud(bPet, 'B', v.mode === 'gym' ? tr('馆主', 'Gym leader') : (B ? B.childName : ''))}
    ${hud(aPet, 'A', A ? A.childName : '')}
    <div class="ground-shadow shadow-defender"></div>
    <div class="ground-shadow shadow-attacker"></div>
    ${trainerImg ? '<div class="ground-shadow shadow-trainer"></div>' : ''}
    <div class="bs-fx"><div class="impact-ring"></div><div class="field-cracks">${cracks}</div><div class="debris-layer">${debris}</div></div>
    ${bImg ? `<div class="pokemon-figure figure-defender"><img class="pokemon-sprite" src="${bImg}" alt="${esc(bPet.name)}"></div>` : ''}
    ${trainerImg ? `<div class="pokemon-figure figure-trainer"><img class="pokemon-sprite" src="${trainerImg}" alt=""></div>` : ''}
    ${aImg ? `<div class="pokemon-figure figure-attacker"><img class="pokemon-sprite" src="${aImg}" alt="${esc(aPet.name)}"></div>` : ''}
    <div class="damage-popup" id="bs-dmg"></div>
    <div class="bs-skill" id="bs-skill"></div>
    <button class="bs-skip" id="bs-skip" onclick="skipStageAnimation()">${tr('跳过演出', 'Skip animation')}</button>
  </div></div>
  ${battleFxHtml('A')}${battleFxHtml('B')}
  ${bench(A)}${bench(B)}`;
}

function renderBattleView() {
  document.body.classList.toggle('show-gloss', glossOn());
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const B = window._battle;
  const v = B.view;
  const title = v.mode === 'gym' ? tr(`道馆第 ${v.stage} 关`, `Gym stage ${v.stage}`) : tr('兄弟对战', 'Sibling battle');
  const turnSide = v.turn ? v.sides[v.turn] : null;
  const finished = v.status === 'finished';
  let controls = '';
  if (v.status === 'waiting') {
    // 对方还没输密码进入：只显示等待，不显示任何倒计时（防守超时要双方都进入才起算）
    controls = `<div class="note">${ic('hourglass')} ${bi('等待对方进入对战——对方加入后，对战才开始哦', 'Waiting for the opponent to join — the battle starts after they join')}</div>`;
  } else if (v.status === 'active' && v.mode === 'pvp' && v.phase === 'defense' && v.pending) {
    const p = v.pending;
    const defender = v.sides[p.defenderSide];
    const iAmDefender = Number(B.childId) === Number(defender.childId) || (p.defenderSide === 'B' && Number(B.childId) !== Number(v.sides.A.childId) && !!window._pvpToken); // 凭证越权修复（2026-10-24）：凭证只在未登录成 A 方账号时才顶 B 的身份
    const cdHtml = p.deadlineEpoch ? `<div class="note" id="defense-countdown">${defenseCountdownText(p)}</div>` : '';
    if (iAmDefender && p.question) {
      controls = `<div class="section-title">${ic('shield')} ${tr(`${esc(p.petName)} 要用「${esc(p.moveName)}」打 ${esc(p.targetName)}！`, `${esc(p.petName)} is about to hit ${esc(p.targetName)} with ${esc(p.moveName)}!`)}</div>
      ${cdHtml}
      <div class="card">
        <div style="font-weight:600;margin-bottom:6px">${bi('答对这道你做过的题，就能防御这一招：', "Answer this question you've done before to block this move:")}</div>
        <div style="margin-bottom:8px">${esc(p.question.question)}</div>
        ${p.question.options.map((op, i) => `<button class="bigbtn blue" style="margin:5px 0" onclick="battleDefendIdx(${i})">${esc(op)}</button>`).join('')}
        <button class="bigbtn ghost" style="margin-top:6px" onclick="battleDefendIdx(-1)">${tr('不答了，直接扛下这一招', 'Skip, take this hit directly')}</button>
      </div>`;
    } else {
      controls = `<div class="note">${ic('shield')} ${bi(`${esc(defender.childName)} 正在答题防守，等他答完就结算这一招…`, `${esc(defender.childName)} is answering to defend. This move settles after they answer…`)}</div>${cdHtml}`;
    }
  } else if (v.status === 'active' && turnSide) {
    const active = turnSide.pets[turnSide.activeIdx];
    let canAct = true;
    if (v.mode === 'pvp') {
      if (v.turn === 'A') canAct = Number(B.childId) === Number(v.sides.A.childId);
      else if (v.turn === 'B') canAct = Number(B.childId) === Number(v.sides.B.childId) || (Number(B.childId) !== Number(v.sides.A.childId) && !!window._pvpToken); // 凭证越权修复（2026-10-24）：同上
    }
    if (v.mode === 'gym' && v.turn === 'B') {
      controls = `<div class="note">${tr('馆主行动中…', 'Gym leader is acting…')}</div>`;
    } else if (!canAct) {
      controls = `<div class="note">${ic('hourglass')} ${bi(`轮到 ${esc(turnSide.childName)} 出招 — 请让 ${esc(turnSide.childName)} 用自己的账号打开这场对战来出招`, `It's ${esc(turnSide.childName)}'s turn — please let ${esc(turnSide.childName)} open this battle with their own account to move`)}</div>`;
    } else if (!v.canAttack) {
      controls = `<div class="note">${ic('hourglass')} ${bi(`${esc(turnSide.childName)} 是先攻方，第一个回合不能出招（热身一下）！`, `${esc(turnSide.childName)} goes first and can't move on the first round (warm-up)!`)}</div>
        <button class="bigbtn blue" onclick="battleMove(null)">${tr('跳过这一回合', 'Skip this round')}</button>`;
    } else if (v.mode === 'gym') {
      // 道馆改版：同时选招——你选招的同时馆主也会出招（或蓄势），防御招能挡住这一回合的攻击
      // 任务 126：全队在场，换宠有得选——每个未倒下的替补各一个按钮（不只给第一个）。
      const benchIdxs = turnSide.pets.map((p, i) => i).filter((i) => i !== turnSide.activeIdx && !turnSide.pets[i].fainted);
      controls = `<div class="section-title">${ic('swords')} ${tr(`第 ${v.turnNo || 1} 回合 和馆主同时选招！${esc(active.name)} 出招`, `Round ${v.turnNo || 1} Pick moves at the same time as the Gym leader! ${esc(active.name)} moves`)}</div>
        ${battleMovePickerHtml(active.moves)}
        ${benchIdxs.map((bi) => `<button class="bigbtn" style="margin:6px 0" onclick="battleSwap(${bi})">${ic('refresh')} ${tr(`换 ${esc(turnSide.pets[bi].name)} 上场（这一回合不出招）`, `Switch to ${esc(turnSide.pets[bi].name)} (no move this round)`)}</button>`).join('')}
        ${v.gymItems ? `<div class="section-title">${ic('backpack')} ${tr(`背包道具（本场回血 ${v.gymItems.uses.heal || 0}/${v.gymItems.caps.heal || 0}，复活 ${v.gymItems.uses.revive || 0}/${v.gymItems.caps.revive || 0}）`, `Backpack items (heals this battle ${v.gymItems.uses.heal || 0}/${v.gymItems.caps.heal || 0}, revives ${v.gymItems.uses.revive || 0}/${v.gymItems.caps.revive || 0})`)}</div>
        ${v.gymItems.items.map((it) => `<button class="bigbtn ghost" style="margin:6px 0" ${(it.qty <= 0 || it.used >= it.cap) ? 'disabled' : ''} onclick="battleUseItem('${it.key}')">${itemIcon(it)} ${esc(it.name)} ×${it.qty}${tr('（', '(')}${it.kind === 'heal' ? tr('回血 ' + it.rate + '%', 'Heal ' + it.rate + '%') : tr('复活回血 ' + it.rate + '%', 'Revive & heal ' + it.rate + '%')}${tr('，', ', ')}${tr(`本场已用 ${it.used}/${it.cap}`, `Used this battle ${it.used}/${it.cap}`)}${tr('）', ')')}</button>`).join('')}
        <p style="color:var(--text-2);font-size:var(--fs-label)">${bi('用药算一次出招机会：这回合你用药就不出招，馆主照常攻击。满血时不能用回血药。', "Using an item counts as your move: you don't attack this round, and the Gym leader still attacks. Healing items can't be used at full HP.")}</p>` : ''}`;
    } else {
      // 兄弟对战：招式选择器包进底部技能栏（任务 71，棋盘风格；图标沿用现有招式图标，等任务 72 全站样式）
      controls = `<div class="section-title">${tr(`轮到 ${esc(turnSide.childName)} ${esc(active.name)} 出招`, `${esc(turnSide.childName)}'s turn ${esc(active.name)} moves`)}</div>
        <div class="pvp-skillbar">${battleMovePickerHtml(active.moves)}</div>`;
    }
  }
  const logLines = (v.log || []).slice(-5);
  app.innerHTML = `
  <div class="topbar"><button class="iconbtn" onclick="backToGym()">${tr('‹ 道馆', '‹ Gym')}</button><div class="title">${ic('swords')} ${title}</div><div style="display:flex;gap:6px;align-items:center;flex:none">${state.lang === 'en' ? `<button class="iconbtn ${glossOn() ? 'gloss-on' : ''}" title="${tr('显示中文释义', 'Show Chinese gloss')}" onclick="toggleGloss(this)">中</button>` : ''}<button class="iconbtn" title="${tr('喊招配音开关', 'Move call sound toggle')}" onclick="toggleMoveSound()">${moveSoundMuted() ? ic('volumex') : ic('volume')}</button></div></div>
  ${battleStageHtml(v)}
  ${finished ? `<div class="note" style="text-align:center;font-size:var(--fs-body)">${ic('trophy')} ${tr(`${esc((v.winnerSide && v.sides[v.winnerSide].childName) || '')} 获胜！`, `${esc((v.winnerSide && v.sides[v.winnerSide].childName) || '')} wins!`)}</div>` : controls}
  ${v.status === 'active' ? `<button class="bigbtn ghost" style="color:var(--danger-text);border-color:var(--danger-text)" onclick="abandonBattle()">${tr('放弃这场对战', 'Abandon this battle')}</button>` : ''}
  <div class="section-title">${biTitle('战况', 'Battle log')}</div>
  <div class="battlelog">${logLines.length ? logLines.map((e) => `<div${e.superEffective || e.resisted || e.immune || e.critical ? ` class="${[e.superEffective ? 'supereff' : '', e.resisted ? 'resisted' : '', e.immune ? 'immune' : '', e.critical ? 'critline' : ''].filter(Boolean).join(' ')}"` : ''}>${esc(e.text || '')}</div>`).join('') : `<div style="color:var(--text-2)">${tr('对战开始！', 'Battle start!')}</div>`}</div>
  ${tabbar()}`;
  // PvP 等待对方时自动刷新（等对方答题防守、或双设备时等对方出招）
  if (window._battlePoll) { clearTimeout(window._battlePoll); window._battlePoll = null; }
  if (window._battleWatch) { clearTimeout(window._battleWatch); window._battleWatch = null; }
  if (v.mode === 'pvp' && v.status === 'active') {
    const tokenActsAsB = Number(B.childId) !== Number(v.sides.A.childId) && !!window._pvpToken; // 凭证越权修复（2026-10-24）：与显示判定同口径
    const waitDefense = v.phase === 'defense' && v.pending
      && !(Number(B.childId) === Number(v.sides[v.pending.defenderSide].childId) || (v.pending.defenderSide === 'B' && tokenActsAsB));
    let waitMove = false;
    if (v.phase !== 'defense' && v.turn) {
      waitMove = v.turn === 'A'
        ? Number(B.childId) !== Number(v.sides.A.childId)
        : !(Number(B.childId) === Number(v.sides.B.childId) || tokenActsAsB);
    }
    if (waitDefense || waitMove) window._battlePoll = setTimeout(refreshBattleState, 3000);
    // 轮到本方行动时挂慢速看门狗（2026-10-24 卡死修复）：自己上一步的响应若在网络层丢失，
    // 本地视图会停在旧回合看似卡死；看门狗只在服务端状态确实已推进时才重渲染，不抢正要点按的按钮。
    else window._battleWatch = setTimeout(watchdogBattleState, 6000);
  }
  // 防守倒计时滴答：每秒只更新文案（不整页重渲染，避免点选项时闪烁）；归零后拉一次服务端状态，由服务端按超时结算推进
  if (window._battleCountdown) { clearTimeout(window._battleCountdown); window._battleCountdown = null; }
  if (v.mode === 'pvp' && v.status === 'active' && v.phase === 'defense' && v.pending && v.pending.deadlineEpoch) {
    window._battleCountdown = setTimeout(tickDefenseCountdown, 1000);
  }
}

/* 防守剩余时间文案（服务端 pending.deadlineEpoch 驱动；120 秒，双方都进入后才起算） */
function defenseCountdownText(p) {
  const left = Math.max(0, (p.deadlineEpoch || 0) - Math.floor(Date.now() / 1000));
  return `${ic('clock')} ${tr(`防守还剩 ${left} 秒，超时没答就当放弃防守啦`, `Defense: ${left} seconds left. No answer in time counts as giving up defense`)}`;
}

function tickDefenseCountdown() {
  window._battleCountdown = null;
  const B = window._battle;
  if (!B || state.view !== 'battle' || !B.view || B.view.phase !== 'defense' || !B.view.pending || !B.view.pending.deadlineEpoch) return;
  const left = Math.max(0, B.view.pending.deadlineEpoch - Math.floor(Date.now() / 1000));
  const el = document.getElementById('defense-countdown');
  if (el) el.textContent = defenseCountdownText(B.view.pending);
  if (left <= 0) { if (B.local) lcLocalDefenseSettle({timedOut: true}); else refreshBattleState(); return; }
  window._battleCountdown = setTimeout(tickDefenseCountdown, 1000);
}

async function refreshBattleState() {
  if (window._battlePoll) { clearTimeout(window._battlePoll); window._battlePoll = null; }
  const B = window._battle;
  if (!B || state.view !== 'battle') return;
  if (B.local) return;
  const prevLogLen = (B.view.log || []).length;
  let j;
  try {
    j = await api('/api/battle/state', { battleId: B.battleId, joinToken: curPvpToken(B.battleId) }, undefined, 15000);
  } catch (e) {
    // 网络异常不能打断轮询链：还在对战页就续上下一轮（旧实现一抛异常轮询永久停摆、视图僵死）
    if (window._battle && window._battle.battleId === B.battleId && state.view === 'battle') {
      window._battlePoll = setTimeout(refreshBattleState, 3000);
    }
    return;
  }
  if (!j.ok || !window._battle || window._battle.battleId !== B.battleId || state.view !== 'battle') return;
  const prevView = B.view;
  const nv = j.battle;
  await animateBattleRound(prevView, nv, (nv.log || []).slice(prevLogLen));
  if (!window._battle || window._battle.battleId !== B.battleId || state.view !== 'battle') return;
  B.view = nv;
  renderBattleView();
}

/* 行动方看门狗：轮到本方时慢速核对服务端；状态没变就不动界面（不抢点按），
 * 已推进（多半是上一步响应丢失）才同步重渲染，让卡住的视图自愈。 */
async function watchdogBattleState() {
  window._battleWatch = null;
  const B = window._battle;
  if (!B || state.view !== 'battle') return;
  if (B.local) return;
  let j;
  try {
    j = await api('/api/battle/state', { battleId: B.battleId, joinToken: curPvpToken(B.battleId) }, undefined, 15000);
  } catch (e) {
    if (window._battle && window._battle.battleId === B.battleId && state.view === 'battle') {
      window._battleWatch = setTimeout(watchdogBattleState, 6000);
    }
    return;
  }
  if (!j.ok || !window._battle || window._battle.battleId !== B.battleId || state.view !== 'battle') return;
  const nv = j.battle;
  const ov = B.view;
  const changed = nv.turnNo !== ov.turnNo || nv.phase !== ov.phase || nv.status !== ov.status
    || !!nv.pending !== !!ov.pending || (nv.log || []).length !== (ov.log || []).length;
  if (!changed) {
    window._battleWatch = setTimeout(watchdogBattleState, 6000);
    return;
  }
  const prevLogLen = (ov.log || []).length;
  await animateBattleRound(ov, nv, (nv.log || []).slice(prevLogLen));
  if (!window._battle || window._battle.battleId !== B.battleId || state.view !== 'battle') return;
  B.view = nv;
  renderBattleView();
}

async function battleMove(moveName) {
  const B = window._battle;
  if (!B || window._battleBusy || window._battleAnimating) return;
  const B0 = window._battle;
  if (B0 && B0.local) {
    if (window._battleBusy) return;
    window._battleBusy = true;
    battleMoveBusyUI(true);
    try {
      const prevLogLen = (B0.view.log || []).length;
      if (B0.local.meta.mode === 'gym') {
        const r = BattleLocal.resolveGymRound(B0.local.st, { moveName: moveName || null });
        if (r.error) { alert(r.error === 'MOVE_NOT_LEARNED' ? tr('这个招式还没学会哦', "You haven't learned this move yet") : r.error === 'MUST_CHOOSE_MOVE' ? tr('先选一个招式吧', 'Pick a move first') : tr('现在不能出招', "Can't move now")); return; }
        await lcAfterLocalRound(prevLogLen);
      } else {
        if (typeof lcLocalPvpMove !== 'function') { alert(tr('本地对战还没准备好', "Local battle isn't ready yet")); return; }
        await lcLocalPvpMove(moveName, prevLogLen);
      }
    } finally { window._battleBusy = false; battleMoveBusyUI(false); }
    return;
  }
  window._battleBusy = true;
  battleMoveBusyUI(true);
  try {
    const body = { battleId: B.battleId, moveName: moveName || null };
    if (B.view.mode === 'pvp' && B.view.turn === 'B') body.joinToken = curPvpToken(B.battleId);
    const prevLogLen = (B.view.log || []).length;
    const prevView = B.view;
    const j = await api('/api/battle/move', body, undefined, 15000);
    if (!j.ok) {
      alert(j.error === 'FORBIDDEN' ? tr('这一步不是你出招哦：请让轮到的那一方用自己的账号打开这场对战再出招', "It's not your turn: please let the player whose turn it is open this battle with their own account") : (j.error || tr('出招失败', 'Move failed')));
      refreshBattleState(); // 报错多半是本地视图与服务端不一致，顺手重同步一次
      return;
    }
    await applyBattleResponse(j, prevLogLen, prevView);
  } catch (e) {
    // 旧实现此处无 catch：网络一抖请求异常就静默无反馈（点了像没点）。改为提示＋重同步。
    alert(tr('网络好像不太稳，这一步没送出去，已经帮你刷新到最新状态啦', "Network seems unstable, this step didn't go through — refreshed to the latest state"));
    refreshBattleState();
  } finally {
    window._battleBusy = false;
    battleMoveBusyUI(false);
  }
}

/* 道馆用药（v11 §9.3）：回血上场宠／复活昏厥备战宠；用药算一次出招机会，本回合不出招。
 * 复活需先选目标（倒下的备战伙伴）；PvP 里没有用药按钮（服务端也会拒绝）。 */
async function battleUseItem(itemKey, targetIdx) {
  const B = window._battle;
  if (!B || window._battleBusy || window._battleAnimating) return;
  if (B && B.local) { alert(tr('离线对战不能用药（不知道背包里还剩几瓶），联网后可用', "Items can't be used in offline battles (backpack counts unknown). Available once online.")); return; }
  if (itemKey === 'medicine:revive' && targetIdx === undefined) {
    const side = B.view.sides.A;
    const fainted = (side.pets || []).map((p, i) => ({ p, i })).filter((x) => x.p.fainted && x.i !== side.activeIdx);
    if (!fainted.length) { alert('没有可以复活的伙伴（复活只能给倒下的备战伙伴用）'); return; }
    modalRoot.innerHTML = `<div class="overlay"><div class="modal">
      <h2>复活哪只伙伴？</h2>
      ${fainted.map((x) => `<button class="bigbtn blue" onclick="closeModal();battleUseItem('medicine:revive',${x.i})">${esc(x.p.name)}（复活回血 50%）</button>`).join('')}
      <button class="bigbtn ghost" onclick="closeModal()">取消</button>
    </div></div>`;
    return;
  }
  window._battleBusy = true;
  try {
    const body = { battleId: B.battleId, itemKey };
    if (targetIdx !== undefined) body.targetIdx = targetIdx;
    const prevLogLen = (B.view.log || []).length;
    const prevView = B.view;
    const j = await api('/api/battle/move', body, undefined, 15000);
    if (!j.ok) {
      alert(j.error || '用药失败');
      refreshBattleState();
      return;
    }
    await applyBattleResponse(j, prevLogLen, prevView);
  } catch (e) {
    alert(tr('网络好像不太稳，这一步没送出去，已经帮你刷新到最新状态啦', "Network seems unstable, this step didn't go through — refreshed to the latest state"));
    refreshBattleState();
  } finally {
    window._battleBusy = false;
  }
}
window.battleUseItem = battleUseItem;

async function applyBattleResponse(j, prevLogLen, prevView) {
  const B = window._battle;
  if (!B) return;
  const postView = j.battle;
  await animateBattleRound(prevView || B.view, postView, (postView.log || []).slice(prevLogLen));
  if (!window._battle || window._battle.battleId !== B.battleId) return;
  B.view = postView;
  renderBattleView();
  if (postView.status === 'finished') {
    clearPvpToken(B.battleId);
    const w = postView.winnerSide ? postView.sides[postView.winnerSide] : null;
    let text = `${w ? esc(w.childName) : ''} 赢啦！`;
    if (j.rewards && j.rewards.eggSpecies) text += `<br>${ic('gift')} 首通奖励：一颗封印蛋（7 天后孵出 ${esc(j.rewards.eggName || '')}）！`;
    if (j.rewards && j.rewards.finalEgg) text += '<br>' + ic('sparkles') + ' 四关全通！还额外赢得一颗梦幻封印蛋！';
    if (j.rewards && j.rewards.ballsAwarded) text += '<br><span class="pb-mini"></span> 冠军奖励：精灵球 +1！';
    if (postView.mode === 'gym' && postView.winnerSide === 'B') text = '差一点就赢啦！回去练练级、带上克制的备战宠，再来挑战 ' + ic('dumbbell');
    celebrate('对战结束！', null, text);
    modalCloseHook = () => { window._battle = null; goGym(B.childId); };
  }
}
window.battleMove = battleMove;

/* 道馆主动换宠（改版）：占一整回合——新宠上场承受这一回合的攻击、本回合不出招 */
async function battleSwap(idx) {
  const B = window._battle;
  if (!B || window._battleBusy || window._battleAnimating) return;
  const B0 = window._battle;
  if (B0 && B0.local) {
    if (B0.local.meta.mode !== 'gym') { alert(tr('兄弟对战里不能换宠哦', "Can't switch pets in sibling battles")); return; }
    if (window._battleBusy) return;
    window._battleBusy = true;
    try {
      const prevLogLen = (B0.view.log || []).length;
      const r = BattleLocal.resolveGymRound(B0.local.st, { swapToIdx: idx });
      if (r.error) { alert(r.error === 'SWAP_INVALID' ? tr('现在不能换这只宠哦', "Can't switch to this pet now") : tr('现在不能换宠', "Can't switch pets now")); return; }
      await lcAfterLocalRound(prevLogLen);
    } finally { window._battleBusy = false; }
    return;
  }
  window._battleBusy = true;
  try {
    const prevLogLen = (B.view.log || []).length;
    const prevView = B.view;
    const j = await api('/api/battle/move', { battleId: B.battleId, swapToIdx: idx }, undefined, 15000);
    if (!j.ok) { alert(j.error || tr('换宠失败', 'Switch failed')); refreshBattleState(); return; }
    await applyBattleResponse(j, prevLogLen, prevView);
  } catch (e) {
    alert(tr('网络好像不太稳，这一步没送出去，已经帮你刷新到最新状态啦', "Network seems unstable, this step didn't go through — refreshed to the latest state"));
    refreshBattleState();
  } finally {
    window._battleBusy = false;
  }
}
window.battleSwap = battleSwap;

async function lcPickLocalDefenseQuestion(defenderChildId) {
  try {
    const atts = await lcGetLocalByChild('quiz_attempts', defenderChildId);
    const ids = [...new Set(atts.map((a) => a.question_id))];
    if (!ids.length) return null;
    const all = await window.LocalCache.getQuestions();
    const pool = all.filter((q) => ids.includes(q.id) && q.active !== false && q.kind !== 'oak');
    if (!pool.length) return null;
    const pick = pool[Math.floor(Math.random() * pool.length)];
    const correctText = pick.options[pick.answer_idx];
    const options = [...pick.options];
    for (let i = options.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = options[i];
      options[i] = options[j];
      options[j] = tmp;
    }
    return {id: pick.id, question: pick.question, options, subject: pick.subject || '', answer_idx: options.indexOf(correctText), explain: pick.explain || ''};
  } catch (e) {
    return null;
  }
}

async function lcLocalDefenseSettle(defense) {
  const B = window._battle;
  if (!B || !B.local || !B.local.st || !B.local.staged) return;
  const prevLogLen = (B.view.log || []).length;
  const r = window.BattleLocal.resolveStagedAttack(B.local.st, B.local.staged, defense);
  if (r && r.error) { alert('防守结算失败'); return; }
  delete B.local.st.pending;
  B.local.staged = null;
  await lcAfterLocalRound(prevLogLen);
}

async function battleDefendIdx(i) {
  const B = window._battle;
  if (!B || window._battleBusy || window._battleAnimating) return;
  const p = B.view.pending;
  if (!p || !p.question) return;
  if (B.local) {
    if (window._battleBusy) return;
    window._battleBusy = true;
    try {
      const p = B.view.pending;
      if (!p || !p.question || !B.local.staged) return;
      const q = p.question;
      let defense;
      if (i < 0) defense = {skipped: true};
      else if (i === q.answer_idx) defense = {kind: window.BattleLocal.pickDefenseKind(Math.random).kind};
      else defense = {correct: false};
      await lcLocalDefenseSettle(defense);
    } finally {
      window._battleBusy = false;
    }
    return;
  }
  window._battleBusy = true;
  try {
    const body = { battleId: B.battleId, answerText: i >= 0 ? p.question.options[i] : null };
    if (p.defenderSide === 'B') body.joinToken = curPvpToken(B.battleId);
    const prevLogLen = (B.view.log || []).length;
    const prevView = B.view;
    const j = await api('/api/battle/defend', body, undefined, 15000);
    if (!j.ok) {
      alert(j.error === 'FORBIDDEN' ? tr('这道防守题要由防守方本人来答哦', 'This defense question must be answered by the defender') : (j.error || tr('防守失败', 'Defense failed')));
      refreshBattleState();
      return;
    }
    await applyBattleResponse(j, prevLogLen, prevView);
  } catch (e) {
    alert(tr('网络好像不太稳，这一步没送出去，已经帮你刷新到最新状态啦', "Network seems unstable, this step didn't go through — refreshed to the latest state"));
    refreshBattleState();
  } finally {
    window._battleBusy = false;
  }
}
window.battleDefendIdx = battleDefendIdx;

/* 喊招配音（借鉴包 v1 §7）：出招事件按招式名查 /static/audio/moves/manifest.json 播放，
 * manifest 由 eno 预生成；缺失的招式静默跳过。静音开关存 localStorage（默认开声）。 */
let _moveManifest = null;
let _moveManifestLoading = null;
function moveSoundMuted() {
  try { return localStorage.getItem('sm_move_muted') === '1'; } catch (e) { return false; }
}
window.toggleMoveSound = () => {
  try { localStorage.setItem('sm_move_muted', moveSoundMuted() ? '0' : '1'); } catch (e) { /* 静默 */ }
  renderBattleView();
};
async function loadMoveManifest() {
  if (_moveManifest) return _moveManifest;
  if (!_moveManifestLoading) {
    _moveManifestLoading = fetch('/static/audio/moves/manifest.json')
      .then((r) => (r.ok ? r.json() : {}))
      .catch(() => ({}));
  }
  _moveManifest = await _moveManifestLoading;
  return _moveManifest;
}
/* 音频解锁（审查 S21）：喊招的 play() 发生在「点击 → await 接口 → await manifest」之后，
 * 已脱离用户手势，iOS Safari 会拒绝播放且错误被吞掉、表现为完全无声。
 * 解法：全局复用同一个 Audio 元素，并在首次用户手势内用一段静音音频把它「解锁」，
 * 之后换 src 播放喊招即被系统视为已授权的媒体元素。 */
let _moveAudio = null;
let _moveAudioUnlocked = false;
const _SILENT_WAV = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=';
function unlockMoveAudio() {
  if (_moveAudioUnlocked) return;
  _moveAudioUnlocked = true;
  try {
    if (!_moveAudio) _moveAudio = new Audio();
    _moveAudio.src = _SILENT_WAV;
    const p = _moveAudio.play();
    if (p && p.catch) p.catch(() => {});
  } catch (e) { /* 解锁失败静默，后续播放再试 */ }
}
document.addEventListener('pointerdown', unlockMoveAudio);
document.addEventListener('keydown', unlockMoveAudio);

let _oakAudio = null;
let _oakAudioUnlocked = false;
function unlockOakAudio() {
  if (_oakAudioUnlocked) return;
  _oakAudioUnlocked = true;
  try {
    if (!_oakAudio) _oakAudio = new Audio();
    _oakAudio.src = _SILENT_WAV;
    const p = _oakAudio.play();
    if (p && p.catch) p.catch(() => {});
  } catch (e) { /* 解锁失败静默，后续播放再试 */ }
}
document.addEventListener('pointerdown', unlockOakAudio);
document.addEventListener('keydown', unlockOakAudio);
async function playOakAudio() {
  const O = window._oak;
  const s = O && O.data.sentences[O.idx];
  if (!s || moveSoundMuted()) return;
  const token = O.audioToken = (O.audioToken || 0) + 1;
  try { speechSynthesis.cancel(); } catch (e) { /* 静默跳过 */ }
  try {
    if (_oakAudio) _oakAudio.pause();
    if (s.audio) {
      if (!_oakAudio) _oakAudio = new Audio();
      _oakAudio.src = s.audio;
      await _oakAudio.play();
      return;
    }
  } catch (e) { /* 音频失败，尝试朗读 */ }
  if (window._oak !== O || O.data.sentences[O.idx] !== s || O.audioToken !== token || moveSoundMuted()) return;
  try {
    const utterance = new SpeechSynthesisUtterance(s.en);
    utterance.lang = 'en-US';
    utterance.rate = 0.9;
    speechSynthesis.speak(utterance);
  } catch (e) { /* 朗读失败静默，只显示文字 */ }
}

async function playMoveSound(moveName) {
  if (!moveName || moveSoundMuted()) return;
  const mf = await loadMoveManifest();
  const f = mf && mf[moveName];
  if (!f) return;
  try {
    const src = /^(\/|https?:)/.test(f) ? f : '/static/audio/moves/' + f;
    if (!_moveAudio) _moveAudio = new Audio();
    _moveAudio.src = src;
    const p = _moveAudio.play();
    if (p && p.catch) p.catch(() => {});
  } catch (e) { /* 播放失败静默 */ }
}

/* 手感打磨：按本次新增的 attack 事件逐个播命中动画（最多 2 个，间隔 ~480ms 串行）：
   攻击方立绘朝对手前冲回位；被击方头顶弹出伤害数字（效果拔群放大＋橙红）、闪白＋≤4px 轻震。
   只做视觉层，不碰战斗规则与数值；元素找不到（已切页）就静默跳过。 */
function playBattleFx(newEvents) {
  // 只出声：喊招按招式名查 manifest 播放（与动画同拍）。
  // 旧的 bface 突进/闪烁/飘字已由舞台动画取代，不再操作已移除的 bface 节点；
  // 防御事件（闪避/格挡/守护）只在战况日志里显示，不再飘字。
  (newEvents || []).filter((e) => (e.type === 'attack' || e.type === 'miss' || e.type === 'effect') && e.move)
    .slice(0, 2).forEach((ev, idx) => setTimeout(() => playMoveSound(ev.move), idx * 480));
}

/* 舞台演出：一次攻击事件播一段（正常模式约 0.85s，减弱动效 0.4s），
 * 跳过或 1.5s 兜底都会 resolve，绝不卡住后续结算。 */
let _stageCleanup = null;
let _stageSkipAll = false;
function skipStageAnimation() {
  _stageSkipAll = true;
  if (_stageCleanup) _stageCleanup();
}
window.skipStageAnimation = skipStageAnimation;

function applyStageHp(ev, prevView) {
  const t = ev.side === 'A' ? 'B' : 'A';
  const bar = document.getElementById('bs-hp-' + t);
  const num = document.getElementById('bs-hpnum-' + t);
  if (!bar || !num || !prevView || !prevView.sides || !prevView.sides[t]) return;
  const side = prevView.sides[t];
  const pet = side.pets[side.activeIdx];
  if (!pet || !pet.maxHp) return;
  const hp = Math.max(0, ev.targetHp);
  bar.style.width = `${Math.max(0, Math.min(100, Math.round((hp / pet.maxHp) * 100)))}%`;
  num.textContent = hp;
}

function playStageAttack(ev, prevView) {
  const stage = document.getElementById('bs-stage');
  if (!stage) return Promise.resolve();
  if (_stageSkipAll) { applyStageHp(ev, prevView); return Promise.resolve(); }
  if (_stageCleanup) _stageCleanup();
  return new Promise((resolve) => {
    let done = false;
    const dmgEl = document.getElementById('bs-dmg');
    const skillEl = document.getElementById('bs-skill');
    const finish = () => {
      if (done) return;
      done = true;
      stage.classList.remove('is-playing', 'dir-boss');
      if (skillEl) skillEl.textContent = '';
      applyStageHp(ev, prevView);
      stage.removeEventListener('animationend', onEnd);
      _stageCleanup = null;
      resolve();
    };
    // 先声明回调再挂监听（v2 的 TDZ 教训：回调绝不能在声明前被引用）。
    const onEnd = (e) => {
      if (e.animationName === 'stage-quake') applyStageHp(ev, prevView);
      if (e.animationName === 'dmg-float' || e.animationName === 'reduced-dmg-fade') finish();
    };
    if (dmgEl) {
      dmgEl.textContent = ev.immune ? '没有效果' : `-${ev.dmg}`;
      dmgEl.classList.toggle('is-effective', !!ev.superEffective);
      dmgEl.classList.toggle('is-crit', !!ev.critical);
    }
    if (skillEl) skillEl.textContent = ev.moveType ? `${ev.moveType} ${ev.move}` : (ev.move || '');
    stage.classList.remove('is-playing', 'dir-boss');
    void stage.offsetWidth;
    if (ev.side === 'B') stage.classList.add('dir-boss');
    stage.addEventListener('animationend', onEnd);
    _stageCleanup = finish;
    setTimeout(finish, 1500);
    stage.classList.add('is-playing');
  });
}

/* 回合过渡：先按战前视图渲染舞台、逐段播攻击演出（最多 2 段），
 * 再由调用方渲染战后视图。无攻击事件、已在播、或无战前视图时直接
 * 返回（调用方照常渲染战后视图）；出声在任何路径下都播。 */
async function animateBattleRound(prevView, postView, newEvents) {
  const B = window._battle;
  if (!B) return;
  playBattleFx(newEvents);
  if (!prevView || window._battleAnimating) return;
  const attacks = (newEvents || []).filter((e) => e.type === 'attack').slice(0, 2);
  if (!attacks.length) return;
  window._battleAnimating = true;
  _stageSkipAll = false;
  try {
    B.view = prevView;
    renderBattleView();
    for (const ev of attacks) {
      if (!window._battle) break;
      await playStageAttack(ev, prevView);
    }
  } finally {
    window._battleAnimating = false;
  }
}

async function abandonBattle() {
  const B = window._battle;
  if (!B) return;
  if (B.local) {
    if (!await askConfirm(tr('确定放弃这场对战吗？放弃不计成绩，也没有奖励。', 'Abandon this battle? No score, no rewards.'), tr('放弃', 'Abandon'))) return;
    window._battle = null;
    goGym(B.childId);
    return;
  }
  if (!await askConfirm(tr('确定放弃这场对战吗？放弃不计成绩，也没有奖励。', 'Abandon this battle? No score, no rewards.'), tr('放弃', 'Abandon'))) return;
  let j;
  try {
    j = await api('/api/battle/abandon', { battleId: B.battleId, joinToken: curPvpToken(B.battleId) }, undefined, 15000);
  } catch (e) {
    alert(tr('网络好像不太稳，放弃没成功，再试一次吧', "Network seems unstable, abandon didn't go through — try again"));
    return;
  }
  if (!j.ok) { alert(j.error || tr('放弃失败', 'Abandon failed')); return; }
  clearPvpToken(B.battleId);
  window._battle = null;
  goGym(B.childId);
}
window.abandonBattle = abandonBattle;
function backToGym() {
  const B = window._battle;
  const id = B ? B.childId : selfChildId();
  if (B && B.view && B.view.status === 'active') { goGym(id); return; } // 进行中的对战保留，可从道馆页再进入
  window._battle = null;
  goGym(id);
}
window.backToGym = backToGym;

/* ---------- 图鉴 / 封印蛋 ---------- */
let dexData = null;
function dexSlot(e, key) {
  return `<div class="slot ${e.unlocked ? (e.no != null ? 'clickable' : '') : 'locked'}"${e.unlocked && e.no != null ? ` onclick="openDexCard('${key}')"` : ''}>
    ${e.unlocked ? `<span class="dex-owned" aria-hidden="true">✓</span>` : ''}
    ${!e.unlocked && e.img ? `<div class="dex-sil" style="mask-image:url(${e.img});-webkit-mask-image:url(${e.img})"></div>` : (e.img ? `<img loading="lazy" src="${e.img}">` : `<div style="padding:6px;display:flex;justify-content:center">${eggHtml(e.egg || EGG_FALLBACK, 56)}</div>`)}
    ${!e.unlocked && e.no != null ? `<div class="dex-no">No.${e.no}</div>` : ''}
    <div>${e.unlocked ? esc(e.name) : '<span class="unk">？？？</span>'}</div></div>`;
}
async function goPokedex(id) {
  careRoomUnmount(); // 离开养成页先卸掉房间
  state.childId = id;
  state.view = 'pokedex';
  const snap = (typeof lcAvailable === 'function' && lcAvailable()) ? await lcSnapshot(id) : null;
  if (snap && snap.pokedexFull) {
    dexData = snap.pokedexFull;
    renderPokedexPage(id, snap.pokedexFull);
    if (lcShouldSync()) lcSyncChild(id);
    return;
  }
  const cached = cacheMap('dexCache')[id];
  if (cached && cacheFresh(cacheMap('dexCacheAt')[id])) {
    dexData = cached;
    renderPokedexPage(id, cached);
    if (typeof lcAvailable === 'function' && lcAvailable() && lcShouldSync()) lcSyncChild(id);
    return;
  }
  if (cached) {
    dexData = cached;
    renderPokedexPage(id, cached);
    refreshDexInBackground(id);
    if (typeof lcAvailable === 'function' && lcAvailable() && lcShouldSync()) lcSyncChild(id);
    return;
  }
  const j = await api('/api/pokedex', { childId: id });
  if (!j.ok) return;
  cacheMap('dexCache')[id] = j; cacheMap('dexCacheAt')[id] = Date.now();
  if (typeof lcAvailable === 'function' && lcAvailable()) lcEnsureFull(id).catch(() => {});
  dexData = j;
  renderPokedexPage(id, j);
  if (typeof lcAvailable === 'function' && lcAvailable() && lcShouldSync()) lcSyncChild(id);
}

/* 图鉴筛选（任务 74，2026-11-09：学小红书 Lonee 文创笔记图鉴页的筛选 chips）：
 * 纯前端过滤已拿到的 pokedexFull 数据，切换不重新请求后端；来源分组保留作默认视图。
 * 注意：正式站未获得条目不带 types/type（后端 details() 防剧透），属性筛选只能命中
 * 类型已知的条目；未获得＋属性的组合在正式站会是空结果，这是数据口径所致，不是 bug。
 * 测试站 TEST_MODE 下全部条目都算已获得（DEBUG_GATES_OPEN），未获得筛选在测试站恒为空，
 * 由单测用夹具数据覆盖。 */
let dexFilter = { scope: 'all', type: null };
let dex151Open = false;
const DEX_FILTER_TYPE_ORDER = ['电', '火', '水', '草', '岩石', '地面', '普通', '飞行', '龙', '妖精', '冰', '格斗', '毒', '超能力', '虫', '幽灵', '恶', '钢'];
function dexEntryTypes(e) {
  if (!e) return [];
  if (e.types && e.types.length) return e.types.filter(Boolean);
  return e.type ? [e.type] : [];
}
function dexFilterMatch(e) {
  if (!e) return false;
  if (dexFilter.scope === 'owned' && !e.unlocked) return false;
  if (dexFilter.scope === 'missing' && e.unlocked) return false;
  if (dexFilter.type && !dexEntryTypes(e).includes(dexFilter.type)) return false;
  return true;
}
function dexFilterTypes(j) {
  const seen = new Set();
  const groups = [j.lineEntries, j.wild, j.others, j.collection, j.eggSpecies, j.dex151];
  for (const g of groups) {
    if (!Array.isArray(g)) continue;
    for (const e of g) for (const t of dexEntryTypes(e)) seen.add(t);
  }
  const ordered = DEX_FILTER_TYPE_ORDER.filter((t) => seen.has(t));
  const extra = [...seen].filter((t) => !DEX_FILTER_TYPE_ORDER.includes(t));
  return [...ordered, ...extra];
}
function dexFilterChipsHtml(j) {
  const isEn = state.lang === 'en';
  const typeLabel = (t) => isEn ? (TYPE_EN[t] ? TYPE_EN[t][0].toUpperCase() + TYPE_EN[t].slice(1) : t) : t;
  const scopeBtn = (scope, zh, en) => `<button type="button" class="movechip pick dex-filter-chip${dexFilter.scope === scope ? ' on' : ''}" onclick="setDexFilterScope('${scope}')" aria-pressed="${dexFilter.scope === scope}">${isEn ? en : zh}</button>`;
  const typeBtn = (t) => {
    const en = TYPE_EN[t];
    return `<button type="button" class="movechip pick dex-filter-chip${dexFilter.type === t ? ' on' : ''}" onclick="setDexFilterType('${t}')" aria-pressed="${dexFilter.type === t}">${en ? `<img loading="lazy" src="/static/img/types/${en}.webp" alt="" onerror="this.remove()">` : ''}${esc(typeLabel(t))}</button>`;
  };
  return `<div class="dex-filter" role="group" aria-label="${tr('图鉴筛选', 'Pokédex filter')}">
    ${scopeBtn('all', '全部', 'All')}${scopeBtn('owned', '已获得', 'Owned')}${scopeBtn('missing', '未获得', 'Not owned')}
    <span class="dex-filter-sep" aria-hidden="true"></span>
    ${dexFilterTypes(j).map(typeBtn).join('')}
  </div>`;
}
window.setDexFilterScope = function(scope) {
  dexFilter.scope = scope;
  if (dexData) renderPokedexPage(state.childId, dexData);
};
window.setDexFilterType = function(type) {
  dexFilter.type = dexFilter.type === type ? null : type;
  if (dexData) renderPokedexPage(state.childId, dexData);
};
function renderPokedexPage(id, j) {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  // 筛选后的各组：默认筛选（全部＋无属性）与原先一致；非默认筛选下空分组整个隐藏。
  const fLine = j.lineEntries.filter((e) => e.current || e.unlocked).filter(dexFilterMatch);
  const fWild = (j.wild || []).filter(dexFilterMatch);
  const fOthers = (j.others || []).filter(dexFilterMatch);
  const fCollection = (j.collection || []).filter(dexFilterMatch);
  const fEggs = (j.eggSpecies || []).filter(dexFilterMatch);
  const f151 = (j.dex151 || []).filter(dexFilterMatch);
  const groupHtml = (titleZh, titleEn, list) => list.length ? `<div class="section-title">${biTitle(titleZh, titleEn)}</div><div class="dex">${list.map((e) => dexSlot(e, e.key)).join('')}</div>` : '';
  app.innerHTML = `
  ${childTop(biTitle('我的图鉴', 'My Pokédex'), `goChild(${id})`, undefined, true)}
  <div class="card dex-head">
    <strong>${bi(`全图鉴共 151 只 已收录 ${j.progress.owned}/151（${j.progress.pct}%）`, `Full Pokédex: 151 species Collected ${j.progress.owned}/151 (${j.progress.pct}%)`)}</strong>
    <div class="xpbar progress"><i style="clip-path:inset(0 ${100 - j.progress.pct}% 0 0)"></i></div>
    <small>${bi('皮丘（172）、咩利羊（179）在原分册，不计入 151 进度。', 'Pichu (172) and Mareep (179) are in their original sections, not counted in the 151.')}</small>
  </div>
  ${dexFilterChipsHtml(j)}
  ${groupHtml('伙伴进化线', 'Companion evolution lines', fLine)}
  ${groupHtml('野外伙伴', 'Wild companions', fWild)}
  ${groupHtml('道馆与稀有', 'Gym & rare', fOthers)}
  ${groupHtml('收藏进化', 'Collection evolution', fCollection)}
  ${groupHtml('封印蛋孵化', 'Sealed egg hatches', fEggs)}
  ${f151.length ? `<section id="dex151-section">
  <div class="section-title dex151-head"><span>${biTitle('关都图鉴 151', 'Kanto Pokédex 151')}</span><button type="button" class="iconbtn dex151-toggle" aria-controls="dex151-grid" aria-expanded="false" onclick="toggleDex151()">${tr('展开 ▸', 'Expand ▸')}</button></div>
  <div id="dex151-grid" hidden><div class="dex"></div></div>
  </section>` : ''}
  ${tabbar()}`;
  // 筛选切换会重渲染整页：此前已展开的 151 网格按当前筛选重填，保持展开态。
  if (dex151Open) {
    const section = document.getElementById('dex151-section');
    const grid = section && section.querySelector('#dex151-grid');
    const button = section && section.querySelector('.dex151-toggle');
    if (grid && button) {
      const body = grid.querySelector('.dex');
      if (body) body.innerHTML = f151.map(dex151SlotHtml).join('');
      grid.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      button.textContent = tr('收起 ▾', 'Collapse ▾');
    }
  }
  // 选中态 chip 若被横向滚动藏住，滚回视野（只动筛选行内部滚动，不动页面）。
  if (typeof document !== 'undefined' && document.querySelectorAll) {
    const onChips = document.querySelectorAll('.dex-filter-chip.on');
    const onChip = onChips[onChips.length - 1];
    if (onChip && onChip.scrollIntoView) onChip.scrollIntoView({ inline: 'nearest', block: 'nearest' });
  }
}
function openDexCard(key) {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const entries = dexData ? [
    ...dexData.lineEntries, ...dexData.wild, ...dexData.others,
    ...(dexData.collection || []),
    ...(dexData.eggSpecies || []),
    ...dexData.dex151.map((e) => ({ ...e, key: `dex151:${e.no}` })),
    ...(dexData.benchDex || []),
  ] : [];

  const e = entries.find((item) => item.key === key);
  if (!e) return;
  // 未获得条目不可点（伊布分支不再例外，进化路线由孩子自己发现）
  if (!e.unlocked) return;
  if (e.no == null) return;
  const source = key.startsWith('dex151:')
    ? entries.find((item) => item.no === e.no && item.unlocked && !item.key.startsWith('dex151:') && (!item.line || item.current)) || e
    : e;
  const route = source?.lineLabel || source?.kind || tr('野外伙伴', 'Wild companion');
  const moves = e.moves || [];
  // 备战宠技能升级入口：卡片记下当前物种的招式表（已学会的带 skillLevel/learned），点开可升级
  window._dexMoves = moves;
  window._dexMoveNo = e.no;
  window._dexMoveKey = key;
  const row = (label, value) => `<div class="dex-card-row"><strong>${label}</strong><span>${esc(String(value))}</span></div>`;
  // 友好度（任务 93）：主宠线卡片显示 5 颗爱心＋X/255，复用照顾页爱心样式（每颗满心 51 点）；只在 e.friendship 有值时显示
  const friendshipHearts = (f0) => {
    const f = Math.max(0, Math.min(255, Number(f0) || 0));
    const full = Math.floor(f / 51);
    const hearts = Array.from({ length: 5 }, (_, i) => `<span class="care-heart ${i < full ? 'on' : 'off'}" style="display:inline-flex;color:${i < full ? 'var(--danger,#F25C54)' : '#d1d5db'};margin:0 2px">${ic('heart')}</span>`).join('');
    return `${hearts}<span style="margin-left:6px;font-weight:600">${f}/255</span>`;
  };
  const TYPE_COLOR = { '电': ['#F8D030', '#333'], '火': ['#F08030', '#fff'], '水': ['#6890F0', '#fff'], '草': ['#78C850', '#fff'], '冰': ['#98D8D8', '#333'], '格斗': ['#C03028', '#fff'], '毒': ['#A040A0', '#fff'], '地面': ['#E0C068', '#333'], '飞行': ['#A890F0', '#fff'], '超能力': ['#F85888', '#fff'], '虫': ['#A8B820', '#fff'], '岩石': ['#B8A038', '#fff'], '幽灵': ['#705898', '#fff'], '龙': ['#7038F8', '#fff'], '恶': ['#705848', '#fff'], '钢': ['#B8B8D0', '#333'], '妖精': ['#EE99AC', '#333'], '普通': ['#A8A878', '#fff'] };
  const typeStyle = (t) => { const c = TYPE_COLOR[t]; return c ? ` style="background:${c[0]};color:${c[1]}"` : ''; };
  const types = (e.types && e.types.length ? e.types : [e.type]).filter(Boolean);
  const badges = types.map((t) => `<span class="dex-card-badge"${typeStyle(t)}>${esc(t)}</span>`).join('');
  /* 进化链：当前形态加粗；分支（伊布 8 种、飞天螳螂 2 条）逐行列出条件 */
  const evo = e.evo || null;
  const evoNode = (s) => `<span class="dex-card-evo-node${s.no === e.no ? ' cur' : ''}">${esc(s.name)}${s.cond ? `<small>${esc(s.cond)}</small>` : ''}</span>`;
  const evoHtml = evo ? `<div class="dex-card-sec"><div class="dex-card-sec-title">${tr('进化链', 'Evolution chain')}</div>
    <div class="dex-card-evo">${evo.chain.map(evoNode).join('<span class="dex-card-evo-arrow">→</span>')}${evo.chain.length === 1 && !evo.branches ? `<span class="dex-card-evo-note">${tr('最终形态', 'Final form')}</span>` : ''}</div>
    ${evo.branches ? `<div class="dex-card-evo-branches">${evo.branches.map((b) => `<div class="dex-card-evo-branch"><span class="dex-card-evo-arrow">→</span> ${evoNode(b)}</div>`).join('')}</div>` : ''}</div>` : '';
  /* 特性：普通特性与隐藏特性分框，带效果说明 */
  const abs = e.abilities || [];
  const abilityBox = (title, list, cls) => list.length ? `<div class="dex-card-ability${cls ? ' ' + cls : ''}"><div class="dex-card-ability-title">${title}</div>${list.map((a) => `<div class="dex-card-ability-item"><strong>${esc(a.name)}</strong>${a.effect ? `<span>${esc(a.effect)}</span>` : ''}</div>`).join('')}</div>` : '';
  const abilitiesHtml = abs.length ? `<div class="dex-card-sec">${abilityBox(tr('特性', 'Abilities'), abs.filter((a) => !a.hidden))}${abilityBox(tr('隐藏特性', 'Hidden ability'), abs.filter((a) => a.hidden), 'hidden')}</div>` : '';
  /* 克制关系（2026-10-27 返工第 3 件）：后端 matchups（PvE 官方口径，含弱点 ×2、抗性 ×0.5、免疫 ×0）；属性徽章是官方属性，PvP 答题对战另有规则。馆主卡片（e.matchupsDual）按官方双属性算，标题与脚注另行标注。 */
  const mu = e.matchups || null;
  const muBadges = (list) => list.map((t) => `<span class="dex-card-badge"${typeStyle(t)}>${esc(t)}</span>`).join('');
  const muTitle = e.matchupsDual ? tr('克制关系（馆主双属性，PvE 官方口径）', 'Matchups (Gym leader dual types, PvE official rules)') : tr('克制关系（PvE 官方口径）', 'Matchups (PvE official rules)');
  const muNote = e.matchupsDual ? bi('克制按官方双属性算，答题对战另有规则。', 'Calculated with official dual types. PvP quiz battles use different rules.') : bi('克制按官方属性算，答题对战另有规则。', 'Calculated with official types. PvP quiz battles use different rules.');
  const muNoteFull = e.matchupsDual ? bi('按馆主官方双属性算（弱点 ×2 含 4 倍、抗性 ×0.5 含 0.25 双抗、免疫 ×0）；上方属性徽章是官方属性。PvP 答题对战另有规则，不按此表。', "Calculated with the Gym leader's official dual types (weakness ×2 including ×4, resistance ×0.5 including ×0.25 double resistance, immunity ×0); type badges above are official types. PvP quiz battles use different rules, not this table.") : bi('按 PvE 官方口径（弱点 ×2、抗性 ×0.5、免疫 ×0）；上方属性徽章是官方属性。PvP 答题对战另有规则，不按此表。', 'Under PvE official rules (weakness ×2, resistance ×0.5, immunity ×0); type badges above are official types. PvP quiz battles use different rules, not this table.');
  const muHtml = mu ? `<div class="dex-card-sec"><div class="dex-card-sec-title">${muTitle}</div>
    <div class="dex-card-matchups"><div><strong>${ic('swords')} ${tr('克制：', 'Strong against:')}</strong>${mu.strong.length ? muBadges(mu.strong) : `<span style="color:var(--text-2)">${tr('无', 'None')}</span>`}</div>
    <div><strong>${ic('shield')} ${tr('被克制：', 'Weak against:')}</strong>${mu.weak.length ? muBadges(mu.weak) : `<span style="color:var(--text-2)">${tr('无', 'None')}</span>`}</div>
    <div><strong>${tr('抗性：', 'Resistances:')}</strong>${mu.resist.length ? muBadges(mu.resist) : `<span style="color:var(--text-2)">${tr('无', 'None')}</span>`}</div>
    ${mu.immune.length ? `<div><strong>${tr('免疫：', 'Immunities:')}</strong>${muBadges(mu.immune)}</div>` : ''}
    <div style="color:var(--text-2);font-size:14px">${muNote}</div><details style="color:var(--text-2);font-size:14px"><summary>${tr('详情', 'Details')}</summary><div>${muNoteFull}</div></details></div></div>` : '';
  /* 种族值（左）＋技能介绍（右）：两栏，窄屏上下堆叠（见 style.css .dex-card-cols） */
  const STAT_LABELS = [['hp', 'HP'], ['attack', tr('攻击', 'Attack')], ['defense', tr('防御', 'Defense')], ['sp_attack', tr('特攻', 'Special Attack')], ['sp_defense', tr('特防', 'Special Defense')], ['speed', tr('速度', 'Speed')]];
  const STAT_COLORS = { hp: '#22a565', attack: '#e5484d', defense: '#f5b301', sp_attack: '#38bdf8', sp_defense: '#2563eb', speed: '#8b5cf6' };
  const STAT_MAX = 200;
  const statsHtml = e.stats ? `<div class="dex-card-col dex-card-stats"><div class="dex-card-sec-title">${tr('种族值', 'Base stats')}</div>${STAT_LABELS.map(([k, label]) => `<div class="dex-stat-row"><span class="dex-stat-label">${label}</span><span class="dex-stat-value">${e.stats[k]}</span><span class="dex-stat-bar"><i style="width:${Math.round(e.stats[k] / STAT_MAX * 100)}%;background:${STAT_COLORS[k]}"></i></span></div>`).join('')}<div class="dex-stat-row dex-stat-total"><span class="dex-stat-label">${tr('总和', 'Total')}</span><span class="dex-stat-value">${e.stats.total}</span></div></div>` : '';
  const actualHtml = e.actualStats ? `<div class="dex-card-actual"><div class="dex-card-sec-title">${tr(`实际六围（Lv.${e.actualLevel}）`, `Actual stats (Lv.${e.actualLevel})`)}</div><div class="dex-actual-row">${STAT_LABELS.map(([k, label]) => `<span class="dex-actual-cell"><span class="dex-actual-label">${label}</span><strong>${e.actualStats[k]}</strong></span>`).join('')}</div>${e.scaledLevel != null ? `<div class="dex-actual-note">${tr(`按有效等级 Lv.${e.scaledLevel} 换算`, `Converted at effective level Lv.${e.scaledLevel}`)}</div>` : ''}</div>` : '';
  const dexFrags = (dexData && typeof dexData.fragments === 'number') ? dexData.fragments : ((window._kidQuiz && window._kidQuiz.fragments) || 0);
  const dexUpgradable = moves.some((m) => m.learned);
  const dexMoveInner = (m) => `<strong>${esc(m.name)}</strong>
        ${m.power != null ? `<sub>${tr(`威力 ${m.power}`, `Power ${m.power}`)}</sub>` : ''}
        ${m.level != null ? `<sub>${tr(`Lv.${m.level}学会`, `Learned at Lv.${m.level}`)}</sub>` : ''}
        ${m.type ? `<span class="dex-card-badge"${typeStyle(m.type)}>${esc(m.type)}</span>` : ''}
        ${m.learned ? `<small class="skillbadge${(m.skillLevel || 1) >= 5 ? ' max' : ''}">${tr(...LANG.childSlice2Skill)}${m.skillLevel || 1}</small>` : ''}
        ${m.desc ? `<p>${esc(m.desc)}</p>` : ''}`;
  const movesHtml = `<div class="dex-card-col dex-card-moves"><div class="dex-card-sec-title">${tr('技能介绍', 'Move details')}</div>${dexUpgradable ? `<p style="color:var(--text-2)">${bi(...LANG.childSlice2Fragments)}${dexFrags}/3 ${bi(...LANG.childSlice2Upgrade)}</p>` : ''}${moves.length ? moves.map((m, mi) => (m.learned ? `<button type="button" class="dex-card-move" onclick="showDexMoveDetail(${mi})">${dexMoveInner(m)}</button>` : `<div class="dex-card-move">${dexMoveInner(m)}</div>`)).join('') : `<p>${bi('还没有学会招式', 'No moves learned yet')}</p>`}</div>`;
  modalRoot.innerHTML = `<div class="overlay" onclick="closeModal()">
    <div class="modal dex-card" onclick="event.stopPropagation()" role="dialog" aria-modal="true" aria-label="${esc(e.name)}">
      <div class="dex-card-no">No.${String(e.no).padStart(3, '0')}</div>
      <div class="dex-card-image"><img loading="lazy" src="${e.img}" alt="${esc(e.name)}"></div>
      <h2 class="dex-card-name">${esc(e.name)}</h2>
      ${badges ? `<div class="dex-card-badges">${badges}</div>` : ''}
      ${evoHtml}
      ${muHtml}
      ${e.level != null ? row(tr('等级', 'Level'), `Lv.${e.level}`) : ''}
      ${e.level != null && dexData.xp ? `<div class="dex-card-row"><strong>${tr('经验', 'XP')}</strong><span>${dexData.xp.intoLevel}/${dexData.xp.span}${tr('，', ', ')}${tr('总经验', 'Total XP')} ${dexData.xp.total}${tr('，', ', ')}${tr('距下一级', 'To next level')} ${dexData.xp.toNext}</span></div>
      <div class="xpbar"><i style="clip-path:inset(0 ${100 - Math.max(0, Math.min(100, dexData.xp.intoLevel / dexData.xp.span * 100))}% 0 0)"></i></div>` : ''}
      ${e.friendship != null ? `<div class="dex-card-row"><strong>${tr('友好度', 'Friendship')}</strong><span>${friendshipHearts(e.friendship)}</span></div>` : ''}
      ${row(tr('获得途径', 'How obtained'), route)}
      ${e.obtainedAt ? row(tr('获得日期', 'Obtained on'), e.obtainedAt) : ''}
      ${abilitiesHtml}
      <div class="dex-card-cols">${statsHtml}${movesHtml}</div>${actualHtml}
      ${window._dexCardGym ? `<button class="bigbtn green" onclick="pickGymBenchFromCard()">${window._dexCardGym.benchNo ? tr('带它备战', 'Bring it to battle prep') : tr('只带主宠', 'Main companion only')}</button>` : ''}
      ${window._dexCardGym ? `<button class="bigbtn" onclick="pickGymLeadFromCard()">${window._dexCardGym.benchNo ? tr('让它先发', 'Make it the lead') : tr('主宠先发', 'Main companion leads')}</button>` : ''}
      <button class="bigbtn" onclick="closeModal()">${tr('关闭', 'Close')}</button>
    </div></div>`;
}
window.openDexCard = openDexCard;
/* 151 网格单格（含未获得的 ??? 格；任务 74 抽出共用，toggle 与筛选重填同源） */
function dex151SlotHtml(e) {
  return e.unlocked ? dexSlot(e, `dex151:${e.no}`) : `<div class="slot locked">
    ${e.img ? `<div class="dex-sil" style="mask-image:url(${e.img});-webkit-mask-image:url(${e.img})"></div>` : ''}
    <div class="dex-no">No.${e.no}</div><span class="unk">???</span></div>`;
}
window.toggleDex151 = function() {
  const section = document.getElementById('dex151-section');
  if (!section) return;
  const grid = section.querySelector('#dex151-grid');
  const button = section.querySelector('.dex151-toggle');
  if (!grid || !button) return;
  const body = grid.querySelector('.dex');
  dex151Open = grid.hidden;
  if (dex151Open && dexData && body && !body.hasChildNodes()) {
    body.innerHTML = dexData.dex151.filter(dexFilterMatch).map(dex151SlotHtml).join('');
  }
  grid.hidden = !grid.hidden;
  button.setAttribute('aria-expanded', String(!grid.hidden));
  button.textContent = grid.hidden ? tr('展开 ▸', 'Expand ▸') : tr('收起 ▾', 'Collapse ▾');
};
// Task 104 v3: 卡牌馆辅助函数提到顶层（原在 goEggs 内，hallCardInner / openCardViewer 需共用）。
const CARD_TYPE_COLOR = { '电': ['#F8D030', '#333'], '火': ['#F08030', '#fff'], '水': ['#6890F0', '#fff'], '草': ['#78C850', '#fff'], '冰': ['#98D8D8', '#333'], '格斗': ['#C03028', '#fff'], '毒': ['#A040A0', '#fff'], '地面': ['#E0C068', '#333'], '飞行': ['#A890F0', '#fff'], '超能力': ['#F85888', '#fff'], '虫': ['#A8B820', '#fff'], '岩石': ['#B8A038', '#fff'], '幽灵': ['#705898', '#fff'], '龙': ['#7038F8', '#fff'], '恶': ['#705848', '#fff'], '钢': ['#B8B8D0', '#333'], '妖精': ['#EE99AC', '#333'], '普通': ['#A8A878', '#fff'] };
const hallTypeHex = (t) => (CARD_TYPE_COLOR[t] || ['#A8A878'])[0];
const hallMoveRow = (m, mainType) => `<div class="rare-card-move"><span class="rare-card-energy" style="background:${esc(hallTypeHex(m.type || mainType))}"></span><span class="rare-card-move-name">${esc(m.name || '')}</span><span class="rare-card-move-pwr">${Number(m.power || 0)}</span></div>`;
const hallGroupLabel = (g) => g === 'mew' ? tr('梦幻', 'Mew') : g === 'legendary' ? tr('传说', 'Legendary') : g === 'eevee' ? tr('伊布进化', 'Eevee Evo') : tr('终极形态', 'Final Evo');
// Task 104 移植（Claude 版 5 层反光）：卡牌馆分组 → 反光档位（梦幻 SAR、传说 UR 金、伊布进化 SR、终极形态普闪）。
const HALL_HOLO_TIER = { mew: 'sar', legendary: 'ur', eevee: 'sr', final: 'holo' };

async function goEggs(id) {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  state.view = 'eggs';
  const j = await api('/api/eggs', { childId: id });
  if (!j.ok) return;
  Object.assign(LANG, {
    eggSlice1Title: ['收藏馆', 'Collection Hall']
  });
  if (j.justHatched && j.justHatched.length) {
    const p = j.justHatched[0].pokemon;
    celebrate(tr('封印解开了！', 'Sealed egg hatched!'), `/static/img/p${p.no}.webp`, tr(`封印蛋孵出了${p.name}，已经进图鉴啦！`, `${p.name} hatched from a sealed egg and joined your Pokédex!`));
  }
  const hallCards = Array.isArray(j.cards) ? j.cards : [];
  const hallHtml = `<div class="section-title">${biTitle('珍稀卡牌馆', 'Rare card hall')}</div>
  ${hallCards.length ? `<div class="card-hall">${hallCards.map((c) => `<button type="button" class="rare-card rare-card-${esc(c.group || 'final')}" data-no="${Number(c.no)}" style="--card-tint:${esc(hallTypeHex((c.types || [])[0]))}26;--card-tint-strong:${esc(hallTypeHex((c.types || [])[0]))}47">${hallCardInner(c)}
  </button>`).join('')}</div>` : `<div class="card-hall-empty">${bi('还没有珍稀精灵', 'No rare Pokémon yet')}</div>`}`;
  app.innerHTML = `
  ${childTop(biTitle(...LANG.eggSlice1Title), `goChild(${id})`, undefined, true)}
  ${hallHtml}
  ${j.eggs.length ? j.eggs.map((e) => `<div class="card eggrow${!e.hatched && e.daysLeft === 1 ? ' soon' : ''}">
    <span class="egg-ic">${e.hatched ? ic('sparkles') : eggHtml(e.egg || EGG_FALLBACK, 32)}</span>
    <div style="min-width:0"><b>${e.hatched ? tr(`已孵化：${esc(e.speciesName || '')}`, `Hatched: ${esc(e.speciesName || '')}`) : tr(`还有 ${e.daysLeft} 天解封`, `${e.daysLeft} days left until unsealed`)}</b>${!e.hatched && e.daysLeft === 1 ? `<span class="egg-soon">${tr('快孵化啦', 'Hatching soon!')}</span>` : ''}
    <span class="egg-sub">${tr(`${e.awardedDate} 获得 ${e.unlockDate} ${e.hatched ? '已解封' : '解封'}`, `${e.awardedDate} obtained ${e.unlockDate} ${e.hatched ? 'unsealed' : 'unseals'}`)}${e.hatched ? '' : tr(' 里面是谁先保密哦', " Who's inside is a secret!")}</span></div></div>`).join('')
    : '<div class="empty"><div class="empty-e">' + ic('egg') + '</div>' + bi('还没有封印蛋。<br>周末挑战道馆胜利就能赢一颗哦！', 'No sealed eggs yet.<br>Win a Weekend Gym challenge to earn one!') + '</div>'}
  ${j.rewardEggs && j.rewardEggs.length ? `<div class="section-title">${biTitle('奖励蛋（高级转盘／稀有转盘／单元测试获得，7 天孵化）', 'Reward eggs (from Advanced Wheel / Rare Wheel / unit tests, hatch in 7 days)')}</div>
  ${j.rewardEggs.map((e) => `<div class="card eggrow${!e.hatched && e.daysLeft === 1 ? ' soon' : ''}">
    <span class="egg-ic">${e.hatched ? ic('sparkles') : eggHtml(e.egg || EGG_FALLBACK, 32)}</span>
    <div style="min-width:0"><b>${e.hatched ? tr(`已孵化：${esc(e.speciesName || '')}`, `Hatched: ${esc(e.speciesName || '')}`) : tr(`${esc(e.speciesName || '')}的蛋 还有 ${e.daysLeft} 天孵化`, `${esc(e.speciesName || '')}'s egg ${e.daysLeft} days left to hatch`)}</b>${!e.hatched && e.daysLeft === 1 ? `<span class="egg-soon">${tr('快孵化啦', 'Hatching soon!')}</span>` : ''}
    <span class="egg-sub">${tr(`${e.awardedDate} 获得 ${e.unlockDate} ${e.hatched ? '已孵化' : '孵化'}`, `${e.awardedDate} obtained ${e.unlockDate} ${e.hatched ? 'Hatched' : 'Hatches'}`)}${e.source ? tr(` 来自${esc(e.source)}`, ` From ${esc(e.source)}`) : ''}</span></div></div>`).join('')}` : ''}
  ${tabbar()}`;
  app.querySelectorAll('.rare-card').forEach((btn) => {
    // 指针驱动倾斜＋闪膜（任务 104 v2 建、v3 按参考站悬停改）：鼠标悬停跟随，触屏按下拖动时跟随；抬起/离开/取消复位。
    // 参考站实测：倾斜很轻、白色柔光高光跟鼠标走、整体略张开、约 1 秒平滑复位、无彩虹镭射。
    // 只改 transform 与 --mx/--my，不碰 click 开详情、不拦滚动。
    let hallDragging = false;
    const hallApplyTilt = (e) => {
      const rect = btn.getBoundingClientRect();
      const px = Math.max(0, Math.min(1, (e.clientX - rect.left) / (rect.width || 1)));
      const py = Math.max(0, Math.min(1, (e.clientY - rect.top) / (rect.height || 1)));
      btn.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
      btn.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
      const rx = ((0.5 - py) * 10).toFixed(2);
      const ry = ((px - 0.5) * 10).toFixed(2);
      btn.style.transform = `perspective(600px) rotateX(${rx}deg) rotateY(${ry}deg) scale(1.04)`;
    };
    const hallResetTilt = () => {
      hallDragging = false;
      btn.classList.add('is-resetting');
      btn.style.transform = '';
      btn.style.removeProperty('--mx');
      btn.style.removeProperty('--my');
      clearTimeout(btn._hallResetT);
      btn._hallResetT = setTimeout(() => btn.classList.remove('is-resetting'), 550);
    };
    btn.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') hallDragging = true;
    });
    btn.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse' || (hallDragging && e.buttons > 0)) hallApplyTilt(e);
    });
    btn.addEventListener('pointerup', hallResetTilt);
    btn.addEventListener('pointerleave', hallResetTilt);
    btn.addEventListener('pointercancel', hallResetTilt);
    btn.addEventListener('click', () => {
      const idx = hallCards.findIndex((c) => Number(c.no) === Number(btn.dataset.no));
      if (idx >= 0) openCardViewer(hallCards, idx);
    });
  });
}
window.goEggs = goEggs; window.goPokedex = goPokedex; window.goGym = goGym;

// Task 104 v3: hallCardInner + 独立 3D 卡片查看器（插入锚点：window.goEggs = goEggs; 这一行之后）
// 卡背按用户 2026-11-13 04:59 指示：跟参考站一致——蓝底金边、中央精灵球、上下 Pokémon 字样（下方倒置）。

function hallCardInner(c) {
  return `
    <div class="rare-card-holo"></div>
    <div class="rare-card-glare"></div>
    <div class="rare-card-head"><span class="rare-card-name">${esc(c.name || '')}</span>${c.hp != null ? `<span class="rare-card-hp"><span class="rare-card-hp-lbl">HP</span>${Number(c.hp)}</span>` : ''}</div>
    <div class="rare-card-art${(c.moves || []).length ? '' : ' is-tall'}"><img src="${esc(c.img || frontImgFor({ no: c.no }))}" alt="${esc(c.name || '')}" loading="lazy" draggable="false"></div>
    ${(c.moves || []).length ? `<div class="rare-card-moves">${c.moves.slice(0, 2).map((m) => hallMoveRow(m, (c.types || [])[0])).join('')}</div>` : ''}
    <div class="rare-card-meta">${c.weak ? `<div class="rare-card-weak"><span class="rare-card-weak-lbl">${tr('弱点', 'Weakness')}</span><span class="rare-card-weak-dot" style="background:${esc(hallTypeHex(c.weak))}"></span><span class="rare-card-weak-x">×2</span></div>` : ''}<div class="rare-card-foot"><span class="rare-card-no">#${String(c.no).padStart(3, '0')}</span><span class="rare-card-ribbon">${hallGroupLabel(c.group)}</span></div></div>`;
}

let _cardViewerCleanup = null;

function closeCardViewer() {
  if (_cardViewerCleanup) {
    const fn = _cardViewerCleanup;
    _cardViewerCleanup = null;
    fn();
  } else {
    modalRoot.innerHTML = '';
  }
}

function openCardViewer(cards, index) {
  if (!Array.isArray(cards) || !cards.length) return;
  closeCardViewer();

  const total = cards.length;
  let curIdx = ((Number(index) || 0) % total + total) % total;
  // 参考站转动手感：目标角 target，当前角 cur，每帧指数靠近（拖拽速率 19.7、静止 9）；松手停哪是哪、不吸附。
  let targetX = 2.3;
  let targetY = -10.3;
  let curX = 2.3;
  let curY = -10.3;
  let dragging = false;
  let activePointerId = null;
  let lastX = 0;
  let lastY = 0;
  let dragN = 340;
  let movedDist = 0;
  let suppressBackdropClick = false;
  let mouseNX = 0;
  let mouseNY = 0;
  let rafId = 0;
  let lastT = 0;
  let lastFaceBack = null;
  let lastMouseT = 0;

  const prevOverflow = document.body.style.overflow;
  document.body.style.overflow = 'hidden';

  modalRoot.innerHTML = `
    <div class="card-viewer-overlay" role="dialog" aria-modal="true">
      <div class="card-viewer-stage">
        <div class="card-viewer">
          <div class="card-viewer-spin">
            <div class="card-viewer-face card-viewer-front rare-card"></div>
            <div class="card-viewer-face card-viewer-back has-real">
              <img class="card-viewer-back-img" src="/static/img/card-back.webp" alt="" draggable="false">
              <div class="card-viewer-laser card-viewer-laser-back"></div>
            </div>
            <div class="card-viewer-edge is-top"></div>
            <div class="card-viewer-edge is-right"></div>
            <div class="card-viewer-edge is-bottom"></div>
            <div class="card-viewer-edge is-left"></div>
          </div>
        </div>
      </div>
      <div class="card-viewer-caption"></div>
      <div class="card-viewer-bar">
        <button type="button" class="card-viewer-nav" data-dir="-1">‹ ${tr('上一张', 'Prev')}</button>
        <button type="button" class="card-viewer-flip"></button>
        <button type="button" class="card-viewer-nav" data-dir="1">${tr('下一张', 'Next')} ›</button>
      </div>
      <button type="button" class="card-viewer-back-btn">${tr('返回', 'Back')}</button>
    </div>
  `;

  const overlay = modalRoot.querySelector('.card-viewer-overlay');
  const stage = modalRoot.querySelector('.card-viewer-stage');
  const cardEl = modalRoot.querySelector('.card-viewer');
  const spin = modalRoot.querySelector('.card-viewer-spin');
  const frontEl = modalRoot.querySelector('.card-viewer-front');
  const captionEl = modalRoot.querySelector('.card-viewer-caption');
  const flipBtn = modalRoot.querySelector('.card-viewer-flip');
  const backBtn = modalRoot.querySelector('.card-viewer-back-btn');
  const navBtns = modalRoot.querySelectorAll('.card-viewer-nav');

  const isBackShowing = () => (Math.abs(Math.round(curY / 180)) % 2) === 1;

  const wrap180 = (a) => {
    let n = ((a % 360) + 360) % 360;
    if (n > 180) n -= 360;
    return n;
  };

  const updateFlipLabel = () => {
    flipBtn.textContent = isBackShowing() ? tr('查看卡面', 'View front') : tr('查看卡背', 'View back');
  };

  const applyTransform = () => {
    spin.style.transform = `rotateX(${curX.toFixed(2)}deg) rotateY(${curY.toFixed(2)}deg)`;
    const mod180 = ((curY % 180) + 180) % 180;
    const tiltY = Math.min(mod180, 180 - mod180);
    const tilt = Math.abs(curX) + tiltY;
    const foil = Math.min(0.9, 0.35 + (tilt / 55) * 0.55);
    cardEl.style.setProperty('--i', foil.toFixed(3));
    cardEl.style.setProperty('--bx', (50 + Math.sin(curY * Math.PI / 180) * 60).toFixed(1) + '%');
    cardEl.style.setProperty('--by', (50 - Math.sin(curX * Math.PI / 180) * 60).toFixed(1) + '%');
    const back = isBackShowing();
    if (back !== lastFaceBack) {
      lastFaceBack = back;
      updateFlipLabel();
    }
  };

  // 每帧追赶：拖拽中速率 19.7（跟手紧），静止速率 9（柔和收住）；静止时叠加鼠标视差（仅鼠标）。
  // 鼠标 3 秒不动（触屏上一直）时叠加轻微摆动（Claude 版 idle sway 的收敛版：±5°/±2.5°，参考站卡包摆动约 ±2.6°）。
  const tick = (now) => {
    const dt = Math.min(((now - lastT) || 16) / 1000, 0.05);
    lastT = now;
    const rate = dragging ? 19.7 : 9;
    const k = 1 - Math.exp(-rate * dt);
    const sway = !dragging && (now - lastMouseT > 3000);
    const dispX = dragging ? targetX : targetX - mouseNY * 6.9 + (sway ? Math.sin(now / 2000) * 2.5 : 0);
    const dispY = dragging ? targetY : targetY + mouseNX * 8.6 + (sway ? Math.sin(now / 1500) * 5 : 0);
    curX += (dispX - curX) * k;
    curY += (dispY - curY) * k;
    applyTransform();
    rafId = requestAnimationFrame(tick);
  };

  const updateMXMY = (e) => {
    const rect = cardEl.getBoundingClientRect();
    const px = Math.max(0, Math.min(100, ((e.clientX - rect.left) / (rect.width || 1)) * 100));
    const py = Math.max(0, Math.min(100, ((e.clientY - rect.top) / (rect.height || 1)) * 100));
    cardEl.style.setProperty('--mx', px.toFixed(1) + '%');
    cardEl.style.setProperty('--my', py.toFixed(1) + '%');
    if (e.pointerType === 'mouse') lastMouseT = performance.now();
  };

  const renderCard = () => {
    const c = cards[curIdx];
    const hex = hallTypeHex((c.types || [])[0]);
    frontEl.className = `card-viewer-face card-viewer-front rare-card rare-card-${esc(c.group || 'final')}${c.tcg ? ' has-tcg' : ''}`;
    frontEl.dataset.r = HALL_HOLO_TIER[c.group] || 'holo';
    frontEl.style.setProperty('--card-tint', `${hex}26`);
    frontEl.style.setProperty('--card-tint-strong', `${hex}47`);
    const fxLayers = '<i class="card-viewer-fx fx-rb"></i><i class="card-viewer-fx fx-tx"></i><i class="card-viewer-fx fx-sp"></i><i class="card-viewer-fx fx-gd"></i><i class="card-viewer-fx fx-gl"></i>';
    frontEl.innerHTML = c.tcg
      ? `<img class="card-viewer-tcg" src="${esc(c.tcg)}" alt="${esc(c.name || '')}" draggable="false">${fxLayers}`
      : `${hallCardInner(c)}${fxLayers}`;
    captionEl.innerHTML = `${esc(c.name || '')} · ${hallGroupLabel(c.group)} · ${tr('拖拽可 360° 旋转赏析 · 双击复位', 'Drag to rotate 360° · Double-click to reset')}`;
    updateFlipLabel();
  };

  const stepCard = (delta) => {
    curIdx = (curIdx + delta + total) % total;
    renderCard();
    targetY = wrap180(targetY);
    curY = wrap180(curY);
    targetX = 2.3;
    targetY = -10.3;
  };

  cardEl.addEventListener('pointerdown', (e) => {
    if (dragging) return;
    dragging = true;
    activePointerId = e.pointerId;
    lastX = e.clientX;
    lastY = e.clientY;
    const rect = cardEl.getBoundingClientRect();
    dragN = Math.max(Math.min(rect.width, rect.height), 240);
    movedDist = 0;
    if (cardEl.setPointerCapture) {
      try { cardEl.setPointerCapture(e.pointerId); } catch (_) {}
    }
    updateMXMY(e);
  });

  cardEl.addEventListener('pointermove', (e) => {
    if (!dragging) {
      if (e.pointerType === 'mouse') updateMXMY(e);
      return;
    }
    if (activePointerId != null && e.pointerId !== activePointerId) return;
    const dx = e.clientX - lastX;
    const dy = e.clientY - lastY;
    lastX = e.clientX;
    lastY = e.clientY;
    movedDist += Math.hypot(dx, dy);
    // 参考站增益：横划满 n 像素转 4.2 弧度（≈240°），竖划 3.4 弧度；X 夹 ±77°，Y 自由。
    targetY += (dx / dragN) * 240.6;
    targetX = Math.max(-77, Math.min(77, targetX - (dy / dragN) * 194.8));
    updateMXMY(e);
  });

  const endDrag = (e) => {
    if (!dragging || (activePointerId != null && e.pointerId !== activePointerId)) return;
    dragging = false;
    if (movedDist > 5) suppressBackdropClick = true;
    if (cardEl.releasePointerCapture) {
      try { cardEl.releasePointerCapture(e.pointerId); } catch (_) {}
    }
    activePointerId = null;
    // 参考站：松手停哪是哪，不吸附回正、不回 X=0。
  };

  cardEl.addEventListener('pointerup', endDrag);
  cardEl.addEventListener('pointercancel', endDrag);
  cardEl.addEventListener('pointerleave', () => {
    if (!dragging) {
      cardEl.style.setProperty('--mx', '50%');
      cardEl.style.setProperty('--my', '50%');
    }
  });

  flipBtn.addEventListener('click', () => {
    targetY = wrap180(targetY);
    curY = wrap180(curY);
    targetX = 0;
    // 落在最近的另一面整倍数（短路径），不停在偏角上。
    const w = targetY;
    const front = Math.abs(w) < 90;
    const base = Math.round(w / 180) * 180;
    targetY = base + (front ? (w >= 0 ? 180 : -180) : (w >= 0 ? -180 : 180));
  });

  cardEl.addEventListener('dblclick', () => {
    targetY = wrap180(targetY);
    curY = wrap180(curY);
    targetX = 2.3;
    targetY = -10.3;
  });

  navBtns.forEach((b) => {
    b.disabled = total <= 1;
    b.addEventListener('click', () => stepCard(Number(b.dataset.dir) || 1));
  });

  backBtn.addEventListener('click', closeCardViewer);

  overlay.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    lastMouseT = performance.now();
    const rect = cardEl.getBoundingClientRect();
    mouseNX = Math.max(-1, Math.min(1, (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2 || 1)));
    mouseNY = Math.max(-1, Math.min(1, (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2 || 1)));
  });

  overlay.addEventListener('click', (e) => {
    if (suppressBackdropClick) {
      suppressBackdropClick = false;
      return;
    }
    if (e.target === overlay || e.target === stage) closeCardViewer();
  });

  const onKeyDown = (e) => {
    if (e.key === 'Escape') {
      closeCardViewer();
    } else if (e.key === 'ArrowLeft' && total > 1) {
      stepCard(-1);
    } else if (e.key === 'ArrowRight' && total > 1) {
      stepCard(1);
    }
  };
  document.addEventListener('keydown', onKeyDown);

  _cardViewerCleanup = () => {
    cancelAnimationFrame(rafId);
    document.removeEventListener('keydown', onKeyDown);
    document.body.style.overflow = prevOverflow;
    modalRoot.innerHTML = '';
  };

  cardEl.style.setProperty('--mx', '50%');
  cardEl.style.setProperty('--my', '50%');
  renderCard();
  lastFaceBack = isBackShowing();
  updateFlipLabel();
  lastT = performance.now();
  applyTransform();
  rafId = requestAnimationFrame(tick);
}

/* ---------- 背包（v11 进化道具） ---------- */
async function goBackpack(id) {
  state.childId = id;
  state.view = 'backpack';
  const j = await api('/api/evo/backpack?childId=' + id);
  if (!j.ok) { alert(j.error || tr('加载失败', 'Failed to load')); goChild(id); return; }
  window._bp = j;
  renderBackpack();
}
window.goBackpack = goBackpack;
function evoOptBtn(o, inst) {
  if (!o.ready) return `<span style="color:var(--text-2)">${tr('还差：', 'Missing: ')}${esc((o.missing || []).join('、') || '—')}</span>`;
  if (o.kind === 'main-final') return `<button class="smallbtn primary" onclick="evoCall('use-stone',{target:'main'})">${tr('进化！', 'Evolve!')}</button>`;
  if (o.kind === 'eevee-branch' && o.branch === 'sylveon') return `<button class="smallbtn primary" onclick="evoCall('evolve',{target:'eevee',branch:'sylveon'})">${tr('进化成仙子伊布！', 'Evolve into Sylveon!')}</button>`;
  if (o.kind === 'eevee-branch') return `<button class="smallbtn primary" onclick="evoCall('use-stone',{target:'eevee',branch:'${o.branch}'})">${tr('进化！', 'Evolve!')}</button>`;
  if (o.kind === 'collection-evo-reward') return `<button class="smallbtn primary" onclick="evoCall('evolve',{target:'species:${o.fromNo}',to:${o.target}})">${tr('领取高级转盘次数 ×1', 'Claim 1 Advanced Wheel spin')}</button>`;
  if (o.kind === 'collection-evo') return o.item
    ? `<button class="smallbtn primary" onclick="evoCall('use-stone',{target:'species:${o.fromNo}',to:${o.target}})">${tr('进化！', 'Evolve!')}</button>`
    : `<button class="smallbtn primary" onclick="evoCall('evolve',{target:'species:${o.fromNo}',to:${o.target}})">${tr('进化！', 'Evolve!')}</button>`;
  return '';
}
function renderBackpack() {
  document.body.classList.toggle('show-gloss', state.lang === 'en' && glossOn());
  const j = window._bp;
  const id = j.childId;
  Object.assign(LANG, {
    bpSlice1Title: ['背包', 'Backpack']
  });
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const MAIN_LINES = ['pikachu', 'charmander', 'squirtle', 'bulbasaur', 'eevee'];
  const hasFairyStone = (j.inventory || []).some((it) => it.key === 'stone:fairy-skill' && it.qty > 0);
  const taughtFairy = (j.fairyMoves || []).length > 0;
  const ballCell = (emoji, name, n) => `<div class="statcell"><b>${emoji} ${n}</b><span>${name}</span></div>`;
  app.innerHTML = `
  ${childTop(`${ic('backpack')} ${biTitle(...LANG.bpSlice1Title)}`, `goChild(${id})`, undefined, true)}
  <div class="card"><div class="section-title">${biTitle('精灵球', 'Poké Balls')}</div>
    <div class="statgrid">
      ${ballCell('<span class="pb-mini"></span>', bi('精灵球', 'Poké Ball'), j.balls.normal)}
      ${ballCell('<span class="pb-mini super"></span>', bi('超级球', 'Super Ball'), j.balls.super)}
      ${ballCell('<span class="pb-mini hyper"></span>', bi('高级球', 'Hyper Ball'), j.balls.hyper)}
      ${ballCell('<span class="pb-mini master"></span>', bi('大师球', 'Master Ball'), j.balls.master)}
    </div>
    <p style="color:var(--text-2);font-size:var(--fs-label)">${bi('球满 99 颗会自动向上兑换：5 精灵球→1 超级球，10 超级球→1 高级球，20 高级球→1 大师球。', 'Balls cap at 99 and auto-upgrade: 5 Poké Balls → 1 Super Ball, 10 Super Balls → 1 Hyper Ball, 20 Hyper Balls → 1 Master Ball.')}</p>
  </div>
  <div class="card"><div class="section-title">${biTitle('道具', 'Items')}</div>
    ${j.inventory.length ? j.inventory.map((it) => `<div class="bp-row"><span style="white-space:nowrap;flex-shrink:0">${itemIcon(it)} ${esc(it.name)} ×${it.qty}</span><span style="color:var(--text-2)">${esc(it.desc || '')}</span></div>`).join('') : '<p style="color:var(--text-2)">' + bi('背包还是空的。考试考得好、单元测试拿高分、高级转盘都能拿到道具哦！', 'Backpack is empty. Good exam scores, high unit-test scores, and the Advanced Wheel can earn items!') + '</p>'}
    ${taughtFairy ? `<div style="margin-top:8px"><b>${tr('伊布已学会的妖精招式：', "Eevee's learned Fairy moves:")}</b>${j.fairyMoves.map((m) => esc(m.name)).join('、')}</div>` : ''}
  </div>
  <p class="wheel-note">${bi('三个转盘都在大木博士之家 → 转盘中心里转。', 'All three wheels live in Dr. Oak\'s House → Wheel Hub.')}</p>
  <div class="card"><div class="section-title">${biTitle(`蛋（${j.eggs.length}）`, `Eggs (${j.eggs.length})`)}</div>
    ${j.eggs.length ? j.eggs.map((e) => `<div class="bp-row"><span style="display:inline-flex;align-items:center;gap:6px">${eggHtml(e.egg || EGG_FALLBACK, 24)}<span>${esc(e.speciesName)}${e.kind === 'reward' ? tr('（奖励蛋）', '(Reward egg)') : ''}</span></span><span>${e.daysLeft > 0 ? tr(`还有 ${e.daysLeft} 天孵化`, `${e.daysLeft} days left to hatch`) : tr('今天就能孵化啦', 'Can hatch today!')}</span></div>`).join('') : '<p style="color:var(--text-2)">' + bi('还没有蛋。道馆胜利、考试奖励和高级转盘都能拿到蛋哦！', 'No eggs yet. Gym wins, exam rewards, and the Advanced Wheel can earn eggs!') + '</p>'}
  </div>
  <div class="card"><div class="section-title">${biTitle('伙伴与进化', 'Companions & Evolution')}</div>
    ${(j.instances || []).map((inst) => `
      <div style="border-bottom:0.5px solid var(--line);padding:10px 0">
        <div style="display:flex;gap:10px;align-items:center">
          ${inst.img ? `<img loading="lazy" src="${inst.img}" style="width:56px;height:56px;object-fit:contain">` : ''}
          <div style="flex:1"><b>${esc(inst.name)}</b>${inst.current ? ' <span class="badge">' + tr('当前伙伴', 'Current companion') + '</span>' : ''}${inst.branch ? ` ${esc(inst.branch)}` : ''}${inst.hasBeenMain && !inst.current ? tr(' 曾是主宠', ' Was main companion') : ''}
          <div style="color:var(--text-2);font-size:var(--fs-label)">${inst.source === 'egg' ? tr('从蛋里孵出来', 'Hatched from an egg') : inst.source === 'main' ? tr('主宠', 'Main companion') : esc(inst.source)}</div></div>
          ${!inst.current && MAIN_LINES.includes(inst.lineKey) ? `<button class="smallbtn" onclick="childSwitchLine('${inst.lineKey}')">${tr('换成这只', 'Switch to this one')}</button>` : ''}
        </div>
        ${inst.lineKey === 'eevee' && (!inst.branch || inst.branch === 'sylveon') && !taughtFairy && hasFairyStone ? `<div style="margin-top:6px"><button class="smallbtn primary" onclick="evoCall('use-stone',{target:'eevee',action:'teach'})">${ic('sparkles')} ${tr('用妖精技能石教伊布学招式', 'Teach Eevee a move with the Fairy Skill Stone')}</button></div>` : ''}

        ${(inst.evoOptions || []).map((o) => `<div class="bp-row" style="margin-top:6px"><span>→ ${esc(o.name)}${o.note ? `（${esc(o.note)}）` : ''}</span>${evoOptBtn(o, inst)}</div>`).join('')}
      </div>`).join('') || '<p style="color:var(--text-2)">' + tr('还没有伙伴实例。', 'No companion instances yet.') + '</p>'}
  </div>
  <p style="color:var(--text-2)">${bi(`今天答题已掉落道具 ${j.dailyDropsToday}/${j.dailyDropLimit} 件。`, `Quiz drops today: ${j.dailyDropsToday}/${j.dailyDropLimit} items.`)}</p>
  ${tabbar()}`;
}
async function evoCall(which, payload) {
  const id = window._bp.childId;
  const j = await api(which === 'use-stone' ? '/api/evo/use-stone' : '/api/evo/evolve', { childId: id, ...payload });
  if (!j.ok) { alert(j.error || tr('操作失败', 'Operation failed')); return; }
  if (j.reward === 'wheel') celebrate(tr('领取成功！', 'Claimed!'), null, tr(`获得高级转盘次数 ×1！现在共有 ${j.wheelChances} 次高级转盘机会。`, `You got 1 Advanced Wheel spin! You now have ${j.wheelChances} chances.`));
  else if (j.move) celebrate(tr('学会新招式！', 'Learned a new move!'), null, tr(`伊布学会了「${esc(j.move.name || j.move)}」！`, `Eevee learned ${esc(j.move.name || j.move)}!`) + (j.pendingFairyEvolve ? tr('升到 16 级就能进化成仙子伊布啦！', 'Reach Lv.16 to evolve into Sylveon!') : ''));
  else if (j.name) celebrate(tr('进化啦！', 'Evolved!'), j.img || null, tr(`进化成了 ${esc(j.name)}！`, `Evolved into ${esc(j.name)}!`));
  else alert(tr('好啦！', 'Done!'));
  goBackpack(id);
}
window.evoCall = evoCall;
/* ---------- 扭蛋机（高级转盘 / 普通转盘 / 稀有转盘 / 养成转盘共用，2026-11-08；原旋转转盘改为扭蛋机） ----------
   服务端先掷骰，前端只做动画：掉出的球必为服务端 wheel.winnerIndex 对应扇区（球色取该扇区 color），
   球弹开亮出的 emoji＋名字即该扇区，绝不自己决定奖品。
   流程：展示（罩里球轻晃）→ 点“扭一下”→ 机身抖＋摇杆转＋罩里球翻滚（0.9s）→ 球掉进出球口（0.7s）
   → 球弹开亮奖品（0.35s）→ 约 1s 后 onDone（出结果弹窗／回背包）。点任意处（扭一下按钮除外）或“跳过”直接出结果。
   wheelSectorAngles / WHEEL_FALLBACK_COLORS 为旧转盘残留（现仅 showWheel 用过，已无调用），留待日后清理。 */
const WHEEL_FALLBACK_COLORS = ['#F6B73C', '#7C9CD6', '#E58AB8', '#58B368', '#F27A4B', '#8B5BB6', '#3BB273', '#E8B923', '#5DA9E9', '#F25C54'];
function wheelValid(wheel) {
  return !!wheel && Array.isArray(wheel.sectors) && wheel.sectors.length > 0 && wheel.sectors.length <= 20
    && Number.isInteger(wheel.winnerIndex) && wheel.winnerIndex >= 0 && wheel.winnerIndex < wheel.sectors.length;
}
function wheelSectorAngles(sectors) {
  const total = sectors.reduce((a, s) => a + (Number(s.weight) > 0 ? Number(s.weight) : 0), 0) || sectors.length;
  let acc = 0;
  return sectors.map((s) => {
    const w = Number(s.weight) > 0 ? Number(s.weight) : 0;
    const start = (acc / total) * 360; acc += w;
    const end = (acc / total) * 360;
    return { start, end, mid: (start + end) / 2 };
  });
}
function wheelPrizeText(p) {
  if (!p) return '';
  if (p.kind === 'egg') return tr(`转到了 ${esc(p.name)}的蛋！7 天后孵化`, `You got ${esc(p.name)}'s egg! It hatches in 7 days`);
  if (p.kind === 'ball') return tr(`转到了 ${esc(p.name)} ×1！`, `You got ${esc(p.name)} ×1!`);
  return tr(`转到了 ${esc(p.name)}！`, `You got ${esc(p.name)}!`);
}
/* 扭蛋机样式（2026-11-08）：纯 CSS＋DOM，不用视频、不用外部图片；球为 CSS 精灵球（上半彩色＋下半白＋黑带＋白钮）。
   机身固定 280px 宽：罩高 150px、机身约 172px；掉球静止位 bottom:23px（对准出球口中心），改任一高度须同步改该值与 gachaDrop 的 -170px 起落。 */
const GACHA_CSS = `.gacha-wrap{text-align:center}
.gacha-wrap h2{margin:.2em 0 .1em}
.gacha-top{font-size:var(--fs-body);letter-spacing:.3em;line-height:1.5}
.gacha-machine{position:relative;width:280px;max-width:100%;margin:4px auto 0}
.gacha-dome{position:relative;height:150px;border:3px solid #d23c2e;border-bottom:0;border-radius:140px 140px 16px 16px/150px 150px 16px 16px;background:linear-gradient(to bottom,#fefbe9,#ffe9b0);overflow:hidden}
.gacha-dome::after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,rgba(255,255,255,.75) 0%,rgba(255,255,255,.12) 28%,rgba(255,255,255,0) 45%);pointer-events:none}
.gacha-balls{position:absolute;inset:0}
.gacha-ball{position:absolute;border-radius:50%;background:linear-gradient(to bottom,var(--ball-top,#e63b2e) 0 46%,#202020 46% 54%,#fff 54% 100%);animation:gachaBob 2.6s ease-in-out infinite}
.gacha-ball::after{content:'';position:absolute;left:50%;top:50%;width:32%;height:32%;transform:translate(-50%,-50%);background:#fff;border:2px solid #202020;border-radius:50%}
.gacha-balls.gacha-tumbling .gacha-ball{animation:gachaTumble .28s ease-in-out infinite}
.gacha-body{position:relative;background:linear-gradient(to bottom,#ef4b3a,#c62f22);border:3px solid #a32718;border-radius:0 0 18px 18px;padding:8px 12px 10px}
.gacha-crank{width:56px;height:56px;margin:0 auto;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffe08a,#f6b73c 60%,#d18f16);border:3px solid #8a5c0b;position:relative;}
.gacha-crank::before{content:'';position:absolute;left:50%;top:50%;width:38px;height:8px;margin:-4px 0 0 -19px;border-radius:4px;background:#8a5c0b;transform:rotate(45deg)}
.gacha-crank::after{content:'';position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#fefbe9;border:2px solid #8a5c0b}
.gacha-crank.gacha-cranking{animation:gachaCrankSpin .85s ease-in-out}
.gacha-slot{position:relative;margin-top:8px;height:84px;border:3px solid #7a1e12;border-radius:12px;background:#fefbe9}
.gacha-drop{position:absolute;left:50%;bottom:23px;width:64px;height:64px;margin-left:-32px;z-index:3}
.gacha-drop-ball{position:relative;width:64px;height:64px}
.gacha-drop-half{position:absolute;left:0;width:100%;height:50%;transition:transform .35s ease,opacity .35s ease}
.gacha-drop-top{top:0;background:var(--ball-top,#e63b2e);border-bottom:3px solid #202020;border-radius:32px 32px 0 0}
.gacha-drop-bottom{bottom:0;background:#fff;border-top:3px solid #202020;border-radius:0 0 32px 32px}
.gacha-drop-btn{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px 0 0 -9px;background:#fff;border:3px solid #202020;border-radius:50%;transition:opacity .3s ease;z-index:1}
.gacha-drop.gacha-open .gacha-drop-top{transform:translateY(-46px) rotate(-28deg);opacity:0}
.gacha-drop.gacha-open .gacha-drop-bottom{transform:translateY(46px) rotate(28deg);opacity:0}
.gacha-drop.gacha-open .gacha-drop-btn{opacity:0}
.gacha-drop-prize{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(0);opacity:0;transition:transform .35s cubic-bezier(.2,1.6,.4,1),opacity .25s ease;background:#fff;border:2px solid #e8b923;border-radius:14px;padding:6px 12px;box-shadow:var(--shadow-float);max-width:200px;text-align:center;z-index:2}
.gacha-drop-prize .pb-ball{margin:0 auto}
.gacha-drop-prize b{display:block;font-size:16px;font-weight:600;line-height:1.3;margin-top:2px}
.gacha-drop.gacha-open .gacha-drop-prize{transform:translate(-50%,-50%) scale(1);opacity:1}
.gacha-drop.gacha-dropping{animation:gachaDrop .7s cubic-bezier(.3,.7,.4,1) both}
.gacha-machine.gacha-shaking{animation:gachaShake .12s linear infinite}
.gacha-center{margin-top:8px;font-size:16px;color:var(--text-2)}
.wheel-tabs{display:flex;gap:8px;justify-content:center;margin:10px auto 0;max-width:320px}
.wheel-tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:8px 4px 6px;background:var(--bg);border:2px solid var(--line);border-radius:14px;font-family:inherit;cursor:pointer;min-height:64px}
.wheel-tab.on{border-color:var(--orange-d);background:var(--pri-l,#FFE7CC);box-shadow:0 0 0 2px rgba(240,138,36,.25)}
.wheel-tab.off{opacity:.45}
.wheel-tab-ic{font-size:22px;line-height:1}
.wheel-tab-name{font-size:14px;font-weight:600;color:var(--text)}
.wheel-tab-count{font-size:14px;font-weight:600;color:var(--orange-d);background:#fff;border:1.5px solid var(--orange-d);border-radius:999px;min-width:26px;padding:0 6px;line-height:18px;margin-top:auto}/* 任务 117：数量钉在卡片底边（margin-top:auto 吃掉名字换行的高度差），三卡等高故圆章对齐 */
.gacha-twist{margin-top:10px}
.gacha-twist:disabled{opacity:.55;cursor:default}
/* 揭示用精灵球框：复用道馆备战 .pb-ball（与 style.css 同款，预览页内联同款以便独立运行） */
.pb-ball{position:relative;width:52px;height:52px;border-radius:50%;background:linear-gradient(#e5484d 0 46%,#202020 46% 54%,#fff 54% 100%);display:flex;align-items:center;justify-content:center;overflow:hidden}
.pb-ball::after{content:'';position:absolute;width:14px;height:14px;border-radius:50%;background:#fff;border:2px solid #202020;left:50%;top:50%;transform:translate(-50%,-50%)}
.pb-ball img{position:relative;z-index:1;width:44px;height:44px;object-fit:contain}
.pb-star{position:relative;z-index:1;font-size:20px}
@keyframes gachaBob{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-4px) rotate(3deg)}}
@keyframes gachaTumble{0%,100%{transform:translateY(0) rotate(-12deg)}50%{transform:translateY(-7px) rotate(12deg)}}
@keyframes gachaShake{0%,100%{transform:translateX(0) rotate(0)}25%{transform:translateX(-4px) rotate(-1deg)}75%{transform:translateX(4px) rotate(1deg)}}
@keyframes gachaCrankSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
@keyframes gachaDrop{0%{transform:translateY(-170px);opacity:0}10%{opacity:1}70%{transform:translateY(0)}80%{transform:translateY(-14px)}90%{transform:translateY(0)}100%{transform:translateY(0)}}
@media (prefers-reduced-motion:reduce){.gacha-ball,.gacha-machine.gacha-shaking,.gacha-balls.gacha-tumbling .gacha-ball,.gacha-crank.gacha-cranking,.gacha-drop.gacha-dropping{animation:none !important}}`;
function ensureGachaCss() {
  if (document.getElementById('gacha-css')) return;
  const st = document.createElement('style');
  st.id = 'gacha-css';
  st.textContent = GACHA_CSS;
  document.head.appendChild(st);
}
/* 玻璃罩里的球：[left%, top%, 直径px, 顶部色, 轻晃延时s]，固定排布（装饰用，不参与抽奖）。 */
const GACHA_BALLS = [
  [6, 60, 36, '#e63b2e', 0], [22, 66, 40, '#3b82f6', .35], [40, 62, 38, '#f6c945', .7], [58, 64, 40, '#e63b2e', 1.05], [76, 58, 36, '#8b5cf6', .2],
  [14, 38, 34, '#22c55e', .55], [32, 36, 36, '#e63b2e', .9], [50, 34, 34, '#3b82f6', .15], [68, 38, 34, '#f6c945', .45],
  [24, 12, 32, '#8b5cf6', .8], [44, 8, 34, '#e63b2e', .05], [62, 14, 30, '#22c55e', .6],
  [8, 18, 28, '#3b82f6', 1.1], [80, 22, 28, '#f6c945', .25],
];
/* 扭蛋机：揭示后奖品常驻显示（任务 92，不再约 1 秒自动归位），按钮变“再扭一次”可接着抽；
 * 再扭调 onTwist 拿新一轮服务端结果（开抽前先收起上一轮奖品）。没机会时按钮置灰“没有机会了”。
 * onTwist 缺省时为一次性（普通转盘每日抽奖）：揭示后按钮显示 noMoreText 且禁用。
 * onTwist 返回 null/抛错/无合法 wheel 时：按钮置灰显示“没有机会了”，孩子仍可跳过/点其他处关弹窗。
 * onDone 只在孩子主动关弹窗时触发，不再每揭示一次就关。
 * 揭示用 .pb-ball（复用道馆备战样式）放具体奖品图、下面直接写具体宠物名；组名（终极形态/伊布进化）绝不出现。 */
// 统一转盘会话（2026-11-10 重构）：一个扭蛋机页面常驻，切换只换盘数据、不重建界面
// 切盘前是每次点 tab 都调 openWheel → showWheel → showModal 全量重建（罩/球/摇杆/按钮全是新的），
// 实际三个盘共用同一台扭蛋机，只差标题/次数/掷骰接口——现只建一次，切盘就地换数据。
let gachaSession = null;
function showWheel({ sectors, winnerIndex, title, centerText, onDone, onTwist, prizeName, prizeImg, chancesLeft, noMoreText, wheelTabs, wheelKey, wheelApi, childId, resultTitle, gatesOpen }) {
  ensureGachaCss();
  const noMore = noMoreText || tr('没有机会了', 'No chances left');
  const twistLabel = tr('🌀 扭一下', '🌀 Twist!');
  const twistAgainLabel = tr('🔁 再扭一次', '🔁 Twist again');
  // 当前轮次：onTwist 成功后更新（扇区/中奖/具体奖品名图/剩余次数/中部文案）
  // 预览模式（2026-11-10 修“点进转盘即抽”）：winnerIndex 为 null 时先不掷骰，进来看一眼，点“扭一下”才调接口抽
  let cur = { sectors: sectors || [], winnerIndex: (winnerIndex == null ? null : winnerIndex), prizeName: prizeName || null, prizeImg: prizeImg || null, centerText: centerText || '', chancesLeft: (chancesLeft == null ? null : chancesLeft), gatesOpen: !!gatesOpen }; /* 任务 124：放行时 0 次也能扭 */
  // 会话态（统一转盘才用）：curOnTwist 可换（切盘换新盘的掷骰接口）；curWheelKey 可换（当前盘）；
  // sessionPrizes 跨盘累积（关弹窗时一次弹结果，不按盘各弹一次）；sessionResultTitle 跟当前盘走
  const isUnified = Array.isArray(wheelTabs) && wheelTabs.length > 1;
  let curWheelKey = wheelKey;
  let curOnTwist = onTwist;
  const sessionPrizes = [];
  let sessionResultTitle = resultTitle || title || '';
  let sessionLastChances = (chancesLeft == null ? null : chancesLeft);
  // 会话缓存的三盘次数（切盘直接用，不等接口；抽完一次后就地更新）
  const sessionCounts = {};
  (wheelTabs || []).forEach((t) => { sessionCounts[t.key] = t.count || 0; });
  if (isUnified && wheelApi && childId != null) curOnTwist = makeWheelTwist(wheelApi, childId, sessionPrizes, (c) => { sessionLastChances = c; });
  const curWinner = () => (cur.winnerIndex == null ? {} : (cur.sectors[cur.winnerIndex] || {}));
  const curWinColor = () => curWinner().color || '#e63b2e';
  const curWinEmoji = () => curWinner().emoji || '🎁';
  const curWinLabel = () => cur.prizeName || curWinner().label || '';
  const ballsHtml = GACHA_BALLS.map((b) => `<div class="gacha-ball" style="left:${b[0]}%;top:${b[1]}%;width:${b[2]}px;height:${b[2]}px;--ball-top:${b[3]};animation-delay:${b[4]}s"></div>`).join('');
  // 三盘切换（2026-11-10 统一转盘中心）：扭蛋机中部三个可选图标，带剩余次数；点别的盘即切过去转那个盘
  const tabsHtml = (Array.isArray(wheelTabs) && wheelTabs.length > 1) ? `<div class="wheel-tabs" role="tablist">${wheelTabs.map((t) => `<button type="button" role="tab" aria-selected="${t.key === wheelKey}" class="wheel-tab${t.key === wheelKey ? ' on' : ''}${(t.count || 0) <= 0 ? ' off' : ''}" data-wheel="${esc(t.key)}"><span class="wheel-tab-ic">${t.icon || '🎡'}</span><span class="wheel-tab-name">${esc(t.label || '')}</span><span class="wheel-tab-count">${t.count || 0}</span></button>`).join('')}</div>` : '';
  showModal(`<div class="gacha-wrap"><h2>${esc(title || '')}</h2><div class="gacha-top" aria-hidden="true">✨ ⚡ 🔥 💧 🍃 ✨</div><div class="gacha-machine" id="gachaMachine"><div class="gacha-dome"><div class="gacha-balls" id="gachaBalls">${ballsHtml}</div></div><div class="gacha-body"><div class="gacha-crank" id="gachaCrank"></div><div class="gacha-slot" id="gachaSlot"></div></div><div class="gacha-drop" id="gachaDrop" hidden><div class="gacha-drop-ball" id="gachaDropBall" style="--ball-top:${esc(curWinColor())}"><div class="gacha-drop-half gacha-drop-top"></div><div class="gacha-drop-half gacha-drop-bottom"></div><div class="gacha-drop-btn"></div></div><div class="gacha-drop-prize" id="gachaDropPrize"></div></div></div>${tabsHtml}<div class="gacha-center" id="gachaCenter">${esc(cur.centerText)}</div><button class="bigbtn gacha-twist" id="gachaTwist">${twistLabel}</button><button class="bigbtn wheel-skip" id="wheelSkip">${tr('跳过', 'Skip')}</button><div class="wheel-hint">${tr('点“扭一下”开始，点其他处跳过', 'Tap “Twist!” to start, tap elsewhere to skip')}</div></div>`);
  // showModal 自带一个“太棒了！”关闭按钮：扭蛋机有自己的跳过逻辑，关掉它，避免扭一半被关掉丢结果
  const modal = modalRoot.querySelector('.modal');
  const defBtn = modal ? Array.from(modal.children).find((el) => el.classList && el.classList.contains('bigbtn') && el.id !== 'wheelSkip' && el.id !== 'gachaTwist') : null;
  if (defBtn) defBtn.remove();
  const machine = document.getElementById('gachaMachine');
  const ballsEl = document.getElementById('gachaBalls');
  const crank = document.getElementById('gachaCrank');
  const drop = document.getElementById('gachaDrop');
  const dropBall = document.getElementById('gachaDropBall');
  const dropPrize = document.getElementById('gachaDropPrize');
  const centerEl = document.getElementById('gachaCenter');
  const twistBtn = document.getElementById('gachaTwist');
  let done = false;       // 弹窗已关，后续定时器一律 no-op
  let busy = false;       // 摇奖/揭示/归位进行中，按钮禁用
  let revealed = false;   // 当前轮次已揭示过（归位后下一次点按即再扭）
  let exhausted = false;  // 已无机会，按钮永久置灰
  const finish = () => {
    if (done) return;
    done = true;
    if (isUnified) gachaSession = null; // 会话结束
    if (isUnified) {
      // 统一转盘：用会话里跨盘累积的奖品弹一次结果，再回背包；没抽过直接回背包（不弹空结果）
      if (!sessionPrizes.length) { closeModal(); goBackpack(childId); return; }
      const text = sessionPrizes.map((p) => wheelPrizeText(p)).join('<br>') + ((sessionLastChances != null && sessionLastChances > 0) ? `<br>${tr(`还剩 ${sessionLastChances} 次机会`, `${sessionLastChances} chances left`)}` : '');
      const lastImg = [...sessionPrizes].reverse().find((p) => p && p.img)?.img || null;
      celebrate(sessionResultTitle, lastImg, text);
      goBackpack(childId);
      return;
    }
    if (typeof onDone === 'function') onDone();
  };
  const skipToEnd = () => { if (done) return; finish(); };
  document.getElementById('wheelSkip').addEventListener('click', (e) => { e.stopPropagation(); skipToEnd(); });
  // 三盘切换（2026-11-10 重构）：点别的盘即在同一扭蛋机里换盘数据，不重建界面、不关弹窗
  if (Array.isArray(wheelTabs) && wheelTabs.length > 1) {
    const tabsEl = modalRoot.querySelector('.wheel-tabs');
    if (tabsEl) tabsEl.addEventListener('click', (e) => {
      const btn = e.target && e.target.closest ? e.target.closest('.wheel-tab') : null;
      if (!btn || btn.disabled) return;
      e.stopPropagation();
      const t = wheelTabs.find((x) => x.key === btn.getAttribute('data-wheel'));
      if (!t || t.key === curWheelKey || typeof t.onSelect !== 'function') return;
      if (busy) return;
      t.onSelect(); // openWheel 见会话已开会走 switchWheel 就地换盘，不重开 showModal
    });
  }
  if (modal) modal.addEventListener('click', (e) => { if (e.target && e.target.closest && e.target.closest('#gachaTwist')) return; skipToEnd(); }); // 点扭蛋机任意处跳过（扭一下按钮除外）
  const overlay = modalRoot.querySelector('.overlay');
  if (overlay) overlay.addEventListener('click', (e) => { if (e.target === overlay) skipToEnd(); }); // 点卡片外空白处（遮罩）也离开
  // 揭示：球里放具体奖品图（无图回退 emoji），下面直接写具体宠物名
  const renderPrize = () => {
    const img = cur.prizeImg || itemIconUrl(curWinner().key); // 任务 72：无服务端图时用道具图标（奖品 key 映射）
    const emoji = curWinEmoji();
    const name = curWinLabel();
    dropPrize.innerHTML = `<span class="pb-ball">${img ? `<img loading="lazy" src="${esc(img)}" alt="">` : `<span class="pb-star">${esc(emoji)}</span>`}</span><b>${esc(name)}</b>`;
    const pimg = dropPrize.querySelector('img');
    if (pimg) pimg.addEventListener('error', () => { pimg.outerHTML = `<span class="pb-star">${esc(emoji)}</span>`; });
  };
  // 归位（任务 92）：keepPrize 为真时奖品常驻显示（出球口卡片不收、奖品名图留着），按钮变“再扭一次”；
  // 为假时掉出的球与奖品消失（切盘/初始态）。其余一律复位：罩里球回轻晃、摇杆复位、再按剩余机会决定按钮状态。
  const resetMachine = (keepPrize) => {
    if (done) return;
    if (!keepPrize) {
      drop.hidden = true;
      drop.classList.remove('gacha-open', 'gacha-dropping');
      dropPrize.innerHTML = '';
    }
    machine.classList.remove('gacha-shaking');
    ballsEl.classList.remove('gacha-tumbling');
    crank.classList.remove('gacha-cranking');
    if (centerEl) centerEl.textContent = cur.centerText;
    busy = false;
    if (typeof curOnTwist !== 'function') { // 一次性（普通转盘每日抽奖）：无再扭，按钮置灰
      exhausted = true;
      twistBtn.disabled = true;
      twistBtn.textContent = noMore;
      return;
    }
    if (cur.chancesLeft != null && cur.chancesLeft <= 0 && !cur.gatesOpen) { // 机会已用完（放行时可继续扭）
      exhausted = true;
      twistBtn.disabled = true;
      twistBtn.textContent = noMore;
      return;
    }
    twistBtn.disabled = false;
    twistBtn.textContent = keepPrize ? twistAgainLabel : twistLabel;
  };
  const playTwist = () => {
    // 新一轮开抽：先收起上一轮的奖品（常驻显示的那张），机器回到待抽状态
    drop.hidden = true;
    drop.classList.remove('gacha-open', 'gacha-dropping');
    dropPrize.innerHTML = '';
    if (REDUCED_MOTION()) { // 减动效：不摇不掉，直接亮奖品，奖品常驻、按钮变“再扭一次”
      drop.hidden = false;
      drop.classList.add('gacha-open');
      renderPrize();
      setTimeout(() => { if (!done) resetMachine(true); }, 1000);
      return;
    }
    machine.classList.add('gacha-shaking');
    ballsEl.classList.add('gacha-tumbling');
    crank.classList.add('gacha-cranking');
    setTimeout(() => { // 摇完：球掉进出球口
      if (done) return;
      machine.classList.remove('gacha-shaking');
      ballsEl.classList.remove('gacha-tumbling');
      drop.hidden = false;
      void drop.offsetWidth; // 强制重排，掉落动画必从头跑
      drop.classList.add('gacha-dropping');
    }, 900);
    setTimeout(() => { // 球落地：弹开亮奖品（必为服务端定的 winner，具体名图优先）
      if (done) return;
      drop.classList.remove('gacha-dropping');
      drop.classList.add('gacha-open');
      renderPrize();
    }, 1650);
    setTimeout(() => { if (!done) resetMachine(true); }, 2650); // 揭示后奖品常驻、按钮变“再扭一次”
  };
  const startTwist = async () => {
    if (busy || done || exhausted) return;
    if (revealed || cur.winnerIndex == null) { // 归位后或预览模式（还没抽过）：先拿一轮服务端结果，再跑动画
      if (typeof curOnTwist !== 'function') return;
      busy = true;
      twistBtn.disabled = true;
      let r = null;
      try { r = await curOnTwist(); } catch (_) { r = null; }
      if (done) return;
      if (!r || !wheelValid({ sectors: r.sectors, winnerIndex: r.winnerIndex })) { // 无机会/报错：按钮置灰“没有机会了”，仍可跳过关弹窗
        exhausted = true;
        busy = false;
        twistBtn.disabled = true;
        twistBtn.textContent = noMore;
        return;
      }
      cur = { sectors: r.sectors, winnerIndex: r.winnerIndex, prizeName: r.prizeName || null, prizeImg: r.prizeImg || null, centerText: (r.chancesLeft != null ? tr(`还剩 ${r.chancesLeft} 次`, `${r.chancesLeft} chances left`) : cur.centerText), chancesLeft: (r.chancesLeft == null ? null : r.chancesLeft) };
      if (dropBall) dropBall.style.setProperty('--ball-top', curWinColor());
      if (centerEl) centerEl.textContent = cur.centerText;
      // 同步当前盘 tab 上的次数显示（抽完机会数变了），会话缓存也更新
      if (isUnified) {
        sessionCounts[curWheelKey] = cur.chancesLeft;
        const activeTabBtn = modalRoot.querySelector(`.wheel-tab[data-wheel="${curWheelKey}"]`);
        if (activeTabBtn) {
          activeTabBtn.classList.toggle('off', (cur.chancesLeft || 0) <= 0);
          const cEl = activeTabBtn.querySelector('.wheel-tab-count');
          if (cEl) cEl.textContent = cur.chancesLeft;
        }
      }
    }
    busy = true;
    revealed = true;
    twistBtn.disabled = true;
    playTwist();
  };
  twistBtn.addEventListener('click', (e) => { e.stopPropagation(); startTwist(); });
  // 切盘（2026-11-10 重构）：只换盘数据，不重建界面——标题/中心文案/次数/掷骰接口/选中态就地更新，
  // 扭蛋机本体（罩/球/摇杆/出球口/扭一下/跳过/提示）不动；奖品仍进共用的 sessionPrizes，关弹窗时一次弹结果
  const switchWheel = (next) => {
    if (done || busy) return;
    const { wheelKey: nextKey, cfg } = next || {};
    if (!cfg || !nextKey || nextKey === curWheelKey) return;
    const myCount = sessionCounts[nextKey] || 0; // 用会话缓存的次数，切盘不等接口、即时生效
    curWheelKey = nextKey;
    sessionResultTitle = cfg.resultTitle;
    curOnTwist = makeWheelTwist(cfg.api, childId, sessionPrizes, (c) => { sessionLastChances = c; });
    cur = { sectors: [], winnerIndex: null, prizeName: null, prizeImg: null, centerText: tr(`还剩 ${myCount} 次`, `${myCount} chances left`), chancesLeft: myCount };
    const h2 = modalRoot.querySelector('.gacha-wrap h2');
    if (h2) h2.textContent = cfg.title;
    if (dropBall) dropBall.style.setProperty('--ball-top', curWinColor());
    if (centerEl) centerEl.textContent = cur.centerText;
    revealed = false;
    const tabsEl = modalRoot.querySelector('.wheel-tabs');
    if (tabsEl) tabsEl.querySelectorAll('.wheel-tab').forEach((b) => {
      const k = b.getAttribute('data-wheel');
      b.classList.toggle('on', k === nextKey);
      b.classList.toggle('off', (sessionCounts[k] || 0) <= 0);
      b.setAttribute('aria-selected', k === nextKey ? 'true' : 'false');
      const cEl = b.querySelector('.wheel-tab-count');
      if (cEl) cEl.textContent = sessionCounts[k] || 0;
    });
    resetMachine();
  };
  if (isUnified) gachaSession = { childId, isOpen: () => !done, switchWheel };
}
/* ---------- 统一转盘中心（2026-11-10）：三盘共用扭蛋机，入口唯一在大木博士之家 ---------- */
// 造一个“扭一下”掷骰函数：调指定盘的 spin 接口，奖品 push 进共用的 prizes（跨盘累积），机会数回写
function makeWheelTwist(endpoint, childId, prizes, onChances) {
  return async () => {
    let r = null;
    try { r = await api(endpoint, { childId }); } catch (_) { return null; }
    if (!r || !r.ok) {
      if (r && r.error) alert(r.error);
      return null;
    }
    if (!wheelValid(r.wheel)) return null;
    prizes.push(r.prize);
    if (typeof onChances === 'function') onChances(r.chancesLeft);
    // 任务 92 根因：winnerIndex 在服务端响应里是 r.wheel.winnerIndex（与 sectors 同级），不是顶层 r.winnerIndex；
    // 之前误读 r.winnerIndex 得 undefined，startTwist 的 wheelValid 恒失败，抽奖永远走“没有机会了”早退、
    // playTwist 从不跑、奖品从不在机器里亮（服务端其实已扣次发奖，退出时 celebrate 才看得到）。
    return { sectors: r.wheel.sectors, winnerIndex: r.wheel.winnerIndex, chancesLeft: r.chancesLeft, prizeName: r.prize.name, prizeImg: r.prize.img || null };
  };
}
// 取三盘剩余次数（背包接口一次返回三项）
async function fetchWheelCounts(childId) {
  try {
    const j = await api('/api/evo/backpack?childId=' + childId);
    if (!j || !j.ok) return { advanced: 0, rare: 0, nurture: 0, gatesOpen: false };
    return { advanced: j.wheelChances || 0, rare: j.rareWheelChances || 0, nurture: j.careWheelChances || 0, gatesOpen: !!j.gatesOpen };
  } catch (_) {
    return { advanced: 0, rare: 0, nurture: 0, gatesOpen: false };
  }
}
// 三盘切换图标（扭蛋机中部）：点别的盘即切过去看那个盘（只进预览，不抽）；0 次的盘置灰不可点
function wheelTabsFor(childId, counts) {
  return [
    { key: 'advanced', label: tr('高级转盘', 'Advanced Wheel'), icon: '🎯', count: counts.advanced || 0, onSelect: () => openWheel('advanced', childId) },
    { key: 'rare', label: tr('稀有转盘', 'Rare Wheel'), icon: '✨', count: counts.rare || 0, onSelect: () => openWheel('rare', childId) },
    { key: 'nurture', label: tr('养成转盘', 'Nurture Wheel'), icon: '🎡', count: counts.nurture || 0, onSelect: () => openWheel('nurture', childId) },
  ];
}
// 进转盘（2026-11-10 修“点进转盘即抽”）：先进预览看一眼，点“扭一下”才调接口掷骰；三次接口共用一套
// countsArg：调用方已取过三盘次数时直接传，省一次背包接口（转盘中心入口已取过，不再取第二遍）
async function openWheel(wheelKey, childId, countsArg) {
  const id = Number(childId);
  if (lcAvailable() && lcNetOff()) { alert(tr('现在没网，转盘等联网后再转哦', "You're offline, spin the wheels once you're back online")); return; }
  const cfg = {
    advanced: { api: '/api/evo/wheel/spin', title: tr('高级转盘', 'Advanced Wheel'), resultTitle: tr('高级转盘结果', 'Advanced Wheel result') },
    rare: { api: '/api/rare-wheel/spin', title: tr('稀有转盘', 'Rare Wheel'), resultTitle: tr('稀有转盘结果', 'Rare Wheel result') },
    nurture: { api: '/api/care-wheel/spin', title: tr('养成转盘', 'Nurture Wheel'), resultTitle: tr('养成转盘结果', 'Nurture Wheel result') },
  }[wheelKey];
  if (!cfg) return;
  // 会话已开：立即切盘（用会话缓存的次数，不等接口），不重建界面
  if (gachaSession && gachaSession.isOpen()) {
    gachaSession.switchWheel({ wheelKey, cfg });
    return;
  }
  const counts = countsArg || await fetchWheelCounts(id);
  const myCount = counts[wheelKey] || 0;
  // 不管有没有次数都进得来（2026-11-10 用户纠正）：先进预览，点“扭一下”没次数时再弹提示
  // 奖品/结果汇总由 showWheel 的会话持有（跨盘累积，关弹窗时一次弹结果）
  showWheel({ sectors: [], winnerIndex: null, title: cfg.title, centerText: tr(`还剩 ${myCount} 次`, `${myCount} chances left`), chancesLeft: myCount, wheelTabs: wheelTabsFor(id, counts), wheelKey, wheelApi: cfg.api, childId: id, resultTitle: cfg.resultTitle, gatesOpen: !!counts.gatesOpen });
}
window.openWheel = openWheel;
// 旧 spin 入口改走 openWheel（预览模式，不再一点即抽）
async function spinWheel(id) { return openWheel('advanced', id); }
window.spinWheel = spinWheel;
async function spinRareWheel(id) { return openWheel('rare', id); }
window.spinRareWheel = spinRareWheel;
async function spinCareWheel(id) { return openWheel('nurture', id); }
window.spinCareWheel = spinCareWheel;
// 转盘中心入口（唯一入口，大木博士之家）：不要中间页，直接进扭蛋机页、在里面用三图标选盘
// 默认进次数最多的盘；全 0 时默认养成盘（最常得）
// 2026-11-11 修“要点两次才开”：取过一次的次数直接传给 openWheel，不再取第二遍；加载期间按钮置灰＋显示“正在打开…”，防重复点
async function openWheelDefault(childId, btn) {
  const id = Number(childId);
  const el = btn && btn.tagName === 'BUTTON' ? btn : null;
  const oldHtml = el ? el.innerHTML : null;
  if (el) { el.disabled = true; el.innerHTML = tr('正在打开…', 'Opening…'); }
  try {
    const counts = await fetchWheelCounts(id);
    let key = 'nurture';
    let best = -1;
    for (const k of ['advanced', 'rare', 'nurture']) {
      const c = counts[k] || 0;
      if (c > best) { best = c; key = k; }
    }
    return await openWheel(key, id, counts);
  } finally {
    if (el && oldHtml != null) { el.innerHTML = oldHtml; el.disabled = false; }
  }
}
window.openWheelDefault = openWheelDefault;
async function childSwitchLine(lineKey) {
  const id = window._bp.childId;
  const j = await api('/api/child/switch-line', { childId: id, line: lineKey });
  if (!j.ok) { alert(j.error || tr('切换失败', 'Switch failed')); return; }
  alert(tr(`已换成${j.lineLabel || ''}，等级和经验保留`, `Switched to ${j.lineLabel || ''}, level and XP kept`));
  goBackpack(id);
}
window.childSwitchLine = childSwitchLine;

/* ---------- 家长端 ---------- */
function goParent() {
  careRoomUnmount(); // 离开养成页先卸掉房间
  setArea('parent');
  if (state.pinOk) { renderParent(); return; }
  let pin = '';
  function draw(err) {
    const d = document.getElementById('pindots');
    if (d) {
      d.innerHTML = [0, 1, 2, 3].map((i) => `<i class="dot${!err && i < pin.length ? ' on' : ''}"></i>`).join('');
      d.className = err ? 'pindots err' : 'pindots';
    }
  }
  window.pinKey = (k) => {
    const m = document.getElementById('pinmsg');
    if (m) m.textContent = '';
    if (k === 'C') pin = ''; else if (k === '⌫') pin = pin.slice(0, -1); else if (pin.length < 4) pin += k;
    draw(false);
    if (pin.length === 4) submitPin(pin);
  };
  // 供 submitPin 输错时调用：清掉闭包里的旧值与圆点（只留报错文案）
  window.pinReset = () => { pin = ''; draw(false); };
  window.pinErrorShow = () => {
    pin = '';
    draw(true);
    setTimeout(() => { if (pin === '') draw(false); }, 750);
  };
  app.innerHTML = `
  <div class="topbar"><button class="iconbtn" onclick="goHome2()">‹ 首页</button><div class="title">家长入口</div><span></span></div>
  <div class="card" style="text-align:center"><h2>输入家长密码</h2>
  <div class="pindots" id="pindots"><i class="dot"></i><i class="dot"></i><i class="dot"></i><i class="dot"></i></div><div id="pinmsg" style="color:var(--danger-text);min-height:22px"></div>
  <div class="pinpad">${['1', '2', '3', '4', '5', '6', '7', '8', '9', 'C', '0', '⌫'].map((k) => `<button onclick="pinKey('${k}')">${k}</button>`).join('')}</div></div>`;
}
async function submitPin(pin) {
  const j = await api('/api/parent/verify-pin', { pin });
  if (j.ok) { state.pinOk = true; state.needPin = false; state.sessionKind = 'parent'; state.sessionChildId = null; renderParent(); return; }
  const msg = document.getElementById('pinmsg');
  if (j.error === 'PIN_LOCKED') {
    msg.textContent = `试太多次啦，${Math.ceil((j.retryAfter || 300) / 60)} 分钟后再试`;
    if (window.pinReset) window.pinReset();
  } else {
    msg.textContent = '密码不对，再试一次';
    // 输错：值与圆点都清掉，只留报错文案。旧实现只清圆点、submitPin 的参数 pin = '' 清不到
    // goParent 闭包里的旧值，下一次按键会被旧值吞掉（须手动删 4 次才能重输）。
    if (window.pinErrorShow) window.pinErrorShow();
    else if (window.pinReset) window.pinReset();
  }
}
async function goHome2() {
  // 孩子会话直接进自己的空间，不展示双孩首页
  if (state.sessionKind === 'child' && state.sessionChildId) { goChild(state.sessionChildId); return; }
  if (lcAvailable()) {
    try {
      var idsRaw = localStorage.getItem('sm.childIds.v1');
      var ids = idsRaw ? JSON.parse(idsRaw) : [];
      if (Array.isArray(ids) && ids.length) {
        var snaps = await Promise.all(ids.map(function (cid) { return lcSnapshot(cid); }));
        if (snaps.length && snaps.every(function (s) { return s && s.complete; })) {
          state.overview = lcOverviewFromSnapshots(snaps);
          state.view = 'home';
          renderHome();
          ids.forEach(function (cid) { lcSyncChild(cid, { rerender: true }).catch(function () {}); });
          return;
        }
      }
    } catch (e) {}
  }
  await loadOverview(false);
  // 孩子会话直接进自己的空间，不展示双孩首页
  if (state.sessionKind === 'child' && state.sessionChildId) { goChild(state.sessionChildId); return; }
  state.view = 'home';
  renderHome();
  try { localStorage.setItem('sm.childIds.v1', JSON.stringify((state.overview && state.overview.children || []).map(function (c) { return c.id; }))); } catch (e) {}
  (state.overview && state.overview.children || []).forEach(function (c) { lcSyncChild(c.id, { rerender: false }).catch(function () {}); });
}
/* 孩子主页「‹ 首页」：孩子会话回选人入口（清会话，换人需重新输密码，防兄弟串门）；
   家长会话沿用 goHome2 回双孩首页。2026-10-20 热修：原实现孩子点首页原地打转、无出口。 */
async function goHomeBtn() {
  if (state.sessionKind === 'child') { await api('/api/logout', {}); clearAllCaches(); location.href = '/login'; return; }
  goHome2();
}

/* 111: 家长面板 chrome（顶栏＋四个 tab），设置页的壳与实数共用一份，避免两处写叉。 */
function parentChromeHtml(tab, body) {
  return `
  <div class="topbar"><button class="iconbtn" onclick="pinLogout()">退出家长</button><div class="title">家长面板</div><span></span></div>
  <div class="ptabs">
    ${[['reviews', 'inbox', '审核'], ['stats', 'chart', '统计'], ['history', 'folder', '历史'], ['settings', 'settings', '设置']].map(([t, e, l]) =>
      `<button class="ptab ${tab === t ? 'on' : ''}" onclick="parentTab('${t}')"><span class="pt-e">${ic(e)}</span><span class="pt-l">${l}</span></button>`).join('')}
  </div>${body}`;
}
/* 111: 设置页的壳——上次缓存的设置（有就真值、无就灰化开关）。读顺序：内存 → localStorage → 灰化。 */
function readCachedSettings() {
  if (state.settings) return state.settings;
  try { const raw = JSON.parse(localStorage.getItem('sm.settings.v1')); if (raw && typeof raw === 'object') return raw; } catch (e) {}
  return null;
}
function parentSettingsShellHtml() {
  if (state.psetDetail) return `<button class="pset-back" onclick="psetBack()">‹ 返回设置</button><div class="card"><p class="muted">${tr('加载中…', 'Loading…')}</p></div>`;
  const cached = readCachedSettings();
  if (cached) return parentSettingsListHtml(cached);
  return parentSettingsListHtml({ careEnabled: false, oakAssess: true, englishMode: false, testMode: false }, true);
}
let _psetSeq = 0;
async function renderParent() {
  setArea('parent');
  if (!state.pinOk) { state.needPin = false; goParent(); return; }
  const tab = state.parentTab;
  // 111: 设置页先画壳、数据到了再填——切 tab 不再等接口（之前等 /api/parent/settings，
  // 网络一卡就 4-5 秒无反馈、偶尔 60 秒+不渲染）。数据回来只在内容变了时才换体
  // （缓存命中则不闪，也不会吞掉正在点的开关）；序号码防旧请求覆盖新壳。
  if (tab === 'settings') {
    const seq = ++_psetSeq;
    app.innerHTML = parentChromeHtml(tab, `<div id="pset-body">${parentSettingsShellHtml()}</div>`);
    parentRenderDepth++;
    let body = '';
    try { body = await parentSettingsHtml(); } catch (e) { body = ''; }
    parentRenderDepth--;
    if (state.needPin || !state.pinOk) { state.needPin = false; goParent(); return; }
    if (state.parentTab !== 'settings' || seq !== _psetSeq) return;
    const host = document.getElementById('pset-body');
    if (!host) return;
    if (!body) {
      // 接口两次都失败：壳留在原地，补一条重试入口（不再是一片空白）
      host.insertAdjacentHTML('beforeend', `<div class="card"><button class="bigbtn ghost" onclick="renderParent()">${tr('设置没加载出来，点我重试', 'Settings failed to load — tap to retry')}</button></div>`);
      return;
    }
    if (host.innerHTML !== body) host.innerHTML = body;
    return;
  }
  let body = '';
  parentRenderDepth++;
  try {
    if (tab === 'reviews') body = await parentReviewsHtml();
    else if (tab === 'stats') body = await parentStatsHtml();
    else if (tab === 'history') body = await parentHistoryHtml();
  } finally {
    parentRenderDepth--;
  }
  if (state.needPin || !state.pinOk) { state.needPin = false; goParent(); return; }
  // 2026-10-27 用户定：抽奖入口横幅撤掉（不固定在每个界面、不要广告标签感）；
  // 上传成绩入口改放孩子端（伙伴页），家长审批仍在审核 tab。
  app.innerHTML = parentChromeHtml(tab, body);
}
window.parentTab = (t) => { state.parentTab = t; state.psetDetail = null; renderParent(); };
window.psetOpen = (key) => { state.psetDetail = key; renderParent(); };
window.psetBack = () => { state.psetDetail = null; renderParent(); };
async function pinLogout() { await api('/api/logout', {}); state.pinOk = false; state.sessionKind = null; clearAllCaches(); location.href = '/login'; }
window.pinLogout = pinLogout;

async function decideRematch(id, approve) {
  const j = await api('/api/parent/pvp-rematch/decide', { id, approve });
  if (!j.ok) { alert(j.error || '处理失败'); return; }
  renderParent();
}
window.decideRematch = decideRematch;

async function parentRematchCardHtml() {
  const j = await api('/api/parent/pvp-rematch');
  if (!j.ok || !j.rematch || j.rematch.status === 'none') return '';
  const r = j.rematch;
  const who = esc(r.requesterName || '孩子');
  if (r.status === 'pending') {
    return `<div class="card" style="border:2px solid var(--orange)">
      <div class="sc-head"><b style="font-size:var(--fs-body)">${ic('swords')} 兄弟对战 再来一局申请</b></div>
      <p style="margin:8px 0">${who} 申请本周再打一场兄弟对战（批准后解锁一场，不改已决出的周冠军）。</p>
      <div class="rowbtns">
        <button class="smallbtn" onclick="decideRematch(${j.requestId}, false)">驳回</button>
        <button class="smallbtn primary" onclick="decideRematch(${j.requestId}, true)">批准再来一局</button>
      </div></div>`;
  }
  const label = { approved: ic('checkcircle') + ' 已批准再来一局（还没打）', rejected: '已驳回本周的再来一局申请', consumed: '本周的再来一局已经打完啦' }[r.status];
  return label ? `<div class="card"><b>${ic('swords')} 兄弟对战 再来一局</b><div style="margin-top:6px;color:var(--text-2)">${label}（${who} 申请）</div></div>` : '';
}

// 打卡历史奖励下拉菜单（2026-11-03）：仅已通过记录可奖，每条限 1 次（不分奖品，服务端以发球记录＋统一标记兜底）
// 选奖品后先弹确认框（孩子名＋对应打卡记录＋奖品名），确认后才发放、成功后原地变“已奖励”牌
async function grantHistoryReward(sel) {
  const kind = sel.value;
  if (!kind) return;
  const label = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : kind;
  const cn = sel.dataset.cn || '孩子';
  const sub = sel.dataset.sub || '';
  const when = [sel.dataset.date || '', sel.dataset.time || ''].filter(Boolean).join(' ');
  const ok = await askConfirm(`给${cn}的「${sub}${when ? ' ' + when : ''}」打卡记录奖励${label}？`, '确认奖励');
  if (!ok) { sel.selectedIndex = 0; return; }
  sel.disabled = true;
  const j = await api('/api/parent/history/grant', { childId: Number(sel.dataset.child), checkinId: Number(sel.dataset.checkin), kind });
  if (j.ok) {
    const nm = (j.grant && j.grant.name) || label;
    sel.outerHTML = '<span class="pill approved">' + ic('gift') + ' 已奖励 ' + esc(nm) + '</span>';
    if (kind === 'ball') alert(`已奖励普通精灵球，现在有 ${j.balls} 颗`);
    else if (kind === 'xp') alert(`已奖励经验+20，现在共 ${j.totalXp} 经验`);
    else alert(`已奖励${nm}×1`);
    return;
  }
  if (j.error === 'ALREADY_REWARDED') { sel.outerHTML = '<span class="pill approved">' + ic('gift') + ' 已奖励</span>'; return; }
  sel.disabled = false; sel.selectedIndex = 0;
  alert(j.error || '奖励失败');
}
window.grantHistoryReward = grantHistoryReward;

async function parentReviewsHtml() {
  const j = await api('/api/parent/pending');
  if (!j.ok) return '<div class="card">加载失败</div>';
  const rmHtml = await parentRematchCardHtml();
  const st = j.schoolTests || [];
  if (!j.reviews.length && !st.length) return rmHtml + '<div class="empty"><div class="empty-e">' + ic('sparkles') + '</div>没有待审核的打卡，<br>孩子交一科，这里就会出现一科。</div>';
  // 孩子上报的学校成绩（2026-10-27：入口移到孩子端，审批仍在这里）
  const stHtml = st.map((r) => `<div class="card">
    <div class="sc-head"><b style="font-size:var(--fs-body)">${esc(r.childName)}</b><span class="sc-name" style="font-size:22px">${esc(r.subject)}</span><span class="pill pending">成绩待审核</span></div>
    <div style="color:var(--text-2);font-size:var(--fs-parent-body)">${esc(r.unit)} ${r.score}/${r.fullScore}（${r.pct} 分） ${esc(r.examDate)}</div>
    ${r.hasPhoto ? `<div class="thumbs"><div class="thumb"><img loading="lazy" src="/api/parent/school-photo/${r.id}" onclick="viewPhoto('/api/parent/school-photo/${r.id}')"></div></div>` : ''}
    <div style="color:var(--text-2);font-size:var(--fs-parent-body)">${r.hasPhoto ? '先看照片再决定；通过后 85+ 自动发普通奖励（普通球／经验+20／回血药三选一），95+ ＋照片得高级转盘机会。' : '没传照片（95+ ＋照片才能得转盘机会）；通过后 85+ 自动发普通奖励。'}</div>
    <div class="rowbtns">
      <button class="smallbtn primary" onclick="reviewSchoolTest(${r.id},'approve')">通过</button>
      <button class="smallbtn danger" onclick="reviewSchoolTest(${r.id},'reject')">驳回</button>
    </div></div>`).join('');
  return rmHtml + stHtml + j.reviews.map((r) => `<div class="card">
    <div class="sc-head"><b style="font-size:var(--fs-body)">${esc(r.childName)}</b><span class="sc-name" style="font-size:22px">${esc(r.subject)}</span>
    ${r.isEarly ? '<span class="pill approved">' + ic('zap') + ' 早交</span>' : ''}</div>
    <div style="color:var(--text-2);font-size:var(--fs-parent-body)">${r.date} ${esc(r.submittedAt)} 提交</div>
    ${r.note ? `<div class="note">${ic('pencil')} ${esc(r.note)}</div>` : ''}
    ${r.photos && r.photos.length ? `<div class="thumbs">${r.photos.map((p) => `<div class="thumb"><img loading="lazy" src="/api/photos/${p.id}" onclick="viewPhoto('/api/photos/${p.id}')"></div>`).join('')}</div><div style="color:var(--text-2);font-size:var(--fs-parent-body)">点图看大图</div>` : ''}
    <div class="rowbtns">
      <button class="smallbtn primary" onclick="reviewAct(${r.id},'approve')">通过</button>
      <button class="smallbtn" onclick="reviewAdjust(${r.id})">改经验</button>
      <button class="smallbtn danger" onclick="reviewReject(${r.id})">驳回</button>
    </div></div>`).join('');
}
async function doReview(id, decision, extra) {
  const payload = { checkinId: id, decision, ...(extra || {}) };
  const j = await api('/api/parent/review', payload);
  if (!j.ok) { alert(j.error || '审核失败'); return; }
  if (j.approved) {
    let msg = `${j.subject ? '「' + j.subject + '」' : ''}+${j.xpAwarded} 经验${j.isEarly ? '（含早交 ×1.2）' : ''}`;
    if (j.levelsGained.length) msg += `，升到 Lv.${j.newLevel}`;
    if (j.newMoves.length) msg += `，学会：${j.newMoves.map((m) => m.name).join('、')}`;
    if (j.evolved) msg += `，进化成 ${j.evolved.to}！`;
    if (j.streakBox) msg += `，连击 ${j.streak} 天开箱 +${j.bonusXp}`;
    if (j.encounter) msg += `，触发野外遭遇：${j.encounter.name}`;
    alert('审核通过：' + msg);
  }
  await loadOverview(false);
  renderParent();
}
window.reviewAct = (id, d) => doReview(id, d);
window.reviewAdjust = async (id) => {
  const v = await askPrompt({ label: '这次给多少经验？（整数）', inputType: 'number' });
  if (v === null) return;
  await doReview(id, 'adjust', { adjustedXp: Number(v) });
};
window.reviewReject = async (id) => {
  const reason = await askPrompt({ label: '驳回理由（孩子能看到）：', initialValue: '作业还没全部完成', okText: '驳回' });
  if (reason === null) return;
  await doReview(id, 'reject', { reason });
};
/* 孩子上报的学校成绩审核（通过：激活＋按同一口径记高级转盘机会；驳回：标记已驳回） */
async function reviewSchoolTest(id, decision) {
  const j = await api('/api/parent/school-test/review', { recordId: id, decision });
  if (!j.ok) { alert(j.error || '审核失败'); return; }
  if (j.approved) {
    alert((j.wheelChance ? '已通过，获得 1 次高级转盘机会！' : '已通过' + (j.wheelReason ? '（' + j.wheelReason + '）' : '')) + (j.ordinary && j.ordinary.granted ? '，普通奖励：' + (j.ordinary.granted.name || j.ordinary.granted.key) : ''));
  } else {
    alert('已驳回');
  }
  await loadOverview(false);
  renderParent();
}
window.reviewSchoolTest = reviewSchoolTest;

async function parentStatsHtml() {
  const j = await api('/api/parent/stats');
  if (!j.ok) return '<div class="card">加载失败</div>';
  return `<div class="card"><h2>打卡统计（${j.today}）</h2><table>
  <tr><th>孩子</th><th>本周(天)</th><th>本月(天)</th><th>累计(天)</th><th>等级/连击</th></tr>
  ${j.stats.map((s) => `<tr><td>${esc(s.name)}</td><td>${s.weekApproved}</td><td>${s.monthApproved}</td><td>${s.totalApproved}</td><td>Lv.${s.level} / ${ic('flame')} ${s.streak}</td></tr>`).join('')}
  </table></div>`;
}
async function parentHistoryHtml() {
  const j = await api('/api/parent/history');
  if (!j.ok) return '<div class="card">加载失败</div>';
  const label = { pending: '待审核', approved: '已通过', rejected: '已驳回' };
  return `<div class="card"><h2>打卡历史</h2>${j.history.length ? j.history.map((h) => `
    <div style="border-bottom:0.5px solid var(--line);padding:8px 0">
      <b>${esc(h.childName)}</b> <b>${esc(h.subject)}</b> ${h.date} ${esc(h.submittedAt)}
      <span class="pill ${h.status}">${label[h.status]}${h.status === 'approved' ? ' +' + h.xp : ''}</span>
      ${h.isEarly ? ' ' + ic('zap') : ''}${h.photos && h.photos.length ? ` ${ic('camera')}×${h.photos.length}` : ''}
      ${h.note ? `<br><span style="color:var(--text-2)">${ic('pencil')} ${esc(h.note)}</span>` : ''}
      ${h.photos && h.photos.length ? `<div class="thumbs" style="margin-top:6px">${h.photos.map((p) => `<div class="thumb"><img loading="lazy" src="/api/photos/${p.id}" onclick="viewPhoto('/api/photos/${p.id}')"></div>`).join('')}</div>` : ''}
      ${h.reason ? `<br><span style="color:var(--danger-text)">理由：${esc(h.reason)}</span>` : ''}
      ${h.status === 'approved' ? (h.rewarded ? ` <span class="pill approved">${ic('gift')} 已奖励${h.rewardedName ? ' ' + esc(h.rewardedName) : ''}</span>` : ` <select class="smallbtn" data-checkin="${h.id}" data-child="${h.childId}" data-cn="${esc(h.childName)}" data-sub="${esc(h.subject)}" data-date="${esc(h.date)}" data-time="${esc(h.submittedAt)}" onchange="grantHistoryReward(this)"><option value="" selected>🎁 奖励…</option><option value="ball">普通精灵球×1</option><option value="xp">经验+20</option><option value="medicine:potion">伤药×1</option><option value="medicine:super-potion">好伤药×1</option><option value="medicine:berry-juice">树果汁×1</option><option value="medicine:water">美味之水×1</option></select>`) : ''}
    </div>`).join('') : '暂无记录'}</div>`;
}

/* ---------- 家长端 · 进化道具（v11 §2.3 学校成绩／§2.4 高级转盘／单元测试） ---------- */
async function parentEvoHtml() {
  const s = state.settings;
  const kids = (s && s.children) || [];
  if (!kids.length) return '';
  let out = '';
  for (const c of kids) {
    const tests = await api('/api/parent/school-tests?childId=' + c.id);
    const recs = tests.ok ? tests.records : [];
    const pendingWheel = recs.filter((r) => r.wheelChance === 'pending').length;
    const unit = await api('/api/child/unit-test?childId=' + c.id);
    out += `<div class="card"><h2>${ic('backpack')} 进化道具 ${esc(c.name)}</h2>
    <p style="color:var(--text-2)">学校考试 85 分以上审核通过后自动发一次普通奖励（普通球／经验+20／回血药三选一）；95 分以上＋上传试卷照片可得 1 次高级转盘机会（每孩每周最多 3 次、同一科目每周最多 1 次）。高级转盘奖品：日之石／月之石／妖精技能石／高级球／主宠蛋／活力碎片／雷之石／火之石／水之石／叶之石／冰之石／金属膜／电力增强器／护具／黑奇石。</p>
    ${pendingWheel ? `<div class="badge">${ic('target')} 高级转盘机会 ${pendingWheel} 次（孩子在背包里转）</div>` : ''}
    <h3 id="school-test-${c.id}" style="margin-top:12px">登记一次学校考试</h3>
    <div class="grid2"><div><label>科目</label><select id="st-subj-${c.id}"><option>语文</option><option>数学</option><option>英语</option><option>阅读</option></select></div>
    <div><label>单元／章节</label><input type="text" id="st-unit-${c.id}" placeholder="比如：第 3 单元 加与减"><div style="margin-top:6px"><button type="button" class="smallbtn" onclick="document.getElementById('st-unit-${c.id}').value='期末考试'">期末考试</button></div></div></div>
    <div class="grid2"><div><label>分数</label><input type="number" id="st-score-${c.id}" placeholder="比如：96"></div>
    <div><label>满分（默认 100）</label><input type="number" id="st-full-${c.id}" value="100"></div></div>
    <label>考试日期</label><input type="date" id="st-date-${c.id}">
    <label>试卷照片（95 分以上想拿高级转盘机会必须传 1 张；只留 15 天）</label><input type="file" id="st-photo-${c.id}" accept="image/*">
    <button class="bigbtn" onclick="saveSchoolTest(${c.id})">保存成绩</button>
    <h3 style="margin-top:16px">学校成绩（${recs.length}）</h3>
    ${recs.length ? recs.map((r) => `<div style="border-bottom:0.5px solid var(--line);padding:8px 0">
      <b>${esc(r.subject)} ${esc(r.unit)}</b> ${r.score}/${r.fullScore}（${r.pct} 分） ${esc(r.examDate)}
      ${r.status === 'void' ? ' <span class="pill rejected">已作废</span>' : r.status === 'pending' ? ' <span class="pill pending">待审核（去审核 tab 通过）</span>' : r.status === 'rejected' ? ' <span class="pill rejected">已驳回</span>' : ''}
      ${r.wheelChance === 'pending' ? ' ' + ic('target') + ' 高级转盘机会未用' : r.wheelChance === 'spun' ? ' ' + ic('target') + ' 高级转盘已转过' : ''}
      ${r.rewardGranted ? ' 已发：' + esc(schoolRewardLabel(r.rewardItemKey)) : ''}
      ${r.status === 'active' && !r.rewardGranted && r.wheelChance !== 'spun' ? ` <button class="smallbtn" onclick="voidSchoolTest(${r.id})">作废</button>` : ''}
    </div>`).join('') : '<p style="color:var(--text-2)">还没有登记过学校成绩。</p>'}
    <h3 id="unit-test-${c.id}" style="margin-top:16px">${ic('pencil')} 上传单元测试抽奖</h3>
    <p style="color:var(--text-2)">家长手动开启一场单元测试（题目从已学单元里出，不超前；题量不足 20 道时按实际题数开，至少 5 道）。85 分以上抽奖：进化石／球／蛋。每孩每周最多 3 次，同一单元 24 小时内只能开一次。</p>
    <div class="grid2"><div><label>科目</label><select id="ut-subj-${c.id}"><option>语文</option><option>数学</option><option>英语</option><option>阅读</option></select></div>
    <div><label>单元／章节</label><input type="text" id="ut-unit-${c.id}" placeholder="比如：三年级上册 第 3 单元 加与减"></div></div>
    <button class="bigbtn" onclick="startUnitTest(${c.id})">开启一次单元测试</button>
    ${unit.ok && unit.openTest ? `<div class="badge" style="margin-top:8px">${ic('pencil')} 有一场未答完的测试：${esc(unit.openTest.subject)} ${esc(unit.openTest.unit)}（${unit.openTest.questionCount} 道）</div>` : ''}
    ${unit.ok && unit.recent && unit.recent.length ? `<div style="margin-top:8px"><b>最近记录</b>${unit.recent.map((t) => `<div style="padding:4px 0">${esc(t.subject)} ${esc(t.unit)} ${t.score} 分（答对 ${t.correctCount}/${t.total}）${t.draw ? (t.draw.won ? ` ${ic('gift')} 中奖（${esc(t.draw.prizeKey || '')}）` : ' 未中奖') : ''}</div>`).join('')}</div>` : ''}
    </div>`;
  }
  return out;
}
async function saveSchoolTest(childId) {
  const subj = document.getElementById('st-subj-' + childId).value;
  const unit = document.getElementById('st-unit-' + childId).value.trim();
  const score = Number(document.getElementById('st-score-' + childId).value);
  const fullScore = Number(document.getElementById('st-full-' + childId).value) || 100;
  const examDate = document.getElementById('st-date-' + childId).value;
  const fileInput = document.getElementById('st-photo-' + childId);
  if (!unit) { alert('请填单元'); return; }
  if (!examDate) { alert('请选考试日期'); return; }
  let photos;
  if (fileInput && fileInput.files && fileInput.files[0]) {
    const dataUrl = await compressImage(fileInput.files[0]);
    photos = [{ data: dataUrl, contentType: 'image/jpeg' }];
  }
  const j = await api('/api/parent/school-test/save', { childId, subject: subj, unit, score, fullScore, examDate, photos });
  if (!j.ok) { alert(j.error || '保存失败'); return; }
  alert((j.wheelChance ? '已保存，获得 1 次高级转盘机会！' : '已保存' + (j.wheelReason ? '（' + j.wheelReason + '）' : '')) + (j.ordinary && j.ordinary.granted ? '，普通奖励：' + (j.ordinary.granted.name || j.ordinary.granted.key) : ''));
  renderParent();
}
window.saveSchoolTest = saveSchoolTest;
async function voidSchoolTest(recordId) {
  if (!await askConfirm('确定作废这条成绩吗？未用的高级转盘机会会一起取消。')) return;
  const j = await api('/api/parent/school-test/void', { recordId });
  if (!j.ok) { alert(j.error || '作废失败'); return; }
  renderParent();
}
window.voidSchoolTest = voidSchoolTest;
async function startUnitTest(childId) {
  const subj = document.getElementById('ut-subj-' + childId).value;
  const unit = document.getElementById('ut-unit-' + childId).value.trim();
  if (!unit) { alert('请填单元'); return; }
  const j = await api('/api/parent/unit-test/start', { childId, subject: subj, unit });
  if (!j.ok) { alert(j.error || '开启失败'); return; }
  alert(`已开启：${j.test.subject} ${j.test.unit}，共 ${j.test.questionCount} 道题，孩子在伙伴页答题`);
  renderParent();
}
window.startUnitTest = startUnitTest;

async function parentSettingsHtml() {
  const j = await api('/api/parent/settings');
  if (!j.ok) return state.psetDetail
    ? `<button class="pset-back" onclick="psetBack()">‹ 返回设置</button><div class="card"><p>${tr('加载失败', 'Failed to load')}</p><button class="bigbtn ghost" onclick="renderParent()">${tr('点我重试', 'Tap to retry')}</button></div>`
    : `<div class="card"><p>${tr('加载失败', 'Failed to load')}</p><button class="bigbtn ghost" onclick="renderParent()">${tr('点我重试', 'Tap to retry')}</button></div>`;
  const s = j.settings; state.settings = s;
  try { localStorage.setItem('sm.settings.v1', JSON.stringify(s)); } catch (e) {}
  if (!state.psetDetail) return parentSettingsListHtml(s);
  let body = '';
  switch (state.psetDetail) {
    case 'settings':
      body = parentSettingsFieldsHtml(s);
      break;
    case 'math':
      body = parentSettingsMathHtml(s);
      break;
    case 'security':
      body = parentSettingsSecurityHtml(s);
      break;
    case 'diag':
      body = await parentDiagHtml();
      if (!body) body = `<div class="card"><div style="color:var(--text-2)">最近 30 天没有薄弱的知识点 ${ic('thumbsup')}</div></div>`;
      break;
    case 'evo':
      body = await parentEvoHtml();
      break;
    case 'questions':
      body = await parentQuestionsHtml();
      break;
    case 'time':
      if (!s.testMode) return parentSettingsListHtml(s);
      body = await parentDebugStateHtml(s);
      break;
    case 'coop':
      body = await parentCoopSettingsHtml();
      break;
    case 'about':
      body = `<div class="card"><div class="section-title">关于</div>
  <div class="about">作业打卡怪兽激励 · 家庭自用版。
  <br>${esc(s.copyright)}</div></div>`;
      break;
    default:
      return parentSettingsListHtml(s);
  }
  return `<button class="pset-back" onclick="psetBack()">‹ 返回设置</button><div class="pset-detail">${body}</div>`;
}

/* 111: 设置开关——loading 时灰化居中、不表态（不假装开或关），数据到了再换真值。 */
function psetToggleHtml(checked, fnName, loading) {
  if (loading) return `<button type="button" class="pset-toggle loading" disabled><span class="pset-knob"></span></button>`;
  return `<button type="button" class="pset-toggle" role="switch" aria-checked="${checked ? 'true' : 'false'}" onclick="event.stopPropagation();${fnName}(${checked ? 'false' : 'true'})"><span class="pset-knob"></span></button>`;
}
function parentSettingsListHtml(s, loading) {
  return `<div class="pset-list">
  <div class="pset-h">学习</div>
  <div class="card"><button class="pset-row" onclick="psetOpen('settings')"><span class="pset-ic">${ic('settings')}</span><span class="pset-tx"><span class="pset-t">用户管理</span></span><span class="pset-c">›</span></button>
  <button class="pset-row" onclick="psetOpen('math')"><span class="pset-ic">${ic('ruler')}</span><span class="pset-tx"><span class="pset-t">学习进度</span></span><span class="pset-c">›</span></button>
  <button class="pset-row" onclick="psetOpen('diag')"><span class="pset-ic">${ic('ruler')}</span><span class="pset-tx"><span class="pset-t">薄弱点</span></span><span class="pset-c">›</span></button>
  <button class="pset-row" onclick="psetOpen('evo')"><span class="pset-ic">${ic('backpack')}</span><span class="pset-tx"><span class="pset-t">进化道具</span></span><span class="pset-c">›</span></button>
  <button class="pset-row" onclick="psetOpen('questions')"><span class="pset-ic">${ic('puzzle')}</span><span class="pset-tx"><span class="pset-t">题目管理</span></span><span class="pset-c">›</span></button></div>
  <div class="pset-h">功能</div>
  <div class="card">
  <div class="pset-row"${loading ? '' : ` onclick="toggleCareEnabled(${!s.careEnabled})"`}><span class="pset-ic">${ic('utensils')}</span><span class="pset-tx"><span class="pset-t">照顾玩法</span></span>${psetToggleHtml(s.careEnabled, 'toggleCareEnabled', loading)}</div>
  <p class="pset-note">打开后，孩子能在伙伴页喂食、洗澡；每次 +10 友好度，喂对最爱口味每天再 +5 经验。需要对应道具。默认关闭。</p>
  <div class="pset-row"${loading ? '' : ` onclick="toggleOakAssess(${s.oakAssess === false})"`}><span class="pset-ic">${ic('flask')}</span><span class="pset-tx"><span class="pset-t">AI 点评</span></span>${psetToggleHtml(s.oakAssess !== false, 'toggleOakAssess', loading)}</div>
  <p class="pset-note">打开后，每句跟读完自动请 AI 老师点评（只显示星级和需重练的词）；关闭后只录音对比听，不发评测。默认打开。</p>
  <div class="pset-row"${loading ? '' : ` onclick="toggleEnglishMode(${!s.englishMode})"`}><span class="pset-ic">${ic('flask')}</span><span class="pset-tx"><span class="pset-t">中文|English</span></span>${psetToggleHtml(s.englishMode, 'toggleEnglishMode', loading)}</div>
  <p class="pset-note">打开后全站显示英文（脑筋急转弯内容仍为中文；三年级英语学习内容按注释规则处理） / When on, the whole site is in English (riddles stay in Chinese; Grade 3 English content follows the annotation rule)</p>
  </div>
  ${s.testMode ? `<div class="pset-h">测试</div>
  <div class="card"><button class="pset-row" onclick="psetOpen('time')"><span class="pset-ic">${ic('flask')}</span><span class="pset-tx"><span class="pset-t">时间模拟</span><span class="pset-s">${esc('偏移天数 模拟小时')}</span></span><span class="pset-c">›</span></button></div>` : ''}
  <div class="pset-h">其他</div>
  <div class="card"><button class="pset-row" onclick="psetOpen('coop')"><span class="pset-ic">${ic('tent')}</span><span class="pset-tx"><span class="pset-t">假期合作道馆</span><span class="pset-s">${esc('设置假期合作道馆')}</span></span><span class="pset-c">›</span></button>
  <button class="pset-row" onclick="psetOpen('about')"><span class="pset-ic">${ic('book')}</span><span class="pset-tx"><span class="pset-t">关于</span><span class="pset-s">${esc('家庭自用版')}</span></span><span class="pset-c">›</span></button></div>
  <div class="pset-h">账号与安全</div>
  <div class="card"><button class="pset-row" onclick="psetOpen('security')"><span class="pset-ic">${ic('lock')}</span><span class="pset-tx"><span class="pset-t">安全</span><span class="pset-s">${esc('修改家长 PIN 管理孩子密码')}</span></span><span class="pset-c">›</span></button>
  <button class="pset-row pset-action" onclick="doLogout()">退出登录</button>
  </div>
  <div class="pset-h">危险操作</div>
  <div class="card"><button class="pset-row pset-action pset-danger" onclick="resetAll()">重置全部数据</button></div>
  </div>`;
}

function parentSettingsFieldsHtml(s) {
  return `<div class="card"><h2>${ic('settings')} 用户管理</h2>
  ${s.children.map((c) => `<div class="grid2"><div><label>${esc(c.name)} 的名字</label><input type="text" id="nm-${c.id}" value="${esc(c.name)}"></div>
    <div><label>年级标签</label><input type="text" id="gr-${c.id}" value="${esc(c.grade)}"></div></div>
    <label>伙伴怪兽线</label>
    <div class="linegrid linesprites">${s.lines.map((l) => `<button class="smallbtn ${c.line === l.key ? 'primary' : ''}" onclick="switchLine(${c.id},'${l.key}')">${l.img ? `<img loading="lazy" src="${l.img}" alt="">` : ''}<span>${esc(l.short || l.label)}</span>${c.line === l.key ? '<i class="linecheck">✓</i>' : ''}</button>`).join('')}</div>`).join('')}
  <div class="grid2 formgrid"><div><label>每科打卡经验</label><input type="number" id="subjectxp" value="${s.subjectXp}" min="1" max="100"></div>
  <div><label>基础经验</label><input type="number" id="basexp" value="${s.baseXp}" min="10" max="200"></div>
  <div><label>问答答对奖励</label><input type="number" id="quizxp" value="${s.quizXp}" min="0" max="100"></div>
  <div><label>答对不重复天数</label><input type="number" id="quizrepeat" value="${s.quizRepeatDays}" min="7" max="90"></div>
  <div><label>早交奖励截止时间</label><input type="time" id="cutoff" value="${s.cutoffTime}"></div></div>
  <div style="color:var(--text-2);font-size:var(--fs-parent-body)">范围：每科 1–100、基础 10–200、问答 0–100、不重复 7–90 天；基础经验兼容旧口径</div>
  <button class="bigbtn" onclick="saveSettings()">保存设置</button>
  </div>`;
}

function gradeNumFromGradeLabel(label) {
  if (/[1１一]/.test(label)) return 1;
  if (/[3３三]/.test(label)) return 3;
  return null;
}

function chineseUnitOptions(gradeNum) {
  if (gradeNum === 3) return [
    '三年级上册 第1单元',
    '三年级上册 第2单元',
    '三年级上册 第3单元',
    '三年级上册 第4单元',
    '三年级上册 第5单元',
    '三年级上册 第6单元',
    '三年级上册 第7单元',
    '三年级上册 第8单元',
    '三年级下册 第1单元',
    '三年级下册 第2单元',
    '三年级下册 第3单元',
    '三年级下册 第4单元',
    '三年级下册 第5单元',
    '三年级下册 第6单元',
    '三年级下册 第7单元',
    '三年级下册 第8单元'
  ];
  if (gradeNum === 1) return [
    '一年级上册 第1单元',
    '一年级上册 第2单元',
    '一年级上册 第3单元',
    '一年级上册 第4单元',
    '一年级上册 第5单元',
    '一年级上册 第6单元',
    '一年级上册 第7单元',
    '一年级上册 第8单元',
    '一年级下册 第1单元',
    '一年级下册 第2单元',
    '一年级下册 第3单元',
    '一年级下册 第4单元',
    '一年级下册 第5单元',
    '一年级下册 第6单元',
    '一年级下册 第7单元',
    '一年级下册 第8单元'
  ];
  return null;
}

function englishUnitOptions(gradeNum) {
  if (gradeNum === 3) return [
    '三年级上册 Unit 1 Making friends',
    '三年级上册 Unit 2 Different families',
    '三年级上册 Unit 3 Our animal friends',
    '三年级上册 Unit 4 Plants around us',
    '三年级上册 Unit 5 The colourful world',
    '三年级上册 Unit 6 Useful numbers',
    '三年级上册 Unit 7 Revision: Being a good guest',
    '三年级下册 Unit 1 Meeting new people',
    '三年级下册 Unit 2 My words and actions',
    '三年级下册 Unit 3 Tools and senses for learning',
    '三年级下册 Unit 4 Healthy food',
    '三年级下册 Unit 5 Old things',
    '三年级下册 Unit 6 Numbers in life'
  ];
  if (gradeNum === 1) return [
    '一年级上册 Unit 1 Hello!（自产）',
    '一年级上册 Unit 2 My Body（自产）',
    '一年级上册 Unit 3 Colours（自产）',
    '一年级上册 Unit 4 Numbers（自产）',
    '一年级上册 Unit 5 School Things（自产）',
    '一年级上册 Unit 6 Animals（自产）',
    '一年级下册 Unit 1 In the Classroom（自产）',
    '一年级下册 Unit 2 My Family（自产）',
    '一年级下册 Unit 3 Fruit（自产）',
    '一年级下册 Unit 4 Toys（自产）',
    '一年级下册 Unit 5 Weather（自产）',
    '一年级下册 Unit 6 Farm Animals（自产）'
  ];
  return null;
}

function progressView(prog, fallbackList, defaultCurrent) {
  const options = prog && (prog.chapters || prog.units || prog.options);
  const list = Array.isArray(options) && options.length ? options : (fallbackList || []);
  const isDefault = prog ? !!prog.isDefault : true;
  const current = (prog && prog.current != null) ? prog.current : defaultCurrent;
  return { list, isDefault, current };
}

function learningSelectHtml(id, label, view, defaultText) {
  return `<label>${label}</label>
    <select id="${esc(id)}">
      <option value="" ${view.isDefault ? 'selected' : ''}>${defaultText}</option>
      ${view.list.map((item) => `<option value="${esc(item)}" ${!view.isDefault && item === view.current ? 'selected' : ''}>${esc(item)}</option>`).join('')}
    </select>`;
}

function parentSettingsLearningHtml(s) {
  return `<div class="card">
  <h2 style="margin-top:16px">${ic('ruler')} 学习进度</h2>
  ${(s.children || []).map((c) => {
    const gradeNum = gradeNumFromGradeLabel(c.grade);
    const cp = progressView(c.chineseProgress, chineseUnitOptions(gradeNum), `${c.grade}上册 第2单元`);
    const mp = progressView(c.mathProgress, null, `${c.grade}上册 第2单元`);
    const ep = progressView(c.englishProgress, englishUnitOptions(gradeNum), `${c.grade}上册 Unit 2`);
    return `<div style="margin-bottom:24px">
    <div style="margin-bottom:16px">
    ${learningSelectHtml('cp-' + c.id, `${esc(c.name)}的语文进度`, cp, '未设置（默认：上册第2单元）')}
    </div>
    <div style="margin-bottom:16px">
    ${learningSelectHtml('mp-' + c.id, `${esc(c.name)}的数学进度`, mp, '未设置（默认：上册第2单元）')}
    </div>
    <div>
    ${learningSelectHtml('ep-' + c.id, `${esc(c.name)}的英语进度`, ep, '未设置（默认：上册 Unit 2）')}
    </div>
    </div>`;
  }).join('')}
  ${(s.children || []).length ? `
  <div style="color:var(--text-2);font-size:var(--fs-parent-body)">题目只会从学到过的单元里出，不会超前。改完从明天的题目开始生效（今天已出的题单不变）。</div>
  <button class="bigbtn" onclick="saveLearningProgress()">保存学习进度</button>
  ` : ''}
  </div>`;
}
function parentSettingsMathHtml(s) { return parentSettingsLearningHtml(s); }

function parentSettingsSecurityHtml(s) {
  return `<div class="card">
  <h2 style="margin-top:16px">安全</h2>
  <label>修改家长 PIN（4 位数字）</label><input type="password" id="newpin" maxlength="4" placeholder="留空不改">
  <button class="bigbtn blue" onclick="saveSecurity()">修改 PIN</button>
  <h2 style="margin-top:16px">孩子密码（进自己空间用）</h2>
  ${s.children.map((c) => `<div class="pset-field"><label>${esc(c.name)} 的密码：${c.hasPassword ? ic('check') + ' 已设置' : '未设置'}</label>
  <input type="password" id="cpw-${c.id}" maxlength="4" inputmode="numeric" placeholder="输入 4 位数字密码">
  ${c.hasPassword ? '' : '<div style="color:var(--text-2);font-size:var(--fs-parent-body)">孩子点头像时会提示找家长设置</div>'}
  <div class="rowbtns">
    <button class="smallbtn primary" onclick="saveChildPw(${c.id})">${c.hasPassword ? '重置密码' : '设置密码'}</button>
    ${c.hasPassword ? `<button class="smallbtn" onclick="clearChildPw(${c.id})">清除密码</button>` : ''}
  </div></div>`).join('')}
  </div>`;
}

async function parentQuestionsHtml() {
  const j = await api('/api/parent/questions');
  if (!j.ok) return '<div class="card">题目管理加载失败</div>';
  const st = j.stats;
  return `<div class="card"><h2>${ic('puzzle')} 题目管理</h2>
  <div>题库统计（启用中）：脑筋急转弯 ${st.riddle} 一年级 ${st.grade1} 三年级 ${st.grade3} 自定义 ${st.custom} 共 ${st.total} 题</div>
  <h3 style="margin-top:16px">新增自定义题目</h3>
  <label>题目</label><textarea id="qq" placeholder="写一道贴合课本的题目"></textarea>
  <label>四个选项</label>
  <div class="grid2"><input type="text" id="qo0" placeholder="选项 A">
  <input type="text" id="qo1" placeholder="选项 B">
  <input type="text" id="qo2" placeholder="选项 C">
  <input type="text" id="qo3" placeholder="选项 D"></div>
  <div class="grid2"><div><label>正确答案</label>
  <select id="qa"><option value="0">A</option><option value="1">B</option><option value="2">C</option><option value="3">D</option></select></div>
  <div><label>适用科目</label>
  <select id="qsub"><option>语文</option><option>数学</option><option>英语</option><option>阅读</option></select></div></div>
  <label>解析（答题后孩子能看到）</label><input type="text" id="qex" placeholder="简单讲一句为什么">
  <label>适用年级</label>
  <select id="qgr"><option value="">通用（两个孩子都能答）</option><option value="1">一年级</option><option value="3">三年级</option></select>
  <button class="bigbtn" onclick="qAdd()">添加题目</button>
  <h3 style="margin-top:16px">我的自定义题（${j.questions.length}）</h3>
  ${j.questions.length ? j.questions.map((q) => `<div style="border-bottom:0.5px solid var(--line);padding:8px 0;${q.active ? '' : 'opacity:.55'}">
    <b>${esc(q.question)}</b> <span class="qchip">${esc(q.subject)}题</span> <span class="qchip">${esc(q.gradeLabel)}</span>${q.active ? '' : ' <span class="pill rejected">已禁用</span>'}
    <div style="color:var(--text-2);font-size:var(--fs-parent-body)">答案：${'ABCD'[q.answer_idx] || '?'}<br>${esc(q.explain)}</div>
    <div class="rowbtns">
      <button class="smallbtn" onclick="qToggle(${q.id})">${q.active ? '禁用' : '启用'}</button>
      <button class="smallbtn danger" onclick="qDelete(${q.id})">删除</button>
    </div></div>`).join('') : '<p style="color:var(--text-2)">还没有自定义题目，上面的表单可以添加。</p>'}
  </div>`;
}
window.qAdd = async () => {
  const body = {
    question: document.getElementById('qq').value,
    options: [0, 1, 2, 3].map((i) => document.getElementById('qo' + i).value),
    answer_idx: Number(document.getElementById('qa').value),
    explain: document.getElementById('qex').value,
    subject: document.getElementById('qsub').value,
    grade: document.getElementById('qgr').value === '' ? null : Number(document.getElementById('qgr').value),
  };
  const j = await api('/api/parent/questions', body);
  if (!j.ok) { alert(j.error || '添加失败'); return; }
  alert('已添加');
  renderParent();
};
window.qDelete = async (id) => {
  if (!await askConfirm('确定删除这道自定义题吗？')) return;
  const j = await api('/api/parent/questions/' + id, null, 'DELETE');
  if (!j.ok) { alert(j.error || '删除失败'); return; }
  renderParent();
};
window.qToggle = async (id) => {
  const j = await api('/api/parent/questions/' + id + '/toggle', {});
  if (!j.ok) { alert(j.error || '操作失败'); return; }
  renderParent();
};
window.saveSettings = async () => {
  const s = state.settings;
  const children = s.children.map((c) => ({
    id: c.id,
    name: document.getElementById('nm-' + c.id).value,
    grade: document.getElementById('gr-' + c.id).value,
  }));
  const j = await api('/api/parent/settings/update', {
    children,
    baseXp: Number(document.getElementById('basexp').value),
    subjectXp: Number(document.getElementById('subjectxp').value),
    quizXp: Number(document.getElementById('quizxp').value),
    quizRepeatDays: Number(document.getElementById('quizrepeat').value),
    cutoffTime: document.getElementById('cutoff').value,
  });
  alert(j.ok ? '已保存' : (j.error || '保存失败'));
  if (j.ok) renderParent();
};
window.saveLearningProgress = async () => {
  const children = (state.settings && state.settings.children) || [];
  const mathProgress = [];
  const chineseProgress = [];
  const englishProgress = [];
  for (const c of children) {
    const mpEl = document.getElementById('mp-' + c.id);
    if (mpEl) mathProgress.push({ id: c.id, chapter: mpEl.value });
    const cpEl = document.getElementById('cp-' + c.id);
    if (cpEl) chineseProgress.push({ id: c.id, chapter: cpEl.value });
    const epEl = document.getElementById('ep-' + c.id);
    if (epEl) englishProgress.push({ id: c.id, chapter: epEl.value });
  }
  if (!mathProgress.length && !chineseProgress.length && !englishProgress.length) return;
  const j = await api('/api/parent/settings/update', { mathProgress, chineseProgress, englishProgress });
  alert(j.ok ? '已保存' : (j.error || '保存失败'));
  if (j.ok) renderParent();
};
window.saveMathProgress = window.saveLearningProgress;
window.saveSecurity = async () => {
  const pin = document.getElementById('newpin').value;
  if (!pin) { alert('没有要修改的'); return; }
  const j = await api('/api/parent/settings/update', { newPin: pin });
  if (!j.ok) { const el = document.getElementById('newpin'); if (el) el.value = ''; }
  alert(j.ok ? 'PIN 已修改，下次进家长端生效' : (j.error || '修改失败'));
};
window.saveChildPw = async (id) => {
  const v = document.getElementById('cpw-' + id).value.trim();
  if (!/^\d{4}$/.test(v)) { alert('孩子密码必须是 4 位数字'); return; }
  const j = await api('/api/parent/settings/update', { childPasswords: [{ id, password: v }] });
  if (!j.ok) { const el = document.getElementById('cpw-' + id); if (el) el.value = ''; }
  alert(j.ok ? '已保存，孩子用新密码进自己的空间' : (j.error || '保存失败'));
  if (j.ok) renderParent();
};
window.clearChildPw = async (id) => {
  if (!await askConfirm('清除后，这个孩子的入口会提示先找家长设置密码。确定清除吗？')) return;
  const j = await api('/api/parent/settings/update', { childPasswords: [{ id, password: '' }] });
  alert(j.ok ? '已清除' : (j.error || '操作失败'));
  if (j.ok) renderParent();
};
window.switchLine = async (childId, line) => {
  const j = await api('/api/parent/switch-line', { childId, line });
  if (j.ok) { alert('已切换到' + j.lineLabel + '，等级和经验保留'); await loadOverview(false); renderParent(); }
  else alert(j.error || '切换失败');
};
window.resetAll = async () => {
  const ok = await askResetPin();
  if (!ok) return;
  const j = await api('/api/parent/reset', { confirm: true });
  if (j.ok) { alert('已重置'); await loadOverview(false); goHome2(); }
  else alert(j.error || '重置失败');
};

/* -------- 时间模拟（仅测试版：服务端 settings.testMode=true 时才渲染） -------- */
async function parentDebugStateHtml(s) {
  const j = await api('/api/parent/debug-state');
  if (!j.ok || !Array.isArray(j.children)) return parentDebugHtml(s, null);
  return parentDebugHtml(s, j.children);
}
function parentDebugHtml(s, dbgChildren) {
  const d = s.debug || { dayOffset: 0, hour: '', virtualToday: '', virtualTime: '', isWeekend: false, gatesOpen: false };
  const hourOpts = ['<option value="">跟随真实时间</option>']
    .concat(Array.from({ length: 24 }, (_, h) => `<option value="${h}" ${String(d.hour) === String(h) ? 'selected' : ''}>${String(h).padStart(2, '0')}:00</option>`)).join('');
  return `<div class="card" style="border:2px dashed #e5484d"><h2>${ic('flask')} 时间模拟（仅测试版）</h2>
  <div>当前虚拟时间：<b>${esc(d.virtualToday)} ${esc(d.virtualTime)}</b>${d.isWeekend ? '（周末）' : '（工作日）'}<br>
  <span style="color:var(--text-2);font-size:var(--fs-parent-body)">偏移对早交截止、周末道馆、连击、封印蛋到期同时生效。</span></div>
  <div class="grid2 formgrid"><div><label>偏移天数</label><input type="number" id="dbg-off" value="${Number(d.dayOffset) || 0}" step="1">
  <div style="color:var(--text-2);font-size:var(--fs-parent-body)">整数，可负</div></div>
  <div><label>模拟小时</label><select id="dbg-hour">${hourOpts}</select></div></div>
  <div class="rowbtns">
    <button class="smallbtn primary" onclick="debugSaveTime()">应用偏移</button>
    <button class="smallbtn" onclick="debugClearTime()">清零偏移</button>
  </div>
  <h3 style="margin-top:16px">门槛放行（仅测试版）</h3>
  <div>全部门槛：<b>${d.gatesOpen ? '已放行（测试站门槛已全部放开）' : '未放行'}</b><br>
  <span style="color:var(--text-2);font-size:var(--fs-parent-body)">开启后喂食/洗澡、道馆/对战、进化、答题、打卡、转盘、测验等所有门槛全部放开（含一天/一周只能做一次的重复限制），随时能测任何功能；关闭后恢复正式站规则。</span></div>
  <div class="rowbtns" style="margin-top:8px">
    <button class="smallbtn ${d.gatesOpen ? '' : 'primary'}" onclick="debugToggleGates(${d.gatesOpen ? 'false' : 'true'})">${d.gatesOpen ? '关闭放行' : '开启放行'}</button>
  </div>
  <h3 style="margin-top:16px">${ic('flask')} 测试调试（仅测试版）</h3>
  ${dbgChildren === null ? '<div>调试数据加载失败</div>' : `
<div style="color:var(--text-2);font-size:var(--fs-parent-body)">直接改数值方便测道馆/对战/进化，不走打卡和问答，不产生任何记录。改等级自动按公式换算累计经验（L 级 = 20×L×(L−1)）。</div>
${dbgChildren.map((c) => `
<div style="border-top:0.5px solid var(--line);padding:12px 0">
  <div><b>${esc(c.name)}</b> ${esc(c.lineLabel)} ${c.level} 级</div>
  <div style="color:var(--text-2);font-size:var(--fs-parent-body)">累计 ${c.totalXp} 经验 本级 ${c.xpIntoLevel}/${c.xpForLevelSpan} 距下一级 ${c.xpToNext}</div>
  <div class="grid2 formgrid"><div><label>等级（1–30）</label>
  <input type="number" id="dbg-lv-${c.id}" value="${c.level}" min="1" max="30" onchange="debugLevelChanged(${c.id})"></div>
  <div><label>累计经验 (0–17400)</label>
  <input type="number" id="dbg-xp-${c.id}" value="${c.totalXp}" min="0" max="17400"></div></div>
  <label>招式（✓=已学会，随等级自动有；勾选=已解锁）</label>
  <div>${c.moves.map((m) => `<label style="display:block;font-weight:normal"><input type="checkbox" id="dbg-mv-${c.id}-${m.level}" data-mv="${esc(m.name)}" ${m.learned || m.early ? 'checked' : ''} ${m.learned ? 'disabled' : ''}> ${m.level} 级 ${esc(m.name)}${m.learned ? '（已学会）' : m.early ? '（已解锁）' : ''}</label>`).join('')}</div>
  <div>技能等级：${c.skillLevels && c.skillLevels.length ? c.skillLevels.map((s) => `${esc(s.name)} Lv.${s.skillLevel}`).join('、') : '暂无'}</div>
  <div class="grid2 formgrid"><div><label>精灵球数（0–99）</label>
  <input type="number" id="dbg-balls-${c.id}" value="${c.balls}" min="0" max="99"></div>
  <div><label>超级球数（0–99）</label>
  <input type="number" id="dbg-sballs-${c.id}" value="${c.ballsSuper}" min="0" max="99"></div>
  <div><label>碎片数 (0–999)</label>
  <input type="number" id="dbg-frag-${c.id}" value="${c.fragments}" min="0" max="999">
  <div style="color:var(--text-2);font-size:var(--fs-parent-body)">设 F 即视同答对 5F 题</div></div>
  <div><label>连击天数（0–365）</label>
  <input type="number" id="dbg-streak-${c.id}" value="${c.streak}" min="0" max="365"></div></div>
  <div class="rowbtns"><button class="smallbtn primary" onclick="debugSaveChild(${c.id})">保存${esc(c.name)}的调试值</button></div>
</div>`).join('')}
`}
  <h3 style="margin-top:16px">测试数据</h3>
  <button class="bigbtn ghost" style="color:var(--danger-text);border-color:var(--danger-text)" onclick="debugReset()">重置测试数据</button>
  <div style="color:var(--text-2);font-size:var(--fs-parent-body);margin-top:6px">清空打卡/问答/进度回到出厂状态（测试孩子、题库与设置保留），并清零时间偏移。超级球也清回 0。</div>
  </div>`;
}
window.debugSaveTime = async () => {
  const off = Number(document.getElementById('dbg-off').value);
  const hv = document.getElementById('dbg-hour').value;
  const j = await api('/api/parent/debug-time', { dayOffset: off, hour: hv === '' ? '' : Number(hv) });
  if (!j.ok) { alert(j.error || '设置失败'); return; }
  alert('已应用时间偏移');
  await loadOverview(false); renderParent();
};
window.debugClearTime = async () => {
  const j = await api('/api/parent/debug-time', { clear: true });
  if (!j.ok) { alert(j.error || '操作失败'); return; }
  alert('已清零偏移，回到真实时间');
  await loadOverview(false); renderParent();
};
window.debugToggleGates = async (open) => {
  const j = await api('/api/parent/debug-gates', { open: !!open });
  if (!j.ok) { alert(j.error || '操作失败'); return; }
  alert(open ? '已开启门槛放行' : '已关闭门槛放行');
  await loadOverview(false); renderParent();
};
window.debugReset = async () => {
  if (!await askConfirm('确定要重置测试数据吗？打卡、问答、等级、图鉴都会清零（题库和设置保留）。', '继续')) return;
  if (!await askConfirm('再确认一次：真的要重置测试数据吗？重置后无法恢复。', '确定重置')) return;
  const j = await api('/api/parent/debug-reset', { confirm: true });
  if (j.ok) { alert('测试数据已重置'); await loadOverview(false); goHome2(); }
  else alert(j.error || '重置失败');
};
window.debugLevelChanged = (id) => {
  const lvEl = document.getElementById(`dbg-lv-${id}`);
  const xpEl = document.getElementById(`dbg-xp-${id}`);
  if (!lvEl || !xpEl) return;
  const L = Number(lvEl.value);
  if (!Number.isInteger(L) || L < 1 || L > 30) return; // 越界时不动经验框，等服务端 400 报错
  xpEl.value = String(20 * L * (L - 1));
};
window.debugSaveChild = async (id) => {
  const num = (sid) => { const el = document.getElementById(sid); return el ? Number(el.value) : undefined; };
  const unlockedMoves = [...document.querySelectorAll(`input[id^="dbg-mv-${id}-"]:not(:disabled):checked`)]
    .map((el) => el.getAttribute('data-mv')).filter(Boolean);
  const body = {
    childId: id,
    level: num(`dbg-lv-${id}`),
    totalXp: num(`dbg-xp-${id}`),
    balls: num(`dbg-balls-${id}`),
    ballsSuper: num(`dbg-sballs-${id}`),
    fragments: num(`dbg-frag-${id}`),
    streak: num(`dbg-streak-${id}`),
    unlockedMoves,
  };
  const j = await api('/api/parent/debug-set', body);
  if (!j.ok) { alert(j.error || '保存失败'); return; }
  alert('已保存调试值');
  await loadOverview(false); renderParent();
};
window.doLogout = async () => { await api('/api/logout', {}); clearAllCaches(); location.href = '/login'; };

window.goHome = goHome2;
window.goHomeBtn = goHomeBtn;
window.goChild = goChild;
window.goParent = goParent;
window.goCheckin = goCheckinPage;
window.goEncounter = goEncounter;

/* ---------- 启动 ---------- */
goHome2();
// ===== 合作道馆：孩子端 + 家长端 =====
const COOP_STATE_TXT = { gathering: '集结中', gathered: '已集结', continue_in_holiday: '假期中继续集结', resting: '本假期营地休整中' };
const COOP_TEAM_TXT = { camp_waiting: '营地等待队员中', one_arrived: '一位队员已到营地', all_gathered: '全员集结完毕' };
const COOP_KIND_TXT = { normal: '普通', elite: '精英', final: '终点', end: '终点', boss: '终点' };
const COOP_NODE_TXT = { locked: '未开放', open: '可挑战', cleared: '已通关' };
const COOP_RUN_TXT = { win: '通关', lose: '惜败', quit: '退出', void: '作废' };

function coopErrText(code) {
  const m = {
    coop_disabled: '合作模式还没开启', out_of_holiday: '现在不在合作开放时间', not_gathered: '还没集结完成',
    makeup_pending: '补集结还没补齐', daily_gate_unmet: '今天先完成 2 科打卡（含阅读）',
    outside_time_window: '开局时间是 9:00–20:30', mutex_gym_pvp: '今天已经打过道馆或兄弟对战啦',
    daily_cap_reached: '今天已经打过一场啦', weekly_cap_reached: '本周场次用完啦', node_locked: '这个节点还没开放',
    not_participant: '你不是这支队伍的成员', bench_not_owned: '这只收藏宠还没有收集到',
    round_stale: '回合已经更新啦，请重新选择', move_locked: '这一招现在用不了，换一个试试'
  };
  return m[code] || String(code || '出错了');
}
function coopErrMsg(e) {
  if (e && /[\u4e00-\u9fa5]/.test(String(e))) return String(e);
  return coopErrText(e);
}
function coopAlert(msg) {
  showModal(`<div class="modal-body"><p>${esc(msg)}</p><div class="row"><button class="btn" onclick="closeModal()">知道了</button></div></div>`);
}
function fmtDate(d) {
  const p = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
}
function coopParseDate(s) {
  const [y, m, d] = String(s).split('-').map(Number);
  return new Date(y, m - 1, d);
}
function addDaysStr(s, n) {
  const d = coopParseDate(s);
  d.setDate(d.getDate() + n);
  return fmtDate(d);
}
function coopBar(done, target) {
  const pct = target > 0 ? Math.min(100, Math.round((done || 0) * 100 / target)) : 0;
  return `<div class="coop-bar" style="background:#f0f0f0;border-radius:6px;height:10px;overflow:hidden"><div style="width:${pct}%;height:100%;background:var(--ok,#3BB273)"></div></div>`;
}
function coopToken(bid) { return sessionStorage.getItem(`coopTok:${bid}`); }
function coopIdArg(v) { return esc(JSON.stringify(v)); }

async function loadCoopEntry(childId) {
  let g = null;
  try { g = await api(`/api/coop/gathering?childId=${childId}`); } catch (e) { g = null; }
  const el = document.getElementById('coopEntry');
  if (!el) return;
  if (!g || !g.available) { el.innerHTML = ''; return; }
  const me = g.me || {}, hw = me.homework || {}, rd = me.reading || {};
  const stateEn = { gathering: 'Gathering', gathered: 'Gathered', continue_in_holiday: 'Gathering continues during holiday', resting: 'Camp resting this holiday' };
  el.innerHTML = `<div class="card coop-entry">
    <h3>${ic('tent')} ${tr('假期合作营地', 'Holiday coop camp')}</h3>
    <p>${tr('作业补给', 'Homework supplies')} ${hw.done || 0}/${hw.target || 0} ${tr('阅读足迹', 'Reading footprints')} ${rd.done || 0}/12</p>
    <p>${esc(tr(COOP_STATE_TXT[me.state] || me.state || '', stateEn[me.state] || me.state || ''))}</p>
    <button class="btn" onclick="goCoop(${childId})">${tr('进入营地', 'Enter camp')}</button>
  </div>`;
}
window.loadCoopEntry = loadCoopEntry;

// 照顾玩法：独立在途锁，不与抓捕锁共享。
let careBusy = false;
let carePageEpoch = 0;
let careReplayTimer = null;

function careReducedMotion() {
  return window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;
}

function loadCareEntry(childId) {
  const el = document.getElementById('careEntry');
  if (!el) return;
  el.innerHTML = '';
  const k = state.childCache[childId] || {};
  if (k.care === null || k.care === undefined) return;
  const id = Number(childId);
  if (!Number.isSafeInteger(id)) return;
  el.innerHTML = `<button class="bigbtn ghost" onclick="goCarePage(${id})">${ic('utensils')} ${tr('照顾伙伴', 'Care for companion')} ${k.care.fedToday ? '<small>' + ic('check') + ' ' + tr('已喂', 'Fed') + '</small>' : ''} ${k.care.bathedToday ? '<small>' + ic('check') + ' ' + tr('已洗', 'Bathed') + '</small>' : ''}</button>`;
}
window.loadCareEntry = loadCareEntry;


// ====== C：养成页伙伴问答与友好度状态机 ======
window._careQaState = {
  childId: null,
  friendship: 0,
  hearts: 0,
  dailyLimit: 3,
  answeredToday: 0,
  remainingToday: 3,
  mode: 'idle', // 'idle' | 'question' | 'result'
  question: null,
  selectedIdx: null,
  lastResult: null,
  busy: false,
};

function renderFriendshipHeartsHtml(friendship) {
  const f = Math.max(0, Math.min(255, Number(friendship) || 0));
  const fullHearts = Math.floor(f / 51);
  const icons = [];
  for (let i = 0; i < 5; i++) {
    icons.push(
      `<span class="care-heart ${i < fullHearts ? 'on' : 'off'}" style="display:inline-flex;color:${i < fullHearts ? 'var(--danger,#F25C54)' : '#d1d5db'};margin:0 2px">${ic('heart')}</span>`
    );
  }
  return `<span class="care-hearts-bar" title="${f}/255" style="display:inline-flex;align-items:center;vertical-align:middle">${icons.join('')}<span style="margin-left:6px;font-size:14px;color:var(--text-2);font-weight:600;white-space:nowrap">${tr('友好度', 'Friendship')} ${f}/255</span></span>`;
}
window.renderFriendshipHeartsHtml = renderFriendshipHeartsHtml;

async function refreshCareQaStatus(childId) {
  const id = Number(childId);
  try {
    const qaSt = await api('/api/care/qa/status?childId=' + id);
    if (qaSt && qaSt.ok) {
      if (window._careQaState.childId !== id) {
        window._careQaState.mode = 'idle';
        window._careQaState.question = null;
        window._careQaState.selectedIdx = null;
        window._careQaState.lastResult = null;
      }
      window._careQaState.childId = id;
      window._careQaState.friendship = Number(qaSt.friendship || 0);
      window._careQaState.hearts = Number(qaSt.hearts || 0);
      window._careQaState.dailyLimit = Number(qaSt.dailyLimit || 3);
      window._careQaState.answeredToday = Number(qaSt.answeredToday || 0);
      window._careQaState.remainingToday = Number(qaSt.remainingToday ?? 3);
    }
  } catch (_) {}
}
window.refreshCareQaStatus = refreshCareQaStatus;

async function startCareQaQuestion() {
  const qa = window._careQaState;
  if (qa.busy) return;
  const id = Number(state.childId);
  qa.busy = true;
  try {
    const res = await api('/api/care/qa/question?childId=' + id);
    if (!res || !res.ok) {
      alert((res && res.error === 'DAILY_LIMIT_REACHED')
        ? tr('今天的 3 道伙伴问答都答完啦，明天再来吧！', "You've completed all 3 partner questions today!")
        : ((res && res.error) || tr('暂无可用题目', 'No questions available')));
      return;
    }
    qa.question = res.question;
    qa.selectedIdx = null;
    qa.lastResult = null;
    qa.mode = 'question';
    qa.answeredToday = Number(res.answeredToday ?? qa.answeredToday);
    qa.remainingToday = Number(res.remainingToday ?? qa.remainingToday);
    qa.friendship = Number(res.friendship ?? qa.friendship);
    qa.hearts = Number(res.hearts ?? qa.hearts);
    renderCarePage();
  } catch (_) {
    alert(tr('加载题目失败，请稍后再试', 'Failed to load question, please try again later'));
  } finally {
    qa.busy = false;
  }
}
window.startCareQaQuestion = startCareQaQuestion;

async function submitCareQaAnswer() {
  const qa = window._careQaState;
  if (qa.busy || !qa.question) return;
  if (qa.selectedIdx === null || qa.selectedIdx === undefined) {
    alert(tr('请先选择一个答案！', 'Please select an option first!'));
    return;
  }
  const id = Number(state.childId);
  qa.busy = true;
  try {
    const res = await api('/api/care/qa/answer', {
      childId: id,
      questionId: qa.question.id,
      answerIdx: qa.selectedIdx,
    }, 'POST');
    if (!res || !res.ok) {
      alert((res && res.error) || tr('提交失败', 'Submit failed'));
      return;
    }
    qa.lastResult = res;
    qa.mode = 'result';
    qa.friendship = Number(res.friendship ?? qa.friendship);
    qa.hearts = Number(res.hearts ?? qa.hearts);
    qa.answeredToday = Number(res.answeredToday ?? qa.answeredToday);
    qa.remainingToday = Number(res.remainingToday ?? qa.remainingToday);

    if (Number(res.xpAwarded) > 0) {
      const previous = Number(sessionStorage.getItem('sm_xpgain')) || 0;
      sessionStorage.setItem('sm_xpgain', String(previous + Number(res.xpAwarded)));
      refreshChildInBackground(id, 'care');
    }
    renderCarePage();
    if (res.correct) {
      carePlayFx(tr('答对啦！+5 经验', 'Correct! +5 XP'), 'gain');
    } else {
      carePlayFx(tr('没关系，看看解析记住它！', "That's okay! Check the explanation!"), '');
    }
  } catch (_) {
    alert(tr('提交失败，请稍后再试', 'Submit failed, please try again later'));
  } finally {
    qa.busy = false;
  }
}
window.submitCareQaAnswer = submitCareQaAnswer;

function renderCareQaCardHtml() {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const qa = window._careQaState;
  const heartsHtml = renderFriendshipHeartsHtml(qa.friendship);

  let bodyHtml = '';
  if (qa.mode === 'question' && qa.question) {
    const q = qa.question;
    const optsHtml = (q.options || []).map((optText, idx) => {
      const isSel = Number(qa.selectedIdx) === idx;
      return `
        <button type="button" class="smallbtn" data-care-qa-opt="${idx}"
          style="min-height:48px;width:100%;text-align:left;padding:10px 12px;border-radius:12px;border:${isSel ? '2px solid var(--blue,#5DA9E9)' : '1.5px solid var(--border,#e5e7eb)'};background:${isSel ? 'rgba(93,169,233,0.10)' : 'var(--card-bg,#fff)'};font-size:14px;font-weight:${isSel ? '600' : '500'}">
          ${esc(optText)}
        </button>
      `;
    }).join('');
    bodyHtml = `
      <div style="margin-top:10px">
        <p style="font-size:16px;font-weight:600;margin:0 0 10px;line-height:1.45">${esc(q.question)}</p>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:12px">${optsHtml}</div>
        <div style="display:flex;gap:8px">
          <button type="button" class="bigbtn green" id="btnCareQaSubmit" style="flex:1;min-height:48px;font-size:14px">${tr('提交答案', 'Submit')}</button>
          <button type="button" class="smallbtn" id="btnCareQaClose" style="min-height:48px;font-size:14px">${tr('收起', 'Close')}</button>
        </div>
      </div>
    `;
  } else if (qa.mode === 'result' && qa.lastResult) {
    const r = qa.lastResult;
    const rightOpt = qa.question && qa.question.options ? qa.question.options[r.answerIdx] : '';
    bodyHtml = `
      <div style="margin-top:10px;padding:12px;border-radius:12px;background:${r.correct ? '#dcf5e0' : 'var(--danger-bg,#FEECE9)'};border:1.5px solid ${r.correct ? 'var(--ok,#3BB273)' : 'var(--danger,#F25C54)'}">
        <b style="font-size:14px;color:${r.correct ? '#2e7d32' : 'var(--danger-text,#B3261E)'}">
          ${r.correct ? bi('回答正确！经验 +5', 'Correct! XP +5') : bi('回答错误，正确答案：' + esc(rightOpt), 'Incorrect. Correct answer: ' + esc(rightOpt))}
        </b>
        ${r.explain ? `<p style="font-size:14px;margin:6px 0 0;color:var(--text-2,#646464)">${esc(r.explain)}</p>` : ''}
        <div style="display:flex;gap:8px;margin-top:12px">
          ${qa.remainingToday > 0
            ? `<button type="button" class="bigbtn blue" id="btnCareQaNext" style="flex:1;min-height:48px;font-size:14px">${tr('再考一道', 'Next Question')} (${qa.remainingToday})</button>`
            : ''}
          <button type="button" class="smallbtn" id="btnCareQaClose" style="min-height:48px;font-size:14px">${tr('收起', 'Close')}</button>
        </div>
      </div>
    `;
  } else {
    const canAsk = qa.remainingToday > 0;
    bodyHtml = `
      <div style="margin-top:10px;display:flex;align-items:center;justify-content:space-between;gap:8px">
        <span style="font-size:14px;color:var(--text-2,#646464)">
          ${bi(`今日已答 ${qa.answeredToday}/${qa.dailyLimit} 道 答对 +5 经验`, `Today ${qa.answeredToday}/${qa.dailyLimit} Correct +5 XP`)}
        </span>
        <button type="button" class="smallbtn" id="btnCareQaStart" ${canAsk ? '' : 'disabled'} style="min-height:48px;font-size:14px;font-weight:600">
          ${canAsk ? tr('开始问答', 'Start QA') : tr('今日已满', 'Done Today')}
        </button>
      </div>
    `;
  }

  return `
    <div class="card care-qa-card" id="careQaCard" style="margin-top:12px">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px 10px">
        <b>${bi('伙伴考考你（每日 3 题）', 'Partner Quiz (3/day)')}</b>
        <div>${heartsHtml}</div>
      </div>
      ${bodyHtml}
    </div>
  `;
}
window.renderCareQaCardHtml = renderCareQaCardHtml;

async function goCarePage(childId) {
  const id = Number(childId);
  if (!Number.isSafeInteger(id)) return;
  if (careBusy) return;
  clearTimeout(careReplayTimer);
  const epoch = ++carePageEpoch;
  careRoomEntry++; // 新一次进页：房间降级重试计数清零
  state.childId = id;
  state.view = 'care';
  try {
    // 照顾页舞台图取自 childCache.form：任何成功 POST 都会清掉 childCache
    //（api() 成功后调 clearAllCaches），所以进页与每次刷新都要重取 /api/child
    // 并回填，否则舞台空白（2026-11-08 小宝洗澡后舞台消失）。
    const [j, cd] = await Promise.all([
      api('/api/care/status?childId=' + id),
      api('/api/child?id=' + id).catch(() => null),
    ]);
    if (epoch !== carePageEpoch || state.view !== 'care' || Number(state.childId) !== id) return;
    if (!j.ok) {
      alert(j.error === 'CARE_DISABLED' ? tr('照顾玩法还没开启，让爸爸妈妈在设置里打开吧', "Care play isn't enabled yet. Ask a parent to turn it on in settings.") : (j.error || tr('加载失败', 'Failed to load')));
      goChild(id);
      return;
    }
    if (cd && cd.ok) storeChild(id, cd);
    state.care = j;
    careUpdateCache(id, j);
    await refreshCareQaStatus(id);
    if (epoch !== carePageEpoch || state.view !== 'care' || Number(state.childId) !== id) return;
    renderCarePage();
  } catch (_) {
    if (epoch === carePageEpoch && state.view === 'care' && Number(state.childId) !== id) return;
    if (epoch === carePageEpoch && state.view === 'care' && Number(state.childId) === id) {
      alert(tr('加载失败，请稍后再试', 'Failed to load, please try again later'));
      goChild(id);
    }
  }
}
window.goCarePage = goCarePage;
window.goCarePage = goCarePage;

function careUpdateCache(id, j) {
  const k = state.childCache[id];
  if (k && k.care != null) {
    k.care = {fedToday: !!j.fedToday, bathedToday: !!j.bathedToday,
      sceneKey: j.scene && j.scene.key};
  }
}

function careSceneHtml(sceneKey, sceneName, sceneText, dateStr) {
  const allowed = ['morning-yard', 'rain-garden', 'book-nook', 'star-terrace',
    'beach', 'snow-cabin', 'rainbow-meadow'];
  const key = allowed.includes(sceneKey) ? sceneKey : 'morning-yard';
  return `<div class="card care-scene care-scene-${esc(key)}">
    <h3>${esc(sceneName || '')}</h3>
    <p>${esc(sceneText || '')}</p>
    <small>${esc(dateStr || '')}</small>
  </div>`;
}

function careItems(items) {
  if (Array.isArray(items)) return items;
  if (items && typeof items === 'object') {
    return Object.entries(items).map(([key, value]) => ({...value, key}));
  }
  return [];
}

// ====== 养成小房间（PixiJS，任务 122）======
// 只在养成页懒加载 care-room bundle（动态 import，首页/打卡页不加载）。
// 降级（减弱动态/无 WebGL/低帧率/出错/加载失败）时回到现在的 CSS 版照顾页，功能不少。
let careRoomHandle = null;
let careRoomMode = 'off'; // 'off' | 'pixi' | 'fallback'
let careRoomChildId = null;
let careRoomEntry = 0; // goCarePage 每进一次 +1；同 entry 降级后不重试挂载
let careRoomFallbackEntry = -1;
let careRoomLoading = null;
let careRoomFallbackReason = null; // 本次降级原因（no-webgl/reduced-motion/error/load-failed…），供调试/验收读取

// 记下降级原因：宿主自己的记录（挂载失败时没有 handle，模块 getDiagnostics 拿不到，
// 只能记在宿主这里）；同时镜像到 window，控制台/探针可直接读。
function careRoomNoteFallback(reason) {
  careRoomFallbackReason = reason || 'unknown';
  if (typeof window !== 'undefined') window._careRoomFallbackReason = careRoomFallbackReason;
}

function careRoomIsActive() {
  return careRoomMode === 'pixi' && !!careRoomHandle && Number(careRoomChildId) === Number(state.childId);
}

function careRoomUnmount() {
  if (careRoomHandle) {
    try { careRoomHandle.unmount(); } catch (_) {}
    careRoomHandle = null;
  }
  careRoomMode = 'off';
  careRoomChildId = null;
  careRoomLoading = null;
  careRoomFallbackReason = null;
  if (typeof window !== 'undefined') window._careRoomFallbackReason = null;
}

function careRoomShowFallback() {
  const roomEl = document.getElementById('careRoom');
  const cssEl = document.getElementById('careCssFallback');
  if (roomEl) roomEl.hidden = true;
  if (cssEl) cssEl.hidden = false;
}

function careRoomShowPixi() {
  const roomEl = document.getElementById('careRoom');
  const cssEl = document.getElementById('careCssFallback');
  if (roomEl) roomEl.hidden = false;
  if (cssEl) cssEl.hidden = true;
}

function careRoomFriendship(k) {
  const qa = (typeof window !== 'undefined' && window._careQaState) ? window._careQaState : {};
  return Number(qa.friendship || (k && k.friendship) || 0);
}

async function careRoomEnsure() {
  const id = Number(state.childId);
  if (state.view !== 'care' || !Number.isSafeInteger(id)) return;
  const roomEl = document.getElementById('careRoom');
  if (!roomEl) return;
  if (careRoomIsActive()) return;
  if (careRoomFallbackEntry === careRoomEntry) return; // 本次进页已降级，不重试
  if (careRoomLoading) return careRoomLoading;
  careRoomLoading = (async () => {
    let fellBack = false;
    try {
      const mod = await import('/static/care-room.js');
      if (state.view !== 'care' || Number(state.childId) !== id) return;
      const roomEl2 = document.getElementById('careRoom');
      if (!roomEl2) return;
      const j = state.care || {};
      const k = state.childCache[id] || {};
      const scene = j.scene || {};
      const feedGrid = document.querySelector('.care-grid-feed');
      const handle = await mod.mount(roomEl2, {
        pet: {
          img: (k.form && k.form.img) || '',
          name: (k.form && (k.form.name || k.form.formName)) || '',
          formName: (k.form && k.form.formName) || '',
        },
        state: {
          childId: id,
          friendship: careRoomFriendship(k),
          fedToday: !!j.fedToday && !j.gatesOpen, /* 任务 124：放行时可重喂 */
          bathedToday: !!j.bathedToday && !j.gatesOpen,
          sceneName: scene.name || '',
          sceneText: scene.text || '',
          today: j.today || '',
          foods: Array.isArray(j.foods) ? j.foods : [],
        },
        showHearts: true, // 养成页本身不显示爱心条，由房间 HUD 显示友好度
        feedSource: feedGrid || null,
        api: {
          // 模块拖食物时调这里：只发请求、不碰 DOM；动画播完 onFed 再刷新
          feed: async (key) => api('/api/care/feed', { childId: id, food: key }, 'POST'),
        },
        onFed: (result) => { careRoomOnFed(result, id); },
        onError: ({ message }) => { alert(message || tr('操作失败，请稍后再试', 'Operation failed, please try again later')); },
        onFallback: ({ reason } = {}) => {
          fellBack = true;
          careRoomNoteFallback(reason);
          careRoomFallbackEntry = careRoomEntry;
          careRoomMode = 'fallback';
          careRoomShowFallback();
        },
      });
      if (state.view !== 'care' || Number(state.childId) !== id) { try { handle.unmount(); } catch (_) {} return; }
      careRoomHandle = handle;
      careRoomChildId = id;
      // 挂载是异步的（import + Pixi 初始化），期间照顾页可能重渲染导致
      // mount 时传的 feedGrid 已过期；挂好后用当前 DOM 里的 grid 再绑一次，
      // 确保拖拽监听落在真正显示的那张食物格上。
      try {
        const freshGrid = document.querySelector('.care-grid-feed');
        if (freshGrid) handle.setFeedSource(freshGrid);
      } catch (_) {}
      if (fellBack) {
        careRoomMode = 'fallback';
        careRoomFallbackEntry = careRoomEntry;
        careRoomShowFallback();
      } else {
        careRoomMode = 'pixi';
        careRoomShowPixi();
      }
    } catch (_) {
      // 加载或挂载失败：回到 CSS 版照顾页（模块已知降级都走 onFallback 返回 NOOP handle、
      // 不抛错；走到这里基本是 import 失败，故记 load-failed）
      careRoomNoteFallback('load-failed');
      careRoomFallbackEntry = careRoomEntry;
      careRoomMode = 'fallback';
      careRoomShowFallback();
    } finally {
      careRoomLoading = null;
    }
  })();
  return careRoomLoading;
}

// 模块喂食动画播完（onFed）后刷新：取最新状态，用 update() 同步房间、只重绘三张卡。
async function careRoomOnFed(result, id) {
  const epoch = carePageEpoch;
  try {
    const [j, cd] = await Promise.all([
      api('/api/care/status?childId=' + id),
      api('/api/child?id=' + id).catch(() => null),
    ]);
    if (state.view !== 'care' || Number(state.childId) !== id || carePageEpoch !== epoch) return;
    if (!j.ok) return;
    if (cd && cd.ok) storeChild(id, cd);
    state.care = j;
    careUpdateCache(id, j);
    if (Number(result && result.xpAwarded) > 0) {
      const previous = Number(sessionStorage.getItem('sm_xpgain')) || 0;
      sessionStorage.setItem('sm_xpgain', String(previous + Number(result.xpAwarded)));
    }
    careRoomSyncAfterRefresh(j, state.childCache[id] || {}, result);
  } catch (_) {}
}

// 房间在跑时的定向刷新：update() 同步房间状态，只重绘喂食/洗澡/最近三张卡，不碰 #careRoom。
function careRoomSyncAfterRefresh(j, k, result) {
  if (careRoomHandle && careRoomMode === 'pixi') {
    try {
      const next = {
        friendship: Number((result && result.friendship) ?? careRoomFriendship(k)),
        fedToday: !!j.fedToday && !j.gatesOpen, /* 任务 124：放行时可重喂 */
        bathedToday: !!j.bathedToday && !j.gatesOpen,
        sceneText: (j.scene && j.scene.text) || '',
        foods: Array.isArray(j.foods) ? j.foods : [],
      };
      if (result && result.level && result.level.evolved) {
        next.pet = {
          img: (k.form && k.form.img) || '',
          name: (k.form && (k.form.name || k.form.formName)) || '',
          formName: (k.form && k.form.formName) || '',
        };
      }
      careRoomHandle.update(next);
    } catch (_) {}
  }
  careRenderCards(j);
  const feedGrid = document.querySelector('.care-grid-feed');
  if (careRoomHandle && careRoomMode === 'pixi' && feedGrid) {
    try { careRoomHandle.setFeedSource(feedGrid); } catch (_) {}
  }
}

function careBiHelpers() {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  return { isBi, bi, biTitle };
}

// 喂食/洗澡格子（从 renderCarePage 抽出，供整页渲染与定向刷新共用）
function careGridHtml(items, kind, done, gatesOpen) {
  return items.map(item => {
    const key = String(item.key || '');
    // 背包数量（2026-11-08）：没有对应道具的选项置灰并标“没有”，点不进去
    const qty = item.qty == null ? null : Number(item.qty);
    const noItem = qty !== null && qty <= 0;
    // HTML 属性和 JavaScript 字符串分别转义；key 不直接拼入代码。
    // 小图标格子（2026-11-05 用户验收）：每项只留 emoji＋名字，最爱改角标爱心，口味文案去掉，给舞台留空间
    return `<button class="carefood" data-care-kind="${kind}" data-care-key="${esc(key)}" ${noItem ? 'data-care-noitem="1" ' : ''}${(careBusy || ((done || noItem) && !gatesOpen)) ? 'disabled' : ''}>
      <span class="care-emoji">${careFxIconFor(kind, key)}</span>
      <span class="care-name">${esc(item.name || '')}</span>
      ${item.isFavoriteKnown ? '<span class="fav" aria-label="' + esc(tr('最爱', 'Favorite')) + '">❤️</span>' : ''}
      ${noItem ? '<span class="care-noitem">' + esc(tr('没有', 'None')) + '</span>' : ''}
    </button>`;
  }).join('');
}

function careFeedCardHtml(j) {
  const { bi, biTitle } = careBiHelpers();
  const foods = careItems(j.foods);
  const fedDone = j.fedToday && !j.gatesOpen; /* 任务 124：放行时可重喂 */
  return `<div class="card ${fedDone ? 'care-done' : ''}" id="careFeedCard">
      <h3>${ic('utensils')} ${biTitle('喂食（每天一次）', 'Feeding (once a day)')}</h3>
      ${fedDone ? '<p>' + bi('今天已经喂过啦，明天再来吧', 'Already fed today, come back tomorrow') + '</p>' : ''}
      <div class="care-grid care-grid-feed">${careGridHtml(foods, 'feed', fedDone, j.gatesOpen)}</div>
    </div>`;
}

function careBathCardHtml(j) {
  const { bi, biTitle } = careBiHelpers();
  const baths = careItems(j.baths);
  const bathDone = j.bathedToday && !j.gatesOpen; /* 任务 124：放行时可重洗 */
  return `<div class="card ${bathDone ? 'care-done' : ''}" id="careBathCard">
      <h3>${ic('droplets')} ${biTitle('洗澡（每天一次）', 'Bathing (once a day)')}</h3>
      ${bathDone ? '<p>' + bi('今天已经洗过啦', 'Already bathed today') + '</p>' : ''}
      <div class="care-grid care-grid-bath">${careGridHtml(baths, 'bath', bathDone, j.gatesOpen)}</div>
    </div>`;
}

function careRecentCardHtml(j) {
  const { bi, biTitle } = careBiHelpers();
  const recent = Array.isArray(j.recent) ? j.recent : [];
  const rows = recent.map((rec, i) => `<button class="care-record" data-care-replay="${i}">
    ${esc(rec.date || rec.day || '')} ${rec.kind === 'bath' ? tr('洗澡', 'Bathing') : tr('喂食', 'Feeding')}
    ${esc(rec.itemName || rec.foodName || rec.bathName || '')} ${esc(rec.sceneName || '')}
    ${rec.favorite ? ' ' + tr('最爱 ', 'Favorite ') + ic('heart') : ''}${Number(rec.xpAwarded) > 0 ? ' ' + tr('+5 经验', '+5 XP') : ''}
  </button>`).join('');
  return `<div class="card" id="careRecentCard"><h3>${ic('film')} ${biTitle('最近照顾', 'Recent care')}</h3>${recent.length ? rows : '<p>' + bi('这周还没有照顾记录', 'No care records this week') + '</p>'}</div>`;
}

// 只重绘喂食/洗澡/最近三张卡（定向刷新用，不碰 #careRoom），并重新绑定格子点击。
function careRenderCards(j) {
  const feedCard = document.getElementById('careFeedCard');
  if (feedCard) feedCard.outerHTML = careFeedCardHtml(j);
  const bathCard = document.getElementById('careBathCard');
  if (bathCard) bathCard.outerHTML = careBathCardHtml(j);
  const recentCard = document.getElementById('careRecentCard');
  if (recentCard) recentCard.outerHTML = careRecentCardHtml(j);
  careBindGridButtons();
}

function careBindGridButtons() {
  document.querySelectorAll('#app [data-care-kind]').forEach(button => {
    button.addEventListener('click', () => {
      if (button.dataset.careKind === 'feed') doCareFeed(button.dataset.careKey, button);
      else doCareBath(button.dataset.careKey, button);
    });
  });
}

function renderCarePage() {
  const { bi, biTitle } = careBiHelpers();
  // 重写 #app 前先卸掉房间（避免 Pixi 在已卸载的 DOM 上继续跑）
  careRoomUnmount();
  clearTimeout(careReplayTimer);
  const id = Number(state.childId);
  const j = state.care;
  const k = state.childCache[id] || {};
  const scene = j.scene || {};
  const heroImg = (k.form && k.form.img)
    ? `<img src="${esc(k.form.img)}" alt="${tr('伙伴', 'Companion')}">`
    : (k.form && k.form.egg ? `<div class="egg">${eggHtml(k.form.egg || EGG_FALLBACK, 110)}</div>` : '');
  document.getElementById('app').innerHTML = `
    ${childTop(ic('utensils') + ' ' + biTitle('照顾伙伴', 'Care for companion'), 'goChild(' + id + ')', undefined, true)}
    <div id="careRoom" hidden></div>
    <div id="careCssFallback">
      <div id="careScene">${careSceneHtml(scene.key, scene.name, scene.text, j.today)}</div>
      <div class="card care-hero" id="careHero">${heroImg}</div>
    </div>
    ${careFeedCardHtml(j)}
    ${careBathCardHtml(j)}
    ${careRecentCardHtml(j)}
    <p class="care-note">${bi('每天喂食、洗澡各一次，每次 +10 友好度；喂对最爱口味再 +5 经验。需要对应道具，没有就先去养成转盘抽一个。友好度越高，道馆单人战时主宠越容易硬撑、闪避和暴击。', 'Feed and bathe once a day each. Each gives +10 Friendship. Feeding a favorite flavor gives +5 XP. Requires the matching item — spin the Nurture Wheel to get one. Higher Friendship makes your lead pet more likely to endure, dodge, and land critical hits in solo Gym battles.')}</p>
    ${tabbar()}`;
  // renderCarePage 末尾事件绑定（B1 传 button + C4 五个问答交互点完整绑定）：
  careBindGridButtons();

  const btnQaStart = document.getElementById('btnCareQaStart');
  if (btnQaStart) btnQaStart.addEventListener('click', () => startCareQaQuestion());

  document.querySelectorAll('#app [data-care-qa-opt]').forEach(optBtn => {
    optBtn.addEventListener('click', () => {
      window._careQaState.selectedIdx = Number(optBtn.dataset.careQaOpt);
      renderCarePage();
    });
  });

  const btnQaSubmit = document.getElementById('btnCareQaSubmit');
  if (btnQaSubmit) btnQaSubmit.addEventListener('click', () => submitCareQaAnswer());

  const btnQaNext = document.getElementById('btnCareQaNext');
  if (btnQaNext) btnQaNext.addEventListener('click', () => startCareQaQuestion());

  const btnQaClose = document.getElementById('btnCareQaClose');
  if (btnQaClose) {
    btnQaClose.addEventListener('click', () => {
      window._careQaState.mode = 'idle';
      window._careQaState.question = null;
      window._careQaState.selectedIdx = null;
      window._careQaState.lastResult = null;
      renderCarePage();
    });
  }

  // 养成页渲染完再挂房间（懒加载，不阻塞整页）
  careRoomEnsure();
}

function careLockBegin() {
  if (careBusy) return false;
  careBusy = true;
  document.querySelectorAll('#app .carefood').forEach(button => { button.disabled = true; });
  return true;
}

function careLockEnd() {
  careBusy = false;
  if (state.view !== 'care') return;
  const j = state.care || {};
  document.querySelectorAll('#app .carefood').forEach(button => {
    // 没有道具的选项保持置灰（2026-11-08），不因解锁被重新启用
    button.disabled = ((button.dataset.careKind === 'feed' ? !!j.fedToday : !!j.bathedToday) || button.dataset.careNoitem === '1') && !j.gatesOpen; /* 任务 124：放行时可重喂/重洗且不扣道具 */
  });
}

const CARE_FX_EMOJI_MAP = {
  apple: '🍎',
  berry: '🍓',
  cookie: '🍪',
  meat: '🍖',
  milk: '🥛',
  honey: '🍯',
  bubble: '🫧',
  shower: '🚿',
  petal: '🌸',
  herb: '🍃',
};

function careFxEmojiFor(kind, key) {
  if (key && CARE_FX_EMOJI_MAP[key]) return CARE_FX_EMOJI_MAP[key];
  return kind === 'bath' ? '🫧' : '🍎';
}
/* 任务 72：照顾格子图标——有生成图用图，无图回退 emoji（care key 为短 key，加 care: 前缀查表）。 */
function careFxIconFor(kind, key) {
  const url = key ? itemIconUrl('care:' + key) : null;
  if (url) return `<img class="item-ic" loading="lazy" src="${url}" alt="" onerror="this.remove()">`;
  return esc(careFxEmojiFor(kind, key));
}

function careFxSparkSymbols(kind, favorite) {
  if (kind === 'bath') return ['🫧', '💧'];
  if (favorite) return ['💖', '⭐'];
  return ['❤️', '💖'];
}

function ensureCareFxStyles() {
  if (typeof document === 'undefined' || document.getElementById('care-fx-styles')) return;
  const style = document.createElement('style');
  style.id = 'care-fx-styles';
  style.textContent = `
    .care-fx-fly {
      position: fixed;
      left: var(--cfx-sx, 50%);
      top: var(--cfx-sy, 70%);
      z-index: 999;
      font-size: 28px;
      line-height: 1;
      margin-left: -14px;
      margin-top: -14px;
      pointer-events: none;
      will-change: transform, opacity;
      animation: care-fx-fly-arc 0.28s cubic-bezier(0.22, 0.68, 0.36, 1) forwards;
    }
    @keyframes care-fx-fly-arc {
      0% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
      60% { opacity: 1; transform: translate3d(calc(var(--cfx-tx, 0px) * 0.65), calc(var(--cfx-ty, 0px) * 0.65 - 24px), 0) scale(1.2); }
      100% { opacity: 0; transform: translate3d(var(--cfx-tx, 0px), var(--cfx-ty, 0px), 0) scale(0.5); }
    }
    .care-fx-fav-flash {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: radial-gradient(circle, rgba(255, 215, 0, 0.58) 0%, rgba(255, 184, 0, 0.2) 55%, rgba(255, 215, 0, 0) 75%);
      opacity: 0;
      will-change: transform, opacity;
      animation: care-fx-flash-pop 0.45s ease-out forwards;
    }
    @keyframes care-fx-flash-pop {
      0% { opacity: 0; transform: scale(0.6); }
      35% { opacity: 1; transform: scale(1.05); }
      100% { opacity: 0; transform: scale(1.2); }
    }
    .care-fx-bath-wiggle {
      animation: care-fx-wiggle-anim 0.55s ease-in-out;
      will-change: transform;
    }
    @keyframes care-fx-wiggle-anim {
      0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
      20% { transform: translate3d(-3px, 0, 0) rotate(-6deg); }
      45% { transform: translate3d(3px, -2px, 0) rotate(6deg); }
      70% { transform: translate3d(-2px, 0, 0) rotate(-4deg); }
    }
    .care-fx-static-badge {
      position: absolute;
      right: 12px;
      top: 10px;
      font-size: 20px;
      line-height: 1;
      pointer-events: none;
      z-index: 5;
    }
  `;
  document.head.appendChild(style);
}

let careFxActiveCleanup = null;

function clearCareFxNodes() {
  if (typeof careFxActiveCleanup === 'function') {
    careFxActiveCleanup();
    careFxActiveCleanup = null;
  }
}

function careWaitWithSkip(ms) {
  return new Promise((resolve) => {
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      clearTimeout(timer);
      if (typeof document !== 'undefined') {
        document.removeEventListener('pointerdown', onSkip, true);
        document.removeEventListener('click', onSkip, true);
      }
      clearCareFxNodes();
      resolve();
    };
    const onSkip = () => finish();
    const timer = setTimeout(finish, ms);
    if (typeof document !== 'undefined') {
      setTimeout(() => {
        if (!done) {
          document.addEventListener('pointerdown', onSkip, { once: true, capture: true });
          document.addEventListener('click', onSkip, { once: true, capture: true });
        }
      }, 30);
    }
  });
}

// B4：按 .fx-spark 类过滤新生成的粒子
function spawnCareThemedSparks(heroEl, kind, favorite) {
  spawnSparks(heroEl, 7);
  const symbols = careFxSparkSymbols(kind, favorite);
  const sparks = Array.from(heroEl.querySelectorAll('.fx-spark')).slice(-7);
  const targets = sparks.length ? sparks : Array.from(heroEl.children).filter(n => !n.matches('img, .egg')).slice(-7);
  targets.forEach((node, idx) => {
    node.textContent = symbols[idx % symbols.length];
  });
}

function carePlayFx(text, cls, opts) {
  // 房间在跑时，飘字直接浮在房间上（#careHero 藏在 CSS 降级区里，看不见）
  if (careRoomIsActive()) {
    const roomEl = document.getElementById('careRoom');
    if (roomEl) floatText(roomEl, text, cls || '');
    return;
  }
  const heroEl = document.getElementById('careHero');
  if (!heroEl) return;

  // 回放或普通两参数调用：保持原有逻辑一字不改
  if (!opts || !opts.kind) {
    if (!careReducedMotion()) {
      const pet = heroEl.querySelector('img, .egg') || heroEl;
      pet.classList.remove('squash-once');
      void pet.offsetWidth;
      pet.classList.add('squash-once');
      setTimeout(() => pet.classList.remove('squash-once'), 700);
      spawnSparks(heroEl, 7);
    }
    floatText(heroEl, text, cls || '');
    return;
  }

  ensureCareFxStyles();
  clearCareFxNodes();

  const { kind, key, favorite, btnEl } = opts;
  const pet = heroEl.querySelector('img, .egg') || heroEl;
  const tempNodes = [];
  const timers = [];
  let impactTriggered = false;

  // B2 修复：若用户在 260ms 内点击跳过，先立即触发 impact（确保 floatText 飘字必定弹出），再清理飞行节点
  const triggerImpact = () => {
    if (impactTriggered) return;
    impactTriggered = true;
    tempNodes.forEach((n) => {
      if (n && n.classList && n.classList.contains('care-fx-fly') && n.parentNode) {
        n.parentNode.removeChild(n);
      }
    });
    pet.classList.remove('squash-once');
    void pet.offsetWidth;
    pet.classList.add('squash-once');
    timers.push(setTimeout(() => pet.classList.remove('squash-once'), 480));

    if (favorite) {
      const flashEl = document.createElement('div');
      flashEl.className = 'care-fx-fav-flash';
      heroEl.appendChild(flashEl);
      tempNodes.push(flashEl);
    }

    spawnCareThemedSparks(heroEl, 'feed', Boolean(favorite));
    floatText(heroEl, text, cls || '');
  };

  careFxActiveCleanup = () => {
    if (kind === 'feed' && !impactTriggered) {
      triggerImpact();
    }
    timers.forEach((t) => clearTimeout(t));
    tempNodes.forEach((n) => { if (n && n.parentNode) n.parentNode.removeChild(n); });
    pet.classList.remove('squash-once', 'care-fx-bath-wiggle');
  };

  if (careReducedMotion()) {
    impactTriggered = true;
    const badge = document.createElement('span');
    badge.className = 'care-fx-static-badge';
    badge.textContent = kind === 'bath' ? '🫧💧' : (favorite ? '💖⭐' : '❤️');
    heroEl.appendChild(badge);
    tempNodes.push(badge);
    floatText(heroEl, text, cls || '');
    return;
  }

  if (kind === 'bath') {
    impactTriggered = true;
    pet.classList.remove('care-fx-bath-wiggle');
    void pet.offsetWidth;
    pet.classList.add('care-fx-bath-wiggle');
    timers.push(setTimeout(() => pet.classList.remove('care-fx-bath-wiggle'), 600));
    spawnCareThemedSparks(heroEl, 'bath', false);
    floatText(heroEl, text, cls || '');
    return;
  }

  const heroRect = heroEl.getBoundingClientRect();
  const targetX = Math.round(heroRect.left + heroRect.width / 2);
  const targetY = Math.round(heroRect.top + heroRect.height / 2);
  const btnRect = (btnEl && typeof btnEl.getBoundingClientRect === 'function')
    ? btnEl.getBoundingClientRect()
    : { left: targetX - 20, top: targetY + 120, width: 40, height: 40 };
  const startX = Math.round(btnRect.left + btnRect.width / 2);
  const startY = Math.round(btnRect.top + btnRect.height / 2);

  const flyEl = document.createElement('div');
  flyEl.className = 'care-fx-fly';
  flyEl.innerHTML = careFxIconFor('feed', key); // 任务 72：飞行动画也用道具图（无图回退 emoji）
  flyEl.style.setProperty('--cfx-sx', startX + 'px');
  flyEl.style.setProperty('--cfx-sy', startY + 'px');
  flyEl.style.setProperty('--cfx-tx', (targetX - startX) + 'px');
  flyEl.style.setProperty('--cfx-ty', (targetY - startY) + 'px');
  document.body.appendChild(flyEl);
  tempNodes.push(flyEl);

  timers.push(setTimeout(triggerImpact, 260));
}

// 照顾页提交后刷新：基线原有函数，合入时被漏掉导致每次喂食/洗澡后抛错；按基线恢复，提示走 tr() 双语。
async function careRefresh(id, epoch) {
  // 同 goCarePage：喂食/洗澡 POST 成功后 api() 会清掉 childCache，
  // 刷新只取 /api/care/status 会让 renderCarePage 读到空 childCache、舞台空白；
  // 须同时重取 /api/child 回填（2026-11-08 小宝洗澡后舞台消失）。
  const [j, cd] = await Promise.all([
    api('/api/care/status?childId=' + id),
    api('/api/child?id=' + id).catch(() => null),
  ]);
  if (state.view !== 'care' || Number(state.childId) !== id || carePageEpoch !== epoch) return;
  if (!j.ok) {
    alert(j.error === 'CARE_DISABLED' ? tr('照顾玩法还没开启，让爸爸妈妈在设置里打开吧', "Care play isn't enabled yet. Ask a parent to turn it on in settings.") : (j.error || tr('加载失败', 'Failed to load')));
    goChild(id);
    return;
  }
  if (cd && cd.ok) storeChild(id, cd);
  state.care = j;
  careUpdateCache(id, j);
  if (careRoomIsActive()) {
    // 房间在跑：定向刷新（update() + 只重绘三张卡），不重写 #app，否则房间会被卸掉
    careRoomSyncAfterRefresh(j, state.childCache[id] || {}, null);
    return;
  }
  renderCarePage();
}

async function careSubmit(kind, key, btnEl) {
  if (state.view !== 'care' || !careLockBegin()) return;
  const id = Number(state.childId);
  const epoch = carePageEpoch;
  try {
    const body = kind === 'feed' ? {childId: id, food: key} : {childId: id, bath: key};
    const j = await api('/api/care/' + kind, body, 'POST');
    const stillHere = state.view === 'care' && Number(state.childId) === id && carePageEpoch === epoch;
    if (!j.ok) {
      alert(j.error === 'CARE_DISABLED' ? tr('照顾玩法还没开启，让爸爸妈妈在设置里打开吧', "Care play isn't enabled yet. Ask a parent to turn it on in settings.") : (j.error || tr('操作失败', 'Operation failed')));
    } else {
      if (Number(j.xpAwarded) > 0) {
        const previous = Number(sessionStorage.getItem('sm_xpgain')) || 0;
        sessionStorage.setItem('sm_xpgain', String(previous + Number(j.xpAwarded)));
      }
      if (stillHere) {
        let fxText = kind === 'bath' ? tr('洗得香香的！', 'Smelling fresh!') :
          (j.favorite ? tr('+5 经验 最爱！', '+5 XP Favorite!') : tr('吃得很开心！', 'Enjoyed the meal!'));
        if (Number(j.friendshipAwarded) > 0) fxText += tr(' 友好度 +' + j.friendshipAwarded, ' Friendship +' + j.friendshipAwarded);
        if (kind === 'feed' && j.level && j.level.evolved) fxText += tr(' 进化成 ' + j.level.evolved.to + '！', ' Evolved into ' + j.level.evolved.to + '!');
        carePlayFx(fxText, kind === 'feed' && j.favorite ? 'gain' : '', {
          kind,
          key,
          favorite: Boolean(j.favorite),
          btnEl: btnEl || null,
        });
        await careWaitWithSkip(careReducedMotion() ? 200 : 750);
      }
    }
    await careRefresh(id, epoch);
  } catch (_) {
    alert(tr('操作失败，请稍后再试', 'Operation failed, please try again later'));
    try {
      await careRefresh(id, epoch);
    } catch (_) {
      alert(tr('刷新失败，请稍后重新进入照顾页', 'Refresh failed, please re-enter the care page later'));
    }
  } finally {
    careLockEnd();
  }
}

async function doCareFeed(foodKey, btnEl) {
  if (careRoomIsActive()) return; // 房间接管喂食（拖食物到宠物身上），点按不再重复提交
  return careSubmit('feed', foodKey, btnEl);
}
async function doCareBath(bathKey, btnEl) {
  return careSubmit('bath', bathKey, btnEl);
}
window.doCareFeed = doCareFeed;
window.doCareBath = doCareBath;
window.careFxEmojiFor = careFxEmojiFor;
window.careFxSparkSymbols = careFxSparkSymbols;
function replayCare(rec) {
  if (!rec || careBusy || state.view !== 'care') return;
  const banner = document.getElementById('careScene');
  if (!banner) return;
  clearTimeout(careReplayTimer);
  banner.innerHTML = careSceneHtml(rec.sceneKey, rec.sceneName, rec.sceneText || '', rec.date || '');
  const bath = rec.kind === 'bath';
  carePlayFx(bath ? tr('洗得香香的！', 'Smelling fresh!') :
    (rec.favorite ? tr('最爱！+5 经验', 'Favorite! +5 XP') : tr('吃得很开心！', 'Enjoyed the meal!')),
    !bath && rec.favorite ? 'gain' : '');
  const epoch = carePageEpoch;
  careReplayTimer = setTimeout(() => {
    if (state.view !== 'care' || epoch !== carePageEpoch ||
        document.getElementById('careScene') !== banner) return;
    const scene = state.care.scene || {};
    banner.innerHTML = careSceneHtml(scene.key, scene.name, scene.text, state.care.today);
  }, 1200);
}
window.replayCare = replayCare;

window.toggleCareEnabled = async function(on) {
  try {
    const j = await api('/api/parent/settings/update', {careEnabled: on}, 'POST');
    if (j.ok) location.reload();
    else alert(j.error || tr('设置失败', 'Settings failed'));
  } catch (_) {
    alert(tr('设置失败，请稍后再试', 'Settings failed, please try again later'));
  }
};


window.toggleEnglishMode = async function(on) {
  try {
    const j = await api('/api/parent/settings/update', {englishMode: on}, 'POST');
    if (j.ok) location.reload();
    else alert(j.error || '设置失败');
  } catch (_) {
    alert('设置失败，请稍后再试');
  }
};

window.toggleOakAssess = async function (on) {
  try {
    const j = await api('/api/parent/settings/update', {oakAssess: on}, 'POST');
    if (j.ok) location.reload();
    else alert(j.error || '设置失败');
  } catch (_) {
    alert('设置失败，请稍后再试');
  }
};

async function goCoop(childId) {
  state.view = 'coop';
  stopCoopPoll();
  let g = null, m = null;
  try {
    [g, m] = await Promise.all([api(`/api/coop/gathering?childId=${childId}`), api(`/api/coop/map?childId=${childId}`)]);
  } catch (e) { /* 渲染降级 */ }
  window._coopPage = { childId, gathering: g, map: m, benchNo: null };
  renderCoopPage();
}
window.goCoop = goCoop;

function coopGatherCard(g) {
  if (!g || !g.available) return `<div class="card"><h3>${ic('tent')} 集结</h3><p>${esc(g && g.reason ? coopErrMsg(g.reason) : '合作营地暂未开放')}</p></div>`;
  const me = g.me || {}, hw = me.homework || {}, rd = me.reading || {}, mate = g.mate || {};
  const team = g.team || {}, caps = g.caps || {}, gate = g.todayGate || {};
  const hwHtml = (!hw.target || hw.unconfigured)
    ? `<p class="muted">作业补给：等爸爸妈妈先设置每天要打卡的科目</p>`
    : `<p>${ic('book')} 作业补给 ${hw.done || 0}/${hw.target}${hw.pass ? ' ' + ic('check') : ''}</p>${coopBar(hw.done, hw.target)}`;
  const mateLines = [];
  if (mate.reading_gap_days > 0) mateLines.push(`队友阅读还差 ${mate.reading_gap_days} 天`);
  if (mate.homework_on_way) mateLines.push('队友作业补给进行中');
  return `<div class="card">
    <h3>${ic('tent')} 我的集结</h3>
    ${hwHtml}
    <p>${ic('book')} 阅读足迹 ${rd.done || 0}/12${rd.pass ? ' ' + ic('check') : ''}</p>${coopBar(rd.done, 12)}
    <p>我的状态：<b>${esc(COOP_STATE_TXT[me.state] || me.state || '')}</b></p>
    ${me.makeup ? `<p>补集结进度 ${me.makeup.done || 0}/${me.makeup.need || 0}</p>` : ''}
    <p>队友：${esc(COOP_STATE_TXT[mate.state] || mate.state || '未知')}${mateLines.length ? '（' + esc(mateLines.join('，')) + '）' : ''}</p>
    <p>队伍：${esc(COOP_TEAM_TXT[team.state] || team.state || '')}</p>
    <p>${gate.met ? ic('checkcircle') + ' 今天已达标，可以开场' : ic('pencil') + ' 今天先完成 2 科打卡（含阅读）才能开场'}</p>
    <p>场次：今日 ${caps.todayUsed || 0}/1 本周 ${caps.weekUsed || 0}/4</p>
  </div>`;
}

function coopBenchChips() {
  const p = window._coopPage;
  const col = (p.map && p.map.benchOptions) || (p.map && p.map.myCollection) || [];
  const chip = (no, label, sel) => `<button class="movechip${sel ? ' sel active' : ''}" onclick="coopPickBench(${coopIdArg(no)})">${label}</button>`;
  return `<div class="movechips">${chip(null, '只带主宠', p.benchNo == null)}${col.map(c => chip(c.no, `#${esc(c.no)} ${esc(c.name)}`, p.benchNo === c.no)).join('')}</div>`;
}
function coopPickBench(no) {
  const pwEl = document.getElementById('coopJoinPw');
  const pw = pwEl ? pwEl.value : '';
  window._coopPage.benchNo = no;
  renderCoopPage();
  const el2 = document.getElementById('coopJoinPw');
  if (el2) el2.value = pw;
}
window.coopPickBench = coopPickBench;

function renderCoopPage() {
  const p = window._coopPage;
  if (!p) return;
  const m = p.map || {};
  let mapHtml = '';
  if (!m.available) {
    mapHtml = `<div class="card"><p>远征地图暂未开放</p></div>`;
  } else {
    const ev = m.event || {}, camp = m.camp || {}, ob = m.openBattle;
    const nodes = m.nodes || [];
    const nodeName = id => { const n = nodes.find(x => x.node_id === id); return n ? n.name : id; };
    const nodeCards = nodes.map(n => {
      const canGo = n.state === 'open' && ev.status === 'active' && !ob;
      return `<div class="card coop-node">
        <b>${esc(n.name)}</b> <span class="muted">${esc(COOP_KIND_TXT[n.kind] || n.kind || '')}</span>
        <p>馆主：${esc(n.bossName || '?')} ${n.bossType ? typeChip(n.bossType) : ''}${n.sweep ? ' 馆主很强，小心！' : ''}</p>
        <p>${esc(COOP_NODE_TXT[n.state] || n.state || '')}${camp.exists && camp.nodeId === n.node_id ? ' ' + ic('tent') + ' 有扎营进度' : ''}</p>
        ${canGo ? `<button class="btn" onclick="coopChallenge(${coopIdArg(n.node_id)})">挑战</button>` : ''}
      </div>`;
    }).join('');
    let obHtml = '';
    if (ob) {
      if (ob.status === 'waiting') {
        obHtml = ob.mine
          ? `<div class="card"><h3>${ic('swords')} 本场战斗</h3><p>等队友加入中…（${esc(nodeName(ob.nodeId))}）</p>
             <button class="btn" onclick="goCoopBattle(${coopIdArg(ob.battleId)})">进入战斗</button>
             <button class="btn ghost" onclick="coopQuit(${coopIdArg(ob.battleId)})">退出</button></div>`
          : `<div class="card"><h3>${ic('swords')} 队友发起了挑战：${esc(nodeName(ob.nodeId))}</h3>
             <p>我的 4 位密码：<input id="coopJoinPw" type="password" inputmode="numeric" maxlength="4" placeholder="4 位数字"></p>
             <p>备战宠（上方选择）：${p.benchNo == null ? '只带主宠' : '#' + esc(p.benchNo)}</p>
             <button class="btn" onclick="coopJoin(${coopIdArg(ob.battleId)})">输入密码加入</button></div>`;
      } else if (ob.status === 'active' || ob.status === 'suspended') {
        obHtml = `<div class="card"><h3>${ic('swords')} 战斗进行中</h3><p>${esc(nodeName(ob.nodeId))}${ob.status === 'suspended' ? '（挂起中）' : ''}</p>
          <button class="btn" onclick="goCoopBattle(${coopIdArg(ob.battleId)})">进入战斗</button></div>`;
      }
    }
    const runs = m.runs || [];
    const runsHtml = runs.length ? runs.map(r => `<li>${esc(r.event_day || '')} ${esc(nodeName(r.node_id))} ${esc(r.end_reason ? (COOP_RUN_TXT[r.end_reason] || r.end_reason) : '进行中')}${r.counts_toward_cap === false ? '（不计场次）' : ''}</li>`).join('') : '<li class="muted">还没有远征记录</li>';
    const rw = m.myRewards || [];
    const rwHtml = rw.length ? rw.map(r => `<li>${ic('award')} ${esc(r.label || r.reward_type || '')}</li>`).join('') : '<li class="muted">还没有纪念品</li>';
    mapHtml = `<div class="card"><h3>${ic('backpack')} 选择备战宠</h3>${coopBenchChips()}</div>
      ${obHtml}
      <h3>${ic('map')} 远征地图${ev.status && ev.status !== 'active' ? '（' + esc(ev.status) + '）' : ''}</h3>
      ${nodeCards || '<p class="muted">暂无节点</p>'}
      <div class="card"><h3>${ic('scroll')} 远征日志</h3><ul>${runsHtml}</ul></div>
      <div class="card"><h3>${ic('award')} 我的合作纪念</h3><ul>${rwHtml}</ul></div>`;
  }
  app.innerHTML = childTop('合作营地', `goChild(${p.childId})`) + coopGatherCard(p.gathering) + mapHtml + tabbar();
}

async function coopChallenge(nodeId) {
  if (lcAvailable() && lcNetOff()) { alert('现在没网，合作挑战等联网后再来哦'); return; }
  const p = window._coopPage;
  const camp = (p.map && p.map.camp) || {};
  if (camp.exists && camp.nodeId === nodeId) return coopCampModal(nodeId);
  await coopCreate(nodeId);
}
window.coopChallenge = coopChallenge;

async function coopCreate(nodeId, campMode) {
  if (lcAvailable() && lcNetOff()) { alert('现在没网，合作战斗建不了，等联网后再来哦'); return; }
  const p = window._coopPage;
  const body = { childId: p.childId, nodeId, benchNo: p.benchNo };
  if (campMode) body.camp = campMode;
  let r;
  try { r = await api('/api/battle/coop/create', body); } catch (e) { return coopAlert('网络出错了，请稍后再试'); }
  if (r && r.ok) {
    const bid = r.battleId || (r.battle && r.battle.battleId);
    if (r.token) sessionStorage.setItem(`coopTok:${bid}`, r.token);
    return goCoopBattle(bid);
  }
  if (r && r.error === 'camp_locked_config') return coopCampModal(nodeId, r.campBattleId);
  coopAlert(coopErrMsg(r && r.error));
}

function coopCampModal(nodeId, campBattleId) {
  window._coopCampCtx = { nodeId, campBattleId: campBattleId || null };
  showModal(`<div class="modal-body"><h3>${ic('tent')} 这里有扎营进度</h3><p>要继续上次的扎营进度，还是放弃重新开始？</p>
    <div class="row">
      <button class="btn" onclick="coopCampContinue()">继续扎营进度</button>
      <button class="btn ghost" onclick="coopCampDiscard()">放弃快照重新开始</button>
      <button class="btn ghost" onclick="closeModal()">取消</button>
    </div></div>`);
}
function coopCampContinue() {
  closeModal();
  const ctx = window._coopCampCtx || {};
  const ob = window._coopPage && window._coopPage.map && window._coopPage.map.openBattle;
  const bid = ctx.campBattleId || (ob && ob.battleId);
  if (!bid) return coopAlert('请先恢复扎营的那场战斗');
  goCoopBattle(bid);
}
function coopCampDiscard() {
  closeModal();
  const ctx = window._coopCampCtx || {};
  coopCreate(ctx.nodeId, 'discard');
}
window.coopCampContinue = coopCampContinue;
window.coopCampDiscard = coopCampDiscard;

async function coopJoin(battleId) {
  if (lcAvailable() && lcNetOff()) { alert('现在没网，加入不了合作战斗，等联网后再来哦'); return; }
  const el = document.getElementById('coopJoinPw');
  const pw = (el ? el.value : '').trim();
  if (!/^\d{4}$/.test(pw)) return coopAlert('请输入 4 位数字密码');
  const p = window._coopPage;
  let r;
  try { r = await api('/api/battle/coop/join', { battleId, childId: p.childId, password: pw, benchNo: p.benchNo }); } catch (e) { return coopAlert('网络出错了'); }
  if (r && r.ok) {
    if (r.joinToken) sessionStorage.setItem(`coopTok:${battleId}`, r.joinToken);
    return goCoopBattle(battleId);
  }
  if (el) el.value = '';
  coopAlert(coopErrMsg(r && r.error));
}
window.coopJoin = coopJoin;

function stopCoopPoll() {
  if (window._coopPoll) clearInterval(window._coopPoll);
  window._coopPoll = null;
}
async function coopRefresh() {
  const b = window._coopBattle;
  if (!b) return false;
  const tok = coopToken(b.battleId);
  if (!tok) return false;
  try {
    const r = await api('/api/battle/coop/state', { battleId: b.battleId, token: tok });
    if (r && r.ok && r.battle) { b.view = r.battle; return true; }
  } catch (e) { /* 忽略，下次轮询再试 */ }
  return false;
}
function coopStartPoll() {
  stopCoopPoll();
  const bid = window._coopBattle && window._coopBattle.battleId;
  window._coopPoll = setInterval(async () => {
    if (state.view !== 'coopBattle' || !window._coopBattle || window._coopBattle.battleId !== bid) return stopCoopPoll();
    const before = JSON.stringify(window._coopBattle.view || null);
    await coopRefresh();
    if (state.view !== 'coopBattle' || !window._coopBattle || window._coopBattle.battleId !== bid) return;
    const v = window._coopBattle.view;
    if (JSON.stringify(v || null) !== before) renderCoopBattle();
    if (v && (v.status === 'finished' || v.status === 'abandoned')) stopCoopPoll();
  }, 4000);
}

async function goCoopBattle(battleId) {
  state.view = 'coopBattle';
  stopCoopPoll();
  window._coopBattle = { battleId, view: null };
  await coopRefresh();
  if (state.view !== 'coopBattle' || window._coopBattle.battleId !== battleId) return;
  renderCoopBattle();
  const v = window._coopBattle.view;
  if (v && v.status !== 'finished' && v.status !== 'abandoned') coopStartPoll();
}
window.goCoopBattle = goCoopBattle;

function coopActivePet(sd) {
  const pets = (sd && sd.pets) || [];
  return pets[sd && sd.activeIdx] || pets.find(x => x.active) || pets[0] || null;
}

function coopSideCard(v, k) {
  const sd = v.sides && v.sides[k];
  if (!sd) return '';
  const seatKey = k === 'A' ? 'L' : 'R';
  const seat = (v.seats && v.seats[seatKey]) || {};
  const isMe = v.mySeat === seatKey;
  const pets = sd.pets || [];
  const act = coopActivePet(sd);
  const dot = `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${seat.online ? 'var(--ok,#3BB273)' : '#cecece'};margin-right:4px"></span>`;
  const roleTag = seat.role === 'support' ? ' <span class="chip">应援席</span>' : '';
  const actHtml = act ? `
    <div style="display:flex;align-items:center;gap:8px;margin:6px 0">
      ${petFace(act, 64)}
      <div style="flex:1">
        <div><b>${esc(act.name)}</b> Lv${act.level}${act.shellCount > 0 ? ` ${ic('shield')}×${act.shellCount}` : ''}</div>
        ${hpBarHtml(act)}
      </div>
    </div>` : '<div class="muted">没有上场宠</div>';
  const bench = pets.map((p, i) => i === sd.activeIdx ? '' : `
    <div style="display:flex;align-items:center;gap:6px;font-size:14px">
      ${petFace(p, 28)}<span>${esc(p.name)}</span><span class="muted">${p.hp}/${p.maxHp}</span>${p.fainted ? ic('moon') : ''}
    </div>`).join('');
  let st;
  if (seat.submitted) {
    const a = seat.submittedAction || {};
    let what = '已行动';
    if (a.type === 'move') what = a.moveName || '出招';
    else if (a.type === 'switch') what = '换宠';
    else if (a.type === 'support') what = '应援';
    st = `✔ ${esc(what)}${a.isAutoPick ? '（代选）' : ''}`;
  } else {
    st = '选招中…';
  }
  return `
    <div class="card" style="flex:1;min-width:0">
      <div>${dot}<b>${esc(seat.childName || sd.childName || '')}</b> <span class="muted">${seatKey}</span>${roleTag}${isMe ? '（我）' : ''}</div>
      ${actHtml}
      ${bench}
      <div style="margin-top:6px;font-size:14px">${st}</div>
    </div>`;
}

function renderCoopBattle() {
  const cb = window._coopBattle || {};
  const v = cb.view;
  if (!v) {
    app.innerHTML = `${childTop('合作战斗', `goCoop(${state.childId})`)}<div class="card">加载中…</div>`;
    return;
  }
  const boss = v.sides && v.sides.BOSS;
  const bp = boss ? coopActivePet(boss) : null;
  const fx = (boss && boss.fx) || {};
  const bossHtml = bp ? `
    <div class="card" style="display:flex;align-items:center;gap:10px">
      ${petFace(bp, 96)}
      <div style="flex:1">
        <div><b>${esc(bp.name)}</b> ${typeChip(bp.type)}
          ${fx.charge ? '<span class="chip">' + ic('zap') + '蓄势中</span>' : ''}${fx.weak ? '<span class="chip">' + ic('warning') + '弱化中</span>' : ''}</div>
        ${hpBarHtml(bp)}
      </div>
    </div>` : '';
  let tele = '';
  if (v.telegraph) {
    const t = v.telegraph;
    const who = t.kind === 'sweep' ? '横扫全场' : '猛攻' + (t.seat ? (t.seat === v.mySeat ? '你' : '队友') : '');
    tele = `<div class="card" style="background:var(--pri-l)">${ic('warning')} 馆主正在蓄势——下一回合将${who}！</div>`;
  }
  const mySeat = (v.seats && v.seats[v.mySeat]) || {};
  const mySide = v.sides && v.sides[v.mySeat === 'L' ? 'A' : 'B'];
  let ops = '';
  if (v.status === 'active') {
    if (mySeat.submitted) {
      ops = '<div class="card">已锁定，等队友行动</div>';
    } else if (mySeat.role === 'support') {
      if ((mySeat.supportNextRound || 0) <= v.roundNo) {
        ops = `<div class="card">
          <button class="btn" onclick="coopSubmit({type:'support', kind:'a'})">${ic('shield')}守护队友</button>
          <button class="btn" onclick="coopSubmit({type:'support', kind:'b'})">${ic('heart')}给队友回血</button>
          <button class="btn" onclick="coopSubmit({type:'support', kind:'c'})">${ic('warning')}弱化馆主</button>
        </div>`;
      } else {
        ops = `<div class="card">应援冷却中（第 ${mySeat.supportNextRound} 回合可用）</div>`;
      }
    } else if (mySide) {
      const pets = mySide.pets || [];
      const act = pets[mySide.activeIdx];
      if (act && !act.fainted && act.hp > 0) {
        const moves = (act.moves || []).map(m => {
          const f = MOVE_FX[m.name];
          return `<button class="btn" onclick="coopPickMove(${coopIdArg(m.name)})">${esc(m.name)}${f && f[2] ? ` <small>${esc(f[2])}</small>` : ''}</button>`;
        }).join('');
        const sw = pets.findIndex((p, i) => i !== mySide.activeIdx && !p.fainted && p.hp > 0);
        const swBtn = sw >= 0 ? `<button class="btn ghost" onclick="coopSubmit({type:'switch', toIdx:${sw}})">换成 ${esc(pets[sw].name)}</button>` : '';
        ops = `<div class="card">${moves}${swBtn}</div>`;
      } else {
        ops = '<div class="card muted">上场宠已昏厥，等待中…</div>';
      }
    }
    if (v.timer && v.timer.reminded90 && !mySeat.submitted) {
      ops += '<div class="card" style="color:var(--danger-text)">' + ic('clock') + ' 快选招啦，太久不动会自动代选哦</div>';
    }
  } else if (v.status === 'waiting') {
    ops = '<div class="card">等队友加入中…</div>';
  } else if (v.status === 'suspended') {
    ops = '<div class="card">战斗挂起中 <button class="btn" onclick="coopResume()">恢复</button></div>';
  } else if (v.status === 'finished' || v.status === 'abandoned') {
    let txt = '本场已结束';
    if (v.ended === 'win') txt = ic('sparkles') + ' 通关啦！';
    else if (v.ended === 'lose') txt = '就差一点，下次再来！';
    else if (v.endReason === 'quit') txt = '已退出本场';
    else if (v.endReason === 'void') txt = '本场已作废';
    const rw = (v.rewards && v.rewards.length)
      ? `<div style="margin-top:6px">${v.rewards.map(r => `<div>${ic('gift')} ${esc(String(r.ref || ''))}</div>`).join('')}</div>` : '';
    ops = `<div class="card"><div><b>${txt}</b></div>${rw}<button class="btn" onclick="goCoop(${state.childId})">回营地</button></div>`;
  }
  const logs = (v.log || []).filter(e => e && e.text).slice(-8);
  const logHtml = `<div class="card" style="font-size:14px">${logs.length ? logs.map(e => `<div>${esc(e.text)}</div>`).join('') : '<div class="muted">暂无记录</div>'}</div>`;
  const quitBtn = ['active', 'suspended', 'waiting'].includes(v.status)
    ? '<div style="text-align:center;margin:10px 0"><button class="btn ghost" onclick="coopQuit()">退出本场</button></div>' : '';
  app.innerHTML = `
    ${childTop('合作战斗', `goCoop(${state.childId})`)}
    <div class="muted" style="margin:4px 0">第 ${v.roundNo || 0} 回合</div>
    ${bossHtml}
    ${tele}
    <div style="display:flex;gap:8px">${coopSideCard(v, 'A')}${coopSideCard(v, 'B')}</div>
    ${ops}
    ${logHtml}
    ${quitBtn}`;
}
window.renderCoopBattle = renderCoopBattle;

window.coopPickMove = function (moveName) {
  const f = MOVE_FX[moveName];
  if (f && f[0] === '防御') {
    window._coopShellMove = moveName;
    showModal(`
      <div style="margin-bottom:10px">${esc(moveName)}：要保护谁？</div>
      <button class="btn" onclick="coopShellGo('self')">护自己</button>
      <button class="btn" onclick="coopShellGo('ally')">护队友</button>
      <button class="btn ghost" onclick="closeModal()">取消</button>`);
    return;
  }
  coopSubmit({ type: 'move', moveName });
};

window.coopShellGo = function (t) {
  closeModal();
  coopSubmit({ type: 'move', moveName: window._coopShellMove, shellTarget: t });
};

async function coopSubmit(action) {
  const cb = window._coopBattle || {};
  const v = cb.view;
  if (!v) return;
  let j;
  try {
    j = await api('/api/battle/coop/submit', {
      battleId: cb.battleId, token: coopToken(cb.battleId), roundNo: v.roundNo, action
    }, 'POST');
  } catch (e) {
    coopAlert(coopErrMsg(e));
    return;
  }
  if (j && j.ok) {
    if (j.battle) window._coopBattle.view = j.battle;
    renderCoopBattle();
  } else {
    coopAlert(coopErrMsg(j));
    if (j && j.view) {
      window._coopBattle.view = j.view;
      renderCoopBattle();
    }
  }
}
window.coopSubmit = coopSubmit;

window.coopResume = async function () {
  const cb = window._coopBattle || {};
  const password = await askPrompt({ title: '恢复战斗', label: '输入我的密码', placeholder: '4 位密码', inputType: 'password', okText: '恢复' });
  if (password == null) return;
  try {
    const j = await api('/api/battle/coop/resume', { battleId: cb.battleId, childId: state.childId, password }, 'POST');
    if (!j || !j.ok) { coopAlert(coopErrMsg(j)); return; }
    if (j.token) sessionStorage.setItem(`coopTok:${cb.battleId}`, j.token);
    if (j.battle) window._coopBattle.view = j.battle;
    renderCoopBattle();
    coopStartPoll();
  } catch (e) {
    coopAlert(coopErrMsg(e));
  }
};

window.coopQuit = async function () {
  const ok = await askConfirm('退出本场？会计入今天的场次哦', '退出');
  if (!ok) return;
  const cb = window._coopBattle || {};
  try {
    const j = await api('/api/battle/coop/quit', { battleId: cb.battleId, token: coopToken(cb.battleId) }, 'POST');
    if (!j || !j.ok) { coopAlert(coopErrMsg(j)); return; }
  } catch (e) {
    coopAlert(coopErrMsg(e));
    return;
  }
  stopCoopPoll();
  goCoop(state.childId);
};

const COOP_SUBJECTS = ['语文', '数学', '英语', '阅读'];
const COOP_END_TXT = { win: '通关', lose: '失败', quit: '退出', void: '作废', timeout: '超时', abandoned: '放弃' };

async function parentCoopSettingsHtml() {
  let j;
  try { j = await api('/api/parent/holiday/config'); } catch (e) { return `<div class="card">合作道馆设置加载失败：${esc(coopErrMsg(e))}</div>`; }
  if (!j || j.ok === false) return `<div class="card">合作道馆设置加载失败：${esc(coopErrMsg(j))}</div>`;
  window._coopCfg = j;
  const master = !!(j.masterEnabled ?? j.master_enabled);
  const h = j.holiday || {};
  const children = j.children || [];
  const subjects = j.subjects || {};
  const statStr = Object.values(j.statutory || {}).flatMap(y => (y && y.off) || []).join(',');
  const subjRows = children.map(c => {
    const sel = subjects[c.id] || [];
    return `<div style="margin:4px 0"><b>${esc(c.name)}</b>
      ${COOP_SUBJECTS.map(s => `<label style="margin-left:6px"><input type="checkbox" class="coop-subj-${c.id}" value="${esc(s)}" ${sel.includes(s) ? 'checked' : ''}>${s}</label>`).join('')}
    </div>`;
  }).join('');
  let recHtml = '<div class="muted">暂无合作记录</div>';
  try {
    const ov = await api('/api/parent/coop/overview');
    if (ov && ov.available) {
      const runs = ov.runs || [];
      const grants = ov.grants || [];
      if (runs.length || grants.length) {
        const nameOf = id => { const c = children.find(x => String(x.id) === String(id)); return c ? c.name : String(id); };
        recHtml = `
          ${runs.map(r => `<div>${esc(r.event_day || '')} ${esc(r.node_id || '')} ${esc(COOP_END_TXT[r.end_reason] || r.end_reason || '进行中')}</div>`).join('')}
          ${grants.length ? '<div style="margin-top:6px"><b>奖励</b></div>' : ''}
          ${grants.map(g => `<div>${ic('gift')} ${esc(nameOf(g.user_id))}：${esc(g.reward_ref || '')}</div>`).join('')}`;
      }
    }
  } catch (e) { /* 记录不可用时显示默认文案 */ }
  return `
    <div class="card">
      <h3>${ic('tent')} 假期合作道馆（家长设置）</h3>
      <div style="margin:6px 0">总开关：${master ? '已开启' : '已关闭'}
        <button class="btn" onclick="toggleCoopMaster(${master ? 'false' : 'true'})">${master ? '关闭' : '开启'}</button>
      </div>
      <div style="margin:6px 0">
        <div class="grid2"><div><label>假期 ID</label><input id="coopHolId" value="${esc(h.holiday_id || '')}"></div>
        <div><label>开始</label><input id="coopHolStart" type="date" value="${esc(h.start_date || '')}"></div></div>
        <div class="grid2"><div><label>结束</label><input id="coopHolEnd" type="date" value="${esc(h.end_date || '')}"></div>
        <div><label>敌方基准等级</label><input id="coopBaseLv" type="number" value="${h.enemy_base_level != null ? esc(String(h.enemy_base_level)) : ''}" placeholder="留空＝按孩子等级自动"></div></div>
        <div class="muted" style="font-size:14px">合作周保存时自动按自然周切分</div>
      </div>
      <div style="margin:6px 0"><b>每孩日常科目</b>${subjRows}</div>
      <div style="margin:6px 0"><b>法定休假日</b><br>
        <textarea id="coopStatutory" rows="3" style="width:100%" placeholder="如 2027-10-01,2027-10-02（假期窗口涉及年份的法定休假日）">${esc(statStr)}</textarea>
      </div>
      <button class="btn" onclick="saveCoopHolidayConfig()">保存</button>
      <div style="margin-top:10px"><b>合作记录</b>${recHtml}</div>
    </div>`;
}
window.parentCoopSettingsHtml = parentCoopSettingsHtml;

window.toggleCoopMaster = async function (on) {
  try {
    const j = await api('/api/parent/holiday/config/update', { masterEnabled: on }, 'POST');
    if (j && j.ok) location.reload();
    else coopAlert(coopErrMsg(j));
  } catch (e) {
    coopAlert(coopErrMsg(e));
  }
};

window.saveCoopHolidayConfig = async function () {
  const val = id => ((document.getElementById(id) || {}).value || '').trim();
  const holiday_id = val('coopHolId');
  const start = val('coopHolStart');
  const end = val('coopHolEnd');
  if (!holiday_id || !start || !end) { coopAlert('请填写假期 ID、开始和结束日期'); return; }
  if (start > end) { coopAlert('开始日期不能晚于结束日期'); return; }
  const coop_weeks = [];
  let cur = start;
  while (cur <= end) {
    const day = coopParseDate(cur).getDay();
    const sun = addDaysStr(cur, (7 - day) % 7);
    const segEnd = sun < end ? sun : end;
    const monday = fmtDate(coopParseDate(addDaysStr(cur, -((day + 6) % 7))));
    coop_weeks.push({ week_key: monday, start: cur, end: segEnd });
    cur = addDaysStr(segEnd, 1);
  }
  const children = (window._coopCfg && window._coopCfg.children) || [];
  const subjects = {};
  for (const c of children) {
    const sel = Array.from(document.querySelectorAll(`.coop-subj-${c.id}`)).filter(x => x.checked).map(x => x.value);
    if (!sel.length) { coopAlert('每个孩子至少选一科日常科目'); return; }
    subjects[c.id] = sel;
  }
  const statutory = {};
  val('coopStatutory').split(/[,，\s]+/).filter(Boolean).forEach(d => {
    const y = d.slice(0, 4);
    if (!statutory[y]) statutory[y] = { off: [] };
    statutory[y].off.push(d);
  });
  const lvRaw = val('coopBaseLv');
  const lvNum = lvRaw === '' ? null : Number(lvRaw);
  const enemy_base_level = lvNum != null && Number.isFinite(lvNum) ? lvNum : null;
  try {
    const j = await api('/api/parent/holiday/config/update', {
      holiday: { holiday_id, start_date: start, end_date: end, coop_weeks, enemy_base_level, map_version: 'coop-m1.v1' },
      subjects,
      statutory
    }, 'POST');
    if (j && j.ok) {
      coopAlert('已保存');
      location.reload();
    } else {
      coopAlert(coopErrMsg(j));
    }
  } catch (e) {
    coopAlert(coopErrMsg(e));
  }
};
