function ic(name) {
  if (IC_FILL[name]) return '<span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none">' + IC_FILL[name] + '</svg></span>';
  return '<span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' + (IC[name] || '') + '</svg></span>';
}
/* 精灵蛋按物种区分（2026-10-27 §52）：后端 eggDesignFor 下发 {no,bg,pat,c1,c2}，前端只画、不拼 emoji；
 * 缺数据时用神秘蛋兜底（EGG_FALLBACK），永不画通用蛋。导航／徽章／空状态里的蛋图标（类别图标）仍走 ic('egg')。 */
const EGG_FALLBACK = { no: null, bg: '#E8E0F0', pat: 'star', c1: '#C9A227', c2: '#8E7CC3' };
function eggHtml(d, size) {
  const e = (d && d.bg && d.pat) ? d : EGG_FALLBACK;
  const s = Math.max(16, Number(size) || 32);
  return `<span class="eggshape pat-${esc(e.pat)}" style="--eggbg:${esc(e.bg)};--eggc1:${esc(e.c1)};--eggc2:${esc(e.c2)};width:${s}px;height:${Math.round(s * 1.25)}px" role="img" aria-label="精灵蛋"></span>`;
}
/* ---------- 任务 72：全站内容图标（卡米猫风格，2026-11-09） ----------
 * 属性/道具图标统一用生成图：圆角方卡＋同色渐变底＋粗描边＋白高光（见 icon-style-reference.md）。
 * key → 图标文件；未映射的回退 emoji/ic。图片加载失败时移除（名字文字仍在）。 */
const ITEM_ICON = {
  'stone:thunder': 'stone-thunder', 'stone:fire': 'stone-fire', 'stone:water': 'stone-water', 'stone:leaf': 'stone-leaf',
  'stone:ice': 'stone-ice', 'stone:sun': 'stone-sun', 'stone:moon': 'stone-moon', 'stone:fairy-skill': 'stone-fairy-skill',
  'ball': 'ball', 'ball:hyper': 'ball-hyper', 'ball:master': 'ball-master',
  'medicine:potion': 'medicine-potion', 'medicine:super-potion': 'medicine-super-potion', 'medicine:berry-juice': 'medicine-berry-juice',
  'medicine:water': 'medicine-water', 'medicine:revive': 'medicine-revive',
  'care:apple': 'care-apple', 'care:berry': 'care-berry', 'care:cookie': 'care-cookie', 'care:meat': 'care-meat',
  'care:milk': 'care-milk', 'care:honey': 'care-honey',
  'care:bubble': 'care-bubble', 'care:shower': 'care-shower', 'care:petal': 'care-petal', 'care:herb': 'care-herb',
  'item:metal-coat': 'item-metal-coat', 'item:electirizer': 'item-electirizer', 'item:protector': 'item-protector', 'item:black-augurite': 'item-black-augurite',
  'xp': 'item-xp',
};
const ITEM_ICON_SRC = (slug) => `/static/img/icons/${slug}.webp`;
function itemIconUrl(key) {
  const slug = ITEM_ICON[key];
  return slug ? ITEM_ICON_SRC(slug) : null;
}
function itemIconImg(key, fallback) {
  const url = itemIconUrl(key);
  if (!url) return fallback;
  return `<img class="item-ic" loading="lazy" src="${url}" alt="" onerror="this.remove()">`;
}
function itemIcon(it) {
  const key = (it && it.key) || '';
  if (key.startsWith('ball:') || (it && it.kind === 'ball')) {
    const cls = key === 'ball:super' ? 'super' : key === 'ball:hyper' ? 'hyper' : key === 'ball:master' ? 'master' : '';
    return '<span class="pb-mini ' + cls + '"></span>';
  }
  if (key.startsWith('egg:')) return eggHtml(it.egg || EGG_FALLBACK, 24);
  if (ITEM_ICON[key]) return itemIconImg(key, '');
  const map = {
    'stone:thunder': 'zap', 'stone:fire': 'flame', 'stone:water': 'droplet', 'stone:leaf': 'leaf',
    'stone:ice': 'snowflake', 'stone:sun': 'sun', 'stone:moon': 'moon', 'stone:fairy-skill': 'sparkles',
    'item:metal-coat': 'wrench', 'item:electirizer': 'plug', 'item:protector': 'shield', 'item:black-augurite': 'gem',
    'medicine:potion': 'pill', 'medicine:berry-juice': 'droplet', 'medicine:revive': 'sparkles',
  };
  return ic(map[key] || 'gift');
}
function stickerIcon(s) {
  const map = { '⭐': 'star', '🌈': 'sparkles', '🔥': 'flame', '🎖': 'award', '🎖': 'award', '🍀': 'leaf', '🏆': 'trophy' };
  return ic(map[s] || 'star');
}
/* 家长区视觉分离：renderParent／goParent 打 parent 标，孩子页打 child 标（清掉） */
function setArea(a) { try { document.body.dataset.area = a; document.body.classList.toggle('parent', a === 'parent'); } catch (e) {} }
let _pageLoad = null;
function beginPageLoad(retryFn) {
  if (_pageLoad) { clearTimeout(_pageLoad._t1); clearTimeout(_pageLoad._t2); }
  const load = { view: state.view, done: false };
  _pageLoad = load;
  if (typeof retryFn === 'function') window._slowRetry = retryFn;
  load._t1 = setTimeout(() => {
    if (!load.done && _pageLoad === load && state.view === load.view) app.innerHTML = skeletonHtml();
  }, 200);
  load._t2 = setTimeout(() => {
    if (!load.done && _pageLoad === load && state.view === load.view) app.innerHTML = slowHtml();
  }, 8000);
  load.finish = () => { load.done = true; clearTimeout(load._t1); clearTimeout(load._t2); };
  return load;
}
function skeletonHtml() {
  return `<div class="sk-wrap"><div class="sk sk-top"></div><div class="sk-card"><div class="sk sk-hero"></div><div class="sk sk-row"></div><div class="sk sk-row"></div></div><div class="sk sk-row"></div><div class="sk sk-row"></div><div class="sk sk-btn"></div><div class="sk-note">正在打开手账…</div></div>`;
}
function slowHtml() {
  return `<div class="slow-wrap"><div class="slow-ball"></div><div class="slow-title">网络有点慢</div><div class="slow-note">小伙伴还在路上，再试一次吧</div><button class="bigbtn" onclick="window._slowRetry&&window._slowRetry()">重新加载</button><div class="slow-note">还是不行？请爸爸妈妈检查一下网络</div></div>`;
}


function showModal(html) {
  modalRoot.innerHTML = `<div class="overlay"><div class="modal">${html}<button class="bigbtn" onclick="closeModal()">太棒了！</button></div></div>`;
}
let modalCloseHook = null;
function closeModal() { modalRoot.innerHTML = ''; window._dexCardGym = null; const f = modalCloseHook; modalCloseHook = null; if (f) f(); }

/* 页面内自定义确认弹窗（Promise<boolean>）：替代原生 confirm 对话框——原生对话框在部分浏览器/WebView 会被自动关闭导致处理函数静默退出。
   点遮罩不关闭（危险操作必须明确点按钮）；「取消」resolve(false)，「确定」resolve(true)。 */
let confirmSettle = null;
function askConfirm(msg, okText = '确定') {
  if (confirmSettle) confirmSettle(false);
  if (promptSettle) promptSettle(null);
  return new Promise((resolve) => {
    const settle = (v) => { if (confirmSettle === settle) { confirmSettle = null; modalRoot.innerHTML = ''; } resolve(v); };
    confirmSettle = settle;
    modalRoot.innerHTML = `<div class="overlay"><div class="modal">
      <p style="font-size:var(--fs-body);line-height:1.6;margin:.4em 0 1em">${esc(msg)}</p>
      <div class="rowbtns">
        <button class="smallbtn" id="cf-cancel">取消</button>
        <button class="smallbtn" id="cf-ok" style="background:var(--danger-text);border-color:var(--danger-text);color:#fff">${esc(okText)}</button>
      </div></div></div>`;
    document.getElementById('cf-cancel').onclick = () => settle(false);
    document.getElementById('cf-ok').onclick = () => settle(true);
  });
}

/* 返工 2026-11-14：重置确认改输家长 PIN（替代两次 askConfirm）。复用 .pinpad/.pindots 样式；
   校验走现成的 POST /api/parent/verify-pin（错 5 次锁 5 分钟，与家长入口同一口径）。
   resolve(true)＝PIN 通过，resolve(null)＝取消。 */
let resetPinSettle = null;
function askResetPin() {
  if (confirmSettle) confirmSettle(false);
  if (promptSettle) promptSettle(null);
  if (resetPinSettle) resetPinSettle(null);
  return new Promise((resolve) => {
    let pin = '';
    const settle = (v) => { if (resetPinSettle === settle) { resetPinSettle = null; modalRoot.innerHTML = ''; window.resetPinKey = null; } resolve(v); };
    resetPinSettle = settle;
    const draw = (err) => {
      const d = document.getElementById('reset-pindots');
      if (d) {
        d.innerHTML = [0, 1, 2, 3].map((i) => `<i class="dot${!err && i < pin.length ? ' on' : ''}"></i>`).join('');
        d.className = err ? 'pindots err' : 'pindots';
      }
    };
    window.resetPinKey = async (k) => {
      const m = document.getElementById('reset-pinmsg');
      if (m) m.textContent = '';
      if (k === 'C') pin = '';
      else if (k === '⌫') pin = pin.slice(0, -1);
      else if (pin.length < 4) pin += k;
      draw(false);
      if (pin.length === 4) {
        const j = await api('/api/parent/verify-pin', { pin });
        if (j.ok) { settle(true); return; }
        if (j.error === 'PIN_LOCKED') {
          if (m) m.textContent = `试太多次啦，${Math.ceil((j.retryAfter || 300) / 60)} 分钟后再试`;
        } else {
          if (m) m.textContent = '密码不对，再试一次';
        }
        pin = '';
        draw(true);
        setTimeout(() => { if (pin === '') draw(false); }, 750);
      }
    };
    modalRoot.innerHTML = `<div class="overlay"><div class="modal">
      <p style="font-size:var(--fs-body);line-height:1.6;margin:.4em 0 1em">输入家长 PIN 以确认重置全部数据</p>
      <div class="pindots" id="reset-pindots"><i class="dot"></i><i class="dot"></i><i class="dot"></i><i class="dot"></i></div><div id="reset-pinmsg" style="color:var(--danger-text);min-height:22px"></div>
      <div class="pinpad">${['1', '2', '3', '4', '5', '6', '7', '8', '9', 'C', '0', '⌫'].map((k) => `<button onclick="resetPinKey('${k}')">${k}</button>`).join('')}</div>
      <div class="rowbtns"><button class="smallbtn" id="reset-pin-cancel">取消</button></div></div></div>`;
    document.getElementById('reset-pin-cancel').onclick = () => settle(null);
  });
}

/* 页面内自定义输入弹窗（Promise<string|null>）：替代原生 prompt 对话框，语义与原生一致——
   「取消」resolve(null)（调用方据此中止），「确定」resolve(输入框当前值字符串)；
   点遮罩不关闭。再开新弹窗（或改开 askConfirm）会先把上一个待决输入以 null 取消。 */
let promptSettle = null;
function askPrompt({ title = '', label = '', placeholder = '', initialValue = '', inputType = 'text', okText = '确定' } = {}) {
  if (promptSettle) promptSettle(null);
  if (confirmSettle) confirmSettle(false);
  return new Promise((resolve) => {
    const settle = (v) => { if (promptSettle === settle) { promptSettle = null; modalRoot.innerHTML = ''; } resolve(v); };
    promptSettle = settle;
    modalRoot.innerHTML = `<div class="overlay"><div class="modal">
      ${title ? `<h2>${esc(title)}</h2>` : ''}
      ${label ? `<p style="font-size:var(--fs-body);line-height:1.6;margin:.4em 0 .4em">${esc(label)}</p>` : ''}
      <input id="ap-input" type="${esc(inputType)}" value="${esc(initialValue)}" placeholder="${esc(placeholder)}"
        ${inputType === 'number' ? 'inputmode="numeric"' : ''} autocomplete="off">
      <div class="rowbtns">
        <button class="smallbtn" id="ap-cancel">取消</button>
        <button class="smallbtn primary" id="ap-ok">${esc(okText)}</button>
      </div></div></div>`;
    const input = document.getElementById('ap-input');
    document.getElementById('ap-cancel').onclick = () => settle(null);
    document.getElementById('ap-ok').onclick = () => settle(input.value);
    input.onkeydown = (e) => { if (e.key === 'Enter') settle(input.value); };
    input.focus();
    input.select();
  });
}
let celebrateTimer = null;
function celebrateCheckin(isEarly, childId, streak) {
  modalRoot.innerHTML = `
  <div class="overlay"><div class="modal" data-celebrate="1">
  <div class="stamp stamp-in stamp-big">已交</div>
  <h2>提交成功！</h2>
  <p>${isEarly ? ic('zap') + ' 早交奖励已锁定！等家长审核通过就能拿到经验啦' : '已经交给家长审核啦，通过后就能拿到经验'}</p>
  ${typeof streak === 'number' ? `<p class="pill">连续打卡 ${streak} 天</p>` : ''}
  <button class="bigbtn" onclick="closeModal();goCheckinPage(${Number(childId)})">继续</button>
  </div></div>`;
  if (celebrateTimer) clearTimeout(celebrateTimer);
  celebrateTimer = setTimeout(() => {
    if (modalRoot.querySelector('[data-celebrate]')) { closeModal(); goCheckinPage(Number(childId)); }
  }, 900);
}
function celebrate(title, img, text, extra = '') {
  showModal(`<div class="confetti">${ic('sparkles')}</div><h2>${title}</h2>${img ? `<img loading="lazy" src="${img}">` : ''}<p>${text}</p>${extra}`);
}
window.closeModal = closeModal;

/* ---------- 手感打磨 FX 助手（2026-10-21 第一批）：飘字/星星粒子，瞬时、不阻塞，结束即删 ---------- */
const REDUCED_MOTION = () => window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function floatText(el, text, cls = '') {
  if (!el) return;
  const s = document.createElement('span');
  s.className = 'fx-float ' + cls;
  s.textContent = text;
  el.appendChild(s);
  setTimeout(() => s.remove(), 950);
}
function spawnSparks(el, n = 7) {
  if (!el || REDUCED_MOTION()) return;
  const chars = ['✦', '✧', '•', '✦'];
  const colors = ['#FFB340', '#FF8C42', '#FFC93C', '#58b368'];
  for (let i = 0; i < n; i++) {
    const s = document.createElement('span');
    s.className = 'fx-spark';
    s.textContent = chars[i % chars.length];
    const ang = (Math.PI * 2 * i) / n + Math.random() * 0.5;
    const dist = 46 + Math.random() * 30;
    s.style.setProperty('--dx', (Math.cos(ang) * dist).toFixed(1) + 'px');
    s.style.setProperty('--dy', (Math.sin(ang) * dist - 14).toFixed(1) + 'px');
    s.style.color = colors[i % colors.length];
    s.style.fontSize = (13 + Math.random() * 8).toFixed(0) + 'px';
    el.appendChild(s);
    setTimeout(() => s.remove(), 880);
  }
}

/* 待展示通知（如连击里程碑宝箱）：逐条弹庆祝，关掉一条确认一条，避免重复弹 */
const seenNoticeIds = new Set();
function showChildNotices(kids) {
  const items = [];
  for (const k of kids || []) {
    for (const n of (k.notices || [])) {
      if (!seenNoticeIds.has(n.id)) { seenNoticeIds.add(n.id); items.push({ k, n }); }
    }
  }
  if (!items.length) return;
  const step = () => {
    const it = items.shift();
    if (!it) return;
    modalCloseHook = async () => { await api('/api/notices/ack', { ids: [it.n.id] }); step(); };
    const p = it.n.payload || {};
    if (it.n.kind === 'streak_box') {
      celebrate('连击大奖！', null,
        `${esc(it.k.name)} 连续打卡 ${p.streak} 天，太有毅力啦！<br>开箱奖励 +${p.xp} 经验<br>${ic('award')} 获得称号「${esc(p.title || '')}」 ${p.sticker ? stickerIcon(p.sticker) : ''}`);
    } else if (it.n.kind === 'evolution') {
      // 进化过场：全屏闪光 2–3 秒，点任意处可跳过；关闭时确认通知
      modalRoot.innerHTML = `<div class="overlay"><div class="modal evo" id="evo-${it.n.id}">
        <div class="evo-flash">${ic('sparkles')}</div><h2>进化啦！</h2>
        <p style="font-size:var(--fs-body)">${esc(p.from || '')} 进化成了</p>
        ${p.img ? `<img loading="lazy" class="evo-img" src="${p.img}">` : ''}
        <h2>${esc(p.to || '')}</h2><p style="color:var(--text-2)">点一下继续</p></div></div>`;
      document.getElementById('evo-' + it.n.id).onclick = () => closeModal();
      setTimeout(() => { if (document.getElementById('evo-' + it.n.id)) closeModal(); }, 3000);
    } else if (it.n.kind === 'evo-ready') {
      // v11：伊布已学会妖精招式、到 16 级可进化成仙子伊布——提示孩子去背包确认
      modalRoot.innerHTML = `<div class="overlay"><div class="modal evo" id="evo-${it.n.id}">
        <div class="evo-flash">${ic('sparkles')}</div><h2>可以进化啦！</h2>
        <p style="font-size:var(--fs-body)">伊布学会了妖精系招式，升到 16 级就能进化成</p>
        ${p.img ? `<img loading="lazy" class="evo-img" src="${p.img}">` : ''}
        <h2>${esc(p.to || '仙子伊布')}</h2><p style="color:var(--text-2)">去伙伴页的背包里确认进化吧！</p></div></div>`;
      document.getElementById('evo-' + it.n.id).onclick = () => closeModal();
      setTimeout(() => { if (document.getElementById('evo-' + it.n.id)) closeModal(); }, 3000);
    } else { modalCloseHook = null; step(); }
  };
  step();
}

/* ---------- 首页 ---------- */
const LANG = {
  homeTitle: ['打卡大冒险', 'Check-in Adventure'],
  parentEntry: ['家长入口', 'Parent portal'],
  pendingReview: ['待审', ' pending review'],
  weekend: [' 周末啦，道馆开放！', " It's the weekend! The Gym is open!"],
  pet: ['宠物', 'Pet'],
  submitted: ['今日已交 ', 'Submitted today: '],
  subjectsApproved: [' 科 通过 ', ' subjects Approved: '],
  subjects: [' 科', ' subjects'],
  firstCheckin: ['今天还没打卡，去交第一科吧！', 'No check-ins yet today. Submit your first subject!'],
  streak: ['连续打卡 ', 'Streak: '],
  days: [' 天', ' days'],
  encounter: [' 有野外遭遇等你！', ' A wild encounter awaits!'],
  sealedEgg: [' 封印蛋 ×', ' Sealed eggs ×'],
  quizRemaining: [' 今日问答（剩 ', ' Daily Quiz ('],
  questionsRemaining: [' 题）', ' left)'],
  quizDone: [' 今日问答已完成 ', ' Daily Quiz completed '],
  dailyEnglish: [' 每日英语（', ' Daily English ('],
  closeParen: ['）', ')'],
  englishDone: [' 今日英语已完成 ', ' Daily English completed '],
  companions: ['伙伴', 'Companions'],
  checkin: ['打卡', 'Check-in'],
  gym: ['道馆', 'Gym'],
  pokedex: ['图鉴', 'Pokédex'],
  back: ['返回', 'Back'],
};

function tr(zh, en) {
  return state.lang === 'en' ? en : zh;
}

function trGrade(label) {
  if (state.lang !== 'en') return label;
  if (label === '一年级') return 'Grade 1';
  if (label === '三年级') return 'Grade 3';
  return label;
}

async function loadOverview(showHatch = true) {
  const j = await api('/api/overview');
  if (!j.ok) { app.innerHTML = '<p>加载失败，请刷新</p>'; return; }
  state.overview = j;
  state.lang = j.englishMode ? 'en' : 'zh';
  document.body.classList.toggle('lang-en', state.lang === 'en');
  if (j.session) {
    state.sessionKind = j.session.kind;
    state.sessionChildId = j.session.childId;
    if (j.session.kind === 'parent') {
      state.pinOk = j.session.pinOk === true;
      if (state.pinOk) state.needPin = false;
    }
  }
  if (showHatch) {
    for (const k of j.children) {
      if (k.hatchedEggs && k.hatchedEggs.length) {
        const p = k.hatchedEggs[0].pokemon;
        celebrate('封印解开了！', `/static/img/p${p.no}.webp`, `${k.name} 的封印蛋孵出了${p.name}，已经进图鉴啦！`);
      }
    }
  }
}

function avatarHtml(form, cls) {
  if (form.img) return `<img loading="lazy" class="${cls}" src="${form.img}" alt="">`;
  return `<div class="${cls}" style="display:flex;align-items:center;justify-content:center">${eggHtml(form.egg || EGG_FALLBACK, 60)}</div>`;
}

function renderHome() {
  setArea('child');
  const o = state.overview;
  app.innerHTML = `
  <div class="topbar"><span></span><div class="title">${ic('home')} ${tr(...LANG.homeTitle)}</div>
    <button class="iconbtn" onclick="goParent()">${tr(...LANG.parentEntry)}${o.pendingReviewCount ? ` (${o.pendingReviewCount}${tr(...LANG.pendingReview)})` : ''}</button></div>
  <p style="color:var(--text-2)">${o.today}${o.isWeekend ? tr(...LANG.weekend) : ''}</p>
  ${o.children.map((k) => `
    <div class="card kidcard" role="button" tabindex="0" aria-label="${esc(trGrade(k.grade))} ${esc(tr(...LANG.pet))} Lv.${k.level}" onclick="goChild(${k.id})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();goChild(${k.id})}">
      <img class="avatar" src="${k.avatar}" alt="">
      <div style="flex:1;min-width:0">
        <div class="kidname">${esc(trGrade(k.grade))} ${tr(...LANG.pet)} Lv.${k.level}</div>
        <div class="kidsub">${k.todaySubmittedCount ? `${tr(...LANG.submitted)}${k.todaySubmittedCount}/5${tr(...LANG.subjectsApproved)}${k.todayApprovedCount}${tr(...LANG.subjects)}` : tr(...LANG.firstCheckin)}</div>
        <div class="streak">${ic('flame')} ${tr(...LANG.streak)}${k.streak}${state.lang === 'en' ? (k.streak === 1 ? ' day' : ' days') : ' 天'}</div>
        <div class="streak-countdown">${k.streak > 0 && k.streak % 7 === 0 ? tr('本周开箱已达成', 'Weekly box earned!') : tr(`距离下次开箱还差 ${7 - (k.streak % 7)} 天`, `${7 - (k.streak % 7)} days to your next streak box`)}</div>
        ${k.pendingEncounter ? '<div class="badge">' + ic('leaf') + tr(...LANG.encounter) + '</div>' : ''}
        ${k.sealedEggCount ? `<div class="badge">${ic('egg')}${tr(...LANG.sealedEgg)}${k.sealedEggCount}</div>` : ''}
        ${k.quizToday && k.quizToday.quota > 0 && k.quizToday.remaining > 0
          ? `<div style="margin-top:8px"><button class="smallbtn" style="font-size:var(--fs-body)" onclick="event.stopPropagation();openQuiz(${k.id})">${ic('puzzle')}${tr(...LANG.quizRemaining)}${k.quizToday.remaining}${tr(...LANG.questionsRemaining)}</button></div>` : ''}
        ${`<div style="margin-top:8px"><button class="smallbtn" style="font-size:var(--fs-body)" onclick="event.stopPropagation();openOakEnglish(${esc(k.id)})"><img class="chip-ic" src="/static/img/home/home-oak-english.webp" alt="">${tr(...LANG.dailyEnglish)}${esc(k.oakToday ? k.oakToday.listenedCount : 0)}/6${tr(...LANG.closeParen)}</button></div>`}
        ${(k.quizToday && k.quizToday.quota > 0 && k.quizToday.remaining === 0) || (k.oakToday && k.oakToday.completed) ? '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:4px">' + (k.quizToday && k.quizToday.quota > 0 && k.quizToday.remaining === 0 ? '<div class="badge">' + ic('puzzle') + tr(...LANG.quizDone) + ic('check') + '</div>' : '') + (k.oakToday && k.oakToday.completed ? '<div class="badge">' + ic('flask') + tr(...LANG.englishDone) + ic('check') + '</div>' : '') + '</div>' : ''}${k.quizToday && k.quizToday.quota > 0 && k.quizToday.remaining === 0 ? '<div id="diagEntry-' + k.id + '"></div>' : ''}
      </div><div style="font-size:22px;flex:none">›</div>
    </div>`).join('')}`;
  showChildNotices(o.children);
  loadDiagEntries();
}

/* 底部四 Tab（伙伴/打卡/道馆/图鉴）；「我」= 当前上下文的孩子：
   孩子会话是本人，家长会话是正在看的孩子（没有上下文时取第一个孩子） */
function selfChildId() {
  return state.childId || state.sessionChildId || (state.overview && state.overview.children[0] && state.overview.children[0].id);
}
function tabbar() {
  const id = selfChildId();
  const v = state.view;
  const on = (keys) => (keys.includes(v) ? 'on' : '');
  /* 底部 Tab 图标：小程序图标母版（修好版，1024→96 WebP），默认/点中两态按当前页切换 */
  const ic = (keys, name) => `<img class="tab-ic" src="/static/img/tabs/${name}${keys.includes(v) ? '-active' : ''}.webp" alt="" draggable="false">`;
  return `<div class="tabbar">
    <button class="${on(['child', 'eggs', 'encounter', 'daily-english', 'backpack'])}" onclick="goChild(${id})"><span class="e">${ic(['child', 'eggs', 'encounter', 'daily-english', 'backpack'], 'tab-home')}</span>${tr(...LANG.companions)}</button>
    <button class="${on(['checkin', 'subject'])}" onclick="goCheckinPage(${id})"><span class="e">${ic(['checkin', 'subject'], 'tab-checkin')}</span>${tr(...LANG.checkin)}</button>
    <button class="${on(['gym'])}" onclick="goGym(${id})"><span class="e">${ic(['gym'], 'tab-gym')}</span>${tr(...LANG.gym)}</button>
    <button class="${on(['pokedex'])}" onclick="goPokedex(${id})"><span class="e">${ic(['pokedex'], 'tab-pokedex')}</span>${tr(...LANG.pokedex)}</button>
  </div>`;
}
/* 孩子子页常驻顶栏：返回 + 标题 + 连击 chip + 家长入口 */
function glossKey(){ return 'gloss_' + selfChildId(); }
function glossOn(){ try { return localStorage.getItem(glossKey()) === '1'; } catch(e){ return false; } }
function toggleGloss(btn){ const on = !glossOn(); try { localStorage.setItem(glossKey(), on ? '1' : '0'); } catch(e){} document.body.classList.toggle('show-gloss', on); if (btn) btn.classList.toggle('gloss-on', on); }

function childTop(title, backFn, streak, glossBtn) {
  document.body.classList.toggle('show-gloss', state.lang === 'en' && glossOn());
  return `<div class="topbar"><button class="iconbtn" onclick="${backFn}">‹ ${tr(...LANG.back)}</button><div class="title">${title}</div>
  <span style="display:flex;gap:6px;align-items:center;flex:none">${state.lang === 'en' && glossBtn ? `<button class="iconbtn${glossOn() ? ' gloss-on' : ''}" onclick="toggleGloss(this)" title="${tr('显示中文释义', 'Show Chinese gloss')}">中</button>` : ''}<button class="iconbtn" onclick="goParent()" title="${tr(...LANG.parentEntry)}">${ic('lock')}</button></span></div>`;
}

/* ---------- 孩子主页 ---------- */
const SUBJ_STATUS = { pending: ['待审核', 'pending'], approved: ['已通过', 'approved'], rejected: ['被驳回', 'rejected'] };
async function goChild(id) {
  careRoomUnmount(); // 离开养成页先卸掉房间
  state.childId = id;
  setArea('child');
  state.view = 'child';
  // 返工 2026-11-14 6a：三科今日数据与主数据并行预取（loadEntry 消费预取 promise，
  // 不多发请求；冷缓存重登录时今日任务不再串行等两轮）。
  DE.prefetch(id); DC.prefetch(id); DM.prefetch(id);
  const _pl = beginPageLoad(() => goChild(id));
  const snap = lcAvailable() ? await lcSnapshot(id) : null;
  let j;
  if (snap) {
    j = { ok: true, child: await lcOverlayPending(snap.child), isWeekend: snap.isWeekend };
  } else {
    const cached = state.childCache[id];
    const cachedFresh = cached && cacheFresh(state.childCacheAt[id]);
    if (cached) {
      j = { ok: true, child: cached, isWeekend: (state.childMeta[id] || {}).isWeekend };
      if (!cachedFresh) refreshChildInBackground(id, 'child');
    } else {
      j = await api('/api/child?id=' + id);
      if (!j.ok) { _pl.finish(); if (j.error === 'FORBIDDEN') { goHome2(); return; } app.innerHTML = slowHtml(); return; }
      storeChild(id, j);
      if (lcAvailable()) lcEnsureFull(id).catch(() => {});
    }
  }
  const k = j.child;
  const form = k.form || { formName: '', img: '', egg: null };
  // titles／stickers 在旧快照里可能是数据库 JSON 文本（字符串），直接 .map 会抛错；只认数组。
  Object.assign(LANG, {
    childSlice2Home: ['首页', 'Home'], childSlice2Parent: ['家长', 'Parent'],
    childSlice2Hatched: ['封印解开了！', 'Sealed egg hatched!'],
    childSlice2Morning: ['早上好', 'Morning'], childSlice2Noon: ['中午好', 'Afternoon'],
    childSlice2Afternoon: ['下午好', 'Afternoon'], childSlice2Evening: ['晚上好', 'Evening'],
    // 返工 2026-11-14 item 4/6b：英文问候去 "Good"——246px 文栏一行放不下 "Hi, 测试大宝! Good afternoon"（实测 277px；
    // 换 "Good afternoon, 测试大宝!" 仍 251px，超 5px），去 "Good" 后最长 "Hi, 测试大宝! Afternoon" 实测 222px。
    childSlice2KeepCatching: ['继续抓！', 'Keep catching! '], childSlice2GoCatch: ['去抓', 'Go catch '],
    childSlice2Gym: ['周末道馆', 'Weekend Gym'], childSlice2Eggs: ['收藏馆', 'Collection Hall'],
    childSlice2Backpack: ['背包 道具', 'Backpack Items'], childSlice2Checkin: ['去打卡', 'Go check in'],
    childSlice2Submitted: ['今日已交', 'Submitted'], childSlice2Streak: ['连击天数', 'Streak'],
    childSlice2Badges: ['徽章', 'Badges'], childSlice2Species: ['图鉴种数', 'Species'],
    childSlice2TotalXp: ['累计经验 ', 'Total XP: '], childSlice2Moves: ['已学会的招式', 'Moves learned'],
    childSlice2Skill: ['技能Lv.', 'Skill Lv.'], childSlice2FirstMove: ['升到 2 级就能学第一个招式啦！', 'Reach Lv.2 to learn your first move!'],
    childSlice2Fragments: ['技能碎片 ', 'Skill fragments '], childSlice2Upgrade: ['3枚可给一个招式升1级', '3 fragments upgrade a move by 1 level']
  });
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const sealedEggs = Array.isArray(k.sealedEggs) ? k.sealedEggs : [];
  const moves = Array.isArray(k.moves) ? k.moves : [];
  const quiz = k.quiz || { fragments: 0, nextFragmentIn: 0 };
  const titles = Array.isArray(k.titles) ? k.titles : [];
  // 称号与贴纸成对发（每 7 天 / 30 天里程碑各 1 个）：徽章行一里程碑只显示一个图标，用贴纸 emoji 作彩色图标，点开弹框看对应称号；数量即里程碑数，不再称号＋贴纸双计
  window._childTitles = titles;
  const stickers = Array.isArray(k.stickers) ? k.stickers : [];
  window._childStickers = stickers;
  if (k.hatchedEggs && k.hatchedEggs.length) {
    const hp = k.hatchedEggs[0].pokemon;
    celebrate(tr(...LANG.childSlice2Hatched), `/static/img/p${hp.no}.webp`, tr(`封印蛋孵出了${hp.name}，已经进图鉴啦！`, `${hp.name} hatched from a sealed egg and joined your Pokédex!`));
    k.hatchedEggs = [];
  }
  const hour = new Date().getHours();
  const greetPair = hour < 11 ? LANG.childSlice2Morning : hour < 14 ? LANG.childSlice2Noon : hour < 18 ? LANG.childSlice2Afternoon : LANG.childSlice2Evening;
  window._kidMoves = moves;
  window._kidId = k.id;
  window._kidQuiz = quiz;
  // 伙伴页导航两列网格（2026-10-27 空间审查 B-01）：去打卡全宽主按钮，其余进 navgrid；按钮文案一行不换行（2026-10-27 §53 铁律：大木博士收短、字号 14px、nowrap＋ellipsis；14px 是带图标能放下的尺寸——16px 时大木博士溢出 12px，演示页 16px 是无图标纯文本）
  const navBtns = [];
  if (k.quizToday && k.quizToday.quota > 0 && k.quizToday.remaining > 0) navBtns.push(`<button class="bigbtn green" onclick="openQuiz(${k.id})"><span class="btn-plate pl-52">${ic('puzzle')}</span><span class="btn-tx">${tr(...LANG.quizRemaining)}${k.quizToday.remaining}${tr(...LANG.questionsRemaining)}</span></button>`);
  navBtns.push(`<button class="bigbtn green" onclick="openOak(${esc(k.id)})"><span class="btn-plate pl-52"><img class="btn-ic" src="/static/img/home/home-oak.webp" alt=""></span><span class="btn-tx">${tr('大木博士之家', "Dr. Oak's House")}</span></button>`);
  if (k.pendingEncounter) navBtns.push(`<button class="bigbtn green" onclick="goEncounter(${k.id})">${k.pendingEncounter.hasQuiz ? `<span class="btn-plate pl-52">${ic('play')}</span><span class="btn-tx">${tr(...LANG.childSlice2KeepCatching)}${esc(k.pendingEncounter.name)}</span>` : `<span class="btn-plate pl-52">${ic('leaf')}</span><span class="btn-tx">${tr(...LANG.childSlice2GoCatch)}${esc(k.pendingEncounter.name)}</span>`}</button>`);
  // 英语交流（与小程序同步：首页直达大木博士英语，💬；道馆只留底部导航栏入口，首页不再重复放）
  navBtns.push(`<button class="bigbtn blue" onclick="openOakEnglish(${k.id})"><span class="btn-plate pl-52"><img class="btn-ic" src="/static/img/home/home-oak-english.webp" alt=""></span><span class="btn-tx">${bi('英语交流', 'English Chat')}</span></button>`);
  navBtns.push(`<button class="bigbtn ghost" onclick="goEggs(${k.id})"><span class="btn-plate pl-52"><img class="btn-ic" src="/static/img/home/home-collection.webp" alt=""></span><span class="btn-tx">${tr(...LANG.childSlice2Eggs)} (${sealedEggs.length})</span></button>`);
  navBtns.push(`<button class="bigbtn ghost" onclick="goBackpack(${k.id})"><span class="btn-plate pl-52"><img class="btn-ic" src="/static/img/home/home-backpack.webp" alt=""></span><span class="btn-tx">${tr(...LANG.childSlice2Backpack)}</span></button>`);
  _pl.finish();
  // 任务 118：招式只露首行 4 格（4 列等宽 grid 撑满内容宽，390px 下每格约 84px；任务 111 的 5 格 66px 定宽留了 16px 右空且卡挤），其余收进「全部招式」展开；下标 i 为 moves 里的全局下标（showMoveDetail 用 window._kidMoves[i]）
  const moveBtn = (m, i) => `<button class="moveicon" onclick="showMoveDetail(${i})"><img loading="lazy" src="${moveIconSrc(m)}" alt="" onerror="this.remove()"><span>${esc(m.name)}${m.early ? ' ' + ic('puzzle') : ''}<small class="skillbadge${(m.skillLevel || 1) >= 5 ? ' max' : ''}">${tr(...LANG.childSlice2Skill)}${m.skillLevel || 1}</small></span></button>`;
  document.body.classList.toggle('show-gloss', state.lang === 'en' && glossOn());
  app.innerHTML = `
  <div class="topbar"><button class="iconbtn" onclick="goHomeBtn()">‹ ${tr(...LANG.childSlice2Home)}</button><div class="title">${esc(k.name)}</div>
  <span style="display:flex;gap:8px;align-items:center;flex:none"><span class="topchip">${ic('flame')} ${k.streak}</span>${state.lang === 'en' ? `<button class="iconbtn${glossOn() ? ' gloss-on' : ''}" onclick="toggleGloss(this)" title="${tr('显示中文释义', 'Show Chinese gloss')}">中</button>` : ''}<button class="iconbtn" onclick="goParent()" title="${tr(...LANG.parentEntry)}">${ic('lock')}</button></span></div>
  <div class="card minicard">
    <div class="mc-img">${form.img ? `<img src="${form.img}" alt="">` : eggHtml(form.egg || EGG_FALLBACK, 72)}</div>
    <div class="mc-body">
      <div class="mc-greet">${tr(`嗨，${esc(k.name)}！${greetPair[0]}`, `Hi, ${esc(k.name)}! ${greetPair[1]}`)}</div>
      <div class="mc-name"><span class="lvl">${esc(form.formName)} Lv.${k.level}</span>${titles.length ? titles.map((t, i) => `<button type="button" class="badge" style="border:none;cursor:pointer;font-size:20px;line-height:1" onclick="showTitleBadge(${i})" aria-label="${esc(t)}">${esc(stickers[i] || '🏅')}</button>`).join('') : ''}</div>
      <div class="xpbar mc-xp"><i style="clip-path:inset(0 ${100 - Math.min(100, Math.round(k.xpIntoLevel / k.xpForLevelSpan * 100))}% 0 0)"></i></div>
      <div class="mc-sub">${tr(`再拿 ${k.xpToNext} 经验升级 · 累计经验 ${k.totalXp}`, `${k.xpToNext} XP to level up · Total XP ${k.totalXp}`)}</div>
    </div>
  </div>
  <div class="statgrid">
    <div class="statcell"><b>${k.todaySubmittedCount || 0}/5</b><span>${tr(...LANG.childSlice2Submitted)}</span></div>
    <div class="statcell"><b>${ic('flame')} ${k.streak}</b><span>${tr(...LANG.childSlice2Streak)}</span></div>
    <div class="statcell"><b>${k.badgeCount || 0}</b><span>${tr(...LANG.childSlice2Badges)}</span></div>
    <div class="statcell"><b>${k.pokedexCount || 0}</b><span>${tr(...LANG.childSlice2Species)}</span></div>
  </div>
  <div id="dailyEnglishEntry-${k.id}">${DE.skeletonHtml(k.id)}</div>
  <div id="dailyChineseEntry-${k.id}">${DC.skeletonHtml(k.id)}</div>
  <div id="dailyMathEntry-${k.id}">${DM.skeletonHtml(k.id)}</div>
  <button class="bigbtn icbtn hero" onclick="goCheckinPage(${k.id})"><span class="btn-plate pl-48"><img class="btn-ic" src="/static/img/home/home-checkin.webp" alt=""></span> ${tr(...LANG.childSlice2Checkin)}</button>
  ${k.quizToday && k.quizToday.quota > 0 && k.quizToday.remaining === 0 ? '<div class="note">' + ic('puzzle') + ' ' + bi('今日问答全部答完啦，明天再来挑战！', "All of today's quiz questions are done, come back tomorrow!") + '</div><div id="diagEntry-' + k.id + '"></div>' : ''}
  ${k.oakToday && k.oakToday.completed ? '<div class="note">' + ic('flask') + ' ' + tr(...LANG.englishDone) + ' ' + ic('check') + '</div>' : ''}
  <div class="section-title sec-head"><span>${biTitle(...LANG.childSlice2Moves)}</span>${moves.length > 4 ? `<button type="button" class="smallbtn" id="movesExpandBtn" aria-expanded="false" onclick="toggleMovesExpand(this)">${tr('全部招式 ▸', 'All moves ▸')}</button>` : ''}</div>
  ${moves.length ? `<div class="moveicons moves5">${moves.slice(0, 4).map((m, i) => moveBtn(m, i)).join('')}</div>` : `<p style="color:var(--text-2)">${tr(...LANG.childSlice2FirstMove)}</p>`}
  ${moves.length > 4 ? `<div class="moveicons moves5" id="movesRest" hidden>${moves.slice(4).map((m, j) => moveBtn(m, j + 4)).join('')}</div>` : ''}
  ${quiz.fragments >= 3
    ? `<p style="color:var(--text-2)">${bi(...LANG.childSlice2Fragments)}${quiz.fragments}/3 ${bi(...LANG.childSlice2Upgrade)}</p>`
    : `<p style="color:var(--text-2)">${bi(...LANG.childSlice2Fragments)}${quiz.fragments}/3 ${bi(`再答对 ${quiz.nextFragmentIn} 题得下一块`, `Answer ${quiz.nextFragmentIn} more questions for the next fragment`)}</p>`}
  ${navBtns.length ? `<div class="grid2 navgrid">${navBtns.join('')}</div>` : ''}
  <div id="unitTestEntry-${k.id}"></div>
  <div id="schoolTestEntry-${k.id}"></div>
  <p style="color:var(--text-2)">${bi(`本周已打卡 ${k.weekApproved} 天${j.isWeekend ? '，周末道馆已开放！' : ''}`, (k.weekApproved===1 ? 'Checked in 1 day this week' : `Checked in ${k.weekApproved} days this week`) + (j.isWeekend ? ', The Weekend Gym is open!' : ''))}</p>
  <div id="coopEntry"></div><div id="careEntry"></div><div id="partyRowEntry" style="margin-top:12px"></div>
  ${tabbar()}`;
  playXpReturnFx(k);
  showChildNotices([k]);
  loadCoopEntry(k.id);
  loadPartyRow(k.id);
  loadDiagEntry(k.id);
  loadUnitTestEntry(k.id);
  loadSchoolTestEntry(k.id);
  loadDailyEnglishEntry(k.id);
  loadDailyChineseEntry(k.id);
  loadDailyMathEntry(k.id);
  if (lcAvailable() && lcShouldSync()) lcSyncChild(id);
}

/* 任务 111：首页招式展开/收起（局部切换，不重渲染整页） */
window.toggleMovesExpand = function (btn) {
  const rest = document.getElementById('movesRest');
  if (!rest) return;
  const open = rest.hidden;
  rest.hidden = !open;
  btn.setAttribute('aria-expanded', String(open));
  btn.innerHTML = open ? tr('收起', 'Collapse') : tr('全部招式 ▸', 'All moves ▸');
};

/* 问答里攒下的经验增量（sessionStorage 一次性标记）：回到伙伴页时经验条从旧值补间到新值＋主宠 squash 一次。
   消费即删，直接刷新页面不会重播；跨等级时旧值钳到 0（条从空涨满也可接受）。 */
function playXpReturnFx(k) {
  let gain = 0;
  try {
    gain = parseInt(sessionStorage.getItem('sm_xpgain') || '0', 10) || 0;
    if (gain > 0) sessionStorage.removeItem('sm_xpgain');
  } catch (e) { /* 隐私模式等场景静默跳过 */ }
  if (gain <= 0) return;
  const bar = app.querySelector('.minicard .xpbar > i');
  if (bar) {
    const target = bar.style.clipPath;
    const span = k.xpForLevelSpan || 1;
    const oldPct = Math.max(0, Math.min(100, Math.round((k.xpIntoLevel - gain) / span * 100)));
    bar.style.clipPath = `inset(0 ${100 - oldPct}% 0 0)`;
    requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.clipPath = target; }));
  }
  const heroImg = app.querySelector('.minicard .mc-img img') || app.querySelector('.minicard .mc-img .eggshape');
  if (heroImg) {
    heroImg.classList.add('squash-once');
    setTimeout(() => heroImg.classList.remove('squash-once'), 700);
  }
}

/* ---------- 打卡（按科独立） ---------- */
const SUBJECTS = ['语文', '数学', '英语', '阅读', '其他'];

async function goCheckinPage(id) {
  careRoomUnmount(); // 离开养成页先卸掉房间
  state.childId = id;
  state.view = 'checkin';
  const _pl = beginPageLoad(() => goCheckinPage(id));
  const snap = lcAvailable() ? await lcSnapshot(id) : null;
  let j;
  if (snap) {
    j = { ok: true, child: await lcOverlayPending(snap.child) };
  } else {
    const cached = state.childCache[id];
    const cachedFresh = cached && cacheFresh(state.childCacheAt[id]);
    if (cached) {
      j = { ok: true, child: cached };
      if (!cachedFresh) refreshChildInBackground(id, 'checkin');
    } else {
      j = await api('/api/child?id=' + id);
      if (!j.ok) { _pl.finish(); if (j.error === 'FORBIDDEN') { goHome2(); return; } app.innerHTML = slowHtml(); return; }
      storeChild(id, j);
      if (lcAvailable()) lcEnsureFull(id).catch(() => {});
    }
  }
  const k = j.child;
  const subs = k.todaySubjects || [];
  const doneCount = subs.filter((t) => t.checkin && t.checkin.status !== 'rejected').length;
  const nextIdx = subs.findIndex((t) => !t.checkin);
  Object.assign(LANG, {
    checkinSlice3Title: ['作业打卡', 'Check-in'],
    checkinSlice3Note: ['每科单独审核，21:30 前提交有早交奖励，经验 ×1.2。', 'Each subject is reviewed on its own. Submit before 21:30 for an early bonus, XP ×1.2.'],
    checkinSlice3Submit: tr('提交', 'Submit'),
    checkinSlice3Edit: tr('修改', 'Edit'),
    checkinSlice3Pending: tr('待审核', 'Pending'),
    checkinSlice3Approved: tr('已通过', 'Approved'),
    checkinSlice3Rejected: tr('被驳回', 'Rejected'),
    checkinSlice3NotSubmitted: tr('未提交', 'Not submitted'),
    checkinSlice3PendingSync: tr('待同步', 'Pending sync'),
    checkinSlice3ParentSays: tr('家长说：', 'Parent says:'),
    checkinSlice3Photos: tr('照片', 'Photos'),
  });
  const checkinSlice3Status = {
    '待审核': LANG.checkinSlice3Pending,
    '已通过': LANG.checkinSlice3Approved,
    '被驳回': LANG.checkinSlice3Rejected,
    '未提交': LANG.checkinSlice3NotSubmitted,
    '待同步': LANG.checkinSlice3PendingSync
  };
  const isBi = state.lang === 'en';
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  _pl.finish();
  app.innerHTML = `
  ${childTop(biTitle(...LANG.checkinSlice3Title), `goChild(${id})`, k.streak, true)}
  <div class="checkin-head"><strong>${tr(`已交 ${doneCount} / ${subs.length} 科`, `Submitted ${doneCount} of ${subs.length}`)}</strong><span>${tr(`连续打卡 ${k.streak} 天`, `Streak ${k.streak}${k.streak === 1 ? ' day' : ' days'}`)}</span></div>
  <div class="checkin-progress"><div class="xpbar progress"><i style="clip-path:inset(0 ${100 - Math.round(doneCount / Math.max(subs.length, 1) * 100)}% 0 0)"></i></div></div>
  <div class="checkin-note">${tr(...LANG.checkinSlice3Note)}</div>
  <div class="checkin-list">${subs.map((t, i) => {
    const c = t.checkin;
    let btn = '', extra = '';
    if (!c) btn = `<button class="smallbtn primary" onclick="event.stopPropagation();goSubjectDetail(${id},'${t.subject}')">${LANG.checkinSlice3Submit}</button>`;
    else if (c.status === 'rejected') { btn = `<button class="smallbtn danger" onclick="event.stopPropagation();goSubjectDetail(${id},'${t.subject}')">${LANG.checkinSlice3Edit}</button>`; extra = c.reason ? `<div class="sc-reason">${LANG.checkinSlice3ParentSays}${esc(c.reason)}</div>` : ''; }
    return `<div class="subjcard${window._popSubject === t.subject ? ' card-pop' : ''}${i === nextIdx ? ' next' : ''}" onclick="goSubjectDetail(${id},'${t.subject}')">
      <div class="sc-head"><span class="sc-name">${t.subject}</span>
      ${c ? `<span class="sc-status ${c.status}">${checkinSlice3Status[SUBJ_STATUS[c.status][0]] || SUBJ_STATUS[c.status][0]}${c.status === 'approved' ? ' +' + (c.xpAwarded || 0) : ''}</span>` : `<span class="sc-status none">${LANG.checkinSlice3NotSubmitted}</span>`}${c && c._local === 'pending' ? ` <span class="sc-status pending">${LANG.checkinSlice3PendingSync}</span>` : ''}${btn}</div>
      ${c && c.note ? `<div class="sc-note">${ic('pencil')} ${esc(c.note)}</div>` : ''}
      ${c && c.photos && c.photos.length ? `<div class="sc-note">${ic('camera')} ${LANG.checkinSlice3Photos} ×${c.photos.length}</div>` : ''}
      ${extra}</div>`;
  }).join('')}</div>
  ${tabbar()}`;
  window._popSubject = null; // 卡片 pop 一次性消费，避免再次进页重播
  if (lcAvailable() && lcShouldSync()) lcSyncChild(id);
}
window.goCheckinPage = goCheckinPage;
window.goCheckin = goCheckinPage; // 兼容旧引用

/* 浏览器端压缩：长边 ≤1600px，JPEG 目标 ≈300KB/张（质量递减，必要时再缩边） */
function compressImage(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      let scale = Math.min(1, 1600 / Math.max(img.naturalWidth, img.naturalHeight));
      const render = (q) => {
        const cv = document.createElement('canvas');
        cv.width = Math.round(img.naturalWidth * scale);
        cv.height = Math.round(img.naturalHeight * scale);
        cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height);
        return cv.toDataURL('image/jpeg', q);
      };
      const kb = (s) => (s.length * 3 / 4) / 1024;
      let q = 0.85, out = render(q);
      while (kb(out) > 330 && q > 0.45) { q -= 0.13; out = render(q); }
      if (kb(out) > 330) { scale *= 0.75; out = render(0.7); }
      resolve(out);
    };
    img.onerror = reject;
    img.src = url;
  });
}

function viewPhoto(src) {
  modalRoot.innerHTML = `<div class="overlay" onclick="closeModal()"><img loading="lazy" class="bigimg" src="${src}"></div>`;
}
window.viewPhoto = viewPhoto;

/* 科目详情：备注 + 照片（≤3）+ 按状态提交/保存/重交；通过后锁定 */
async function goSubjectDetail(id, subject) {
  state.childId = id;
  state.view = 'subject';
  const cachedSd = state.childCache[id];
  const sdFresh = cachedSd && cacheFresh(state.childCacheAt[id]);
  const j = sdFresh ? { ok: true, child: cachedSd } : await api('/api/child?id=' + id);
  if (!j.ok) { if (j.error === 'FORBIDDEN') goHome2(); return; }
  const k = j.child;
  if (!sdFresh) storeChild(id, j);
  const entry = (k.todaySubjects || []).find((t) => t.subject === subject);
  let c = entry ? entry.checkin : null;
  if (!c && lcAvailable()) {
    try {
      const prows = await lcGetLocalByChild('checkins', id);
      const prow = (prows || []).find((r) => r && r._local === 'pending' && r.subject === subject && String(r.date || '') === lcShDate());
      if (prow) c = { id: prow.id, status: 'pending', note: prow.note || '', submittedAt: prow.submitted_at || '', isEarly: !!prow.is_early, xpAwarded: null, reason: null, photos: [], _local: 'pending' };
    } catch (e) { /* 缓存读取失败时按未提交处理 */ }
  }
  window._subj = {
    childId: id, subject, checkinId: c ? c.id : null, status: c ? c.status : 'none',
    photos: c ? (c.photos || []).map((p) => ({ id: p.id })) : [],
  };
  renderSubjectDetail(k, c);
}
window.goSubjectDetail = goSubjectDetail;

function renderSubjectDetail(k, c) {
  const S = window._subj;
  const editable = S.status !== 'approved';
  const srcOf = (p) => (p.id ? '/api/photos/' + p.id : p.dataUrl);
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  app.innerHTML = `
  ${childTop(S.subject + '打卡', `goCheckinPage(${S.childId})`, k.streak, true)}
  <div class="card">
    <div class="sc-head"><span class="sc-name" style="font-size:22px">${S.subject}</span>
    ${c ? `<span class="sc-status ${c.status}">${tr(...SUBJ_STATUS[c.status])}${c.status === 'approved' ? ' +' + (c.xpAwarded || 0) + tr(' 经验', ' XP') : ''}</span>` : `<span class="sc-status none">${tr('未提交', 'Not submitted')}</span>`}${c && c._local === 'pending' ? ` <span class="sc-status pending">${tr('待同步', 'Pending sync')}</span>` : ''}</div>
    ${c && c.status === 'rejected' && c.reason ? `<div class="note" style="background:var(--danger-bg)">${bi(`家长说：${esc(c.reason)}<br>改好后点下面按钮重新提交。`, `Parent says: ${esc(c.reason)}<br>Fix it and tap the button below to resubmit.`)}</div>` : ''}
    ${c ? `<div style="color:var(--text-2);font-size:var(--fs-label);margin-top:4px">${bi(`提交时间 ${esc(c.submittedAt || '')}${c.isEarly ? ' ' + ic('zap') + ' 早交' : ''}`, `Submitted at ${esc(c.submittedAt || '')}${c.isEarly ? ' ' + ic('zap') + ' Early Submit' : ''}`)}</div>` : ''}
    <label>${bi('备注（可选，写一句给家长看的话）', 'Note (optional, a message for parents)')}</label>
    <textarea id="subj-note" placeholder="${tr('比如：今天的课文读了两遍', "e.g. Read today's text twice")}" ${editable ? '' : 'disabled'}>${esc(c ? c.note || '' : '')}</textarea>
    <label>${bi('作业照片（最多 3 张）', 'Homework photos (up to 3)')}</label>
    <div class="thumbs">
      ${S.photos.map((p, i) => `<div class="thumb"><img loading="lazy" src="${srcOf(p)}" onclick="viewPhoto('${srcOf(p)}')">
        ${editable ? `<button class="thumb-x" onclick="delSubjPhoto(${i})">×</button>` : ''}</div>`).join('')}
      ${editable && S.photos.length < 3 ? `<button class="addtile" onclick="document.getElementById('subj-file').click()">＋<br>${tr('拍照', 'Take photo')}</button>` : ''}
    </div>
    <input type="file" id="subj-file" accept="image/*" style="display:none" onchange="addSubjPhoto(this)">
    ${S.status === 'none' ? `<button class="bigbtn" onclick="submitSubject()">${tr('提交打卡 ✔', 'Submit check-in ✔')}</button>` : ''}
    ${S.status === 'pending' ? `<button class="bigbtn" onclick="saveSubjectEdit()">${tr('保存修改', 'Save changes')}</button>` : ''}
    ${S.status === 'rejected' ? `<button class="bigbtn" onclick="submitSubject()">${tr('修改并重新提交', 'Edit and resubmit')}</button>` : ''}
    ${S.status === 'approved' ? `<div class="note">${bi(`${ic('lock')} 已经审核通过，这科锁定啦，不能再改。做得好！`, `${ic('lock')} Approved and locked — this subject can't be changed now. Well done!`)}</div>` : ''}
  </div>
  ${tabbar()}`;
}
function subjPayload() {
  const S = window._subj;
  return {
    note: document.getElementById('subj-note').value.trim(),
    photos: S.photos.map((p) => (p.id ? { id: p.id } : { data: p.dataUrl, contentType: 'image/jpeg' })),
  };
}
window.addSubjPhoto = async (input) => {
  const file = input.files && input.files[0];
  input.value = '';
  if (!file) return;
  try {
    const dataUrl = await compressImage(file);
    window._subj.photos.push({ dataUrl });
    // 保留已填备注再重渲染
    const note = document.getElementById('subj-note').value;
    const j = await api('/api/child?id=' + window._subj.childId);
    if (j.ok) {
      const c = (j.child.todaySubjects || []).find((t) => t.subject === window._subj.subject).checkin;
      renderSubjectDetail(j.child, c ? { ...c, note } : (note ? { note, status: window._subj.status, submittedAt: '', photos: [] } : null));
      const ta = document.getElementById('subj-note'); if (ta && !c) ta.value = note;
    }
  } catch { alert('这张照片读不出来，换一张试试'); }
};
window.delSubjPhoto = (i) => {
  window._subj.photos.splice(i, 1);
  const note = document.getElementById('subj-note').value;
  api('/api/child?id=' + window._subj.childId).then((j) => {
    if (!j.ok) return;
    const c = (j.child.todaySubjects || []).find((t) => t.subject === window._subj.subject).checkin;
    renderSubjectDetail(j.child, c);
    const ta = document.getElementById('subj-note'); if (ta && !c) ta.value = note;
  });
};
function lcLocalId() {
  if (window.crypto && typeof window.crypto.randomUUID === 'function') return 'local:' + window.crypto.randomUUID();
  return 'local:' + Date.now() + '-' + Math.floor(Math.random() * 1e9);
}
function lcTrackCmd(cmdId, info) {
  try {
    const cmds = JSON.parse(localStorage.getItem('sm.cmds.v1') || '{}');
    cmds[cmdId] = { type: info.type, childId: info.childId, payload: info.payload, at: Date.now() };
    localStorage.setItem('sm.cmds.v1', JSON.stringify(cmds));
  } catch (e) { /* 存储不可用时静默跳过 */ }
}

window.submitSubject = async () => {
  const S = window._subj;
  const { note, photos } = subjPayload();
  if (lcAvailable() && lcNetOff()) {
    const shNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Shanghai' }));
    const hm = String(shNow.getHours()).padStart(2, '0') + ':' + String(shNow.getMinutes()).padStart(2, '0');
    const isEarly = hm < '21:30';
    const localRowId = lcLocalId();
    try {
      await lcPutLocal('checkins', { child_id: S.childId, id: localRowId, date: lcShDate(), subject: S.subject, subjects: JSON.stringify([S.subject]), note, status: 'pending', submitted_at: hm, submitted_epoch: Math.floor(Date.now() / 1000), is_early: isEarly ? 1 : 0, xp_awarded: null, reason: null, photos: [], _local: 'pending' });
    } catch (e) { /* 本地预演失败不阻断入队 */ }
    const oldPhotos = photos.filter((p) => p.id).map((p) => ({ id: p.id }));
    const cmdId0 = await window.LocalCache.enqueue(S.childId, 'checkin', { childId: S.childId, subject: S.subject, note, photos: oldPhotos });
    lcTrackCmd(cmdId0, { type: 'checkin', childId: S.childId, payload: { childId: S.childId, subject: S.subject, note, photos: oldPhotos } });
    try {
      const m = JSON.parse(localStorage.getItem('sm.photoCmds.v1') || '{}');
      m[cmdId0] = { subject: S.subject, date: lcShDate(), localCheckinId: localRowId };
      localStorage.setItem('sm.photoCmds.v1', JSON.stringify(m));
    } catch (e) { /* 存储不可用时静默跳过 */ }
    for (let i = 0; i < photos.length; i++) {
      const p = photos[i];
      if (p.id || !p.data) continue;
      try {
        const blob = await fetch(p.data).then((r) => r.blob());
        await window.LocalCache.queuePhoto(S.childId, cmdId0, 'photo-' + i + '.jpg', blob);
      } catch (e) { /* 单张照片失败不阻断其他照片 */ }
    }
    const btn = app.querySelector('.card .bigbtn');
    if (btn) { btn.textContent = '✓ 已提交（待同步）'; btn.classList.add('btn-done'); btn.disabled = true; }
    window._popSubject = S.subject;
    celebrate('已记下啦！', null, '现在没网，打卡先存在手机里，联网后会自动交给家长审核（待同步）。通过前不算经验哦');
    setTimeout(() => { closeModal(); goCheckinPage(S.childId); }, 600);
    return;
  }
  const j = await api('/api/checkin', { childId: S.childId, subject: S.subject, note, photos });
  if (!j.ok) { alert(j.error || '提交失败'); return; }
  /* 手感打磨：按钮短暂变成功态（✓ 已提交＋回弹），回打卡页后该科卡片翻成待审核时轻 pop 一次 */
  const btn = app.querySelector('.card .bigbtn');
  if (btn) { btn.textContent = '✓ 已提交'; btn.classList.add('btn-done'); btn.disabled = true; }
  window._popSubject = S.subject;
  const _st = state.childCache && state.childCache[S.childId] && state.childCache[S.childId].streak;
  celebrateCheckin(j.isEarly, S.childId, (typeof _st === 'number' ? _st : null));
  await loadOverview(false);
};
window.saveSubjectEdit = async () => {
  const S = window._subj;
  const { note, photos } = subjPayload();
  if (lcAvailable() && lcNetOff()) {
    if (typeof S.checkinId !== 'string' || !S.checkinId.startsWith('local:')) {
      alert('现在没网，这科的修改要等联网后再保存哦');
      return;
    }
    const shNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Shanghai' }));
    const hm = String(shNow.getHours()).padStart(2, '0') + ':' + String(shNow.getMinutes()).padStart(2, '0');
    let submittedAt = hm;
    try {
      const rows = await lcGetLocalByChild('checkins', S.childId);
      const original = rows.find((row) => row.id === S.checkinId);
      if (original && original.submitted_at) submittedAt = original.submitted_at;
    } catch (e) { /* 缓存读取失败时使用当前时间 */ }
    await lcPutLocal('checkins', { child_id: S.childId, id: S.checkinId, date: lcShDate(), subject: S.subject, subjects: JSON.stringify([S.subject]), note, status: 'pending', submitted_at: submittedAt, submitted_epoch: Math.floor(Date.now() / 1000), is_early: 0, xp_awarded: null, reason: null, photos: [], _local: 'pending' });
    try {
      const m = JSON.parse(localStorage.getItem('sm.photoCmds.v1') || '{}');
      m[S.checkinId] = { subject: S.subject, date: lcShDate(), localCheckinId: S.checkinId };
      localStorage.setItem('sm.photoCmds.v1', JSON.stringify(m));
    } catch (e) { /* 存储不可用时静默跳过 */ }
    for (let i = 0; i < photos.length; i++) {
      const p = photos[i];
      if (p.id || !p.data) continue;
      try {
        const blob = await fetch(p.data).then((r) => r.blob());
        await window.LocalCache.queuePhoto(S.childId, S.checkinId, 'photo-' + i + '.jpg', blob);
      } catch (e) { /* 单张照片失败不阻断其他照片 */ }
    }
    celebrate('保存好啦！', null, '修改已存在手机里（待同步），联网后自动更新');
    setTimeout(() => { closeModal(); goCheckinPage(S.childId); }, 500);
    return;
  }
  const j = await api('/api/checkin/edit', { checkinId: S.checkinId, note, photos });
  if (!j.ok) { alert(j.error || '保存失败'); return; }
  celebrate('保存好啦！', null, '备注和照片都更新了，等家长审核哦');
  setTimeout(() => { closeModal(); goCheckinPage(S.childId); }, 500);
  await loadOverview(false);
};

/* ---------- 野外遭遇（借鉴包 v1：答题抓捕） ----------
 * 投球先选球种（普通/超级，扣库存），再答题（按稀有度 1/2/3 道）：
 * 普通球全对命中；超级球多 1 道题、答对原档题数即命中（A 方案）；
 * 最多投 3 次，没命中它就跑掉。 */
async function goEncounter(id) {
  if (lcAvailable() && lcNetOff()) { alert('现在没网，野外遭遇要联网才能生成哦'); return; }
  state.view = 'encounter';
  const j = await api('/api/encounter/pending', { childId: id });
  if (!j.ok || !j.encounter) { alert('现在没有野外遭遇'); goChild(id); return; }
  const quizBack = !!(j.encounter.quiz && j.encounter.quiz.questions && j.encounter.quiz.questions.length);
  const savedSel = quizBack ? { ...(j.encounter.quiz.sel || {}) } : {};
  window._enc = { childId: id, data: j.encounter, sel: savedSel, msg: quizBack ? (Object.keys(savedSel).length ? '上次选的答案都记着呢，接着答完这组题吧！' : '有扔出的球还没答完，接着答这组题吧！') : '' };
  renderEncounter();
}
window.goEncounter = goEncounter;

function renderEncounter() {
  const E = window._enc;
  const e = E.data;
  const id = E.childId;
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  const pips = '<span class="pb-mini"></span>'.repeat(e.ballsUsed || 0) + '<span class="pip"></span>'.repeat(Math.max(0, 3 - (e.ballsUsed || 0)));
  let action = '';
  if (e.quiz && e.quiz.questions && e.quiz.questions.length) {
    const qs = e.quiz.questions;
    const ballLabelZh = { normal: '<span class="pb-mini"></span> 精灵球', super: '<span class="pb-mini super"></span> 超级球', hyper: '<span class="pb-mini hyper"></span> 高级球', master: '<span class="pb-mini master"></span> 大师球' }[e.quiz.ball] || '<span class="pb-mini"></span> 精灵球';
    const ballLabelEn = { normal: '<span class="pb-mini"></span> Poké Ball', super: '<span class="pb-mini super"></span> Super Ball', hyper: '<span class="pb-mini hyper"></span> Hyper Ball', master: '<span class="pb-mini master"></span> Master Ball' }[e.quiz.ball] || '<span class="pb-mini"></span> Poké Ball';
    const suffixZh = e.quiz.ball === 'super' ? `（超级球：多 1 道题，答对 ${e.questionsNeeded} 道就能抓到）` : e.quiz.ball === 'hyper' ? `（高级球：多 2 道题，答对 ${e.questionsNeeded} 道就能抓到）` : '（要全部答对哦）';
    const suffixEn = e.quiz.ball === 'super' ? `(Super Ball: 1 extra question, answer ${e.questionsNeeded} correctly to catch it)` : e.quiz.ball === 'hyper' ? `(Hyper Ball: 2 extra questions, answer ${e.questionsNeeded} correctly to catch it)` : '(answer all correctly!)';
    action = `<div class="card" style="text-align:left">
      <div style="font-weight:600;margin-bottom:6px">${bi(`${ballLabelZh}扔出去啦！答对题目才能命中${suffixZh}：`, `${ballLabelEn} thrown! Answer correctly to hit${suffixEn}:`)}</div>
      ${qs.map((q, qi) => `<div style="margin:12px 0"><div style="font-weight:600">${tr(`第 ${qi + 1} 题：`, `Question ${qi + 1}: `)}${esc(q.question)}</div>
        ${q.options.map((o, oi) => `<button class="quizopt ${E.sel[q.id] === oi ? 'selected' : ''}" onclick="selectCatchOpt(${q.id}, ${oi})"><b>${'ABCD'[oi]}</b> ${esc(o)}</button>`).join('')}</div>`).join('')}
      <button class="bigbtn green" onclick="submitCatchAnswers()">${tr('确认答案，看看抓没抓到！', 'Check answers and see if you caught it!')}</button>
      <button class="bigbtn ghost" onclick="exitCatchQuiz()">${ic('pause')} ${tr('先退出，下次接着答', 'Exit for now, continue later')}</button>
      <p style="color:var(--text-2);font-size:16px;margin:8px 0 0">${bi('球已经扔出去啦，退出不会浪费球：选过的答案会自动记下来，下次进来接着答就行。', 'The ball is already thrown — exiting will not waste it: your selected answers are saved, just come back and continue.')}</p>
    </div>`;
  } else {
    // 「继续答题」只在服务端确有待答题组（e.quiz 带球种）却一张题都渲染不出来时出现
    // （题组题目被家长删光等分叉状态）：它走 resumeCatch 的 resume 口径，只认未答完的
    // 题组、不查库存不扣球。无题组时不显示此钮——已扔出的球若都答完，继续抓只能再扔
    // 新球，旧实现按 ballsUsed>0 无条件显示此钮、点了却走新投球扣球，与文案矛盾（2026-10-24 修复）。
    const resumable = !!(e.quiz && e.quiz.ball);
    action = `<div style="display:flex;flex-direction:column;gap:10px">
      ${resumable ? `<button class="bigbtn" onclick="resumeCatch()">${tr('▶ 继续答题（有已扔出的球还没答完，不用球也能进）', '▶ Continue answering (a thrown ball is unfinished — no ball needed)')}</button>` : ''}
      <button class="bigbtn green" ${!(e.balls > 0) ? 'disabled' : ''} onclick="throwCatchBall('normal')"><span class="pb-mini"></span> ${tr(`扔精灵球（有 ${e.balls || 0} 颗）`, `Throw a Poké Ball (${e.balls || 0} left)`)}</button>
      <button class="bigbtn blue" ${!(e.ballsSuper > 0) ? 'disabled' : ''} onclick="throwCatchBall('super')"><span class="pb-mini super"></span> ${tr(`扔超级球（有 ${e.ballsSuper || 0} 颗，多 1 道题，答对 ${e.questionsNeeded} 道就能抓到）`, `Throw a Super Ball (${e.ballsSuper || 0} left, 1 extra question, answer ${e.questionsNeeded} correctly to catch it)`)}</button>
      <button class="bigbtn" style="background:#f5c518" ${!(e.ballsHyper > 0) ? 'disabled' : ''} onclick="throwCatchBall('hyper')"><span class="pb-mini hyper"></span> ${tr(`扔高级球（有 ${e.ballsHyper || 0} 颗，多 2 道题，答对 ${e.questionsNeeded} 道就能抓到）`, `Throw a Hyper Ball (${e.ballsHyper || 0} left, 2 extra questions, answer ${e.questionsNeeded} correctly to catch it)`)}</button>
      <button class="bigbtn" style="background:#b388eb" ${!(e.ballsMaster > 0) ? 'disabled' : ''} onclick="throwCatchBall('master')"><span class="pb-mini master"></span> ${tr(`扔大师球（有 ${e.ballsMaster || 0} 颗，直接抓到，不用答题）`, `Throw a Master Ball (${e.ballsMaster || 0} left, Catches directly, no questions needed)`)}</button>
      ${!(e.balls > 0) && !(e.ballsSuper > 0) && !(e.ballsHyper > 0) && !(e.ballsMaster > 0) ? `<p style="color:var(--danger-text)">${bi(`没有球啦！${e.ballsUsed > 0 ? `已经扔出的 ${e.ballsUsed} 颗球都答完啦，还剩 ${Math.max(0, 3 - (e.ballsUsed || 0))} 次扔球机会，拿到新球今天还能接着抓；` : ''}每日答题答对有机会掉落精灵球哦。`, `No balls left!${e.ballsUsed > 0 ? ` The ${e.ballsUsed} balls already thrown are all answered, with ${Math.max(0, 3 - (e.ballsUsed || 0))} throws left. Get new balls and you can keep catching today;` : ''} Answering daily questions correctly can drop Poké Balls.`)}</p>` : ''}
    </div>`;
  }
  app.innerHTML = `
  ${childTop(biTitle('野外遭遇', 'Wild encounter'), `goChild(${id})`, undefined, true)}
  <div class="hero"><img src="/static/img/p${e.no}.webp"><h2>${bi(`野生的${esc(e.name)}出现了！`, `A wild ${esc(e.name)} appeared!`)}</h2>
  <p style="color:var(--text-2)">${bi(`${esc(e.tierLabel || '')}精灵，抓它要答对 ${e.questionsNeeded} 道题，最多扔 3 次球`, `${esc(e.tierLabel || '')} Pokémon, Answer ${e.questionsNeeded} questions to catch it, Up to 3 balls`)}</p>
  <div id="balls" style="font-size:22px">${pips}</div>
  <div style="min-height:30px;font-weight:600">${esc(E.msg || '')}</div></div>
  ${action}
  ${tabbar()}`;
}

function selectCatchOpt(qid, oi) {
  window._enc.sel[qid] = oi;
  renderEncounter();
  saveCatchDraft(); // 点选即自动保存（防突然关页面丢进度）；失败静默，下次点选/退出会再存
}
window.selectCatchOpt = selectCatchOpt;

/* 草稿保存：把当前已选答案整表发服务端存进 quiz_state.sel。保存失败不打扰孩子
 * （网络抖动时下一次点选、或点「先退出」时会再存一次）。 */
function saveCatchDraft() {
  const E = window._enc;
  if (!E || !E.data || !E.data.quiz) return Promise.resolve(null);
  return api('/api/encounter/draft', { encounterId: E.data.id, sel: E.sel }).catch(() => null);
}
window.saveCatchDraft = saveCatchDraft;

/* 抓捕页防连点（审查 S19）：投球/提交共用一把在途锁，请求未回来前重复点击直接忽略，
 * 同时把本页当前可点的按钮临时禁用；结束时只恢复被临时禁用的那批（原本就 disabled 的
 * 如库存为 0 的扔球按钮不在恢复之列）。后端 M1 已保证扣球原子性，这里防的是前端误触叠加。 */
let _catchBusy = false;
let _catchDisabledBtns = [];
function catchLockBegin() {
  if (_catchBusy) return false;
  _catchBusy = true;
  _catchDisabledBtns = [...document.querySelectorAll('.bigbtn')].filter((b) => !b.disabled);
  _catchDisabledBtns.forEach((b) => { b.disabled = true; });
  return true;
}
function catchLockEnd() {
  _catchBusy = false;
  _catchDisabledBtns.forEach((b) => { b.disabled = false; });
  _catchDisabledBtns = [];
}

async function throwCatchBall(ball) {
  if (lcAvailable() && lcNetOff()) { alert('现在没网，扔球等联网后再试哦'); return; }
  if (!catchLockBegin()) return;
  try {
    const E = window._enc;
    const j = await api('/api/encounter/throw', { encounterId: E.data.id, ball });
    if (!j.ok) { alert(j.error || '扔球失败'); return; }
    if (j.master && j.hit) {
      // 大师球：0 题直接捕获，不出题组
      celebrate('抓到啦！', frontImgFor(j), `大师球直接抓到了${esc(j.name)}！已经进图鉴啦！`);
      goChild(E.childId); return;
    }
    E.data = { ...E.data, ballsUsed: j.ballsUsed, balls: j.balls, ballsSuper: j.ballsSuper, ballsHyper: j.ballsHyper ?? E.data.ballsHyper, ballsMaster: j.ballsMaster ?? E.data.ballsMaster, quiz: { ball: j.ball, questions: j.questions } };
    E.sel = j.resumed ? { ...(j.sel || {}) } : {};
    E.msg = j.resumed ? '接着答完这组题吧！' : '球扔出去啦，快答题！';
    renderEncounter();
  } finally { catchLockEnd(); }
}
window.throwCatchBall = throwCatchBall;

/* 「继续答题」：只续答已扔出、未答完的题组（服务端 resume 口径）——不查库存、不扣球，
 * 球种与题目都以服务端存的题组为准。服务端说没有待答题组时如实提示并刷新遭遇页，
 * 不让孩子撞上新投球的「没有精灵球」假报错（2026-10-24 修复）。 */
async function resumeCatch() {
  if (!catchLockBegin()) return;
  try {
    const E = window._enc;
    const j = await api('/api/encounter/throw', { encounterId: E.data.id, resume: true });
    if (!j.ok) { alert(j.error || '继续答题失败'); goEncounter(E.childId); return; }
    if (!j.questions || !j.questions.length) { alert('题库里暂时没有合适的题，等家长补充题目哦'); goEncounter(E.childId); return; }
    E.data = { ...E.data, ballsUsed: j.ballsUsed, balls: j.balls, ballsSuper: j.ballsSuper, ballsHyper: j.ballsHyper ?? E.data.ballsHyper, ballsMaster: j.ballsMaster ?? E.data.ballsMaster, quiz: { ball: j.ball, questions: j.questions } };
    E.sel = { ...(j.sel || {}) };
    E.msg = Object.keys(E.sel).length ? '上次选的答案都记着呢，接着答完这组题吧！' : '接着答完这组题吧！';
    renderEncounter();
  } finally { catchLockEnd(); }
}
window.resumeCatch = resumeCatch;

/* 「先退出」：不提交、不结算——题组与已选答案都在服务端存着（球已在投出时扣除，
 * 退出不退球，保留的是用这颗球续答的权利）；离开前再存一次草稿兜底。回孩子页即可，
 * 下次从遭遇入口进来恢复整组题＋已选答案，从没答的题接着答（提交前仍可改选）。 */
async function exitCatchQuiz() {
  const E = window._enc;
  try { await saveCatchDraft(); } catch { /* 点选时已逐次自动保存，兜底失败也不挡退出 */ }
  goChild(E ? E.childId : state.childId);
}
window.exitCatchQuiz = exitCatchQuiz;

/* 留空提醒（2026-10-24 改版）：提交时有题没选，先弹框数清还有几道没答——
 * 「回去接着答」是默认（绿色主按钮），只有孩子亲手点「就这样交」才继续提交；
 * 服务端另有一道同样的拦截兜底，任何路径都不会再把留空静默结算掉。 */
function showCatchBlankConfirm(n) {
  modalRoot.innerHTML = `
  <div class="overlay"><div class="modal">
    <h2>还有 ${n} 道题没答哦</h2>
    <p style="color:var(--text-2);line-height:1.6">没答的题会算答错，这颗球可能就浪费啦。回去把题答完，或者点「先退出」下次接着答——球不会跑。</p>
    <button class="bigbtn green" onclick="closeModal()">回去接着答</button>
    <button class="bigbtn ghost" onclick="closeModal();submitCatchAnswers(true)">就这样交（没答的算错）</button>
  </div></div>`;
}
window.showCatchBlankConfirm = showCatchBlankConfirm;

async function submitCatchAnswers(confirmed) {
  // 注意：按钮 onclick 会把事件对象传进来，只有严格等于 true 才算显式确认
  const forceSubmit = confirmed === true;
  const E = window._enc;
  const qs = E.data.quiz.questions;
  const blanks = qs.filter((q) => E.sel[q.id] === undefined).length;
  if (blanks > 0 && !forceSubmit) { showCatchBlankConfirm(blanks); return; }
  if (!catchLockBegin()) return;
  let j;
  try {
    const answers = qs.map((q) => ({ questionId: q.id, answerIdx: E.sel[q.id] === undefined ? null : E.sel[q.id] }));
    j = await api('/api/encounter/answer', { encounterId: E.data.id, answers, confirmBlanks: forceSubmit });
  } finally { catchLockEnd(); }
  if (!j.ok) {
    if (j.blanks) { showCatchBlankConfirm(j.blanks); return; } // 服务端拦截兜底：同样先提醒，不静默失败
    alert(j.error || '提交失败'); return;
  }
  const id = E.childId;
  if (j.status === 'caught') {
    celebrate('抓到啦！', null, `${j.name} 被收服了，已经放进图鉴！`);
    setTimeout(() => { closeModal(); goChild(id); }, 800);
    return;
  }
  if (j.status === 'fled') {
    celebrate('跑掉啦…', null, `3 次机会用完了，${j.name} 跑进草丛啦。明天打卡再来试试，你可以的 ${ic('dumbbell')}`);
    setTimeout(() => { closeModal(); goChild(id); }, 800);
    return;
  }
  E.data = { ...E.data, ballsUsed: j.ballsUsed, balls: j.balls, ballsSuper: j.ballsSuper, quiz: null };
  E.sel = {};
  E.msg = `答对 ${j.correctCount}/${j.total} 题，没能命中！还剩 ${j.remaining} 次机会，再扔一个球试试`;
  renderEncounter();
}
window.submitCatchAnswers = submitCatchAnswers;

/* ---------- 每日问答 ---------- */
async function openQuiz(childId) {
  if (lcAvailable() && lcNetOff()) {
    const tq = await lcGetTodayQuiz(childId);
    if (!tq || !tq.questions.length) { alert(tr('今日题单还没缓存下来，需要联网加载一次', "Today's questions aren't cached yet, please go online once to load them")); return; }
    const first = tq.questions.findIndex((q) => !tq.answered.has(q.id));
    if (first === -1) { alert(tr('今天的题都答完啦，明天再来！', "You've answered all of today's questions, come back tomorrow!")); return; }
    window._quiz = {
      data: {
        childId,
        questions: tq.questions.map((q) => ({
          id: q.id, label: q.label || q.subject, question: q.question,
          options: q.options, answered: tq.answered.has(q.id),
          answer_idx: q.answer_idx, explain: q.explain || '',
        })),
        quota: tq.quota, remaining: tq.remaining,
        quiz: { fragments: 0, correctTotal: 0, nextFragmentIn: 5 },
      },
      idx: first,
    };
    renderQuizStep();
    return;
  }
  const j = await api('/api/quiz/today?child_id=' + childId);
  if (!j.ok) { alert(j.error || '加载失败'); return; }
  if (!j.quota) { alert(tr('今天还没有通过审核的打卡，审核通过后回来答题吧！', 'No approved check-ins yet today, come back after a check-in is approved!')); return; }
  const first = j.questions.findIndex((q) => !q.answered);
  if (first === -1) { alert(tr('今天的题都答完啦，明天再来！', "You've answered all of today's questions, come back tomorrow!")); return; }
  window._quiz = { data: j, idx: first };
  renderQuizStep();
}
window.openQuiz = openQuiz;

function renderQuizStep() {
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  Object.assign(LANG, {
    quizSlice4Question: (x, y) => tr(`第 ${x} / ${y} 题`, `Question ${x} / ${y}`),
    quizSlice4ReadAloud: ['识字不多的话，请爸爸妈妈把题目读给你听哦', 'If reading is hard, ask a parent to read the question aloud'],
    quizSlice4Submit: tr('提交答案', 'Submit answer'),
    quizSlice4Submitting: tr('提交中…', 'Submitting…'),
    quizSlice4Later: tr('稍后再来', 'Later'),
    quizSlice4CorrectPending: tr('答对啦！（待同步，经验等联网确认后到账）', 'Correct! (Pending sync, XP will arrive after online confirmation)'),
    quizSlice4Wrong: tr('答错啦，不扣经验', 'Wrong, no XP lost'),
    quizSlice4Explanation: tr('解析：', 'Explanation:'),
    quizSlice4Pending: ['待同步：联网后由服务端确认发奖', 'Pending sync: the server will confirm rewards once online'],
    quizSlice4CorrectXP: (x) => tr(`答对啦！+${x} 经验`, `Correct! +${x} XP`),
    quizSlice4SuperBall: tr('哇！掉落了一颗超级球！', 'Wow! A Super Ball dropped!'),
    quizSlice4PokeBall: tr('掉落精灵球！', 'A Poké Ball dropped!'),
    quizSlice4Encounter: (name) => tr(`野外精灵出现了：${name}！等下去伙伴页抓它`, `A wild Pokémon appeared: ${name}! Go catch it from the Companions page later`),
    quizSlice4Fragment: (x) => tr(`获得 1 枚技能碎片！（${x}/3）`, `Got 1 skill fragment! (${x}/3)`),
    quizSlice4Level: (x) => tr(`升级到 Lv.${x}！`, `Leveled up to Lv.${x}!`),
    quizSlice4Learned: tr('学会：', 'Learned: '),
    quizSlice4Evolved: (to) => tr(`进化成 ${to}！`, `Evolved into ${to}!`),
    quizSlice4Next: tr('下一题 ›', 'Next ›'),
    quizSlice4Done: tr('完成', 'Done'),
    quizSlice4NoAnswer: tr('这道题没有缓存答案，需要联网再答', "This question's answer isn't cached, please go online to answer it"),
  });
  const Q = window._quiz;
  const q = Q.data.questions[Q.idx];
  Q.selected = null;
  Q.submitting = false;
  modalRoot.innerHTML = `
  <div class="overlay"><div class="modal quiz">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
      <span class="qchip">${esc(q.label)}</span>
      <span style="color:var(--text-2);white-space:nowrap">${LANG.quizSlice4Question(Q.idx + 1, Q.data.questions.length)}</span>
    </div>
    ${Q.data.readAloudHint ? '<div class="note" style="margin-top:10px">' + ic('volume') + ' ' + bi(...LANG.quizSlice4ReadAloud) + '</div>' : ''}
    <h2 class="qtext">${esc(q.question)}</h2>
    <div id="qopts">${q.options.map((o, i) => `<button class="quizopt" onclick="selectQuizOpt(${i})"><b>${'ABCD'[i]}</b> ${esc(o)}</button>`).join('')}</div>
    <button class="bigbtn green" id="qsubmit" disabled onclick="submitQuizAnswer()">${LANG.quizSlice4Submit}</button>
    <div id="qresult"></div>
    <button class="bigbtn ghost" onclick="closeQuiz()">${LANG.quizSlice4Later}</button>
  </div></div>`;
}

/* 点选项只选中高亮（提交前可随意改选），点「提交答案」才判题——防卡顿下误触直接判错 */
function selectQuizOpt(i) {
  const Q = window._quiz;
  if (!Q || Q.submitting) return;
  if (Q.data.questions[Q.idx].answered) return;
  Q.selected = i;
  document.querySelectorAll('.quizopt').forEach((b, bi) => b.classList.toggle('selected', bi === i));
  const sb = document.getElementById('qsubmit');
  if (sb) sb.disabled = false;
}
window.selectQuizOpt = selectQuizOpt;

async function submitQuizAnswer() {
  const Q = window._quiz;
  if (!Q || Q.selected == null || Q.submitting) return;
  Q.submitting = true;
  const qid = Q.data.questions[Q.idx].id;
  const oi = Q.selected;
  const btns = document.querySelectorAll('.quizopt');
  btns.forEach((b) => { b.disabled = true; b.style.opacity = .85; });
  const sb = document.getElementById('qsubmit');
  if (sb) { sb.disabled = true; sb.textContent = LANG.quizSlice4Submitting; }
  if (lcAvailable() && lcNetOff()) {
    const full = Q.data.questions[Q.idx];
    if (full.answer_idx === undefined) { alert(LANG.quizSlice4NoAnswer); renderQuizStep(); return; }
    const correct = oi === full.answer_idx;
    try {
      await lcPutLocal('quiz_attempts', { child_id: Q.data.childId, id: lcLocalId(), question_id: qid, date_shanghai: lcShDate(), correct: correct ? 1 : 0, xp_awarded: 0, fragments_awarded: 0, created_epoch: Math.floor(Date.now() / 1000), _local: 'pending' });
    } catch (e) { /* 本地预演失败不阻断入队 */ }
    const cmdId = await window.LocalCache.enqueue(Q.data.childId, 'quiz_answer', { child_id: Q.data.childId, question_id: qid, answer_idx: oi });
    lcTrackCmd(cmdId, { type: 'quiz_answer', childId: Q.data.childId, payload: { child_id: Q.data.childId, question_id: qid, answer_idx: oi } });
    if (sb) sb.style.display = 'none';
    Q.data.questions[Q.idx].answered = true;
    btns.forEach((b, i) => {
      b.classList.remove('selected');
      if (i === full.answer_idx) b.classList.add('right');
      else if (i === oi && !correct) b.classList.add('wrong');
    });
    const isBi = state.lang === 'en';
    const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
    const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
    const extra = correct ? ic('checkcircle') + ' ' + LANG.quizSlice4CorrectPending : LANG.quizSlice4Wrong;
    document.getElementById('qresult').innerHTML = '<div class="qexp"><b>' + extra + '</b><br><br>' + ic('lightbulb') + ' ' + LANG.quizSlice4Explanation + esc(full.explain || '') + '<br><span style="color:var(--text-2)">' + bi(...LANG.quizSlice4Pending) + '</span></div><button class="bigbtn" onclick="nextQuiz()">' + (Q.idx + 1 < Q.data.questions.length ? LANG.quizSlice4Next : ic('checkcircle') + ' ' + LANG.quizSlice4Done) + '</button>';
    return;
  }
  const j = await api('/api/quiz/answer', { child_id: Q.data.childId, question_id: qid, answer_idx: oi });
  if (!j.ok) { alert(j.error || '提交失败'); renderQuizStep(); return; }
  if (sb) sb.style.display = 'none';
  Q.data.questions[Q.idx].answered = true;
  btns.forEach((b, i) => {
    b.classList.remove('selected');
    if (i === j.correctIdx) b.classList.add('right');
    else if (i === oi) b.classList.add('wrong');
  });
  /* 手感打磨：答对→正确选项 pop 回弹＋「+N」飘字＋星星粒子，并记下经验增量供伙伴页回流动画；
     答错→所选选项小幅左右晃一次（标红＋解析沿用现有） */
  if (j.correct) {
    const rightBtn = btns[j.correctIdx];
    if (rightBtn) {
      rightBtn.classList.add('opt-pop');
      setTimeout(() => rightBtn.classList.remove('opt-pop'), 600);
      floatText(rightBtn, `+${j.xpAwarded}`);
      spawnSparks(rightBtn, 7);
    }
    try {
      const prev = parseInt(sessionStorage.getItem('sm_xpgain') || '0', 10) || 0;
      sessionStorage.setItem('sm_xpgain', String(prev + (j.xpAwarded || 0)));
    } catch (e) { /* 静默跳过 */ }
  } else {
    const wrongBtn = btns[oi];
    if (wrongBtn) {
      wrongBtn.classList.add('nudge');
      setTimeout(() => wrongBtn.classList.remove('nudge'), 260);
    }
  }
  let extra;
  if (j.correct) {
    extra = `${ic('checkcircle')} ${LANG.quizSlice4CorrectXP(j.xpAwarded)}`;
    if (j.drop) extra += j.drop.kind === 'super' ? '<br><span class="pb-mini super"></span> ' + LANG.quizSlice4SuperBall : '<br><span class="pb-mini"></span> ' + LANG.quizSlice4PokeBall;
    if (j.encounter) extra += `<br>${ic('leaf')} ${LANG.quizSlice4Encounter(esc(j.encounter.name))}`;
    if (j.fragmentsAwarded) extra += `<br>${ic('puzzle')} ${LANG.quizSlice4Fragment(j.quizFragments)}`;
    if (j.level && j.level.newLevel > j.level.oldLevel) extra += `<br>${LANG.quizSlice4Level(j.level.newLevel)}`;
    if (j.level && j.level.newMoves && j.level.newMoves.length) extra += `<br>${ic('sparkles')} ${LANG.quizSlice4Learned}${j.level.newMoves.map((m) => esc(m.name)).join('、')}`;
    if (j.level && j.level.evolved) extra += `<br>${ic('sparkles')} ${LANG.quizSlice4Evolved(esc(j.level.evolved.to))}`;
  } else {
    extra = LANG.quizSlice4Wrong;
  }
  document.getElementById('qresult').innerHTML = `
    <div class="qexp"><b>${extra}</b>${j.showExplain !== false ? `<br><br>${ic('lightbulb')} ${LANG.quizSlice4Explanation}${esc(j.explain)}` : ''}</div>
    <button class="bigbtn" onclick="nextQuiz()">${Q.idx + 1 < Q.data.questions.length ? LANG.quizSlice4Next : ic('checkcircle') + ' ' + LANG.quizSlice4Done}</button>`;
}
window.submitQuizAnswer = submitQuizAnswer;

function nextQuiz() {
  const Q = window._quiz;
  let i = Q.idx + 1;
  while (i < Q.data.questions.length && Q.data.questions[i].answered) i++;
  if (i >= Q.data.questions.length) { closeQuizDone(); return; }
  Q.idx = i;
  renderQuizStep();
}
window.nextQuiz = nextQuiz;

async function refreshAfterQuiz() {
  await loadOverview(false);
  if (state.view === 'child' && state.childId) goChild(state.childId);
  else if (state.view === 'home') renderHome();
}
function closeQuiz() { closeModal(); refreshAfterQuiz(); }
window.closeQuiz = closeQuiz;
function closeQuizDone() {
  celebrate('今日问答完成！', null, '今天的题目都答完啦，明天打卡后再来挑战！');
  setTimeout(() => { closeModal(); refreshAfterQuiz(); }, 900);
}

/* 先修回溯诊断 · 孩子端「练一练」：只在每日问答答完后出现，不提薄弱／诊断／根因 */
async function loadDiagEntries() {
  const o = state.overview;
  if (!o || !o.children) return;
  for (const k of o.children) loadDiagEntry(k.id);
}
async function loadDiagEntry(childId) {
  const el = document.getElementById('diagEntry-' + childId);
  if (!el) return;
  const j = await api('/api/quiz/diagnosis?child_id=' + childId);
  if (!j.ok || !j.pending || !j.pending.reviewQuestions || !j.pending.reviewQuestions.length) return;
  const n = j.pending.reviewQuestions.length;
  const rootName = j.pending.root ? j.pending.root.name : '';
  el.innerHTML = `<div style="margin-top:8px"><button class="smallbtn" style="font-size:var(--fs-body)" onclick="event.stopPropagation();openReview(${childId})">${ic('pencil')} 练一练（${n} 道 ${esc(rootName)}）</button></div>`;
}
async function openReview(childId) {
  const j = await api('/api/quiz/diagnosis?child_id=' + childId);
  if (!j.ok) { alert(j.error || '加载失败'); return; }
  if (!j.pending || !j.pending.reviewQuestions || !j.pending.reviewQuestions.length) { alert('今天没有要练的题，明天再来！'); return; }
  window._review = { data: j, idx: 0 };
  renderReviewStep();
}
window.openReview = openReview;
/* 单元测试 · 孩子端（v11 §2.5）：家长开启后在伙伴页答题；85 分以上抽奖，不加经验、不掉球 */
async function loadUnitTestEntry(childId) {
  const el = document.getElementById('unitTestEntry-' + childId);
  if (!el) return;
  const j = await api('/api/child/unit-test?childId=' + childId);
  if (!j.ok || !j.openTest) return;
  const t = j.openTest;
  el.innerHTML = `<div style="margin-top:8px"><button class="bigbtn blue" onclick="openUnitTest(${childId})">${ic('pencil')} 单元测试：${esc(t.subject)} ${esc(t.unit)}（${t.questionCount} 道）</button></div>`;
}
async function openUnitTest(childId) {
  const j = await api('/api/child/unit-test?childId=' + childId);
  if (!j.ok || !j.openTest) { alert('没有要答的单元测试'); return; }
  window._ut = { childId, test: j.openTest, sel: {} };
  renderUnitTestPage();
}
window.openUnitTest = openUnitTest;
function renderUnitTestPage() {
  const U = window._ut;
  const t = U.test;
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  app.innerHTML = `
  ${childTop(`${ic('pencil')} ${biTitle('单元测试', 'Unit test')}`, `goChild(${U.childId})`, undefined, true)}
  <div class="card"><h2>${esc(t.subject)} ${esc(t.unit)}</h2>
  <p style="color:var(--text-2)">${bi(`共 ${t.questionCount} 道题，每题 5 分，85 分以上可以抽奖！测试题不加经验、不掉精灵球。`, `There are ${t.questionCount} questions, 5 points each. Score 85 or above to enter the prize draw! Test questions give no XP and no Poké Balls.`)}</p>
  ${t.questions.map((q, qi) => `<div style="border-bottom:0.5px solid var(--line);padding:12px 0">
    <div style="font-weight:600">${qi + 1}. ${esc(q.question)}</div>
    <div>${q.options.map((o, oi) => `<button class="quizopt" data-ut-q="${q.id}" data-ut-o="${oi}" onclick="selectUnitTestOpt(${q.id},${oi})"><b>${'ABCD'[oi]}</b> ${esc(o)}</button>`).join('')}</div>
  </div>`).join('')}
  <p style="color:var(--text-2)" id="ut-answered">${bi(`已答 0/${t.questionCount} 道`, `Answered 0/${t.questionCount}`)}</p>
  <button class="bigbtn green" onclick="submitUnitTest()">${tr('交卷', 'Submit test')}</button>
  </div>
  ${tabbar()}`;
}
function selectUnitTestOpt(qid, oi) {
  window._ut.sel[qid] = oi;
  document.querySelectorAll(`[data-ut-q="${qid}"]`).forEach((b) => b.classList.remove('selected'));
  document.querySelector(`[data-ut-q="${qid}"][data-ut-o="${oi}"]`)?.classList.add('selected');
  const counter = document.getElementById('ut-answered');
  if (counter) counter.textContent = state.lang === 'en' ? `Answered ${Object.keys(window._ut.sel).length}/${window._ut.test.questionCount}` : `已答 ${Object.keys(window._ut.sel).length}/${window._ut.test.questionCount} 道`;
}
window.selectUnitTestOpt = selectUnitTestOpt;
async function submitUnitTest() {
  const U = window._ut;
  const t = U.test;
  const unanswered = t.questions.filter((q) => U.sel[q.id] === undefined);
  if (unanswered.length) { alert(`还有 ${unanswered.length} 道题没答哦`); return; }
  if (lcAvailable() && lcNetOff()) {
    try {
      await lcPutLocal('unit_tests', { child_id: U.childId, id: lcLocalId(), subject: t.subject, unit: t.unit, status: 'submitted', score: null, correct_count: null, total_count: t.questionCount, submitted_epoch: Math.floor(Date.now() / 1000), _local: 'pending' });
    } catch (e) { /* 本地预演失败不阻断入队 */ }
    const cmdId = await window.LocalCache.enqueue(U.childId, 'unit_test_submit', { childId: U.childId, testId: t.id, answers: t.questions.map((q) => ({ questionId: q.id, answerIdx: U.sel[q.id] })) });
    lcTrackCmd(cmdId, { type: 'unit_test_submit', childId: U.childId, payload: { childId: U.childId, testId: t.id, answers: t.questions.map((q) => ({ questionId: q.id, answerIdx: U.sel[q.id] })) } });
    celebrate('交卷啦（待同步）', null, '答案已存在手机里，联网后自动交卷；分数和抽奖等服务端确认后出');
    goChild(U.childId);
    return;
  }
  const j = await api('/api/child/unit-test/submit', { childId: U.childId, testId: t.id, answers: t.questions.map((q) => ({ questionId: q.id, answerIdx: U.sel[q.id] })) });
  if (!j.ok) { alert(j.error || '交卷失败'); return; }
  let text = `得了 ${j.score} 分，答对 ${j.correctCount}/${j.total} 道。`;
  if (j.won && j.prize) {
    text += j.prize.kind === 'egg' ? `<br>${ic('gift')} 中奖啦！抽到了 ${esc(j.prize.name)}的蛋，7 天后孵化！` : `<br>${ic('gift')} 中奖啦！抽到了 ${esc(j.prize.name)}！`;
  } else if (j.score >= 85) {
    text += '<br>这次没中奖，下次再接再厉！';
  } else {
    text += '<br>85 分以上才能抽奖，下次加油！';
  }
  celebrate('单元测试完成', null, text);
  goChild(U.childId);
}
window.submitUnitTest = submitUnitTest;

/* ---------- 每日英语打卡（2026-11-07，用户定：两孩每日 5 句、只跟读打卡先跑） ----------
 * 内容来自服务端选题（GET /api/daily-english，种子取 child_id＋当天日期）；v1 不加经验、不答题。
 * v2（2026-11-09）：每句跟读评分（POST /api/daily-english/assess，复用 Oak 录音＋讯飞主/Azure 备管线），
 * 75 分＝4 星、5 句全 ≥75 才打卡（跟读站 85 分线区分）；成绩记 daily_english_assessments（迁移 0029）。
 * 当日 5 句缓存在 localStorage（sm.dailyEnglish.<childId>），离线时文字照常看、音频置灰；
 * 打卡（POST /api/daily-english/checkin）须联网。句子中文是内容释义、恒显示，不随「中」按钮隐藏。
 * 示范音走跟读站原链接（english.example.com），不用 TTS 兜底——播不出就标失败态，不编音频。
 * 播放不跟随战斗招式静音开关（sm_move_muted 是「喊招配音开关」，只管战斗音效）。 */

/* ================== 通用星级与每日基础函数 ================== */
function calcStars(pron) {
  if (typeof pron !== 'number' || !Number.isFinite(pron)) return 1;
  return pron >= 85 ? 5 : pron >= 75 ? 4 : pron >= 60 ? 3 : pron >= 40 ? 2 : 1;
}
function dailyBi(zh, en) {
  return state.lang === 'en' ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
}

/* ================== 每日三科打卡核心模块 (JS-H1 合并) ================== */
class DailyModule {
  // cacheKey 一直漏接：配置里只给了 key（sm.dailyEnglish 等），loadEntry/goPage/refresh/checkin
  // 用的 this.cacheKey 是 undefined，三科共用 localStorage 的 "undefined.<id>" 互相覆盖，
  // 缓存兜底基本失效——这也是主页三按钮刷出来又刷没的原因之一（2026-11-11 任务 88 修）。
  constructor(cfg) { Object.assign(this, cfg); this.cacheKey = cfg.key; }
  st() { return window[this.stateKey]; }
  updateRow(i) {
    const el = document.getElementById(`${this.prefix}-row-${i !== undefined ? i : ''}`);
    if (el) el.innerHTML = this.renderRow(i);
  }
  updateCheckin() {
    const el = document.getElementById(`${this.prefix}-checkin-area`);
    if (el) el.innerHTML = this.checkinHtml(this.st().childId, !!this.st().done);
  }
  checkinHtml(childId, done) {
    if (done) return `<button class="bigbtn gray" disabled>${dailyBi('今日已完成 ✓', 'Done today ✓')}</button>`;
    const missing = this.getMissing();
    if (!missing) return `<button class="bigbtn" onclick="${this.prefix}Checkin(${childId})">${dailyBi('打卡', 'Check in')}</button>`;
    return `<button class="bigbtn gray" disabled>${dailyBi('打卡', 'Check in')}</button><p class="muted">${dailyBi(missing.zh, missing.en)}</p>`;
  }
  // 同步读本地缓存（无缓存或无效返回 null）。三科缓存键各用各的 key（见 constructor）。
  readCache(childId) {
    try {
      const raw = JSON.parse(localStorage.getItem(`${this.cacheKey}.${childId}`));
      if (this.isValidCache(raw)) return { ok: true, childId, cached: true, ...raw };
    } catch(e) {}
    return null;
  }
  // 科目按钮的完整 HTML（图标＋名字＋状态 pill＋箭头）。loadEntry 与骨架共用同一份。
  entryHtml(childId, j) {
    const done = !!j.completed;
    const passText = this.entryPassText(j);
    return `<div class="subjmini" onclick="goDaily${this.capitalName}(${childId})">
      <span class="sm-name"><img class="sm-ic" src="/static/img/home/${this.icon}.webp" alt=""> ${tr(this.titleZh, this.titleEn)}</span>
      <span class="sm-right">${done ? `<span class="pill approved">${tr('已完成', 'Done')} ✓</span>` : `<span class="pill none">${tr(this.countZh, this.countEn)}</span>`}
      ${!done && passText ? `<span class="pill">${passText}</span>` : ''}
      <span class="sm-arrow">›</span></span></div>`;
  }
  // 111: 加载失败又无缓存：不再是死路一条的“联网后查看”，给个点我重试。
  retryHtml(childId) {
    return `<div class="subjmini" onclick="loadDaily${this.capitalName}Entry(${childId})"><span class="sm-name"><img class="sm-ic" src="/static/img/home/${this.icon}.webp" alt=""> ${tr(this.titleZh, this.titleEn)}</span><span class="sm-right"><span class="pill none">${tr('点我重试', 'Tap to retry')}</span><span class="sm-arrow">›</span></span></div>`;
  }
  offlineHtml(childId) {
    return `<div class="subjmini" style="opacity:.6"><span class="sm-name"><img class="sm-ic" src="/static/img/home/${this.icon}.webp" alt=""> ${tr(this.titleZh, this.titleEn)}</span><span class="sm-right"><span class="pill none">${tr('联网后查看', 'Needs network')}</span><span class="sm-arrow">›</span></span></div>`;
  }
  // 常驻按钮骨架（2026-11-11 任务 88）：goChild 首屏就渲染，按钮从打开主页起一直可见。
  // 缓存有就直接显示真实状态，无缓存先显示“…”占位，loadEntry 随后静默补数据。
  skeletonHtml(childId) {
    const cached = this.readCache(childId);
    if (cached) return this.entryHtml(childId, cached);
    return `<div class="subjmini" onclick="goDaily${this.capitalName}(${childId})"><span class="sm-name"><img class="sm-ic" src="/static/img/home/${this.icon}.webp" alt=""> ${tr(this.titleZh, this.titleEn)}</span><span class="sm-right"><span class="pill none">…</span><span class="sm-arrow">›</span></span></div>`;
  }
  // 返工 2026-11-14 6a：并行预取（goChild 在等 /api/child 的同时发三科请求；
  // loadEntry 消费它，不多发请求；离线时不预取）。
  prefetch(childId) {
    if (this._prefetch && this._prefetch.childId === childId) return;
    if (typeof lcNetOff === 'function' && lcNetOff()) return;
    this._prefetch = { childId, promise: api(`${this.apiPath}?child_id=${childId}`).catch(() => null) };
  }
  async loadEntry(childId) {
    const el = document.getElementById(`${this.entryPrefix}-${childId}`);
    if (!el) return;
    // 缓存先行：同步渲染，按钮立刻有真实状态；主页重绘（后台刷新/离线同步）也不会闪没。
    const cached = this.readCache(childId);
    if (cached) el.innerHTML = this.entryHtml(childId, cached);
    // 静默取最新数据，到了只更新本按钮，不刷新整页、不碰其他内容。
    if (lcNetOff()) {
      if (!cached) el.innerHTML = this.offlineHtml(childId);
      this._prefetch = null; // 离线不消费预取（数据会过期），回线后重新取
      return;
    }
    let fresh = null;
    const pre = this._prefetch;
    this._prefetch = null;
    if (pre && pre.childId === childId) {
      try { fresh = await pre.promise; } catch(e) {}
    } else {
      try { fresh = await api(`${this.apiPath}?child_id=${childId}`); } catch(e) {}
    }
    if (fresh?.ok) {
      try { localStorage.setItem(`${this.cacheKey}.${childId}`, JSON.stringify(this.formatCache(fresh))); } catch(e) {}
      el.innerHTML = this.entryHtml(childId, fresh);
    } else if (!cached) {
      el.innerHTML = this.retryHtml(childId);
    }
    // API 失败但有缓存：保留缓存渲染，不闪。
  }
  async goPage(childId) {
    state.childId = childId; state.view = this.view; setArea('child');
    const _pl = beginPageLoad(() => window[`goDaily${this.capitalName}`](childId));
    let j = null;
    if (!lcNetOff()) {
      try { j = await api(`${this.apiPath}?child_id=${childId}`); } catch(e) {}
      if (j?.ok) { try { localStorage.setItem(`${this.cacheKey}.${childId}`, JSON.stringify(this.formatCache(j))); } catch(e) {} }
    }
    if (!j?.ok) {
      try {
        const raw = JSON.parse(localStorage.getItem(`${this.cacheKey}.${childId}`));
        if (this.isValidCache(raw)) j = { ok: true, childId, cached: true, ...raw };
      } catch(e) {}
    }
    _pl.finish();
    const biTitle = (zh, en) => state.lang === 'en' ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
    if (!j?.ok) {
      app.innerHTML = `${childTop(biTitle(this.titleZh, this.titleEn), `goChild(${childId})`)}
      <div class="card"><p>${dailyBi(`现在没网，看不到今日${this.unit}。联网后再来吧！`, `You're offline, so today's ${this.unitEn} aren't available yet. Come back when you're online!`)}</p>
      <button class="bigbtn" onclick="goChild(${childId})">${dailyBi('返回', 'Back')}</button></div>${tabbar()}`;
      return;
    }
    const done = !!j.completed;
    window[this.stateKey] = this.initState(childId, j, done);
    app.innerHTML = `${childTop(biTitle(this.titleZh, this.titleEn), `goChild(${childId})`, undefined, true)}
    <div class="card">
      <p class="muted">${dailyBi(`今日${this.countZh} ${j.date}`, `Today's ${this.countEn} ${j.date}`)}</p>
      ${this.introHtml(done, j)}
      <div class="de-list">${this.renderList(j)}</div>
      <div id="${this.prefix}-checkin-area" style="margin-top:12px">${this.checkinHtml(childId, done)}</div>
      ${done && (j.careWheelChances || 0) > 0 ? `<p class="wheel-note">${dailyBi('养成转盘机会已到账，去大木博士之家 → 转盘中心转吧！', 'Your Nurture Wheel spin is ready — go to Dr. Oak\'s House → Wheel Hub to spin it!')}</p>` : ''}
      ${done ? `<button class="bigbtn ghost" disabled>${dailyBi('明日再来', 'Come back tomorrow')}</button>` : ''}
      <button class="bigbtn ghost" onclick="goChild(${childId})">${dailyBi('返回', 'Back')}</button>
    </div>${tabbar()}`;
  }
  async checkin(childId) {
    if (lcNetOff()) { alert(tr('现在没网，打卡等联网后再点哦', "You're offline — check in once you're back online")); return; }
    const j = await api(`${this.apiPath}/checkin`, { childId });
    if (!j?.ok) {
      if (j?.error === 'NOT_PASSED') {
        await this.refresh(childId);
        alert(tr(this.notPassedZh(j), this.notPassedEn(j))); return;
      }
      alert(j?.error || tr('打卡失败', 'Check-in failed')); return;
    }
    try {
      const raw = JSON.parse(localStorage.getItem(`${this.cacheKey}.${childId}`));
      if (raw) { raw.completed = true; localStorage.setItem(`${this.cacheKey}.${childId}`, JSON.stringify(raw)); }
    } catch(e) {}
    celebrate(tr('打卡完成', 'Checked in!'), null, tr(this.successZh, this.successEn));
    goChild(childId);
  }
}

/* ================== 各科特化实现 ================== */
let _deAudio = null;
function dePlay(url, btn) {
  if (!url) return;
  try {
    if (_deAudio) _deAudio.pause();
    if (!_deAudio) _deAudio = new Audio();
    _deAudio.src = url;
    const p = _deAudio.play();
    if (p && p.catch) p.catch(() => { if (btn) btn.classList.add('audio-failed'); });
  } catch (e) { /* 播放失败静默（按钮已标失败态） */ }
}
window.dePlay = dePlay;

function deSidKey(s) { return s.episodeId + ':' + s.sid; }
function deScore(i) {
  const D = window._de;
  if (!D || !D.sentences[i]) return null;
  return (D.scores || {})[deSidKey(D.sentences[i])] || null;
}
function deRecHtml(i) {
  const D = window._de;
  const rec = (D.rec || {})[i] || {};
  const sc = deScore(i);
  const offline = lcNetOff();
  const busy = Object.values(D.rec || {}).some((r) => r.state === 'recording' || r.state === 'requesting' || r.state === 'assessing' || r.state === 'saving');
  let scoreHtml = '';
  if (sc && typeof sc.best === 'number') {
    const n = calcStars(sc.best);
    const stars = '★'.repeat(n) + '☆'.repeat(5 - n);
    scoreHtml = sc.passed
      ? `<div class="de-score ok"><span class="de-stars">${stars}</span> ${dailyBi('已达标 ✓', 'Passed ✓')}</div>`
      : `<div class="de-score short"><span class="de-stars">${stars}</span> ${dailyBi('未达标', 'Not Passed')}</div>`;
  }
  let btnLabel, btnCls = 'de-rec-btn', disabled = offline || !!D.done;
  if (rec.state === 'recording') {
    btnLabel = `⏹ ${dailyBi('停止', 'Stop')}（${Math.floor((Date.now() - (rec.recAt || Date.now())) / 1000)}s）`;
    btnCls += ' recording';
    disabled = false;
  } else if (rec.state === 'requesting') {
    btnLabel = dailyBi('准备录音…', 'Getting ready…');
    disabled = true;
  } else if (rec.state === 'assessing' || rec.state === 'saving') {
    btnLabel = dailyBi('⭐ 评测中…', '⭐ Scoring…');
    disabled = true;
  } else if (sc) {
    btnLabel = `🎙️ ${dailyBi('再录一次', 'Record again')}`;
    disabled = offline || !!D.done || busy;
  } else {
    btnLabel = `🎙️ ${dailyBi('跟读录音', 'Record & read aloud')}`;
    disabled = offline || !!D.done || busy;
  }
  const errHtml = rec.state === 'error' && rec.msg ? `<div class="de-err">${esc(rec.msg)}</div>` : '';
  const micHtml = rec.mic === 'denied' ? `<div class="de-err">${tr(...LANG.oakSlice4Denied)}</div>`
    : rec.mic === 'unsupported' ? `<div class="de-err">${tr(...LANG.oakSlice4Unsupported)}</div>` : '';
  return `<button class="${btnCls}" id="de-recbtn-${i}" ${disabled ? 'disabled' : ''} onclick="deRecord(${i})">${btnLabel}</button>${scoreHtml}${errHtml}${micHtml}`;
}
async function deDcRecord(getD, rec, updateRow, stopSelf, onBlob) {
  const D = getD();
  if (!D || D.done) return;
  if (rec.state === 'recording') {
    rec.state = 'saving';
    try { if (rec.timer) clearInterval(rec.timer); } catch (_) {}
    try { rec.recorder.stop(); } catch (_) { rec.state = 'error'; rec.msg = tr('录音没成功，再试一次', 'Recording failed, try again'); }
    updateRow();
    return;
  }
  if (rec.state === 'requesting' || rec.state === 'assessing' || rec.state === 'saving') return;
  const seq = ++D.seq;
  rec.state = 'requesting'; rec.msg = '';
  updateRow();
  let stream;
  try {
    if (!window.MediaRecorder || !navigator.mediaDevices?.getUserMedia) throw new Error('unsupported');
    stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
    if (getD() !== D || seq !== D.seq) { stream.getTracks().forEach((t) => t.stop()); return; }
    rec.stream = stream;
    const mime = oakPickMime();
    const recorder = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
    const chunks = [];
    rec.recorder = recorder; rec.chunks = chunks; rec.mic = 'ok';
    recorder.ondataavailable = (e) => { if (e.data.size) chunks.push(e.data); };
    recorder.onstop = () => {
      stream.getTracks().forEach((t) => t.stop());
      if (getD() !== D || seq !== D.seq) return;
      try { if (rec.timer) clearInterval(rec.timer); } catch (_) {}
      rec.state = 'idle'; rec.recorder = null; rec.stream = null;
      const blob = new Blob(chunks, { type: recorder.mimeType || chunks[0]?.type || mime });
      if (blob.size) onBlob(blob);
      else { rec.state = 'error'; rec.msg = tr('录音没成功，再试一次', 'Recording failed, try again'); }
      updateRow();
    };
    recorder.onerror = () => {
      if (getD() !== D || seq !== D.seq) return;
      try { if (rec.timer) clearInterval(rec.timer); } catch (_) {}
      rec.state = 'error'; rec.msg = tr('录音没成功，再试一次', 'Recording failed, try again');
      updateRow();
    };
    recorder.start(250);
    rec.recAt = Date.now(); rec.state = 'recording';
    rec.timer = setInterval(() => {
      if (getD() !== D || seq !== D.seq) return;
      if (Date.now() - rec.recAt >= 30000) stopSelf();
      else updateRow();
    }, 250);
    updateRow();
  } catch (e) {
    if (stream) stream.getTracks().forEach((t) => t.stop());
    if (getD() !== D || seq !== D.seq) return;
    rec.state = 'error'; rec.stream = null; rec.recorder = null;
    rec.mic = e.name === 'NotAllowedError' || e.name === 'SecurityError' ? 'denied' : e.message === 'unsupported' || e.name === 'NotSupportedError' ? 'unsupported' : 'unknown';
    rec.msg = tr('录音没成功，检查一下麦克风再试', 'Recording failed, check the microphone and try again');
    updateRow();
  }
}

async function deDcAssess(getD, rec, blob, url, refText, onSync) {
  const D = getD();
  if (lcAvailable() && lcNetOff()) {
    rec.state = 'error'; rec.msg = tr('现在没网，录音已保存，联网后可重新评测出分', "You're offline — the recording is saved, score it once you're back online");
    onSync(); return;
  }
  const seq = ++D.seq;
  const current = () => getD() === D && seq === D.seq;
  rec.state = 'assessing'; rec.msg = '';
  onSync();
  let wav;
  try { wav = await oakBlobToWav16k(blob); }
  catch (_) {
    if (current()) { rec.state = 'error'; rec.msg = tr('这段录音处理不了，重新录一遍吧', "This recording can't be processed, record it again"); onSync(); }
    return;
  }
  if (!current()) return;
  const controller = new AbortController();
  const timeoutMsg = tr('点评超时了，录音已保存，点重新点评', 'Scoring timed out, the recording is saved — tap to score again');
  const timer = setTimeout(() => controller.abort(), 30000);
  try {
    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'audio/wav', 'x-ref-text': encodeURIComponent(refText) }, body: wav, signal: controller.signal });
    if (response.status === 504) throw new Error(timeoutMsg);
    if (!response.ok) throw new Error(tr('点评没成功，检查一下网络再试', 'Scoring failed, check the network and try again'));
    const j = await response.json();
    if (controller.signal.aborted) throw new Error(timeoutMsg);
    if (!current()) return;
    if (j.error === 'timeout') throw new Error(timeoutMsg);
    if (j.ok !== true) throw new Error(j.error === 'not_configured' ? tr('AI 点评还没开通，请家长在家长区确认设置', "AI scoring isn't on yet, ask a parent to check the settings") : j.error === 'not_recognized' ? tr('没听清，再大声读一遍吧', "Didn't catch that, read it louder") : tr('点评没成功，检查一下网络再试', 'Scoring failed, check the network and try again'));
    onSync('score', { best: j.best, attempts: j.attempts, passed: !!j.passed });
    rec.state = 'idle'; rec.msg = '';
  } catch (e) {
    if (!current()) return;
    rec.state = 'error';
    rec.msg = controller.signal.aborted || e.name === 'AbortError' || e.message === timeoutMsg ? timeoutMsg : e.message;
  } finally {
    clearTimeout(timer);
  }
  if (current()) onSync('done');
}

async function deRecord(i) {
  const D = window._de;
  if (!D || D.done) return;
  const rec = (D.rec[i] ||= {});
  if (rec.state !== 'recording' && Object.values(D.rec).some((r) => r.state === 'recording' || r.state === 'requesting' || r.state === 'assessing' || r.state === 'saving')) return;
  return deDcRecord(() => window._de, rec, () => DE.updateRow(i), () => deRecord(i), (blob) => deAssess(i, blob));
}
window.deRecord = deRecord;

async function deAssess(i, blob) {
  const D = window._de;
  if (!D) return;
  const rec = (D.rec[i] ||= {});
  const s = D.sentences[i];
  if (!s) return;
  return deDcAssess(() => window._de, rec, blob, '/api/daily-english/assess?child_id=' + D.childId, s.en, (step, score) => {
    if (step === 'score') {
      D.scores[deSidKey(s)] = score;
      try {
        const key = 'sm.dailyEnglish.' + D.childId;
        const raw = JSON.parse(localStorage.getItem(key) || 'null');
        if (raw) { raw.scores = D.scores; localStorage.setItem(key, JSON.stringify(raw)); }
      } catch (e) {}
      return;
    }
    DE.updateRow(i);
    if (step === 'done') DE.updateCheckin();
  });
}

function dcTextLines(text) {
  return String(text || '').split('。').map((s) => s.trim()).filter(Boolean).map((s) => esc(s) + '。').join('<br>');
}
function dcRecHtml() {
  const D = window._dc;
  const rec = D.rec || {};
  const sc = D.score;
  const offline = lcNetOff();
  const busy = rec.state === 'recording' || rec.state === 'requesting' || rec.state === 'assessing' || rec.state === 'saving';
  let scoreHtml = '';
  if (sc && typeof sc.best === 'number') {
    const n = calcStars(sc.best);
    const stars = '★'.repeat(n) + '☆'.repeat(5 - n);
    scoreHtml = sc.passed
      ? `<div class="de-score ok"><span class="de-stars">${stars}</span> ${dailyBi('已达标 ✓', 'Passed ✓')}</div>`
      : `<div class="de-score short"><span class="de-stars">${stars}</span> ${dailyBi('未达标', 'Not Passed')}</div>`;
  }
  let btnLabel, btnCls = 'de-rec-btn', disabled = offline || !!D.done;
  if (rec.state === 'recording') {
    btnLabel = `⏹ ${dailyBi('停止', 'Stop')}（${Math.floor((Date.now() - (rec.recAt || Date.now())) / 1000)}s）`;
    btnCls += ' recording';
    disabled = false;
  } else if (rec.state === 'requesting') {
    btnLabel = dailyBi('准备录音…', 'Getting ready…');
    disabled = true;
  } else if (rec.state === 'assessing' || rec.state === 'saving') {
    btnLabel = dailyBi('⭐ 评测中…', '⭐ Scoring…');
    disabled = true;
  } else if (sc) {
    btnLabel = `🎙️ ${dailyBi('再录一次', 'Record again')}`;
    disabled = offline || !!D.done || busy;
  } else {
    btnLabel = `🎙️ ${dailyBi('跟读录音', 'Record & read aloud')}`;
    disabled = offline || !!D.done || busy;
  }
  const errHtml = rec.state === 'error' && rec.msg ? `<div class="de-err">${esc(rec.msg)}</div>` : '';
  const micHtml = rec.mic === 'denied' ? `<div class="de-err">${tr(...LANG.oakSlice4Denied)}</div>`
    : rec.mic === 'unsupported' ? `<div class="de-err">${tr(...LANG.oakSlice4Unsupported)}</div>` : '';
  return `<button class="${btnCls}" id="dc-recbtn" ${disabled ? 'disabled' : ''} onclick="dcRecord()">${btnLabel}</button>${scoreHtml}${errHtml}${micHtml}`;
}
async function dcRecord() {
  const D = window._dc;
  if (!D || D.done) return;
  return deDcRecord(() => window._dc, D.rec, () => DC.updateRow(), dcRecord, dcAssess);
}
window.dcRecord = dcRecord;
async function dcAssess(blob) {
  const D = window._dc;
  if (!D) return;
  const rec = D.rec;
  const item = D.item;
  if (!item) return;
  return deDcAssess(() => window._dc, rec, blob, '/api/daily-chinese/assess?child_id=' + D.childId, item.text, (step, score) => {
    if (step === 'score') {
      D.score = score;
      try {
        const key = 'sm.dailyChinese.' + D.childId;
        const raw = JSON.parse(localStorage.getItem(key) || 'null');
        if (raw) { raw.score = D.score; localStorage.setItem(key, JSON.stringify(raw)); }
      } catch (e) {}
      return;
    }
    DC.updateRow();
    if (step === 'done') DC.updateCheckin();
  });
}
const DM_PASS_COUNT = 4;
function dmRowHtml(i) {
  const D = window._dm;
  const p = D.problems[i];
  const a = (D.answers || {})[i];
  const offline = lcNetOff();
  const locked = !!D.done || !!a;
  let resultHtml = '';
  if (a) {
    resultHtml = a.correct
      ? `<div class="de-score ok">✓ ${dailyBi('答对了！', 'Correct!')}</div>`
      : `<div class="de-score short">✗ ${dailyBi(`答错了，正确答案是 ${a.correctAnswer}`, `Wrong — the answer is ${a.correctAnswer}`)}</div>`;
  }
  let qHtml = '';
  if (p.kind === 'word') {
    qHtml = `<div class="de-en" style="font-size:var(--fs-body);line-height:1.5">${i + 1}. ${esc(p.q)}${state.lang === 'en' && p.qEn ? `<span class="bi-sub"><br>${esc(p.qEn)}</span>` : ''}</div>`;
  } else {
    qHtml = `<div class="de-en" style="font-size:22px">${i + 1}. ${esc(p.q)}</div>`;
    if (p.kind === 'bracket') {
      qHtml += `<div class="muted" style="font-size:var(--fs-label);margin-top:2px">${dailyBi('填一填', 'Fill in the blank')}</div>`;
    }
  }
  return `<div class="de-sent"><div class="de-body">
    ${qHtml}
    <div style="display:flex;gap:8px;margin-top:8px">
      <input id="dm-input-${i}" type="number" inputmode="numeric" ${locked ? 'disabled' : ''} value="${a ? esc(String(a.answer)) : ''}" placeholder="${state.lang === 'en' ? 'Answer' : '答案'}" style="flex:1;min-height:48px;border:2px solid var(--line);border-radius:12px;padding:0 12px;font-size:var(--fs-body);background:#fff" />
      <button class="smallbtn" style="min-height:48px;min-width:76px" ${locked || offline ? 'disabled' : ''} onclick="dmAnswer(${i})">${dailyBi('提交', 'Submit')}</button>
    </div>${resultHtml}</div></div>`;
}
async function dmAnswer(i) {
  const D = window._dm;
  if (!D || D.done) return;
  if ((D.answers || {})[i]) return;
  const input = document.getElementById('dm-input-' + i);
  if (!input) return;
  const v = input.value.trim();
  if (v === '' || Number.isNaN(Number(v))) { alert(tr('先填一个答案再提交哦', 'Enter an answer first')); return; }
  if (lcNetOff()) { alert(tr('现在没网，联网后再提交哦', "You're offline — submit once you're back online")); return; }
  input.disabled = true;
  const j = await api('/api/daily-math/answer', { childId: D.childId, index: i, answer: Number(v) });
  if (!j || !j.ok) {
    input.disabled = false;
    alert(j && j.error ? j.error : tr('提交失败', 'Submit failed'));
    return;
  }
  D.answers[i] = { answer: j.answer, correct: !!j.correct, correctAnswer: j.correctAnswer };
  D.correctCount = j.correctCount;
  D.passed = !!j.passed;
  DM.updateRow(i);
  if (document.getElementById('dm-score')) {
    document.getElementById('dm-score').innerHTML = dailyBi(`已答对 ${D.correctCount}/5`, `Correct ${D.correctCount}/5`);
  }
  DM.updateCheckin();
}
window.dmAnswer = dmAnswer;

/* ================== 各科特化配置与实例化 ================== */
const DE = new DailyModule({
  prefix: 'de', entryPrefix: 'dailyEnglishEntry', view: 'daily-english', capitalName: 'English',
  key: 'sm.dailyEnglish', apiPath: '/api/daily-english', stateKey: '_de',
  icon: 'home-daily-english', titleZh: '每日英语', titleEn: 'Daily English', unit: '5 句', unitEn: '5 sentences',
  countZh: '今日 5 句', countEn: '5 sentences',
  formatCache: j => ({ date: j.date, sentences: j.sentences, completed: j.completed, scores: j.scores || {} }),
  isValidCache: raw => raw && raw.date && raw.sentences,
  initState: (childId, j, done) => ({ childId, date: j.date, sentences: j.sentences, scores: j.scores || {}, rec: {}, seq: 0, done }),
  entryPassText: j => {
    const passedCount = j.scores ? Object.values(j.scores).filter((s) => s && s.passed).length : 0;
    return passedCount > 0 ? tr(`已达标 ${passedCount}/5`, `Passed ${passedCount}/5`) : '';
  },
  introHtml: (done, j) => {
    const off = lcNetOff() ? `<p class="muted">${dailyBi('现在没网，示范音听不了，文字照常看。', "You're offline, so the demo audio is unavailable — the text still works.")}</p>` : '';
    return off + (done ? `<p>${dailyBi('今日已完成 ✓ 明天再来 5 句！', 'Done for today ✓ See you tomorrow for 5 more!')}</p>` : `<p>${dailyBi('先听示范音，再点「跟读录音」读一遍，每句达到 75 分才能打卡。', 'Listen to the demo audio, tap Record & read aloud, and score 75+ on all 5 sentences to check in.')}</p>`);
  },
  renderRow: i => {
    const s = window._de.sentences[i];
    const titleHtml = s.titleEn ? `<div class="de-ep">${esc(s.titleEn)}${s.titleZh ? ' ' + esc(s.titleZh) : ''}${s.speaker ? ' 🎙️ ' + esc(s.speaker) : ''}${(s.type === 'card' || s.type === 'video') ? ' 💬 ' + dailyBi('口语', 'Spoken') : ''}</div>` : '';
    return `<div class="de-sent"><div class="de-num">${i + 1}</div><div class="de-body"><div class="de-en">${esc(s.en)}</div><div class="de-zh">${esc(s.zh)}</div>${titleHtml}<div class="de-audio">
      <button class="de-audio-btn" ${lcNetOff() ? 'disabled' : ''} onclick="dePlay('${esc(s.audioNormal)}', this)">🔊 ${dailyBi('常速', 'Normal')}</button>
      <button class="de-audio-btn" ${lcNetOff() ? 'disabled' : ''} onclick="dePlay('${esc(s.audioSlow)}', this)">🐢 ${dailyBi('慢速', 'Slow')}</button>
    </div><div class="de-rec" id="de-rec-${i}">${deRecHtml(i)}</div></div></div>`;
  },
  renderList: j => j.sentences.map((s, i) => `<div id="de-row-${i}">${DE.renderRow(i)}</div>`).join(''),
  getMissing: () => {
    const missing = [];
    for (let i = 0; i < window._de.sentences.length; i++) {
      const sc = (window._de.scores || {})[`${window._de.sentences[i].episodeId}:${window._de.sentences[i].sid}`];
      if (!sc || !sc.passed) missing.push(i + 1);
    }
    if (missing.length === 0) return null;
    return {
      zh: `还差第 ${missing.join('、')} 句达标，录完再打卡哦`,
      en: missing.length === 1 ? `Sentence ${missing[0]} needs practice — record it first, then check in` : `Sentences ${missing.join(', ')} need practice — record them first, then check in`
    };
  },
  refresh: async (childId) => {
    try {
      const j = await api(`/api/daily-english?child_id=${childId}`);
      if (j && j.ok) {
        window._de.scores = j.scores || {}; window._de.done = !!j.completed;
        try { const raw = JSON.parse(localStorage.getItem(`sm.dailyEnglish.${childId}`)); if (raw) { raw.scores = j.scores || {}; raw.completed = j.completed; localStorage.setItem(`sm.dailyEnglish.${childId}`, JSON.stringify(raw)); } } catch(e) {}
        for (let i = 0; i < window._de.sentences.length; i++) DE.updateRow(i);
        DE.updateCheckin();
      }
    } catch(e) {}
  },
  notPassedZh: j => `还差第 ${(j.missing || []).map(m=>m.index).join('、')} 句达标，录完再打卡哦`,
  notPassedEn: j => (j.missing || []).length === 1 ? `Sentence ${(j.missing || [])[0].index} needs practice — record it first, then check in` : `Sentences ${(j.missing || []).map(m=>m.index).join(', ')} need practice — record them first, then check in`,
  successZh: '今日 5 句跟读完成，明天再来！',
  successEn: 'All 5 sentences done today, see you tomorrow!'
});
window.loadDailyEnglishEntry = (id) => DE.loadEntry(id);
window.goDailyEnglish = (id) => DE.goPage(id);
window.deCheckin = (id) => DE.checkin(id);

const DC = new DailyModule({
  prefix: 'dc', entryPrefix: 'dailyChineseEntry', view: 'daily-chinese', capitalName: 'Chinese',
  key: 'sm.dailyChinese', apiPath: '/api/daily-chinese', stateKey: '_dc',
  icon: 'home-daily-chinese', titleZh: '每日语文', titleEn: 'Daily Chinese', unit: '1 篇', unitEn: 'passage',
  countZh: '今日 1 篇', countEn: '1 passage',
  formatCache: j => ({ date: j.date, item: j.item, completed: j.completed, score: j.score || null }),
  isValidCache: raw => raw && raw.date && raw.item,
  initState: (childId, j, done) => ({ childId, date: j.date, item: j.item, score: j.score || null, rec: {}, seq: 0, done }),
  entryPassText: j => j.score?.passed ? tr('已达标 ✓', 'Passed ✓') : '',
  introHtml: (done) => done ? `<p>${dailyBi('今日已完成 ✓ 明天再来 1 篇！', 'Done for today ✓ See you tomorrow for another passage!')}</p>` : `<p>${dailyBi('照着文字大声读一遍，点「跟读录音」录下来，达到 4 星才能打卡。', 'Read the text aloud, tap Record, and score 4+ stars to check in.')}</p>`,
  renderRow: () => {
    const item = window._dc.item;
    return `<div class="de-sent"><div class="de-body">
      <div class="de-en" style="font-size:var(--fs-body)">${esc(item.title)}${item.author ? ` ${esc(item.author)}` : ''}</div>
      <div class="de-zh">${esc(item.unit || '')}${item.kind === 'poem' ? ` ${dailyBi('古诗', 'Poem')}` : ` ${dailyBi('课文', 'Text')}`}</div>
      <div style="margin-top:10px;font-size:var(--fs-body);line-height:1.9">${dcTextLines(item.text)}</div>
      <div class="de-rec" id="dc-rec">${dcRecHtml()}</div>
    </div></div>`;
  },
  renderList: j => `<div id="dc-row-">${DC.renderRow()}</div>`,
  getMissing: () => {
    const sc = window._dc?.score;
    if (sc && sc.passed) return null;
    return { zh: '读一遍、达到 4 星才能打卡哦', en: 'Read it aloud and score 4+ stars to check in' };
  },
  refresh: async (childId) => {
    try {
      const j = await api(`/api/daily-chinese?child_id=${childId}`);
      if (j && j.ok) {
        window._dc.score = j.score || null; window._dc.done = !!j.completed;
        try { const raw = JSON.parse(localStorage.getItem(`sm.dailyChinese.${childId}`)); if (raw) { raw.score = j.score || null; raw.completed = j.completed; localStorage.setItem(`sm.dailyChinese.${childId}`, JSON.stringify(raw)); } } catch(e) {}
        DC.updateRow(); DC.updateCheckin();
      }
    } catch(e) {}
  },
  notPassedZh: j => '还未达标，录完再打卡哦',
  notPassedEn: j => 'Still needs practice — record it first, then check in',
  successZh: '今日 1 篇朗读完成，明天再来！',
  successEn: 'Passage done today, see you tomorrow!'
});
window.loadDailyChineseEntry = (id) => DC.loadEntry(id);
window.goDailyChinese = (id) => DC.goPage(id);
window.dcCheckin = (id) => DC.checkin(id);

const DM = new DailyModule({
  prefix: 'dm', entryPrefix: 'dailyMathEntry', view: 'daily-math', capitalName: 'Math',
  key: 'sm.dailyMath', apiPath: '/api/daily-math', stateKey: '_dm',
  icon: 'home-daily-math', titleZh: '每日数学', titleEn: 'Daily Math', unit: '5 道题', unitEn: '5 problems',
  countZh: '今日 5 道', countEn: '5 problems',
  formatCache: j => ({ date: j.date, problems: j.problems, answers: j.answers || {}, correctCount: j.correctCount || 0, completed: j.completed }),
  isValidCache: raw => raw && raw.date && raw.problems,
  initState: (childId, j, done) => ({ childId, date: j.date, problems: j.problems, answers: j.answers || {}, correctCount: j.correctCount || 0, passed: !!j.passed, done }),
  entryPassText: j => (j.correctCount || 0) > 0 ? tr(`已答对 ${j.correctCount}/5`, `Correct ${j.correctCount}/5`) : '',
  introHtml: (done) => `${done ? `<p>${dailyBi('今日已完成 ✓ 明天再来 5 道！', 'Done for today ✓ See you tomorrow for 5 more!')}</p>` : `<p>${dailyBi('每道题想好再提交，提交后不能改；答对 4 道才能打卡。', 'Think before you submit — you cannot change an answer. Get 4 right to check in.')}</p>`}
    <p><b id="dm-score">${dailyBi(`已答对 ${window._dm?.correctCount || 0}/5`, `Correct ${window._dm?.correctCount || 0}/5`)}</b></p>`,
  renderRow: i => dmRowHtml(i),
  renderList: j => j.problems.map((p, i) => `<div id="dm-row-${i}">${dmRowHtml(i)}</div>`).join(''),
  getMissing: () => {
    const n = window._dm?.correctCount || 0;
    if (n >= DM_PASS_COUNT) return null;
    return { zh: `已答对 ${n}/5，答对 4 道才能打卡哦`, en: `Correct ${n}/5 — get 4 right to check in` };
  },
  refresh: async (childId) => {
    try {
      const j = await api(`/api/daily-math?child_id=${childId}`);
      if (j && j.ok) {
        window._dm.problems = j.problems; window._dm.answers = j.answers || {}; window._dm.correctCount = j.correctCount || 0; window._dm.passed = !!j.passed; window._dm.done = !!j.completed;
        try { const raw = JSON.parse(localStorage.getItem(`sm.dailyMath.${childId}`)); if (raw) { raw.answers = j.answers || {}; raw.correctCount = j.correctCount || 0; raw.completed = j.completed; localStorage.setItem(`sm.dailyMath.${childId}`, JSON.stringify(raw)); } } catch(e) {}
        for (let i = 0; i < window._dm.problems.length; i++) DM.updateRow(i);
        if (document.getElementById('dm-score')) document.getElementById('dm-score').innerHTML = dailyBi(`已答对 ${window._dm.correctCount}/5`, `Correct ${window._dm.correctCount}/5`);
        DM.updateCheckin();
      }
    } catch(e) {}
  },
  notPassedZh: j => `已答对 ${j.correctCount || 0}/5，答对 4 道才能打卡哦`,
  notPassedEn: j => `Correct ${j.correctCount || 0}/5 — get 4 right to check in`,
  successZh: '今日 5 道数学题完成，明天再来！',
  successEn: 'All 5 problems done today, see you tomorrow!'
});
window.loadDailyMathEntry = (id) => DM.loadEntry(id);
window.goDailyMath = (id) => DM.goPage(id);
window.dmCheckin = (id) => DM.checkin(id);

/* 学校成绩上报 · 孩子端（2026-10-27）：入口从家长端横幅移到孩子伙伴页；
 * 孩子上传成绩＋试卷照片 → 家长在审核 tab 通过／驳回；通过后按现有规则发奖／记高级转盘机会。 */
function schoolRewardLabel(key) {
  const labels = {
    'ball:normal': '普通球×1',
    'xp:20': '经验+20',
    'medicine:potion': '伤药×1',
    'medicine:berry-juice': '树果汁×1',
    'medicine:super-potion': '好伤药×1',
    'medicine:water': '美味之水×1',
    'medicine:revive': '活力碎片×1',
  };
  return Object.prototype.hasOwnProperty.call(labels, key) ? labels[key] : (key || '');
}
async function loadSchoolTestEntry(childId) {
  const el = document.getElementById('schoolTestEntry-' + childId);
  if (!el) return;
  const j = await api('/api/child/school-tests?childId=' + childId);
  const recs = j.ok ? (j.records || []) : [];
  const label = { pending: '待审核', active: '已通过', rejected: '已驳回', void: '已作废' };
  const pill = (s) => `<span class="pill ${s === 'active' ? 'approved' : s === 'pending' ? 'pending' : 'rejected'}">${label[s] || s}</span>`;
  el.innerHTML = `<div style="margin-top:8px"><button class="bigbtn icbtn secondary" onclick="openSchoolTestUpload(${childId})"><span class="btn-plate pl-40"><img class="btn-ic" src="/static/img/home/home-school-score.webp" alt=""></span> ${tr('上传学校成绩', 'Upload School Results')}</button></div>`
    + (recs.length ? `<div style="margin-top:8px">${recs.slice(0, 5).map((r) => `<div style="border-bottom:0.5px solid var(--line);padding:6px 0;font-size:16px">
      <b>${esc(r.subject)} ${esc(r.unit)}</b> ${r.score}/${r.fullScore}（${r.pct} 分） ${pill(r.status)}
      ${r.status === 'active' && r.wheelChance === 'pending' ? ' ' + ic('target') + ' 高级转盘机会 1 次，去背包转' : ''}
      ${r.status === 'active' && r.rewardGranted ? ' 已发：' + esc(schoolRewardLabel(r.rewardItemKey)) : ''}
      ${r.status === 'rejected' ? ' 爸爸妈妈说这次不算，下次加油' : ''}</div>`).join('')}</div>` : '');
}
function openSchoolTestUpload(childId) {
  const d = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  const today = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const biTitle = (zh, en) => isBi ? `${en}<span class="bi-title-zh"> · ${zh}</span>` : zh;
  app.innerHTML = `
  ${childTop(`${ic('award')} ${biTitle('上传学校成绩', 'Upload school test score')}`, `goChild(${childId})`, undefined, true)}
  <div class="card"><h2>${biTitle('上传学校成绩', 'Upload school test score')}</h2>
  <p style="color:var(--text-2)">${bi('考完试把成绩报给爸爸妈妈审核：85 分以上通过后可以领一次奖励；95 分以上＋试卷照片，通过后得 1 次高级转盘机会。', 'After a test, report your score for parents to review: 85 or above earns a reward after approval; 95 or above with a test paper photo earns 1 Advanced Wheel spin after approval.')}</p>
  <div class="grid2"><div><label>${tr('科目', 'Subject')}</label><select id="cst-subj"><option>语文</option><option>数学</option><option>英语</option><option>阅读</option></select></div>
  <div><label>${tr('考试名称', 'Test name')}</label><input type="text" id="cst-unit" placeholder="${tr('比如：期中考试／第 3 单元测验', 'e.g. Mid-term exam / Unit 3 test')}"><div style="margin-top:6px"><button type="button" class="smallbtn" onclick="document.getElementById('cst-unit').value='期末考试'">${tr('期末考试', 'Final exam')}</button></div></div></div>
  <div class="grid2"><div><label>${tr('分数', 'Score')}</label><input type="number" id="cst-score" placeholder="${tr('比如：96', 'e.g. 96')}"></div>
  <div><label>${tr('满分（默认 100）', 'Full score (default 100)')}</label><input type="number" id="cst-full" value="100"></div></div>
  <label>${tr('考试日期', 'Test date')}</label><input type="date" id="cst-date" value="${today}">
  <label>${bi(`${ic('camera')} 试卷照片（95 分以上想拿高级转盘机会要传 1 张；只留 15 天）`, `${ic('camera')} Test paper photo (upload 1 to get a spin for 95 or above; kept for 15 days only)`)}</label><input type="file" id="cst-photo" accept="image/*">
  <button class="bigbtn green" onclick="submitSchoolTestUpload(${childId})">${tr('交给爸爸妈妈审核', 'Submit for parent review')}</button>
  </div>
  ${tabbar()}`;
}
window.openSchoolTestUpload = openSchoolTestUpload;
async function submitSchoolTestUpload(childId) {
  const subj = document.getElementById('cst-subj').value;
  const unit = document.getElementById('cst-unit').value.trim();
  const score = Number(document.getElementById('cst-score').value);
  const fullScore = Number(document.getElementById('cst-full').value) || 100;
  const examDate = document.getElementById('cst-date').value;
  const fileInput = document.getElementById('cst-photo');
  if (!unit) { alert('请填考试名称'); return; }
  if (!examDate) { alert('请选考试日期'); return; }
  let photos;
  if (fileInput && fileInput.files && fileInput.files[0]) {
    const dataUrl = await compressImage(fileInput.files[0]);
    photos = [{ data: dataUrl, contentType: 'image/jpeg' }];
  }
  const j = await api('/api/child/school-test/submit', { childId, subject: subj, unit, score, fullScore, examDate, photos });
  if (!j.ok) { alert(j.error || '提交失败'); return; }
  celebrate('成绩已提交', null, '爸爸妈妈审核通过后，85 分以上可以领奖励；95 分以上＋照片可得 1 次高级转盘机会（同一科目每周限 1 次）！'); /* 任务 117：原句"还能得"过度承诺——科目周限额挡下时孩子以为必得；补限额说明，审核弹窗的 wheelReason 本就带原因 */
  goChild(childId);
}
window.submitSchoolTestUpload = submitSchoolTestUpload;
function renderReviewStep() {
  const R = window._review;
  const q = R.data.pending.reviewQuestions[R.idx];
  R.selected = null; R.submitting = false;
  const rootName = R.data.pending.root ? R.data.pending.root.name : '';
  modalRoot.innerHTML = `
  <div class="overlay"><div class="modal quiz">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
      <span class="qchip">${ic('pencil')} 练一练</span>
      <span style="color:var(--text-2);white-space:nowrap">第 ${R.idx + 1} / ${R.data.pending.reviewQuestions.length} 题</span>
    </div>
    <div class="note" style="margin-top:10px">把「${esc(rootName)}」练得更牢</div>
    <h2 class="qtext">${esc(q.question)}</h2>
    <div id="qopts">${q.options.map((o, i) => `<button class="quizopt" onclick="selectReviewOpt(${i})"><b>${'ABCD'[i]}</b> ${esc(o)}</button>`).join('')}</div>
    <button class="bigbtn green" id="qsubmit" disabled onclick="submitReviewAnswer()">提交答案</button>
    <div id="qresult"></div>
    <button class="bigbtn ghost" onclick="closeReview()">稍后再来</button>
  </div></div>`;
}
function selectReviewOpt(i) {
  const R = window._review;
  if (!R || R.submitting) return;
  R.selected = i;
  document.querySelectorAll('.quizopt').forEach((b, j) => b.classList.toggle('selected', j === i));
  const sb = document.getElementById('qsubmit');
  if (sb) sb.disabled = false;
}
window.selectReviewOpt = selectReviewOpt;
async function submitReviewAnswer() {
  const R = window._review;
  if (!R || R.selected == null || R.submitting) return;
  R.submitting = true;
  const qid = R.data.pending.reviewQuestions[R.idx].id;
  const oi = R.selected;
  const btns = document.querySelectorAll('.quizopt');
  btns.forEach((b) => { b.disabled = true; b.style.opacity = .85; });
  const sb = document.getElementById('qsubmit');
  if (sb) { sb.disabled = true; sb.textContent = '提交中…'; }
  const j = await api('/api/quiz/review', { child_id: R.data.childId, question_id: qid, answer_idx: oi });
  if (!j.ok) { alert(j.error || '提交失败'); renderReviewStep(); return; }
  if (sb) sb.style.display = 'none';
  btns.forEach((b, i) => {
    b.classList.remove('selected');
    if (i === j.correctIdx) b.classList.add('right');
    else if (i === oi) b.classList.add('wrong');
  });
  const extra = j.correct ? ic('checkcircle') + ' 答对啦！' : '答错啦，不扣经验';
  document.getElementById('qresult').innerHTML = `
    <div class="qexp"><b>${extra}</b><br><br>${ic('lightbulb')} 解析：${esc(j.explain)}</div>
    <button class="bigbtn" onclick="nextReview()">${R.idx + 1 < R.data.pending.reviewQuestions.length ? '下一题 ›' : ic('sparkles') + ' 练好了'}</button>`;
}
window.submitReviewAnswer = submitReviewAnswer;
function nextReview() {
  const R = window._review;
  R.idx++;
  if (R.idx >= R.data.pending.reviewQuestions.length) { closeReviewDone(); return; }
  renderReviewStep();
}
window.nextReview = nextReview;
function closeReview() { closeModal(); refreshAfterQuiz(); }
window.closeReview = closeReview;
function closeReviewDone() {
  celebrate('练好了！', null, '今天的练一练都答完啦！');
  setTimeout(() => { closeModal(); refreshAfterQuiz(); }, 900);
}

/* 先修回溯诊断 · 家长端「薄弱点」区：数学进度之后、「安全」之前 */
async function parentDiagHtml() {
  const s = state.settings;
  const kids = (s && s.children) || [];
  if (!kids.length) return '';
  let out = '';
  for (const c of kids) {
    const j = await api('/api/quiz/diagnosis?child_id=' + c.id);
    if (!j.ok) continue;
    const weak = j.weak || [], unstable = j.unstable || [], pend = j.pending, hist = j.history || [];
    if (!weak.length && !unstable.length && !pend && !hist.length) continue;
    out += `<div class="card"><h2>${ic('ruler')} 薄弱点 ${esc(c.name)}</h2>`;
    if (weak.length) {
      out += `<div style="margin:8px 0"><b>薄弱的知识点</b>${weak.map((w) => `<div style="padding:6px 0;border-bottom:0.5px solid var(--line)">「${esc(w.name)}」${esc(w.chapter)}：30 天内答错 ${w.wrong} 次／共答 ${w.total} 次</div>`).join('')}</div>`;
    } else {
      out += `<div style="color:var(--text-2)">最近 30 天没有薄弱的知识点 ${ic('thumbsup')}</div>`;
    }
    if (pend) {
      out += `<div style="margin:8px 0"><b>根因链</b>：${pend.chain.map((x, i) => `${i ? ' → ' : ''}${esc(x.name)}${x.strength ? `（${x.strength === 'hard' ? '先修' : '相关'}）` : ''}`).join('')}`;
      const reasons = pend.chain.filter((x) => x.reason).map((x) => `${esc(x.name)}：${esc(x.reason)}`);
      if (reasons.length) out += `<div style="color:var(--text-2);font-size:var(--fs-parent-body);margin-top:4px">${reasons.join('<br>')}</div>`;
      out += `</div>`;
      const n = (pend.reviewQuestions || []).length;
      const done = pend.reviewCorrect || 0;
      const note = pend.note === 'fail-closed' ? '这个点在停用清单里，只提示、不出题。'
        : pend.note === 'no-question' ? '这个知识点没有题可出。'
        : pend.note === 'no-review-questions' ? '今天没有能出的复习题（都答过或在今日题单里）。' : '';
      out += `<div style="margin:8px 0"><b>复习进度</b>：${pend.status === 'pending' ? `今日出了 ${n} 道，已答对 ${done} 道` : pend.status}${note ? `（${note}）` : ''}</div>`;
    }
    if (unstable.length) {
      out += `<div style="margin:8px 0"><b>不稳的知识点</b>（只错过 1 次，留意就好）：${unstable.map((w) => `<div style="padding:4px 0">「${esc(w.name)}」${esc(w.chapter)}：30 天内答错 1 次</div>`).join('')}</div>`;
    }
    if (hist.length) {
      out += `<div style="margin:8px 0"><b>历史</b>${hist.map((h) => `<div style="padding:4px 0;color:var(--text-2)">${esc(h.created_date)} ${esc(h.triggerName)} → ${esc(h.rootName)} ${h.status === 'done' ? '已练好' : '已过期'} 复习答对 ${h.reviewCorrect} 道</div>`).join('')}</div>`;
    }
    out += `</div>`;
  }
  return out;
}

async function openOakEnglish(childId) {
  let j;
  try { j = await api('/api/oak/today?child_id=' + childId); }
  catch (e) { alert('加载失败'); return; }
  if (!j.ok) { alert(j.error || '加载失败'); return; }
  if (!j.sentences || !j.sentences.length) { alert(tr('今天的大木博士英语还没准备好，明天再来吧！', "Today's Dr. Oak English isn't ready yet, come back tomorrow!")); return; }
  if (j.completed) { alert(tr(`今天的 ${j.sentences.length} 句英语都听完啦，明天再来！`, `You've listened to all ${j.sentences.length} of today's English sentences, come back tomorrow!`)); return; }
  const first = j.sentences.findIndex((s) => !s.listened);
  window._oak = { data: j, idx: first === -1 ? 0 : first, submitting: false,
    audioToken: 0, rec: null, mic: 'unknown', assess: null, assessSeq: 0,
    recState: 'idle', recorder: null, stream: null, chunks: [] };
  if (!window.MediaRecorder || !navigator.mediaDevices?.getUserMedia) window._oak.mic = 'unsupported';
  oakLoadAssess(window._oak);
  renderOakStep();
}
window.openOakEnglish = openOakEnglish;

async function openOak(childId) {
  const id = Number(childId);
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  // 三按钮是 flex 行：裸 bi() 会被拆成英文文本＋中文 span 两个并排 item，各自垂直居中，基线对不上；收进同一 .bi-tx 文本块，英文在上、中文在下，左对齐同一 x
  const biTx = (zh, en) => isBi ? `<span class="bi-tx"><span class="bi-en">${en}</span><span class="bi-sub">${zh}</span></span>` : `<span class="bi-tx">${zh}</span>`;

  let wh = null;
  try {
    wh = await api('/api/warehouse/status?child_id=' + id);
  } catch (_) {}

  const careEnabled = wh && wh.ok ? Number(wh.care_enabled) === 1 : false;
  const carriedCnt = wh && wh.ok ? (wh.carried || []).length : 0;
  const storedCnt = wh && wh.ok ? (wh.stored || []).length : 0;
  // 副文案定宽 64px 换两行（Party 4/4 / Stored 0），给主文案留出 166px、Pokémon Storage 放得下一行；不限宽时它一行占 108px，会把英文挤成两行
  const whSub = wh && wh.ok
    ? `<span style="display:block;font-size:14px;opacity:.85;margin-left:auto;text-align:right;flex:none;width:64px">${tr(`随身 ${carriedCnt}/4 仓库 ${storedCnt} 只`, `Party ${carriedCnt}/4 Stored ${storedCnt}`)}</span>`
    : '';

  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="container" style="max-width:390px;margin:0 auto;padding:12px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <button class="smallbtn" style="min-height:48px;min-width:64px;font-size:14px" onclick="goChild(${id})">← ${tr('返回', 'Back')}</button>
        <h2 style="margin:0;font-size:var(--fs-body)">${bi('大木博士之家', "Dr. Oak's House")}</h2>
        <span style="width:64px"></span>
      </div>

      <div class="card" style="padding:16px;margin-bottom:16px;border-radius:16px">
        <p style="margin:0;font-size:1rem;line-height:1.5;font-weight:600">
          🧓 ${bi('你好呀！今天想在家里做些什么呢？', 'Hello there! What would you like to do at home today?')}
        </p>
      </div>

      <div style="display:flex;flex-direction:column;gap:12px">
        <button class="bigbtn blue icbtn" style="min-height:54px;font-size:1rem;width:100%" onclick="openWarehousePage(${id})">
          <span class="btn-plate pl-48"><img class="btn-ic" src="/static/img/feat/pokemon-storage.webp" alt=""></span> ${biTx('精灵仓库', 'Pokémon Storage')}${whSub}
        </button>

        ${careEnabled ? `
        <button class="bigbtn orange icbtn" style="min-height:54px;font-size:1rem;width:100%" onclick="goCarePage(${id})">
          <span class="btn-plate pl-48"><img class="btn-ic" src="/static/img/feat/partner-care.webp" alt=""></span> ${biTx('伙伴养成', 'Partner Care')}
        </button>` : ''}

        <button class="bigbtn icbtn" style="min-height:54px;font-size:1rem;width:100%;background:linear-gradient(180deg,var(--pri,#FF9F43),var(--pri-d,#F08A24));color:#3d2c1e" onclick="openWheelDefault(${id}, this)">
          <span class="btn-plate pl-48"><img class="btn-ic" src="/static/img/feat/wheel-hub.webp" alt=""></span> ${biTx('转盘中心', 'Wheel Hub')}
        </button>
      </div>
    </div>
  `;
}
window.openOak = openOak;

function partyRowFiveBallsHtml(mainPet, carriedList, opts = {}) {
  const list = (carriedList || []).slice(0, 4);
  const slots = [];
  const mainHasImg = mainPet && mainPet.img;
  const mainVisual = mainHasImg
    ? `<img loading="lazy" src="${esc(mainPet.img)}" alt="" style="width:40px;height:40px;object-fit:contain">`
    : (mainPet && mainPet.egg ? eggHtml(mainPet.egg || EGG_FALLBACK, 32) : ic('star'));
  const mainName = (mainPet && mainPet.name) || tr('主宠', 'Partner');

  const mainNo = (mainPet && mainPet.no != null) ? Number(mainPet.no) : null;
  const mainClick = (mainNo != null && opts.childId != null) ? `onclick="openPartyPetCard(${Number(opts.childId)}, ${mainNo})"` : '';
  slots.push(`
    <button type="button" class="party-slot main-slot" ${mainClick} style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:72px;padding:6px 2px;border-radius:12px;background:linear-gradient(180deg,#FFFBEB,#FEF3C7);border:1.5px solid #D4A017;text-align:center;cursor:${mainClick ? 'pointer' : 'default'}">
      <div style="width:44px;height:44px;display:flex;align-items:center;justify-content:center">${mainVisual}</div>
      <span style="font-size:14px;font-weight:600;line-height:1.2;margin-top:4px;max-width:64px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(mainName)}</span>
      <span style="font-size:14px;color:var(--text-2,#646464)">${tr('主宠', 'Main')}</span>
    </button>
  `);

  for (let i = 0; i < 4; i++) {
    const c = list[i];
    if (c) {
      const isSwapTarget = Boolean(opts.swapPendingTakeNo);
      const clickAttr = opts.interactive
        ? (isSwapTarget
            ? `onclick="confirmWarehouseSwap(${Number(opts.childId)}, ${Number(opts.swapPendingTakeNo)}, ${Number(c.no)})"`
            : `onclick="warehouseStorePet(${Number(opts.childId)}, ${Number(c.no)})"`)
        : (opts.childId != null ? `onclick="openPartyPetCard(${Number(opts.childId)}, ${Number(c.no)})"` : '');
      const actionLabel = opts.interactive
        ? (isSwapTarget ? tr('换出它', 'Swap out') : tr('存入', 'Store'))
        : '';
      slots.push(`
        <button type="button" class="party-slot carried-slot" ${clickAttr}
          style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:72px;padding:6px 2px;border-radius:12px;background:linear-gradient(180deg,#FFFBEB,#FEF3C7);border:${isSwapTarget ? '2px dashed var(--danger,#F25C54)' : '1.5px solid #D4A017'};cursor:${clickAttr ? 'pointer' : 'default'};text-align:center">
          <div style="width:44px;height:44px;display:flex;align-items:center;justify-content:center">
            <img loading="lazy" src="${esc(c.img)}" alt="" style="width:40px;height:40px;object-fit:contain">
          </div>
          <span style="font-size:14px;font-weight:600;line-height:1.2;margin-top:4px;max-width:64px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(c.name)}</span>
          ${actionLabel ? `<span style="font-size:14px;color:${isSwapTarget ? 'var(--danger,#F25C54)' : 'var(--text-2,#646464)'};font-weight:600">${actionLabel}</span>` : ''}
        </button>
      `);
    } else {
      slots.push(`
        <div class="party-slot empty-slot" style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:72px;padding:6px 2px;border-radius:12px;border:1.5px dashed var(--border,#d1d5db);opacity:.6;text-align:center">
          <div style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;font-size:18px">⚪</div>
          <span style="font-size:14px;color:var(--text-2,#646464);margin-top:4px">${tr('空槽位', 'Empty')}</span>
        </div>
      `);
    }
  }

  return `<div class="party-five-row" style="display:grid;grid-template-columns:repeat(5, minmax(0, 1fr));gap:6px;width:100%;align-items:stretch">${slots.join('')}</div>`;
}
window.partyRowFiveBallsHtml = partyRowFiveBallsHtml;

async function loadPartyRow(childId) {
  const id = Number(childId);
  const box = document.getElementById('partyRowEntry');
  if (!box) return;
  try {
    const j = await api('/api/warehouse/status?child_id=' + id);
    if (!j || !j.ok) return;
    const target = document.getElementById('partyRowEntry');
    if (!target) return;
    const isBi = state.lang === 'en';
    const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
    target.innerHTML = `
      <div class="card" style="padding:12px;border-radius:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <b style="font-size:14px">${bi('随身队伍', 'Party Lineup')} (${(j.carried || []).length}/4)</b>
          <button class="smallbtn" style="min-height:48px;font-size:14px" onclick="openWarehousePage(${id})">${tr('管理仓库', 'Storage')}</button>
        </div>
        ${partyRowFiveBallsHtml(j.mainPet, j.carried || [], { interactive: false, childId: id })}
      </div>
    `;
  } catch (_) {}
}
window.loadPartyRow = loadPartyRow;

window._whState = { childId: null, swapPendingTakeNo: null, data: null, mainPet: null };

async function openWarehousePage(childId, keepPendingTakeNo = null) {
  const id = Number(childId);
  let j;
  try {
    j = await api('/api/warehouse/status?child_id=' + id);
  } catch (e) {
    alert(tr('加载仓库失败', 'Failed to load storage'));
    return;
  }
  if (!j || !j.ok) {
    alert(warehouseErrMsg(j && j.error, tr('加载仓库失败', 'Failed to load storage')));
    return;
  }
  window._whState = {
    childId: id,
    swapPendingTakeNo: keepPendingTakeNo,
    data: j,
    mainPet: j.mainPet || { name: tr('主宠', 'Partner'), img: '' },
  };
  renderWarehouseView();
}
window.openWarehousePage = openWarehousePage;

function renderWarehouseView() {
  const { childId, swapPendingTakeNo, data, mainPet } = window._whState;
  const isBi = state.lang === 'en';
  const bi = (zh, en) => isBi ? `${en}<span class="bi-sub"><br>${zh}</span>` : zh;
  const carried = data.carried || [];
  const stored = data.stored || [];
  const isFull = carried.length >= 4;

  const swapBanner = swapPendingTakeNo
    ? `<div class="card" style="background:#fefbe9;border:1.5px solid #FF9F43;padding:10px 12px;margin-bottom:12px;border-radius:12px;display:flex;align-items:center;justify-content:space-between;gap:8px">
         <span style="font-size:14px;font-weight:600;color:#7c4a00">
           ${bi('随身已满 4 只！请点击上方携带行中要换出的收藏伙伴。', 'Party is full (4/4)! Tap a carried partner above to swap out.')}
         </span>
         <button class="smallbtn" style="min-height:48px;font-size:14px" onclick="cancelWarehouseSwap()">${tr('取消', 'Cancel')}</button>
       </div>`
    : '';

  const storedHtml = stored.length === 0
    ? `<div class="card" style="padding:24px 16px;text-align:center;color:var(--text-2,#646464);font-size:14px;border-radius:14px">
         ${bi('仓库空空如也，去完成任务收集更多伙伴吧！', "Prof. Oak's storage is empty. Complete tasks to catch more partners!")}
       </div>`
    : `<div style="display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:10px">
         ${stored.map((c) => {
           const selected = Number(swapPendingTakeNo) === Number(c.no);
           return `
             <button type="button" onclick="warehouseClickStored(${Number(childId)}, ${Number(c.no)})"
               style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:96px;padding:10px 6px;border-radius:14px;background:var(--card-bg,#fff);border:${selected ? '2px solid #FF9F43' : '1.5px solid var(--border,#e5e7eb)'};cursor:pointer">
               <img loading="lazy" src="${esc(c.img)}" alt="" style="width:52px;height:52px;object-fit:contain">
               <b style="font-size:14px;margin-top:6px">${esc(c.name)}</b>
               <span style="font-size:14px;color:var(--primary,#2563eb);margin-top:2px;font-weight:600">
                 ${isFull ? tr('交换入队', 'Swap in') : tr('取出携带', 'Withdraw')}
               </span>
             </button>
           `;
         }).join('')}
       </div>`;

  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="container" style="max-width:390px;margin:0 auto;padding:12px">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
        <button class="smallbtn" style="min-height:48px;min-width:64px;font-size:14px" onclick="openOak(${Number(childId)})">← ${tr('返回', 'Back')}</button>
        <h2 style="margin:0;font-size:1rem;white-space:nowrap">${bi('大木博士的仓库', "Prof. Oak's Storage")}</h2>
        <span style="width:64px"></span>
      </div>

      ${swapBanner}

      <div class="card" style="padding:12px;margin-bottom:14px;border-radius:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <b style="font-size:14px">${bi('随身携带（主宠 + 最多 4 只收藏宠）', 'Party (Main + up to 4 Collection)')}</b>
          <span style="font-size:14px;color:var(--text-2,#646464)">${carried.length} / 4</span>
        </div>
        ${partyRowFiveBallsHtml(mainPet, carried, { interactive: true, childId, swapPendingTakeNo })}
        ${carried.length && !swapPendingTakeNo ? `<div style="margin-top:10px;text-align:center;font-size:14px;color:var(--text-2,#646464)">${bi('点击携带宠 → 送回仓库休息', 'Tap a carried partner → send back to storage')}</div>` : ''}
      </div>

      <div class="card" style="padding:12px;border-radius:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
          <b style="font-size:14px">${bi('仓库存放', 'Stored in Warehouse')} (${stored.length})</b>
        </div>
        ${storedHtml}
        ${stored.length ? `<div style="margin-top:10px;text-align:center;font-size:14px;color:var(--text-2,#646464)">${bi('点击仓库宠 → 加入随身队伍', 'Tap a stored partner → join the party')}</div>` : ''}
      </div>
    </div>
  `;
}

function cancelWarehouseSwap() {
  window._whState.swapPendingTakeNo = null;
  renderWarehouseView();
}
window.cancelWarehouseSwap = cancelWarehouseSwap;

// 仓库接口错误码翻译：后端回的是英文 code，直接 alert 会原样弹给孩子，统一转成双语提示。
function warehouseErrMsg(code, fallback) {
  const map = {
    NOT_IN_WAREHOUSE: ['这只伙伴不在仓库里', 'This partner is not in storage'],
    NOT_CARRIED: ['这只伙伴不在随身携带中', 'This partner is not in your party'],
    PARTY_FULL_SWAP_REQUIRED: ['随身已满 4 只，请先换出一只', 'Party is full (4/4). Swap one out first'],
    MAIN_PET_CANNOT_STORE: ['主宠不能存进仓库', 'Your main partner cannot be stored'],
    INVALID_SPECIES: ['这只伙伴不能存取', 'This partner cannot be moved'],
    INVALID_SWAP_PAIR: ['请选择两只不同的伙伴交换', 'Pick two different partners to swap'],
    NOT_FOUND: ['找不到这个孩子', 'Child not found'],
  };
  const m = map[code];
  return m ? tr(m[0], m[1]) : fallback;
}

async function warehouseStorePet(childId, no) {
  let j;
  try {
    j = await api('/api/warehouse/store', { child_id: childId, no }, 'POST');
  } catch (e) {
    alert(tr('操作失败', 'Action failed'));
    return;
  }
  if (!j || !j.ok) {
    alert(warehouseErrMsg(j && j.error, tr('操作失败', 'Action failed')));
    return;
  }
  window._whState.data.carried = j.carried;
  window._whState.data.stored = j.stored;
  window._whState.swapPendingTakeNo = null;
  renderWarehouseView();
  refreshChildInBackground(childId, 'warehouse');
}
window.warehouseStorePet = warehouseStorePet;

async function warehouseClickStored(childId, takeNo) {
  const carried = (window._whState.data && window._whState.data.carried) || [];
  if (carried.length >= 4) {
    window._whState.swapPendingTakeNo = Number(takeNo);
    renderWarehouseView();
    return;
  }
  let j;
  try {
    j = await api('/api/warehouse/take', { child_id: childId, no: takeNo }, 'POST');
  } catch (e) {
    alert(tr('取出失败', 'Withdraw failed'));
    return;
  }
  if (!j || !j.ok) {
    alert(warehouseErrMsg(j && j.error, tr('取出失败', 'Withdraw failed')));
    return;
  }
  window._whState.data.carried = j.carried;
  window._whState.data.stored = j.stored;
  window._whState.swapPendingTakeNo = null;
  renderWarehouseView();
  refreshChildInBackground(childId, 'warehouse');
}
window.warehouseClickStored = warehouseClickStored;

async function confirmWarehouseSwap(childId, takeNo, storeNo) {
  let j;
  try {
    j = await api('/api/warehouse/swap', { child_id: childId, take_no: takeNo, store_no: storeNo }, 'POST');
  } catch (e) {
    alert(tr('交换失败', 'Swap failed'));
    return;
  }
  if (!j || !j.ok) {
    alert(warehouseErrMsg(j && j.error, tr('交换失败', 'Swap failed')));
    return;
  }
  window._whState.data.carried = j.carried;
  window._whState.data.stored = j.stored;
  window._whState.swapPendingTakeNo = null;
  renderWarehouseView();
  refreshChildInBackground(childId, 'warehouse');
}
window.confirmWarehouseSwap = confirmWarehouseSwap;
window.openOak = openOak;

function renderOakStep() {
  const O = window._oak;
  if (!O) return;
  Object.assign(LANG, {
    oakSlice4Title: ['大木博士', 'Dr. Oak'],
    oakSlice4Sentence: ['第 ', 'Sentence '],
    oakSlice4SentenceEnd: [' 句', ''],
    oakSlice4Topic: ['今日话题：', "Today's topic:"],
    oakSlice4Stars: ['今日 5 星：', '5-star today: '],
    oakSlice4StarsEnd: [' 句（4 句即可抽奖）', ' sentences (4 unlocks the draw)'],
    oakSlice4Drew: ['已抽中', 'Already drew '],
    oakSlice4XP: ['经验 +', 'XP +'],
    oakSlice4Ball: ['普通精灵球 ×1', 'Poké Ball ×1'],
    oakSlice4Replay: ['再听一次', 'Listen again'],
    oakSlice4Previous: ['上一句', 'Previous'],
    oakSlice4Next: ['下一句 ›', 'Next ›'],
    oakSlice4Done: ['完成', 'Done'],
    oakSlice4Submitting: ['提交中…', 'Submitting…'],
    oakSlice4Later: ['稍后再来', 'Later'],
    oakSlice4Denied: ['麦克风没打开，请让大人帮忙检查一下', "The microphone isn't on, please ask an adult to check it"],
    oakSlice4Unsupported: ['这个浏览器不能录音，请用 Safari 打开再试', "This browser can't record, please open it in Safari and try again"],
    oakSlice4RecordFirst: ['先点「跟读录音」，读一遍再往下走', 'Tap Read aloud and record first, read it once, then continue'],
    oakSlice4SubmitFailed: ['提交失败', 'Submission failed, please try again later'],
    oakSlice4SubmitRetry: ['提交失败，请稍后再试', 'Submission failed, please try again later'],
    oakSlice4Level: ['升级到 Lv.', 'Leveled up to Lv.'],
    oakSlice4Evolved: ['进化成 ', 'Evolved into '],
    oakSlice4Draw: ['今日抽奖：', "Today's draw: "],
    oakSlice4Complete: ['今日英语完成！', "Today's English done!"],
    oakSlice4CompleteStart: ['句子都听完啦，+', 'All sentences done, +'],
    oakSlice4CompleteEnd: [' 经验！大木博士为你点赞 ', ' XP! Dr. Oak gives you a thumbs up '],
    oakSlice4Bang: ['！', '!'],
    oakSlice4Stop: ['停止录音', 'Stop recording'],
    oakSlice4RecordAgain: ['重新录一遍', 'Record again'],
    oakSlice4Record: ['跟读录音', 'Read aloud and record'],
    oakSlice4Recording: ['录音中 ', 'Recording '],
    oakSlice4Wait: ['请稍等…', 'Please wait…'],
    oakSlice4Compare: ['对比听', 'Compare and listen'],
    oakSlice4Mine: ['听我的', 'Listen to mine'],
    oakSlice4FeedbackOff: ['AI 点评已关闭，只对比听', 'AI feedback is off, compare listening only'],
    oakSlice4Reviewing: ['AI 老师点评中…', 'AI teacher is reviewing…'],
    oakSlice4ReviewAgain: ['重新点评', 'Review again'],
    oakSlice4Encouragement: [['读得太棒啦！', 'Amazing reading!'], ['读得很好，继续加油！', 'Great reading, keep it up!'], ['不错，再练练会更好！', 'Nice, a bit more practice will make it even better!'], ['别灰心，多听几遍再试试！', "Don't give up, listen a few more times and try again!"]],
    oakSlice4Practice: ['这几个词再练练：', 'Practice these words: '], oakSlice4DrawUnlocked: ['4 句 5 星达成！抽到了', '4 five-star sentences! You drew '], oakSlice4RecordFailed: ['录音没成功，再试一次', 'Recording failed, try again'], oakSlice4RecordCheck: ['录音没成功，检查一下麦克风再试', 'Recording failed, please check the microphone and try again']
  });
  const s = O.data.sentences[O.idx];
  modalRoot.innerHTML = `
  <div class="overlay"><div class="modal quiz">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
      <span class="qchip">${ic('flask')} ${tr(...LANG.oakSlice4Title)}</span>
      <span style="color:var(--text-2);white-space:nowrap">${tr(...LANG.oakSlice4Sentence)}${esc(O.idx + 1)} / ${esc(O.data.sentences.length)}${tr(...LANG.oakSlice4SentenceEnd)}</span>
      <span class="oak-lab">OAK LAB</span>
    </div>
    <div class="oak-topic">${tr(...LANG.oakSlice4Topic)}${esc(O.data.topic)}</div>
    <div class="oak-hint">${ic('star')} ${tr(...LANG.oakSlice4Stars)}${esc(O.data.fiveStarCount || 0)}/${esc(O.data.sentences.length)}${tr(...LANG.oakSlice4StarsEnd)}${O.data.draw ? ` ${ic('gift')} ${tr(...LANG.oakSlice4Drew)}${oakDrawPrizeText(O.data.draw)}` : ''}</div>
    <h2 class="qtext">${esc(s.en)}</h2>
    ${s.showZh !== false ? `<div class="oak-zh">${esc(s.zh)}</div>` : ''}
    <button class="smallbtn" onclick="replayOak()">${ic('volume')} ${tr(...LANG.oakSlice4Replay)}</button>
    <div class="oak-rec-row" id="oakRec"></div>
    <div class="oak-hint" id="oakMic"></div>
    <div class="oak-rec-row" id="oakCompare"></div>
    <div id="oakAssess"></div>
    ${O.idx > 0 ? `<button class="bigbtn ghost" id="oakprev" onclick="prevOakStep()" ${O.submitting ? 'disabled' : ''}>‹ ${tr(...LANG.oakSlice4Previous)}</button>` : ''}
    <button class="bigbtn green" id="oaknext" onclick="submitOakListen()" ${O.submitting ? 'disabled' : ''}>${O.idx === 5 ? ic('checkcircle') + ' ' : ''}${esc(O.submitting ? tr(...LANG.oakSlice4Submitting) : O.idx === 5 ? tr(...LANG.oakSlice4Done) : tr(...LANG.oakSlice4Next))}</button>
    <button class="bigbtn ghost" onclick="closeOak()">${tr(...LANG.oakSlice4Later)}</button>
  </div></div>`;
  oakRenderControls();
  playOakAudio();
}

async function submitOakListen() {
  const O = window._oak;
  if (!O || O.submitting || O.data.completed) return;
  const s = O.data.sentences[O.idx];
  if (s.listened) {
    // 已听过的句子：本地前进，不重复提交（后端只接受按顺序首次提交，重提会 400）
    if (O.idx >= O.data.sentences.length - 1) { closeOak(); return; }
    oakReset(O);
    O.idx++;
    O.submitting = false;
    oakLoadAssess(O);
    renderOakStep();
    return;
  }
  if (!O.rec) {
    // 硬门禁：没录音就不能下一句；麦克风被拒／浏览器不支持也不放行，只提示原因
    alert(O.mic === 'denied' ? tr(...LANG.oakSlice4Denied)
      : O.mic === 'unsupported' ? tr(...LANG.oakSlice4Unsupported)
      : tr(...LANG.oakSlice4RecordFirst));
    return;
  }
  O.submitting = true;
  const btn = document.getElementById('oaknext');
  if (btn) { btn.disabled = true; btn.textContent = tr(...LANG.oakSlice4Submitting); }
  try {
    const j = await api('/api/oak/listen', { child_id: O.data.childId, question_id: s.id });
    if (!j.ok) { alert(j.error || tr(...LANG.oakSlice4SubmitFailed)); return; }
    if (j.xpAwarded) {
      try {
        const prev = parseInt(sessionStorage.getItem('sm_xpgain') || '0', 10) || 0;
        sessionStorage.setItem('sm_xpgain', String(prev + (j.xpAwarded || 0)));
      } catch (e) { /* 静默跳过 */ }
    }
    s.listened = true;
    O.data.listenedCount = j.listenedCount;
    O.data.completed = j.completed;
    if (window._oak !== O) { refreshAfterQuiz(); return; }
    if (j.completed) {
      if (_oakAudio) _oakAudio.pause();
      try { speechSynthesis.cancel(); } catch (e) { /* 静默跳过 */ }
      window._oak = null;
      oakReset(O);
      let extra = '';
      if (j.level && j.level.newLevel > j.level.oldLevel) extra += `<br>${tr(...LANG.oakSlice4Level)}${esc(j.level.newLevel)}${tr(...LANG.oakSlice4Bang)}`;
      if (j.level && j.level.evolved) extra += `<br>${ic('sparkles')} ${tr(...LANG.oakSlice4Evolved)}${esc(j.level.evolved.to)}${tr(...LANG.oakSlice4Bang)}`;
      if (O.data.draw) extra += `<br>${ic('gift')} ${tr(...LANG.oakSlice4Draw)}${oakDrawPrizeText(O.data.draw)}${tr(...LANG.oakSlice4Bang)}`;
      celebrate(tr(...LANG.oakSlice4Complete), null, tr(...LANG.oakSlice4CompleteStart) + esc(j.xpAwarded) + tr(...LANG.oakSlice4CompleteEnd) + ic('thumbsup'), extra);
      setTimeout(() => { closeModal(); refreshAfterQuiz(); }, 900);
    } else {
      oakReset(O);
      O.idx++;
      O.submitting = false;
      oakLoadAssess(O);
      renderOakStep();
    }
  } catch (e) { alert(tr(...LANG.oakSlice4SubmitRetry)); }
  finally {
    if (window._oak === O && !O.data.completed) {
      O.submitting = false;
      const next = document.getElementById('oaknext');
      if (next) {
        next.disabled = false;
        next.textContent = O.idx === 5 ? tr(...LANG.oakSlice4Done) : tr(...LANG.oakSlice4Next);
      }
    }
  }
}
window.submitOakListen = submitOakListen;

function prevOakStep() {
  const O = window._oak;
  if (!O || O.submitting || O.idx <= 0) return;
  oakReset(O);
  O.idx--;
  O.submitting = false;
  oakLoadAssess(O);
  renderOakStep();
}
window.prevOakStep = prevOakStep;

function closeOak() {
  if (window._oak) oakReset(window._oak);
  window._oak = null;
  if (_oakAudio) _oakAudio.pause();
  try { speechSynthesis.cancel(); } catch (e) { /* 静默跳过 */ }
  closeModal();
  refreshAfterQuiz();
}
window.closeOak = closeOak;
function replayOak() { playOakAudio(); }
window.replayOak = replayOak;
function oakKey(O) {
  return `${O.data.childId}|${O.data.date}|${O.data.sentences[O.idx].id}`;
}
function oakLoadAssess(O) {
  if (!O.data.assessEnabled) return;
  try {
    const saved = JSON.parse(localStorage.getItem('oak.assess') || '{}')[oakKey(O)];
    if (saved) O.assess = { state: 'done', stars: saved.stars, bad: saved.bad };
  } catch (_) {}
}
function oakStopPlayback(O) {
  O.playSeq = (O.playSeq || 0) + 1;
  O.playing = false;
  if (O.ownAudio) { O.ownAudio.pause(); O.ownAudio.src = ''; O.ownAudio = null; }
  if (_oakAudio) _oakAudio.pause();
  O.audioToken = (O.audioToken || 0) + 1;
  try { speechSynthesis.cancel(); } catch (_) {}
}
function oakReset(O) {
  O.assessSeq++;
  O.recSeq = (O.recSeq || 0) + 1;
  clearInterval(O.recTimer);
  oakStopPlayback(O);
  const recorder = O.recorder;
  if (recorder && recorder.state !== 'inactive') {
    try { recorder.stop(); } catch (_) {}
  } else if (O.stream) O.stream.getTracks().forEach(t => t.stop());
  if (O.rec) URL.revokeObjectURL(O.rec.url);
  O.rec = null; O.assess = null; O.recState = 'idle';
  O.recorder = null; O.stream = null; O.chunks = [];
}
/* Oak 抽奖奖品文案（新旧 draw 兼容）：服务端新版给 prizeName/prizeEmoji（全部奖品类），
   旧版只有 prize xp/ball 两支；三处引用（提示行、完成结算、评测结果框）共用，避免新奖品显示成球。 */
function oakDrawPrizeText(d) {
  if (!d) return '';
  if (d.prizeName) {
    const img = d.prizeKey ? itemIconUrl(d.prizeKey) : null; // 任务 72：奖品 key 有图用图，无图回退 emoji
    const icon = img ? `<img class="item-ic" loading="lazy" src="${img}" alt="" onerror="this.remove()"> ` : (d.prizeEmoji ? esc(d.prizeEmoji) + ' ' : '');
    return `${icon}${esc(d.prizeName)}`;
  }
  return d.prize === 'xp' ? `${itemIconImg('xp', '')}${tr(...LANG.oakSlice4XP)}${esc(d.xpAwarded)}` : `${itemIconImg('ball', '')}${tr(...LANG.oakSlice4Ball)}`;
}
/* Oak 评测结果框里的抽奖行：justDrawn 且带服务端 wheel 时弹一次真实普通转盘（同一 draw 只弹一次，
