window.oakRecord = oakRecord;
function oakAudioFinished(audio, start) {
  return new Promise((resolve, reject) => {
    const cleanup = () => {
      audio.removeEventListener('ended', ended);
      audio.removeEventListener('error', failed);
      audio.removeEventListener('pause', failed);
    };
    const ended = () => { cleanup(); resolve(); };
    const failed = () => { cleanup(); reject(new Error('playback')); };
    audio.addEventListener('ended', ended);
    audio.addEventListener('error', failed);
    audio.addEventListener('pause', failed);
    try { Promise.resolve(start()).catch(failed); } catch (_) { failed(); }
  });
}
async function oakPlayback(compare) {
  const O = window._oak;
  if (!O || !O.rec || O.playing || O.recState !== 'idle') return;
  oakStopPlayback(O);
  const seq = O.playSeq, s = O.data.sentences[O.idx];
  O.playing = true; oakRenderControls();
  const current = () => window._oak === O && seq === O.playSeq;
  try {
    if (compare && !moveSoundMuted()) {
      let played = false;
      if (s.audio) {
        if (!_oakAudio) _oakAudio = new Audio();
        _oakAudio.src = s.audio;
        try { await oakAudioFinished(_oakAudio, () => _oakAudio.play()); played = true; } catch (_) {}
      }
      if (!current()) return;
      if (!played) await new Promise((resolve, reject) => {
        const utterance = new SpeechSynthesisUtterance(s.en);
        utterance.lang = 'en-US'; utterance.rate = 0.9;
        utterance.onend = resolve; utterance.onerror = reject;
        speechSynthesis.speak(utterance);
