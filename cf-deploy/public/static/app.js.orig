/* 作业打卡怪兽激励 — 前端 SPA */
const app = document.getElementById('app');
const modalRoot = document.getElementById('modal-root');
let state = { overview: null, view: 'home', childId: null, pinOk: false, needPin: false, parentTab: 'reviews', psetDetail: null, settings: null, sessionKind: null, sessionChildId: null, childCache: {}, childMeta: {}, childCacheAt: {} };
const CACHE_TTL_MS = 45000;
const CHILD_READ_POST = ['/api/gym/status', '/api/battle/pvp/status', '/api/pokedex', '/api/encounter/pending', '/api/battle/state', '/api/battle/coop/state'];
function cacheFresh(at) { return at && (Date.now() - at) < CACHE_TTL_MS; }
function storeChild(id, j) { state.childCache[id] = j.child; state.childCacheAt[id] = Date.now(); state.childMeta[id] = { isWeekend: j.isWeekend }; }
function invalidateChildCaches() { state.childCache = {}; state.childCacheAt = {}; state.childMeta = {}; }
function clearAllCaches() { invalidateChildCaches(); if (typeof clearPageCaches === 'function') clearPageCaches(); }
function cacheMap(name) { if (!state[name]) state[name] = {}; return state[name]; }

async function refreshDexInBackground(id) {
  const j = await api('/api/pokedex', { childId: id });
  if (!j.ok) return;
  cacheMap('dexCache')[id] = j; cacheMap('dexCacheAt')[id] = Date.now();
  if (state.childId !== id || state.view !== 'pokedex') return;
  const grid = document.getElementById('dex151-grid');
  if (grid && !grid.hidden) return; // 151 网格正展开时不重渲染，免得收起用户已展开的网格
  dexData = j;
  renderPokedexPage(id, j);
}

/* ---------- 本地缓存集成（2026-10-28 完整版 C 路） ---------- */
function lcAvailable() { return typeof window !== 'undefined' && !!window.LocalCache && typeof indexedDB !== 'undefined'; }
const lcFetch = window.fetch.bind(window);
function lcShDate() { return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai' }).format(new Date()); }
function lcWeekStartMon(dateStr) { var p = String(dateStr || '').split('-'); var d = new Date(Date.UTC(+p[0], +p[1] - 1, +p[2])); var diff = (d.getUTCDay() + 6) % 7; d.setUTCDate(d.getUTCDate() - diff); return d.toISOString().slice(0, 10); }
function lcFlattenDex(dexJ) {
  var out = [];
  var src = dexJ || {};
  var groups = [];
  if (Array.isArray(src.lineEntries)) groups = groups.concat(src.lineEntries);
  if (Array.isArray(src.wild)) groups = groups.concat(src.wild);
  if (Array.isArray(src.others)) groups = groups.concat(src.others);
  if (Array.isArray(src.collection)) groups = groups.concat(src.collection);
  if (Array.isArray(src.eggSpecies)) groups = groups.concat(src.eggSpecies);
  if (Array.isArray(src.dex151)) groups = groups.concat(src.dex151);
  for (var i = 0; i < groups.length; i++) {
    var e = groups[i] || {};
    var row = {};
    for (var k in e) row[k] = e[k];
    row.entry_key = e.key || e.entry_key || (e.no !== undefined && e.no !== null ? 'dex151:' + e.no : undefined);
    if (row.entry_key === undefined || row.entry_key === null || row.entry_key === '') continue;
    out.push(row);
  }
  out.push({ entry_key: '__full__', full: src });
  return out;
}
function lcSaveAggregates(childId, childJ, quizAllJ, dexJ, gymJ, pvpJ, syncVersion) {
  return window.LocalCache.saveFull(childId, { child: Object.assign({}, childJ.child, { _isWeekend: childJ.isWeekend }), questions: (quizAllJ && quizAllJ.questions) || [], pokedex: lcFlattenDex(dexJ), gymStatus: gymJ, pvpStatus: pvpJ, quizToday: (childJ.child && childJ.child.quizToday) || null, syncVersion: syncVersion });
}
async function lcRefreshAggregates(childId, syncVersion) {
  var reqs = await Promise.all([
    lcFetch('/api/child?id=' + encodeURIComponent(childId)),
    lcFetch('/api/quiz/all?child_id=' + encodeURIComponent(childId)),
    lcFetch('/api/pokedex', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ childId: childId }) }),
    lcFetch('/api/gym/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ childId: childId }) }),
    lcFetch('/api/battle/pvp/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ childId: childId }) })
  ]);
  for (var i = 0; i < reqs.length; i++) { if (!reqs[i] || !reqs[i].ok) return; }
  var vals = await Promise.all(reqs.map(function (r) { return r.json(); }));
  storeChild(childId, vals[0]);
  await lcSaveAggregates(childId, vals[0], vals[1], vals[2], vals[3], vals[4], syncVersion);
}
/* ---------- 快照资源 hash 校验（任务 91，2026-11-11） ----------
 * hash-assets 每次轮换都会给图片文件改名（旧 hash 文件下线）；本地快照
 * （IndexedDB __full__ 行）存的是旧 hash 的 img URL，图鉴先读快照渲染
 * 就会 404 空白。校验：快照里第一条带 hash 的 img 必须与当前加载的
 * app.<hash>.js 同 hash，否则作废快照、走网络重拉。取不到当前 hash
 * 或快照里无带 hash 的 img 时不断言，维持原行为；只影响读路径，不删数据。 */
function lcCurrentAssetHash() {
  try {
    if (window._lcAssetHash) return window._lcAssetHash;
    var scripts = document.getElementsByTagName('script');
    for (var i = 0; i < scripts.length; i++) {
      var m = (scripts[i].src || '').match(/\/app\.([0-9a-f]{8})\.js(?:[?#]|$)/);
      if (m) { window._lcAssetHash = m[1]; return m[1]; }
    }
  } catch (e) {}
  return null;
}
function lcSnapshotHashOk(full, child) {
  try {
    var h = lcCurrentAssetHash();
    if (!h) return true;
    var imgs = [];
    var groups = full ? [full.wild, full.lineEntries, full.others, full.collection, full.eggSpecies, full.dex151] : [];
    for (var gi = 0; gi < groups.length; gi++) {
      var g = groups[gi];
      if (!Array.isArray(g)) continue;
      for (var ei = 0; ei < g.length; ei++) {
        if (g[ei] && typeof g[ei].img === 'string' && g[ei].img) imgs.push(g[ei].img);
      }
    }
    if (child) {
      if (child.form && typeof child.form.img === 'string' && child.form.img) imgs.push(child.form.img);
      if (child._evo && typeof child._evo.img === 'string' && child._evo.img) imgs.push(child._evo.img);
    }
    for (var ii = 0; ii < imgs.length; ii++) {
      var m = imgs[ii].match(/\.([0-9a-f]{8})\.(?:webp|png|js|css)$/);
      if (m) return m[1] === h;
    }
    return true;
  } catch (e) { return true; }
}
async function lcSnapshot(childId) {
  try {
    var snap = await window.LocalCache.getSnapshot(childId);
    if (!snap || !snap.complete || !snap.child) return null;
    // 日期缺失或与当天上海日期不一致时，跨天快照作废，回退到网络重拉。
    if (!snap.child.today || snap.child.today !== lcShDate()) return null;
    // 快照里的孩子对象必须是 /api/child 的完整对象（含 form／sealedEggs／moves 等计算字段）；
    // 增量同步写进来的数据库原始行是子集（无这些字段），当作不可用快照回退到网络，
    // 避免 goChild 读 k.sealedEggs.length 抛错白屏。已存的子集会在下次同步后由
    // lcRefreshAggregates 重拉完整对象覆盖，校验只影响读路径、不删数据。
    if (!snap.child.form || !Array.isArray(snap.child.sealedEggs) || !Array.isArray(snap.child.moves)) return null;
    var full = null;
    var rows = Array.isArray(snap.pokedex) ? snap.pokedex : [];
    for (var i = 0; i < rows.length; i++) { if (rows[i] && rows[i].entry_key === '__full__') { full = rows[i].full || null; break; } }
    if (!full) return null;
    if (!lcSnapshotHashOk(full, snap.child)) return null;
    return { child: snap.child, isWeekend: snap.child._isWeekend, gymStatus: snap.gymStatus, pvpStatus: snap.pvpStatus, quizToday: snap.quizToday, pokedexFull: full, syncVersion: snap.syncVersion, complete: snap.complete };
  } catch (e) { return null; }
}
async function lcEnsureFull(childId) {
  try {
    var ok = await window.LocalCache.isComplete(childId);
    if (ok) return { ok: true, snapshot: await lcSnapshot(childId) };
    var reqs = await Promise.all([
      lcFetch('/api/child?id=' + encodeURIComponent(childId)),
      lcFetch('/api/quiz/all?child_id=' + encodeURIComponent(childId)),
      lcFetch('/api/pokedex', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ childId: childId }) }),
      lcFetch('/api/gym/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ childId: childId }) }),
      lcFetch('/api/battle/pvp/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ childId: childId }) })
    ]);
    for (var i = 0; i < reqs.length; i++) { if (!reqs[i] || !reqs[i].ok) return { ok: false }; }
    var vals = await Promise.all(reqs.map(function (r) { return r.json(); }));
    storeChild(childId, vals[0]);
    await lcSaveAggregates(childId, vals[0], vals[1], vals[2], vals[3], vals[4], null);
    return { ok: true, snapshot: await lcSnapshot(childId) };
  } catch (e) { return { ok: false }; }
}
async function lcIdb() {
  return await new Promise(function (resolve, reject) {
    var req = indexedDB.open('sm-local', 1);
    req.onupgradeneeded = function (ev) {
      var db = ev.target.result;
      if (!db.objectStoreNames.contains('checkins')) { db.createObjectStore('checkins', { keyPath: 'id' }); }
      if (!db.objectStoreNames.contains('pending_photos')) { db.createObjectStore('pending_photos', { keyPath: 'id' }); }
      if (!db.objectStoreNames.contains('quiz_daily')) { db.createObjectStore('quiz_daily', { keyPath: 'id' }); }
      if (!db.objectStoreNames.contains('quiz_attempts')) { db.createObjectStore('quiz_attempts', { keyPath: 'id' }); }
      if (!db.objectStoreNames.contains('outbox')) { db.createObjectStore('outbox', { keyPath: 'cmd_id' }); }
      if (!db.objectStoreNames.contains('local')) { db.createObjectStore('local', { keyPath: 'id' }); }
    };
    req.onsuccess = function () { resolve(req.result); };
    req.onerror = function () { reject(req.error || new Error('idb')); };
  });
}
async function lcPutLocal(store, row) {
  try {
    var db = await lcIdb();
    return await new Promise(function (resolve, reject) {
      var tx = db.transaction(store, 'readwrite');
      tx.objectStore(store).put(row);
      tx.oncomplete = function () { resolve(true); };
      tx.onerror = function () { reject(tx.error || new Error('put')); };
    });
  } catch (e) { return false; }
}
async function lcGetLocalByChild(store, childId) {
  var db = await lcIdb();
  return await new Promise(function (resolve, reject) {
    try {
      var tx = db.transaction(store, 'readonly');
      var os = tx.objectStore(store);
      var out = [];
      if (os.indexNames && os.indexNames.contains && os.indexNames.contains('by_child')) {
        var idx = os.index('by_child');
        var req = idx.getAll(childId);
        req.onsuccess = function () { resolve(req.result || []); };
        req.onerror = function () { reject(req.error || new Error('getAll')); };
      } else {
        var req2 = os.getAll();
        req2.onsuccess = function () { resolve((req2.result || []).filter(function (r) { return String(r.child_id) === String(childId); })); };
        req2.onerror = function () { reject(req2.error || new Error('getAll')); };
      }
    } catch (e) { reject(e); }
  });
}
async function lcDeleteLocal(store, key) {
  try {
    var db = await lcIdb();
    return await new Promise(function (resolve, reject) {
      var tx = db.transaction(store, 'readwrite');
      tx.objectStore(store).delete(key);
      tx.oncomplete = function () { resolve(true); };
      tx.onerror = function () { reject(tx.error || new Error('del')); };
    });
  } catch (e) { return false; }
}
async function lcRemoveOutboxCmd(cmdId) { return await lcDeleteLocal('outbox', cmdId); }
function lcTrackSettle(cmdId, info) {
  try {
    var raw = localStorage.getItem('sm.settles.v1');
    var obj = raw ? JSON.parse(raw) : {};
    obj[cmdId] = Object.assign({}, info, { at: Date.now() });
    localStorage.setItem('sm.settles.v1', JSON.stringify(obj));
  } catch (e) {}
}
async function lcOutboxHas(cmdId) {
  try {
    var db = await lcIdb();
    return await new Promise(function (resolve) {
      var tx = db.transaction('outbox', 'readonly');
      var req = tx.objectStore('outbox').get(cmdId);
      req.onsuccess = function () { resolve(!!req.result); };
      req.onerror = function () { resolve(false); };
    });
  } catch (e) { return false; }
}
async function lcWatchOutbox(childId) {
  try {
    var raw = localStorage.getItem('sm.cmds.v1');
    if (!raw) return;
    var obj = JSON.parse(raw) || {};
    var keys = Object.keys(obj);
    var changed = false;
    for (var i = 0; i < keys.length; i++) {
      var cmdId = keys[i];
      var info = obj[cmdId];
      if (!info || String(info.childId) !== String(childId)) continue;
      if (!(await lcOutboxHas(cmdId))) {
        delete obj[cmdId];
        changed = true;
        continue;
      }
      try {
        var r = await lcFetch('/api/commands', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cmd_id: cmdId, child_id: childId, type: info.type, payload: info.payload }) });
        var j = await r.json().catch(function () { return null; });
        if (r.ok && j && j.ok) {
          await lcRemoveOutboxCmd(cmdId);
          delete obj[cmdId];
          changed = true;
        } else if (r.status === 400 && j && j.error) {
          await lcRemoveOutboxCmd(cmdId);
          delete obj[cmdId];
          changed = true;
          alert('这条记录服务端已经处理过啦，不用再同步：' + j.error);
        }
      } catch (e) {}
    }
    if (changed) localStorage.setItem('sm.cmds.v1', JSON.stringify(obj));
    await window.LocalCache.flushOutbox(lcFetch);
  } catch (e) {}
}
async function lcWatchSettles(childId) {
  try {
    var raw = localStorage.getItem('sm.settles.v1');
    if (!raw) return;
    var obj = JSON.parse(raw) || {};
    var changed = false;
    var keys = Object.keys(obj);
    for (var i = 0; i < keys.length; i++) {
      var cmdId = keys[i];
      var info = obj[cmdId];
      if (!info || String(info.childId) !== String(childId)) continue;
      try {
        var r = await lcFetch('/api/commands', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ cmd_id: cmdId, child_id: childId, type: info.type, payload: info.payload }) });
        var j = await r.json().catch(function () { return { ok: false }; });
        if (j && j.ok) {
          if (info.type === 'pvp_settle' && j && j.counted === false && j.practice === true) alert('这场记为练习场（不计次），战报已保留，不发奖励');
          delete obj[cmdId];
          changed = true;
        } else if (j && j.error && (j.error === 'WEEK_PASSED' || j.error === 'ALREADY_CLEARED' || j.error === 'NOT_WEEKEND' || j.error === 'CHECKINS_TOO_FEW' || j.error === 'DATE_IN_FUTURE' || j.error === 'FORBIDDEN' || j.error === 'INVALID_PAIR')) {
          // 服务端结算校验（2026-11-15）新增的拒绝码：这些重试也不会变好，清掉待结算，别无限重试
          alert(j.error === 'WEEK_PASSED' ? '该场通关所属周已结束，未结算奖励' : j.error === 'ALREADY_CLEARED' ? '本周已通关，未重复结算奖励' : j.error === 'NOT_WEEKEND' ? '道馆只在周六、周日开放，这场没有结算奖励' : j.error === 'CHECKINS_TOO_FEW' ? '那一周打卡不满 4 天，这场没有结算奖励' : '这场对战结算校验未通过，没有结算奖励');
          delete obj[cmdId];
          changed = true;
          await lcRemoveOutboxCmd(cmdId);
        }
      } catch (e) {}
    }
    if (changed) localStorage.setItem('sm.settles.v1', JSON.stringify(obj));
  } catch (e) {}
}
async function lcFlushPendingPhotos(childId) {
  try {
    var pend = await window.LocalCache.pendingPhotos(childId);
    if (!pend || !pend.length) return;
    var raw = localStorage.getItem('sm.photoCmds.v1');
    var cmdMap = raw ? JSON.parse(raw) : {};
    var checkins = await lcGetLocalByChild('checkins', childId).catch(function () { return []; });
    for (var i = 0; i < pend.length; i++) {
      var photo = pend[i];
      var localId = String(photo.checkin_local_id || '');
      if (!localId || !cmdMap[localId]) continue;
      var wantSubj = String(cmdMap[localId].subject || '');
      var wantDate = String(cmdMap[localId].date || '');
      var nextDate = '';
      try {
        var parts = wantDate.split('-');
        var dd = new Date(Date.UTC(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]) + 1));
        nextDate = dd.toISOString().slice(0, 10);
      } catch (e) {}
      var found = null;
      for (var j = 0; j < checkins.length; j++) {
        var row = checkins[j] || {};
        if (row._local) continue;
        if (String(row.subject || '') !== wantSubj) continue;
        var rd = String(row.date || '');
        if (rd === wantDate || (nextDate && rd === nextDate)) { found = row; break; }
      }
      if (found) await lcPutLocal('pending_photos', Object.assign({}, photo, { checkin_local_id: String(found.id) }));
    }
    await window.LocalCache.flushPhotos(lcFetch);
  } catch (e) {}
}
async function lcGetTodayQuiz(childId) {
  try {
    var rows = await lcGetLocalByChild('quiz_daily', childId).catch(function () { return []; });
    var today = lcShDate();
    var day = null;
    for (var i = 0; i < rows.length; i++) { if (String(rows[i].date_shanghai) === today) { day = rows[i]; break; } }
    if (!day) return null;
    var ids = [];
    try { ids = Array.isArray(day.question_ids) ? day.question_ids : JSON.parse(day.question_ids || '[]'); } catch (e) { ids = []; }
    var qs = await window.LocalCache.getQuestions();
    var map = {};
    for (var j = 0; j < (qs || []).length; j++) map[String(qs[j].id)] = qs[j];
    var list = [];
    for (var k = 0; k < ids.length; k++) {
      var q = map[String(ids[k])];
      if (!q) continue;
      list.push({ id: q.id, question: q.question, options: q.options, answer_idx: q.answer_idx, explain: q.explain, subject: q.subject, label: q.subject });
    }
    var attempts = await lcGetLocalByChild('quiz_attempts', childId).catch(function () { return []; });
    var answered = new Set();
    for (var m = 0; m < attempts.length; m++) { if (String(attempts[m].date_shanghai || '') === today) answered.add(attempts[m].question_id); }
    return { questions: list, answered: answered, quota: list.length, remaining: Math.max(0, list.length - answered.size) };
  } catch (e) { return null; }
}
async function lcOverlayPending(child) {
  try {
    if (!child || !lcAvailable()) return child;
    var rows = await lcGetLocalByChild('checkins', child.id).catch(function () { return []; });
    var today = lcShDate();
    var pend = [];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r && r._local === 'pending' && String(r.date || '') === today) pend.push(r);
    }
    if (!pend.length) return child;
    var copy = JSON.parse(JSON.stringify(child));
    copy.todaySubjects = copy.todaySubjects || [];
    for (var j = 0; j < pend.length; j++) {
      var row = pend[j];
      var found = null;
      for (var k = 0; k < copy.todaySubjects.length; k++) {
        if (copy.todaySubjects[k].subject === row.subject) { found = copy.todaySubjects[k]; break; }
      }
      if (found) {
        if (!found.checkin) found.checkin = { id: row.id, status: 'pending', note: row.note || '', submittedAt: row.submitted_at || '', isEarly: !!row.is_early, xpAwarded: null, reason: null, photos: [], _local: 'pending' };
      } else {
        copy.todaySubjects.push({ subject: row.subject, checkin: { id: row.id, status: 'pending', note: row.note || '', submittedAt: row.submitted_at || '', isEarly: !!row.is_early, xpAwarded: null, reason: null, photos: [], _local: 'pending' } });
      }
    }
    return copy;
  } catch (e) { return child; }
}
function lcNetOff() { return typeof navigator !== 'undefined' && navigator.onLine === false; }
function lcNeedNetAttr(label) { return ' data-need-net="' + label + '"'; }
function lcApplyNetState() {
  try {
    var off = lcNetOff();
    var els = document.querySelectorAll('[data-need-net]');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (off) { el.disabled = true; el.style.opacity = .55; el.title = '需要联网'; }
      else { el.disabled = false; el.style.opacity = ''; el.title = ''; }
    }
  } catch (e) {}
}
function lcShouldSync() { return Date.now() >= (window._lcNoSyncUntil || 0); }
function lcOverviewFromSnapshots(snaps) {
  return { today: lcShDate(), isWeekend: !!(snaps[0] && snaps[0].isWeekend), pendingReviewCount: 0, children: (snaps || []).map(function (s) { return Object.assign({}, s.child, { quizToday: s.quizToday || s.child.quizToday || null, sealedEggCount: (s.child.sealedEggs || []).length }); }) };
}
async function lcPruneLocalCheckins(childId) {
  try {
    var cached = state.childCache[childId];
    if (!cached || !cacheFresh(state.childCacheAt[childId])) return;
    var rows = await lcGetLocalByChild('checkins', childId).catch(function () { return []; });
    for (var i = 0; i < rows.length; i++) {
      var row = rows[i];
      if (!row || row._local !== 'pending') continue;
      var entry = null;
      var subs = cached.todaySubjects || [];
      for (var j = 0; j < subs.length; j++) {
        if (subs[j].subject === row.subject) { entry = subs[j]; break; }
      }
      var server = entry && entry.checkin && entry.checkin.id && String(entry.checkin.id).indexOf('local:') !== 0 ? entry.checkin : null;
      if (server) await lcDeleteLocal('checkins', row.id);
    }
  } catch (e) {}
}

async function lcSyncChild(childId, opts) {
  opts = opts || {};
  var before = null;
  try { before = await lcSnapshot(childId); } catch (e) {}
  try {
    var res = await window.LocalCache.syncNow(childId, lcFetch);
    try { await lcWatchSettles(childId); } catch (e) {}
    try { await lcWatchOutbox(childId); } catch (e) {}
    try { await lcFlushPendingPhotos(childId); } catch (e) {}
    try { await lcRefreshAggregates(childId, res.version); } catch (e) {}
    try { await lcPruneLocalCheckins(childId); } catch (e) {}
    if (opts.rerender !== false && state.childId === childId && ['child', 'checkin', 'gym', 'pokedex', 'home'].indexOf(state.view) >= 0) lcRerenderCurrent();
    return { ok: true, version: res.version };
  } catch (e) { return { ok: false }; }
}
function lcSyncSoon() {
  try {
    if (window._lcSyncSoonTimer) clearTimeout(window._lcSyncSoonTimer);
    window._lcSyncSoonTimer = setTimeout(function () {
      if (state.childId && lcAvailable() && !lcNetOff()) lcSyncChild(state.childId, { rerender: false }).catch(function () {});
    }, 1500);
  } catch (e) {}
}
function lcRerenderCurrent() {
  try {
    var y = window.scrollY;
    window._lcNoSyncUntil = Date.now() + 10000;
    if (state.view === 'home') { renderHome(); try { var ids = JSON.parse(localStorage.getItem('sm.childIds.v1') || '[]'); Promise.all(ids.map(function (cid) { return lcSnapshot(cid); })).then(function (snaps) { var ok = snaps.filter(function (s) { return s && s.complete; }); if (ok.length && state.view === 'home') { state.overview = lcOverviewFromSnapshots(ok); renderHome(); window.scrollTo(0, y); } }).catch(function () {}); } catch (e) {} }
    else if (state.view === 'child') goChild(state.childId);
    else if (state.view === 'checkin') goCheckinPage(state.childId);
    else if (state.view === 'gym') goGym(state.childId);
    else if (state.view === 'pokedex') goPokedex(state.childId);
    else if (state.view === 'subject' && window._subj) goSubjectDetail(window._subj.childId, window._subj.subject);
    window.scrollTo(0, y);
  } catch (e) {}
}
function lcPendingBadge(childId, elId) {
  try {
    window.LocalCache.pendingCount(childId).then(function (n) { var el = document.getElementById(elId); if (el) el.textContent = n ? String(n) : ''; }).catch(function () {});
  } catch (e) {}
}
window.addEventListener('online', function () { lcApplyNetState(); if (state.childId && lcAvailable()) lcSyncChild(state.childId, { rerender: true }).catch(function () {}); });
window.addEventListener('offline', function () { lcApplyNetState(); });
/* ---------- 本地缓存集成（2026-10-28 完整版 C 路） ---------- */

async function refreshChildInBackground(id, view) { try { const j = await api('/api/child?id=' + id); if (!j.ok) { if (j.error === 'FORBIDDEN') goHome2(); return; } storeChild(id, j); if (state.childId !== id || state.view !== view) return; const y = window.scrollY; if (view === 'child') await goChild(id); else if (view === 'checkin') await goCheckinPage(id); window.scrollTo(0, y); } catch (e) { /* 后台刷新失败静默，不弹 */ } }
let parentRenderDepth = 0;

async function api(path, body, method, timeoutMs) {
  const m = method || (body ? 'POST' : 'GET');
  // 111 根因修：读请求（GET）默认 8 秒超时、网络失败自动重试 1 次。
  // 之前只有对战动作传了 15 秒超时（2026-10-24），其余请求无限等——网络一卡，设置页 60 秒+不渲染、每日三行 30 秒+空白。
  // 写请求不自动重试（不幂等）；已传显式超时的调用保持原值。
  const budget = timeoutMs || (m === 'GET' ? 8000 : 0);
  const attempts = (m === 'GET' && !timeoutMs) ? 2 : 1;
  let lastErr = null;
  for (let a = 0; a < attempts; a++) {
    const opt = { method: m, headers: { 'Content-Type': 'application/json' } };
    if (body) opt.body = JSON.stringify(body);
    let timer = null;
    try {
      if (budget) {
        const ctl = new AbortController();
        opt.signal = ctl.signal;
        timer = setTimeout(() => ctl.abort(), budget);
      }
      let r;
      try {
        r = await fetch(path, opt);
      } finally {
        if (timer) clearTimeout(timer);
      }
      const j = await r.json().catch(() => ({ ok: false }));
      if (j && j.ok && m !== 'GET' && !CHILD_READ_POST.some((p) => path.indexOf(p) === 0)) { clearAllCaches(); if (typeof lcSyncSoon === 'function') { try { lcSyncSoon(); } catch (e) {} } }
      if (j.error === 'NEED_LOGIN') location.href = '/login';
      else if (j.error === 'NEED_PIN') {
        // 只改状态不写 DOM：renderParent 构建期间由其顶层统一切回 PIN 盘，杜绝覆写竞态
        const wasOk = state.pinOk;
        state.pinOk = false;
        state.needPin = true;
        if (wasOk && parentRenderDepth === 0) goParent();
      }
      return j;
    } catch (e) {
      lastErr = e;
      if (a + 1 < attempts) await new Promise((r) => setTimeout(r, 500));
    }
  }
  throw lastErr;
}
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
