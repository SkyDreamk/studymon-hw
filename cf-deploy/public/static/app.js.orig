  return `<div>${ic('gift')} ${tr(...LANG.oakSlice4DrawUnlocked)}${oakDrawPrizeText(d)}${tr(...LANG.oakSlice4Bang)}</div>`;
}
function oakRenderControls() {
  const O = window._oak;
  if (!O) return;
  const row = document.getElementById('oakRec');
  if (!row) return;
  const busy = O.recState === 'requesting' || O.recState === 'saving';
  // 录音按钮只建一次：录音中每 250ms 刷新秒数时只改文字，不重建按钮节点；
  // 否则 iPhone 上点按正好撞上 innerHTML 重建会被吃掉，表现为“点了停止好几秒没反应”。
  let btn = row._oakBtn, timer = row._oakTimer;
  if (!btn || !row.contains(btn) || !timer || !row.contains(timer)) {
    row.innerHTML = '';
    btn = document.createElement('button');
    btn.className = 'smallbtn';
    btn.setAttribute('onclick', 'oakRecord()');
    timer = document.createElement('span');
    row.appendChild(btn);
    row.appendChild(timer);
    row._oakBtn = btn;
    row._oakTimer = timer;
  }
  btn.disabled = busy || O.submitting || O.mic === 'unsupported';
  btn.innerHTML = O.recState === 'recording' ? ic('stop') + ' ' + tr(...LANG.oakSlice4Stop) : O.rec ? ic('mic') + ' ' + tr(...LANG.oakSlice4RecordAgain) : ic('mic') + ' ' + tr(...LANG.oakSlice4Record);
  timer.textContent = O.recState === 'recording' ? `● ${tr(...LANG.oakSlice4Recording)}${Math.floor((Date.now() - O.recAt) / 1000)}s` : busy ? tr(...LANG.oakSlice4Wait) : '';
  document.getElementById('oakMic').textContent = O.mic === 'denied' ? tr(...LANG.oakSlice4Denied) : O.mic === 'unsupported' ? tr(...LANG.oakSlice4Unsupported) : O.recError === LANG.oakSlice4RecordFailed[0] ? tr(...LANG.oakSlice4RecordFailed) : O.recError === LANG.oakSlice4RecordCheck[0] ? tr(...LANG.oakSlice4RecordCheck) : O.recError || '';
  document.getElementById('oakCompare').innerHTML = O.rec ? `<button class="smallbtn" onclick="oakPlayback(true)" ${O.playing || O.recState !== 'idle' ? 'disabled' : ''}>${ic('volume')} ${tr(...LANG.oakSlice4Compare)}</button><button class="smallbtn" onclick="oakPlayback(false)" ${O.playing || O.recState !== 'idle' ? 'disabled' : ''}>${ic('mic')} ${tr(...LANG.oakSlice4Mine)}</button>` : '';
  const box = document.getElementById('oakAssess'), a = O.assess;
  box.className = O.rec || a ? 'oak-assess' : '';
  if (!O.data.assessEnabled) {
    box.innerHTML = O.rec ? `<div class="oak-hint">${tr(...LANG.oakSlice4FeedbackOff)}</div>` : '';
  } else if (!a) box.innerHTML = '';
  else if (a.state === 'assessing') box.innerHTML = ic('star') + ' ' + tr(...LANG.oakSlice4Reviewing);
  else if (a.state === 'error') box.innerHTML = `<div class="oak-err">${esc(a.msg)}</div><button class="smallbtn" onclick="oakRetryAssess()">↻ ${tr(...LANG.oakSlice4ReviewAgain)}</button>`;
  else if (a.state === 'done') {
    const n = Math.max(1, Math.min(5, Number(a.stars) || 1));
    const encouragement = tr(...LANG.oakSlice4Encouragement[n === 5 ? 0 : n === 4 ? 1 : n === 3 ? 2 : 3]);
    box.innerHTML = `<div class="oak-stars">${'★'.repeat(n)}${'☆'.repeat(5 - n)}</div><div style="margin-top:4px">${encouragement}</div>${a.bad?.length ? `<div class="oak-bad">${tr(...LANG.oakSlice4Practice)}${a.bad.slice(0, 3).map(w => `<button class="oak-word" onclick="replayOak()">${esc(w.w)}</button>`).join('')}</div>` : ''}${oakDrawLine(O)}`;
  } else box.innerHTML = '';
}
function oakPickMime() {
  const probe = document.createElement('audio');
  for (const mime of ['audio/mp4', 'audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus']) {
    try { if (MediaRecorder.isTypeSupported(mime) && probe.canPlayType(mime)) return mime; } catch (_) {}
  }
  return '';
}
async function oakRecord() {
  const O = window._oak;
  if (!O || O.submitting) return;
  if (O.recState === 'recording') {
    O.recState = 'saving'; clearInterval(O.recTimer);
    try { O.recorder.stop(); } catch (_) { oakReset(O); }
    oakRenderControls(); return;
  }
  if (O.recState !== 'idle') return;
  oakReset(O);
  const seq = O.recSeq;
  O.recState = 'requesting'; O.recError = '';
  oakRenderControls();
  let stream;
  try {
    if (!window.MediaRecorder || !navigator.mediaDevices?.getUserMedia) throw new Error('unsupported');
    stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
    if (window._oak !== O || seq !== O.recSeq) { stream.getTracks().forEach(t => t.stop()); return; }
    O.stream = stream;
    const mime = oakPickMime();
    const recorder = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
    const chunks = [];
    O.recorder = recorder; O.chunks = chunks; O.mic = 'ok';
    recorder.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
    recorder.onstop = () => {
      stream.getTracks().forEach(t => t.stop());
      if (window._oak !== O || seq !== O.recSeq) return;
      clearInterval(O.recTimer);
      O.recState = 'idle'; O.recorder = null; O.stream = null; O.chunks = [];
      const blob = new Blob(chunks, { type: recorder.mimeType || chunks[0]?.type || mime });
      if (blob.size) {
        O.rec = { blob, mime: blob.type, url: URL.createObjectURL(blob) };
        if (O.data.assessEnabled) oakAssess(blob, O.data.sentences[O.idx]);
      } else O.recError = '录音没成功，再试一次';
      oakRenderControls();
    };
    recorder.onerror = () => {
      if (window._oak !== O || seq !== O.recSeq) return;
      oakReset(O); O.recError = '录音没成功，再试一次'; oakRenderControls();
    };
    recorder.start(250);
    O.recAt = Date.now(); O.recState = 'recording';
    O.recTimer = setInterval(() => {
      if (window._oak !== O || seq !== O.recSeq) return;
      if (Date.now() - O.recAt >= 30000) oakRecord();
      else oakRenderControls();
    }, 250);
    oakRenderControls();
  } catch (e) {
