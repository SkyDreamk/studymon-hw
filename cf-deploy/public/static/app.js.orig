  if (wheelValid(d.wheel)) {
    const key = `${O.data.childId}|${O.data.date}|${d.prizeKey || d.prize || ''}|${d.prizeName || ''}`;
    if (O._oakWheelKey !== key) {
      O._oakWheelKey = key;
      setTimeout(() => {
        if (window._oak !== O) return;
        // 普通转盘每日抽奖为一次性（奖品已在答题结算时发到账，每天一次）：不传 onTwist，归位后按钮显示“今日已抽完”且禁用；再扭会显示没发到的奖品，故不允许
        showWheel({ sectors: d.wheel.sectors, winnerIndex: d.wheel.winnerIndex, title: tr('普通转盘', 'Ordinary Wheel'), centerText: tr('普通转盘', 'Ordinary Wheel'), onDone: () => closeModal(), noMoreText: tr('今日已抽完', "Today's draw is done") });
      }, 0);
    }
