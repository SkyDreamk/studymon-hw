const CHINESE_CHAPTERS = {
  1: ['一年级上册 第1单元', '一年级上册 第2单元', '一年级上册 第3单元', '一年级上册 第4单元', '一年级上册 第5单元', '一年级上册 第6单元', '一年级上册 第7单元', '一年级上册 第8单元', '一年级下册 第1单元', '一年级下册 第2单元', '一年级下册 第3单元', '一年级下册 第4单元', '一年级下册 第5单元', '一年级下册 第6单元', '一年级下册 第7单元', '一年级下册 第8单元'],
