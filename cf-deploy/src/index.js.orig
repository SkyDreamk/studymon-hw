  // 第四批（2026-11-06）：8 条进化线（90 线等下一批 91 进来时再接）
  69: { stages: [69, 70, 71], conds: [{ kind: 'level', level: 21 }, { kind: 'stone', stone: 'stone:leaf' }] },
