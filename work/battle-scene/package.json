{
  "name": "battle-scene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared PixiJS v8 battle scene - Phase 1 Gym",
  "main": "src/battle-scene.js",
  "scripts": {
    "build": "node scripts/measure-bundle.mjs --build-only",
    "measure": "node scripts/measure-bundle.mjs",
    "demo": "npm run build && node scripts/dev-server.mjs",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run measure && npm run lint:tokens && npm run test:unit && playwright test"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "0.24.2"
  }
}
