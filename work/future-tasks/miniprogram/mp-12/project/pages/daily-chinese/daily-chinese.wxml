<view class="dc-page">
  <view wx:if="{{loading}}" class="dc-state-card">
    <view class="dc-state-title">加载中…</view>
    <view class="dc-state-desc">正在获取今日语文朗读内容</view>
  </view>

  <view wx:elif="{{loadError}}" class="dc-state-card">
    <view class="dc-state-title">加载失败</view>
    <view class="dc-state-desc">{{loadError}}</view>
    <view class="dc-btn dc-btn-primary dc-retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view wx:if="{{completed}}" class="dc-done-banner">✓ 今日已完成打卡</view>

    <view class="dc-card">
      <view class="dc-meta-row">
        <text class="dc-date" wx:if="{{date}}">{{date}}</text>
        <view class="dc-badges">
          <text class="dc-badge dc-badge-kind" wx:if="{{kindLabel}}">{{kindLabel}}</text>
          <text class="dc-badge dc-badge-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
        </view>
      </view>

      <view class="dc-title">{{item.title}}</view>
      <view class="dc-author" wx:if="{{item.author}}">{{item.author}}</view>

      <view class="dc-passage-box">
        <text class="dc-passage-text" selectable="{{true}}">{{item.text}}</text>
      </view>

      <view class="dc-score-row">
        <view class="dc-score-main">
          <text wx:if="{{hasScore}}" class="dc-score-text">最好 {{best}} 分 · {{starsStr}}</text>
          <text wx:else class="dc-score-empty">未评分</text>
        </view>
        <view wx:if="{{passed}}" class="dc-passed-tag">已达标</view>
      </view>

      <view wx:if="{{lastPron !== null}}" class="dc-last-score">
        本次 {{lastPron}} 分<text wx:if="{{attempts > 0}}">（累计 {{attempts}} 次）</text>
      </view>

      <view class="dc-actions-row">
        <view
          class="dc-btn dc-btn-record {{recording ? 'dc-btn-recording' : ''}} {{assessing ? 'dc-btn-disabled' : ''}}"
          bindtap="onTapRecord"
        >
          <text wx:if="{{assessing}}">评分中…</text>
          <text wx:elif="{{recording}}">录音中…点一下停止</text>
          <text wx:else>🎤 跟读</text>
        </view>
      </view>
    </view>

    <view class="dc-footer">
      <view
        class="dc-btn dc-btn-checkin {{(!passed || completed || checkingIn) ? 'dc-btn-disabled' : 'dc-btn-primary'}}"
        bindtap="onTapCheckin"
      >
        <text wx:if="{{completed}}">今日已完成</text>
        <text wx:elif="{{checkingIn}}">打卡中…</text>
        <text wx:elif="{{!passed}}">还差 1 篇达标（需75分）</text>
        <text wx:else>完成今日打卡</text>
      </view>
    </view>
  </block>
</view>
