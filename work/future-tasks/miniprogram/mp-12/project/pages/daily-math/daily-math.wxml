<view class="dm-page">
  <view wx:if="{{loading}}" class="dm-state-card">
    <view class="dm-state-title">加载中…</view>
    <view class="dm-state-desc">正在获取今日数学练习</view>
  </view>

  <view wx:elif="{{loadError}}" class="dm-state-card">
    <view class="dm-state-title">加载失败</view>
    <view class="dm-state-desc">{{loadError}}</view>
    <view class="dm-btn dm-btn-primary dm-retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view wx:if="{{completed}}" class="dm-done-banner">✓ 今日已完成</view>

    <view class="dm-header-card">
      <view class="dm-header-top">
        <text class="dm-date" wx:if="{{date}}">{{date}}</text>
        <text class="dm-count-tag">今日 5 道题</text>
      </view>
      <view class="dm-progress-row">
        <text class="dm-progress-label">已答对</text>
        <text class="dm-progress-num">{{correctCount}}/5</text>
      </view>
      <view class="dm-note">每道题想好再提交，提交后不能改；答对 4 道才能打卡。</view>
    </view>

    <view class="dm-list">
      <view wx:for="{{problemList}}" wx:key="index" class="dm-problem-card">
        <view class="dm-problem-head">
          <text class="dm-problem-no">第 {{index + 1}} 题</text>
          <text wx:if="{{item.kindLabel}}" class="dm-kind-badge">{{item.kindLabel}}</text>
        </view>

        <view class="dm-question-zh">{{item.q}}</view>
        <view wx:if="{{item.kind === 'word' && item.qEn}}" class="dm-question-en">{{item.qEn}}</view>

        <view class="dm-input-row">
          <input
            class="dm-input {{(item.answered || completed) ? 'dm-input-disabled' : ''}}"
            type="number"
            placeholder="答案"
            value="{{item.answered ? item.userAnswer : item.inputValue}}"
            disabled="{{item.answered || completed || item.submitting}}"
            data-index="{{item.index}}"
            bindinput="onInputAnswer"
          />
          <view
            class="dm-btn dm-submit-btn {{(item.answered || completed || item.submitting || item.inputValue === '') ? 'dm-btn-disabled' : 'dm-btn-primary'}}"
            data-index="{{item.index}}"
            bindtap="onTapSubmit"
          >
            <text wx:if="{{item.submitting}}">提交中…</text>
            <text wx:elif="{{item.answered}}">已提交</text>
            <text wx:else>提交</text>
          </view>
        </view>

        <view wx:if="{{item.answered}}" class="dm-result-row">
          <text wx:if="{{item.correct}}" class="dm-result-correct">答对了 ✓</text>
          <text wx:else class="dm-result-wrong">答错了，正确答案是 {{item.correctAnswer}}</text>
        </view>
      </view>
    </view>

    <view class="dm-footer">
      <view
        class="dm-btn dm-btn-checkin {{(completed || !passed || checkingIn) ? 'dm-btn-disabled' : 'dm-btn-primary'}}"
        bindtap="onTapCheckin"
      >
        <text wx:if="{{completed}}">今日已完成</text>
        <text wx:elif="{{checkingIn}}">打卡中…</text>
        <text wx:elif="{{!passed}}">还差 {{neededCount}} 道答对</text>
        <text wx:else>完成今日打卡</text>
      </view>
    </view>
  </block>
</view>
