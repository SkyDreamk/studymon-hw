.container { padding: 16rpx; }
.empty-state { color: #5c6b7a; font-size: 28rpx; padding: 40rpx; }
.quiz-header { padding: 32rpx; text-align: left; margin-bottom: 24rpx; }
.progress-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.progress-title { font-size: 32rpx; font-weight: bold; color: #1f2d3d; }
.progress-counts { font-size: 28rpx; color: #2f7cf6; font-weight: bold; }
.bar-track { width: 100%; height: 16rpx; background: #e1e4e8; border-radius: 8rpx; overflow: hidden; margin-bottom: 20rpx; }
.bar-fill { height: 100%; background: #2f7cf6; transition: width 0.3s; }
.fragment-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.fragment-info { font-size: 26rpx; color: #5c6b7a; }
.moves-entry-btn { width: auto; height: 52rpx; line-height: 52rpx; padding: 0 24rpx; margin: 0; font-size: 24rpx; font-weight: bold; color: #fff; background: #2f7cf6; border-radius: 999rpx; }
.moves-entry-btn::after { border: none; }
.hint-text { margin-top: 16rpx; font-size: 24rpx; color: #059669; background: #D1FAE5; padding: 12rpx; border-radius: 12rpx; display: inline-block; }

.question-card { padding: 32rpx; text-align: left; margin-bottom: 24rpx; }
.q-label { font-size: 24rpx; color: #5c6b7a; background: #e1e4e8; padding: 4rpx 16rpx; border-radius: 999rpx; display: inline-block; margin-bottom: 16rpx; }
.q-text { font-size: 32rpx; font-weight: bold; color: #1f2d3d; margin-bottom: 32rpx; line-height: 1.5; }
.options-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.option-btn { background: #F9FAFB; border: 2rpx solid #E5E7EB; color: #1f2d3d; padding: 24rpx; font-size: 28rpx; font-weight: normal; border-radius: 16rpx; text-align: left; margin: 0; line-height: 1.4; height: auto; }
.option-btn::after { border: none; }
.opt-correct { background: #D1FAE5 !important; border-color: #059669 !important; color: #059669 !important; font-weight: bold; }
.opt-wrong { background: #FEE2E2 !important; border-color: #DC2626 !important; color: #DC2626 !important; text-decoration: line-through; }
.opt-disabled { opacity: 0.6; }

.result-box { margin-top: 32rpx; padding-top: 32rpx; border-top: 2rpx dashed #E5E7EB; }
.result-title { font-size: 32rpx; font-weight: bold; margin-bottom: 16rpx; }
.res-correct { color: #059669; }
.res-wrong { color: #DC2626; }
.result-details { font-size: 26rpx; color: #4B5563; line-height: 1.6; margin-bottom: 20rpx; }
.res-xp { color: #2f7cf6; font-weight: bold; }
.res-encounter { color: #8B5CF6; font-weight: bold; margin-top: 8rpx; }
.res-levelup { color: #EC4899; font-weight: bold; margin-top: 8rpx; background: #FCE7F3; padding: 12rpx; border-radius: 12rpx; display: inline-block; }
.explain-box { background: #F3F4F6; padding: 24rpx; border-radius: 16rpx; font-size: 26rpx; color: #1f2d3d; line-height: 1.5; }
.explain-title { font-weight: bold; margin-bottom: 8rpx; color: #6B7280; }
