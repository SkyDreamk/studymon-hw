.container { padding: 16rpx; }
.header-card { padding: 24rpx 32rpx; margin: 16rpx; margin-bottom: 24rpx; text-align: left; }
.header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.page-title { font-size: 34rpx; font-weight: bold; color: #1f2d3d; }
.streak-text { font-size: 26rpx; font-weight: bold; color: #2f7cf6; }
.progress-label { font-size: 24rpx; color: #5c6b7a; margin-bottom: 12rpx; }
.bar-track { width: 100%; height: 12rpx; background: #e1e4e8; border-radius: 6rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #2f7cf6; transition: width 0.3s; }
.empty-state { padding: 48rpx 32rpx; color: #5c6b7a; font-size: 28rpx; border: 4rpx dashed #e1e4e8; background: transparent; box-shadow: none; text-align: center; border-radius: 24rpx; margin: 16rpx; }
.subjects-list { padding: 0 16rpx; }
.subject-card { text-align: left; margin-bottom: 16rpx; padding: 20rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04); }
.subj-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.subj-name { font-size: 30rpx; font-weight: bold; color: #1f2d3d; }
.pill { padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: bold; }
.status-none { background: #F3F4F6; color: #6B7280; }
.status-pending { background: #FEF3C7; color: #D97706; }
.status-approved { background: #D1FAE5; color: #059669; }
.status-rejected { background: #FEE2E2; color: #DC2626; }
.subj-note { font-size: 24rpx; color: #4B5563; margin-bottom: 8rpx; line-height: 1.4; }
.subj-photos { font-size: 24rpx; color: #6366F1; margin-bottom: 8rpx; }
.subj-reason { font-size: 24rpx; color: #DC2626; background: #FEF2F2; padding: 12rpx 16rpx; border-radius: 12rpx; margin-bottom: 8rpx; }
.subj-action { margin-top: 12rpx; text-align: right; }
.btn-sm { display: inline-block; width: auto; font-size: 26rpx; padding: 0 32rpx; margin: 0; height: 56rpx; line-height: 56rpx; }
