.container { padding: 24rpx; }
.card { padding: 40rpx; text-align: left; }
.title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.subj-title { font-size: 40rpx; font-weight: bold; color: #1f2d3d; }
.pill { padding: 8rpx 24rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: bold; }
.status-none { background: #F3F4F6; color: #6B7280; }
.status-pending { background: #FEF3C7; color: #D97706; }
.status-approved { background: #D1FAE5; color: #059669; }
.status-rejected { background: #FEE2E2; color: #DC2626; }
.reason-banner { background: #FEF2F2; color: #DC2626; padding: 20rpx; border-radius: 16rpx; margin-bottom: 24rpx; font-size: 26rpx; line-height: 1.4; }
.note-input { width: 100%; box-sizing: border-box; height: 200rpx; background: #F9FAFB; border: 2rpx solid #E5E7EB; border-radius: 16rpx; padding: 24rpx; font-size: 28rpx; margin-bottom: 32rpx; color: #1f2d3d; }
.note-display { font-size: 28rpx; color: #4B5563; background: #F9FAFB; padding: 24rpx; border-radius: 16rpx; margin-bottom: 32rpx; }
.photo-section { margin-bottom: 32rpx; }
.photo-label { font-size: 28rpx; font-weight: bold; margin-bottom: 20rpx; color: #1f2d3d; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.photo-wrap { position: relative; width: 140rpx; height: 140rpx; }
.photo-img { width: 100%; height: 100%; border-radius: 12rpx; background: #F3F4F6; }
.photo-del { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; background: #DC2626; color: #fff; text-align: center; line-height: 36rpx; border-radius: 50%; font-size: 28rpx; z-index: 2; }
.photo-add { width: 140rpx; height: 140rpx; background: #F9FAFB; border: 4rpx dashed #D1D5DB; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 48rpx; color: #9CA3AF; }
.locked-msg { margin-top: 24rpx; font-size: 28rpx; font-weight: bold; color: #059669; text-align: center; }
.footer-hint { margin-top: 32rpx; font-size: 24rpx; color: #5c6b7a; text-align: center; padding: 0 40rpx; line-height: 1.5; }
